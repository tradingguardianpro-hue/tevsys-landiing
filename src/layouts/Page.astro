---
import { Header, Footer } from '@components/odyssey-theme';
import Layout from './Base.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import settings from '../config/settings';
import { footerSocials } from '../config/footer';
import { getFooterColumns } from '../i18n/footer.js';
import { getNav } from '../i18n/nav.js';
import { getLocaleFromUrl, localizeHref } from '../i18n/locales.js';
import BrandOval from '../components/BrandOval.astro';
import LanguageSwitcher from '../components/core/LanguageSwitcher.astro';

export interface Props {
  seo?: BaseHeadProps;
  bodyClass?: string;
  /** Forzar locale (p. ej. páginas bajo /en). Si no, se deduce de la URL. */
  lang?: string;
}

const { seo, bodyClass, lang: langProp } = Astro.props as Props;
const lang = langProp || getLocaleFromUrl(Astro.url);
const nav = getNav(lang);
const homeHref = localizeHref('/', lang);
const footerColumns = getFooterColumns(lang);
---

<Layout seo={seo} bodyClass={bodyClass} lang={lang}>
  <Header rightMenu navData={nav} slot="header" lang={lang} logoHref={homeHref}>
    <BrandOval slot="logo" />
    <LanguageSwitcher slot="action-item" />
  </Header>
  <div id="page">
    <slot />
  </div>
  <Footer
    slot="footer"
    background="var(--theme-surface-1)"
    color="var(--theme-on-surface-1)"
    footerColumns={footerColumns}
    footerSocials={footerSocials}
    copyrightName={settings.name}
    showPlug={settings.showPlug}
    lang={lang}
  >
    <a href={homeHref} slot="logo" class="footer-brand__name">
    <img src="/favicon.png" alt="" width="24" height="24" class="footer-brand__logo" />
    <span>tevsys™</span>
  </a>
  </Footer>
</Layout>
