---
import { SkipLink } from '@components/odyssey-theme';
import BaseHead from '../components/head/BaseHead.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import EvidenceLightboxGlobal from '../components/core/EvidenceLightboxGlobal.astro';

export interface Props {
	seo?: BaseHeadProps;
	/** Clases opcionales en `<body>` (p. ej. hooks de motion por página). */
	bodyClass?: string;
	/** Idioma del documento (`es` | `en` …). */
	lang?: string;
	/**
	 * Tema del documento. Por defecto `dark` (marca).
	 * Piloto 23 oct: `light` solo en `/como-funciona` — reversible.
	 */
	theme?: 'dark' | 'light';
}

const { seo, bodyClass, lang = 'es', theme = 'dark' } = Astro.props;
---

<html lang={lang} data-theme={theme}>
	<head>
		<BaseHead {...seo} />
	</head>
	<body class:list={[bodyClass]}>
		<SkipLink />
    <slot name="announcement-bar" />
		<slot name="header" />
		<main id="content">
			<slot />
		</main>
		<slot name="footer" />
		<EvidenceLightboxGlobal />
		<script>
			import { inject } from '@vercel/analytics';
			inject({
				beforeSend: (event) => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('va-disable')) {
						return null;
					}
					return event;
				},
			});
		</script>
	</body>
</html>
