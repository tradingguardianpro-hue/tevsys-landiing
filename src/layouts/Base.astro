---
import { SkipLink } from '@components/odyssey-theme';
import { ViewTransitions, fade } from 'astro:transitions';
import BaseHead from '../components/head/BaseHead.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import EvidenceLightboxGlobal from '../components/core/EvidenceLightboxGlobal.astro';

export interface Props {
	seo?: BaseHeadProps;
	/** Clases opcionales en `<body>` (p. ej. hooks de motion por página). */
	bodyClass?: string;
	/** Idioma del documento (`es` | `en` …). */
	lang?: string;
	/**
	 * Tema del documento. Por defecto `dark` (marca).
	 * Piloto 23 oct: `light` solo en `/como-funciona` — reversible.
	 */
	theme?: 'dark' | 'light';
}

const { seo, bodyClass, lang = 'es', theme = 'dark' } = Astro.props;
---

<html lang={lang} data-theme={theme}>
	<head>
		{/* Antes del CSS: si hay #ancla en carga fría, tapa negra hasta revelar (fundido · 23 oct 2026). */}
		<script is:inline>
			(() => {
				try {
					if (!location.hash || location.hash.length < 2) return;
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
					document.documentElement.classList.add('tgp-hash-arrive');
					/* Tapa inmediata (antes de que cargue reset.css) — evita un frame del muro. */
					const boot = document.createElement('style');
					boot.id = 'tgp-hash-arrive-boot';
					boot.textContent =
						'html.tgp-hash-arrive{background-color:#0a0a0c}' +
						'html.tgp-hash-arrive body{opacity:0!important}';
					document.documentElement.appendChild(boot);
				} catch (_) {}
			})();
		</script>
		<BaseHead {...seo} />
		{/* Canon 23 oct: View Transitions (~180 ms). Carga fría con # = fundido tgp-hash-arrive. */}
		<ViewTransitions />
	</head>
	<body class:list={[bodyClass]}>
		<SkipLink />
    <slot name="announcement-bar" />
		<slot name="header" />
		<main id="content" transition:animate={fade({ duration: '180ms' })}>
			<slot />
		</main>
		<slot name="footer" />
		<EvidenceLightboxGlobal />
		<script is:inline>
			(() => {
				const scrollToHash = () => {
					if (!location.hash || location.hash.length < 2) return;
					const id = decodeURIComponent(location.hash.slice(1));
					const el = document.getElementById(id);
					if (el) el.scrollIntoView({ behavior: 'auto', block: 'start' });
				};

				const revealColdHash = () => {
					const root = document.documentElement;
					if (!root.classList.contains('tgp-hash-arrive')) return;
					requestAnimationFrame(() => {
						requestAnimationFrame(() => {
							root.classList.add('tgp-hash-arrive-in');
							const boot = document.getElementById('tgp-hash-arrive-boot');
							if (boot) boot.remove();
							window.setTimeout(() => {
								root.classList.remove('tgp-hash-arrive', 'tgp-hash-arrive-in');
							}, 220);
						});
					});
				};

				/* Tras swap de View Transitions: ancla sin montaña rusa. */
				document.addEventListener('astro:after-swap', scrollToHash);
				document.addEventListener('astro:page-load', () => {
					scrollToHash();
					revealColdHash();
				});

				if (document.readyState === 'complete') {
					scrollToHash();
					revealColdHash();
				} else {
					window.addEventListener(
						'load',
						() => {
							scrollToHash();
							revealColdHash();
						},
						{ once: true },
					);
				}
			})();
		</script>
		<script>
			import { inject } from '@vercel/analytics';
			inject({
				beforeSend: (event) => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('va-disable')) {
						return null;
					}
					return event;
				},
			});
		</script>
	</body>
</html>
