---
import { SkipLink } from '@components/odyssey-theme';
import BaseHead from '../components/head/BaseHead.astro';
import type { Props as BaseHeadProps } from '../components/head/BaseHead.astro';
import EvidenceLightboxGlobal from '../components/core/EvidenceLightboxGlobal.astro';

export interface Props {
	seo?: BaseHeadProps;
	/** Clases opcionales en `<body>` (p. ej. hooks de motion por página). */
	bodyClass?: string;
	/** Idioma del documento (`es` | `en` …). */
	lang?: string;
	/**
	 * Tema del documento. Por defecto `dark` (marca).
	 * Piloto 23 oct: `light` solo en `/como-funciona` — reversible.
	 */
	theme?: 'dark' | 'light';
}

const { seo, bodyClass, lang = 'es', theme = 'dark' } = Astro.props;

/** Canon anclas 23 oct: salto directo + fundido tapa ~200 ms. View Transitions probado y descartado (parecía scroll corto). */
const HASH_FADE_MS = 200;
---

<html lang={lang} data-theme={theme}>
	<head>
		{/* Antes del CSS: si hay #ancla, tapa negra hasta revelar (fundido corto · canon). */}
		<script is:inline>
			(() => {
				try {
					if (!location.hash || location.hash.length < 2) return;
					if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
					document.documentElement.classList.add('tgp-hash-arrive');
					/* Tapa inmediata (antes de que cargue reset.css) — evita un frame del muro. */
					const boot = document.createElement('style');
					boot.id = 'tgp-hash-arrive-boot';
					boot.textContent =
						'html.tgp-hash-arrive{background-color:#0a0a0c}' +
						'html.tgp-hash-arrive body{opacity:0!important}';
					document.documentElement.appendChild(boot);
				} catch (_) {}
			})();
		</script>
		<BaseHead {...seo} />
	</head>
	<body class:list={[bodyClass]}>
		<SkipLink />
    <slot name="announcement-bar" />
		<slot name="header" />
		<main id="content">
			<slot />
		</main>
		<slot name="footer" />
		<EvidenceLightboxGlobal />
		<script is:inline define:vars={{ HASH_FADE_MS }}>
			(() => {
				const root = document.documentElement;
				if (!root.classList.contains('tgp-hash-arrive')) return;
				const reveal = () => {
					requestAnimationFrame(() => {
						requestAnimationFrame(() => {
							root.classList.add('tgp-hash-arrive-in');
							const boot = document.getElementById('tgp-hash-arrive-boot');
							if (boot) boot.remove();
							window.setTimeout(() => {
								root.classList.remove('tgp-hash-arrive', 'tgp-hash-arrive-in');
							}, HASH_FADE_MS + 40);
						});
					});
				};
				if (document.readyState === 'complete') reveal();
				else window.addEventListener('load', reveal, { once: true });
			})();
		</script>
		<script>
			import { inject } from '@vercel/analytics';
			inject({
				beforeSend: (event) => {
					if (typeof localStorage !== 'undefined' && localStorage.getItem('va-disable')) {
						return null;
					}
					return event;
				},
			});
		</script>
	</body>
</html>
