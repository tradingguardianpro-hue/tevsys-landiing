---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
import settings from '../config/settings.js';
---

<!-- seo explícito: un solo <title> desde settings (evita ambigüedad con caché / meta) -->
<Layout seo={{ title: settings.title, description: settings.description }}>
	<div class="tevsys-home-hero-stack">
		<div class="tevsys-home-kitt-rect tevsys-home-kitt-rect--rise" aria-hidden="true"></div>
		<div class="tevsys-home-kitt-rect tevsys-home-kitt-rect--fall" aria-hidden="true"></div>
		<div class="tevsys-home-hero-stack__content">
			<HomeHeroSection />
		</div>
	</div>
	<Container>
		<div class="tevsys-home-band tevsys-home-band--cards">
			<div class="tevsys-home-mid-glow" aria-hidden="true"></div>
			<p class="tevsys-home-hero-bridge" aria-label="Capas del producto: Precisión, HyperClose, SML, Evidencia">
				<span class="tevsys-home-hero-bridge__text">Precisión · HyperClose · SML · Evidencia</span>
			</p>
		<section class="feature-card__section">
			<h2 class="feature-section__title">¿Has perdido dinero por no parar a tiempo — y por deslizamiento al límite?</h2>
			<div class="feature-card__checklist-static">
				<p class="feature-section__hook">Sin excusas. Las buenas intenciones no cierran con alta precisión ni bloquean operaciones. <span class="tevsys-brand-accent-underline">Nosotros sí.</span></p>
				<ul class="feature-card__checklist-static-items" aria-label="Checklist resumen de valor">
					<li>Doble trazabilidad real: lógica interna tevsys + ejecución oficial MT5.</li>
					<li>Configuras una vez. Ejecutamos siempre. Incluso los días que tú decides estar OFF.</li>
				</ul>
			</div>
			<p class="feature-card__intro-ellos"><span class="feature-hook__dot" aria-hidden="true"></span>Ellos deslizan. En tevsys cerramos.</p>
			<div class="feature-card__grid">
				<a href="/features/precision" class="tevsys-card">
					<span class="tevsys-card__arrow" aria-hidden="true">→</span>
					<div class="tevsys-card__image">
						<!-- PNG directo: el .webp antiguo tapaba el arte nuevo hasta regenerar con `node scripts/optimize-images.js` -->
						<img src="/assets/images/home/cards/card-1-input.png?v=8" alt="0,06% error medio" width="640" height="400" loading="lazy" decoding="async" />
					</div>
					<div class="tevsys-card__content">
						<div class="tevsys-card__title-row">
							<h3><span class="card-title__accent">0,06%</span> error medio</h3>
							<span class="tevsys-card__saber-mas">Saber más</span>
						</div>
						<p class="feature-card__hook">¿Has sentido que tu Stop Loss te cerró en otro planeta? — tevsys te lo cuenta todo.</p>
						<p><span class="feature-card__value-accent">Ajuste a tiempo real</span>: volatilidad, spread, slippage y comisiones.</p>
						<p>{settings.documentedOperatives} operativas documentadas en 5 entornos de ejecución.</p>
					</div>
				</a>
				<a href="/features/hyperclose" class="tevsys-card">
					<span class="tevsys-card__arrow" aria-hidden="true">→</span>
					<div class="tevsys-card__image">
						<img src="/assets/images/home/cards/card-2-hyperclose.png?v=9" alt="HyperClose" width="640" height="400" loading="lazy" decoding="async" />
					</div>
					<div class="tevsys-card__content">
						<div class="tevsys-card__title-row">
							<h3><span class="card-title__accent">HyperClose</span></h3>
							<span class="tevsys-card__saber-mas">Saber más</span>
						</div>
						<p class="feature-card__hook">La diferencia entre querer parar y<span class="feature-card__value-accent feature-card__value-accent--spaced">no poder seguir</span>.</p>
						<p>Si operas bloqueado, HyperClose cierra en milisegundos.</p>
						<p>Cada intento queda registrado. También en días OFF.</p>
					</div>
				</a>
				<a href="/features/sml" class="tevsys-card">
					<span class="tevsys-card__arrow" aria-hidden="true">→</span>
					<div class="tevsys-card__image">
						<img src="/assets/images/home/cards/card-3-sml.png?v=10" alt="SML Smart Money Lock" width="640" height="400" loading="lazy" decoding="async" />
					</div>
					<div class="tevsys-card__content">
						<div class="tevsys-card__title-row">
							<h3><span class="card-title__accent">SML</span> — Smart Money Lock</h3>
							<span class="tevsys-card__saber-mas">Saber más</span>
						</div>
						<p class="feature-card__hook">No es obligatorio. Es una recompensa.</p>
						<p>Lo activas cuando quieras: amplías margen entre 5 % y 25 % (<span class="feature-card__value-accent">mín. 75 % protegido</span>).</p>
						<p>Conserva lo ganado y convive con tus límites y días OFF.</p>
					</div>
				</a>
				<a href="/features/evidencia" class="tevsys-card">
					<span class="tevsys-card__arrow" aria-hidden="true">→</span>
					<div class="tevsys-card__image">
						<img src="/assets/images/home/cards/card-4-evidencia.png?v=7" alt="Evidencia verificable" width="640" height="400" loading="lazy" decoding="async" />
					</div>
					<div class="tevsys-card__content">
						<div class="tevsys-card__title-row">
							<h3><span class="card-title__accent">Evidencia</span> verificable</h3>
							<span class="tevsys-card__saber-mas">Saber más</span>
						</div>
						<p class="feature-card__hook">No confíes: Comprueba.</p>
						<p class="feature-card__evidence-case"><strong>Caso real:</strong> 100.000 € · 20 lotes · Apertura Wall Street.</p>
						<p class="feature-card__evidence-stat">Error al cierre: <span class="feature-card__evidence-stat-value">0,0072 %</span></p>
						<p class="feature-card__evidence-proofline">Vídeo del cierre, informe MT5 e historial de transacciones.</p>
						<p class="feature-card__evidence-close">Todo verificable. Todo descargable.</p>
						<p class="feature-card__whisper">Para ti o para quien te audite.</p>
					</div>
				</a>
			</div>
		</section>
		</div>
	</Container>
	<div class="tevsys-home-band tevsys-home-band--lower">
		<div class="tevsys-home-lower-strip" aria-hidden="true"></div>
		<section class="audit-teaser-section" aria-labelledby="audit-teaser-title">
			<div class="audit-teaser-shell">
				<p class="audit-teaser-kicker">Verificación con IA · próximamente</p>
				<h2 id="audit-teaser-title">¿Quieres auditar tu operativa con IA?</h2>
				<p class="audit-teaser-lead">No auditamos tu estrategia: auditamos ejecución, precisión de cierre, el cumplimiento de límites y la evidencia real.</p>
				<p class="audit-teaser-bridge">Hoy ya puedes cruzar MT5 y logs tevsys por tu cuenta. Estamos preparando la revisión asistida para quien quiera un dictamen estructurado.</p>
				<ul class="audit-teaser-points" aria-label="Qué revisamos en auditoría IA">
					<li>Registros internos de tevsys (estado, bloqueos y eventos clave).</li>
					<li>Logs de sesión de tevsys + informe oficial MT5 del mismo periodo.</li>
				</ul>
				<p class="audit-teaser-note">Pensado para traders, academias y equipos que exigen trazabilidad real en cada decisión.</p>
				<a href="/auditoria-ia" class="audit-teaser-cta">Próximamente — qué estamos preparando</a>
			</div>
		</section>
		<Container>
		<section class="plans-section">
			<h2 class="plans-section__title">Elige tu cuenta</h2>
			<p class="plans-section__subtitle">No vendemos señales. Vendemos ejecución disciplinada, alta precisión verificable de cierre en MT5, evidencia real y control bajo presión.</p>
			<div class="plans-grid">
				<article class="plan-card">
					<div class="plan-card__image">
						<picture><source type="image/webp" srcset="/assets/images/plans/essential-card.webp" /><img src="/assets/images/plans/essential-card.png" alt="Plan Essential" width="640" height="360" loading="lazy" decoding="async" /></picture>
					</div>
					<div class="plan-card__content">
						<p class="plan-card__status plan-card__status--live">Demo activa</p>
						<h3><span class="card-title__accent">Essential</span></h3>
						<ul class="plan-card__bullets plan-card__bullets--aperitivo" aria-label="Resumen Essential">
							<li><strong>Disciplina automatizada</strong> y <strong>gestión de riesgo</strong> con los límites que tú configuras.</li>
							<li>Cierre de alta precisión · bloqueo hasta rotación.</li>
							<li><strong>HyperClose</strong> · bloqueado o límite tocado: un intento de operar → cierre inmediato.</li>
							<li>Días OFF y rotación diaria (un día activo).</li>
							<li>Noticias y horarios · cuando estén listas.</li>
						</ul>
						<p class="plan-card__aperitivo-footer">Demo disponible · detalle y condiciones en <a href="/precios#essential">Precios</a></p>
						{settings.checkoutEssentialReady ? (
							<div class="plan-card__cta-row">
								<a href="/precios#essential" class="plan-card__cta plan-card__cta--primary">Comprar Essential</a>
								<a href="/company/contact?plan=essential" class="plan-card__cta plan-card__cta--secondary">Probar demo</a>
							</div>
						) : (
							<a href="/company/contact?plan=essential" class="plan-card__cta">Elegir Essential</a>
						)}
					</div>
				</article>
				<article class="plan-card">
					<div class="plan-card__image">
						<picture><source type="image/webp" srcset="/assets/images/plans/advanced-card.webp" /><img src="/assets/images/plans/advanced-card.png" alt="Plan Advanced" width="640" height="360" loading="lazy" decoding="async" /></picture>
					</div>
					<div class="plan-card__content">
						<p class="plan-card__status plan-card__status--waitlist">Lista de espera</p>
						<h3><span class="card-title__accent">Advanced</span></h3>
						<p>En Advanced ofrecemos todo lo de Essential, además: protección configurable toda la semana, SML y días OFF. En desarrollo — lista de espera.</p>
						<a href="/company/contact?plan=advanced" class="plan-card__cta">Elegir Advanced</a>
					</div>
				</article>
				<article class="plan-card">
					<div class="plan-card__image">
						<picture><source type="image/webp" srcset="/assets/images/plans/pro-card.webp" /><img src="/assets/images/plans/pro-card.png" alt="Plan Pro" width="640" height="360" loading="lazy" decoding="async" /></picture>
					</div>
					<div class="plan-card__content">
						<p class="plan-card__status plan-card__status--waitlist">Lista de espera</p>
						<h3><span class="card-title__accent">Pro</span></h3>
						<p>En Pro ofrecemos todo lo de Advanced, además: drawdown y estructura completa para capitales más altos. En desarrollo — lista de espera.</p>
						<a href="/company/contact?plan=pro" class="plan-card__cta">Elegir Pro</a>
					</div>
				</article>
			</div>
		</section>
		</Container>
		<section class="founder-section tevsys-home-founder-band">
			<div class="tevsys-home-founder-strip" aria-hidden="true"></div>
			<Container>
			<div class="founder-message">
				<p class="founder-claim"><span class="founder-tevsys">tevsys</span> no es el sueño de un inversor. Es la respuesta de un trader.</p>
				<blockquote>
					"Nadie me enseñó a gestionar el riesgo ni la disciplina. Tuve que inventar algo que me obligara a cumplir mis límites con fiabilidad y precisión. <span class="founder-tevsys">tevsys</span> es eso: lo que me faltaba entonces, ahora para todos."
				</blockquote>
				<p class="founder-signature">— Gabi, fundador de tevsys</p>
			</div>
			</Container>
		</section>
		<div class="tevsys-home-tail-bubble-solo" aria-hidden="true"></div>
	</div>
</Layout>

<style>
	.tevsys-home-hero-bridge {
		position: relative;
		z-index: 1;
		margin: 0;
		padding: clamp(1.15rem, 2.6vw, 1.85rem) 0 clamp(0.7rem, 1.6vw, 1rem);
		text-align: center;
	}
	.tevsys-home-hero-bridge::before {
		content: '';
		display: block;
		width: min(7.5rem, 42vw);
		height: 1px;
		margin: 0 auto clamp(0.8rem, 1.5vw, 0.95rem);
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(228, 232, 240, 0.36) 50%,
			transparent 100%
		);
	}
	.tevsys-home-hero-bridge__text {
		font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
		font-size: clamp(0.72rem, 1.05vw, 0.8125rem);
		font-weight: 500;
		letter-spacing: 0.055em;
		color: rgba(228, 232, 240, 0.62);
		line-height: 1.45;
	}
	.tevsys-home-band--cards > .feature-card__section {
		margin-top: clamp(0.2rem, 0.75vw, 0.45rem);
	}
	.feature-card__section {
		--feature-card-radius: clamp(0.85rem, 1.5vw, 1.15rem);
		margin: var(--section-margin) auto;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		text-rendering: optimizeLegibility;
	}
	.feature-section__title {
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: clamp(1.65rem, 3.5vw, 2rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.25;
		margin: 0 0 1.125rem;
	}
	.feature-section__hook {
		font-size: 1rem;
		opacity: 0.94;
		margin: 0 0 0.7rem;
		line-height: 1.55;
	}
	/* Subrayado ámbar → gris (misma familia que /como-funciona). */
	.tevsys-brand-accent-underline {
		display: inline-block;
		font-weight: 600;
		opacity: 1;
		color: rgba(244, 246, 248, 0.98);
	}
	.tevsys-brand-accent-underline::after {
		content: '';
		display: block;
		/* Un poco más ancha que el texto: sobresale a la derecha del «sí» (familia /como-funciona). */
		width: min(8.35rem, calc(100% + 1.35rem));
		height: 3px;
		margin: 0.34rem 0 0 0.04rem;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			rgba(245, 176, 65, 0.95) 0%,
			rgba(148, 154, 168, 0.62) 72%,
			rgba(110, 116, 128, 0.35) 100%
		);
	}
	html[data-theme='light'] .tevsys-brand-accent-underline::after {
		background: linear-gradient(
			90deg,
			rgba(218, 155, 48, 0.9) 0%,
			rgba(120, 125, 138, 0.5) 75%,
			rgba(90, 95, 108, 0.28) 100%
		);
	}
	.feature-card__checklist-static {
		max-width: min(54rem, 100%);
		padding: clamp(0.85rem, 1.8vw, 1.1rem) clamp(0.95rem, 2vw, 1.25rem);
		margin: 0 0 0.8rem;
		border-radius: var(--feature-card-radius, 0.85rem);
		background: linear-gradient(165deg, hsl(222, 14%, 7%), hsl(222, 12%, 5.5%));
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow:
			0 18px 44px -32px rgba(0, 0, 0, 0.55),
			inset 0 1px 0 rgba(255, 255, 255, 0.05),
			0 0 0 1px rgba(245, 176, 65, 0.06);
	}
	.feature-card__checklist-static-items {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.feature-card__checklist-static-items li {
		position: relative;
		padding-left: 1.15rem;
		margin: 0 0 0.45rem;
		font-size: 1rem;
		line-height: 1.55;
		opacity: 0.92;
		color: rgba(244, 246, 248, 0.94);
	}
	.feature-card__checklist-static-items li::before {
		content: '';
		position: absolute;
		left: 0.05rem;
		top: 0.62rem;
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: rgba(245, 176, 65, 0.9);
	}
	.feature-card__checklist-static-items li:last-child {
		margin-bottom: 0;
	}
	/* Estilo micropáginas: punto amarillo + texto gris (hereda) */
	.feature-card__intro-ellos {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-style: italic;
		font-weight: 600;
		opacity: 0.9;
		font-size: 1.05rem;
		margin: 0.25rem 0 clamp(2rem, 4vw, 2.65rem);
		line-height: 1.45;
	}
	.feature-card__intro-ellos .feature-hook__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #f5b041;
		flex-shrink: 0;
	}
	.feature-card__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: clamp(1rem, 2.5vw, 1.35rem);
		margin-top: clamp(0.35rem, 1.2vw, 0.85rem);
	}
	.audit-teaser-section {
		margin: calc(var(--tevsys-lower-strip-h, 180px) * -0.965) auto clamp(2rem, 4vw, 2.75rem);
	}
	@media (max-width: 768px) {
		.audit-teaser-section {
			margin-top: calc(var(--tevsys-lower-strip-h, 150px) * -0.975);
		}
	}
	.audit-teaser-shell {
		max-width: min(52rem, 92%);
		margin: 0 auto;
		padding: clamp(0.95rem, 2.2vw, 1.3rem) clamp(1rem, 2.4vw, 1.5rem);
		border-radius: 1rem;
		border: 1px solid rgba(100, 196, 255, 0.28);
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.008) 100%);
		box-shadow: 0 0 0 1px rgba(100, 196, 255, 0.08) inset;
	}
	/* Etiquetas pequeñas — misma familia que puente hero y capas (IBM Plex Mono). */
	.tevsys-meta-label {
		font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
		font-weight: 500;
		letter-spacing: 0.04em;
	}
	.audit-teaser-kicker {
		margin: 0 0 0.42rem;
		font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
		font-size: clamp(0.72rem, 1.05vw, 0.78rem);
		text-transform: none;
		letter-spacing: 0.055em;
		font-weight: 500;
		color: rgba(245, 176, 65, 0.92);
	}
	.audit-teaser-shell h2 {
		margin: 0 0 1rem;
		font-size: clamp(1.2rem, 2.3vw, 1.5rem);
		line-height: 1.3;
		letter-spacing: -0.02em;
	}
	.audit-teaser-lead {
		margin: 0 0 0.48rem;
		font-size: 0.99rem;
		line-height: 1.56;
		opacity: 0.95;
	}
	.audit-teaser-bridge {
		margin: 0 0 0.58rem;
		font-size: 0.92rem;
		line-height: 1.52;
		opacity: 0.88;
		max-width: 52ch;
	}
	.audit-teaser-points {
		margin: 0 0 0.58rem;
		padding: 0;
		list-style: none;
	}
	.audit-teaser-points li {
		position: relative;
		padding-left: 1.05rem;
		margin: 0 0 0.34rem;
		font-size: 0.94rem;
		line-height: 1.45;
		opacity: 0.9;
	}
	.audit-teaser-points li::before {
		content: '';
		position: absolute;
		left: 0.05rem;
		top: 0.54rem;
		width: 0.38rem;
		height: 0.38rem;
		border-radius: 50%;
		background: rgba(100, 196, 255, 0.9);
	}
	.audit-teaser-points li:last-child {
		margin-bottom: 0;
	}
	.audit-teaser-note {
		margin: 0 0 0.8rem;
		font-size: 0.92rem;
		line-height: 1.5;
		opacity: 0.84;
	}
	.audit-teaser-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.54rem 0.92rem;
		border-radius: 0.65rem;
		border: 1px solid rgba(100, 196, 255, 0.5);
		color: rgba(232, 247, 255, 0.98);
		background: rgba(100, 196, 255, 0.12);
		font-size: 0.86rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.audit-teaser-cta:hover {
		background: rgba(100, 196, 255, 0.18);
		border-color: rgba(100, 196, 255, 0.72);
	}
	.tevsys-card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		/* Gris solo en el bloque de texto: si hay rendija bajo la imagen, no se ve “franja” gris del fondo de la card */
		background-color: transparent;
		color: var(--theme-on-surface-1);
		border-radius: var(--feature-card-radius);
		text-decoration: none;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.045);
		box-shadow:
			0 22px 56px -34px rgba(0, 0, 0, 0.62),
			0 0 36px -18px rgba(245, 176, 65, 0.07);
		transition:
			border-color 0.22s ease,
			box-shadow 0.22s ease,
			transform 0.22s ease;
	}
	.tevsys-card:hover {
		border-color: rgba(245, 176, 65, 0.38);
		box-shadow:
			0 0 32px rgba(245, 176, 65, 0.16),
			0 22px 50px -26px rgba(0, 0, 0, 0.58);
		/* Pase 1: menos “salto”; sigue notándose premium */
		transform: translateY(-1px);
	}
	.tevsys-card:focus-visible {
		outline: 2px solid rgba(245, 176, 65, 0.85);
		outline-offset: 3px;
	}
	.tevsys-card__arrow {
		position: absolute;
		bottom: 1rem;
		right: 1rem;
		font-size: 1.25rem;
		opacity: 0.45;
