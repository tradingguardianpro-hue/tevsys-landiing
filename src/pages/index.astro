---
import { Container, FeatureCard } from '@components/odyssey-theme';

import Layout from '../layouts/Page.astro';
import HomeHeroSection from '../components/sections/heros/HomeHeroSection.astro';
---

<Layout>
	<HomeHeroSection />
	<Container>
		<section class="feature-card__section">
			<h2>Qué hace tevsys</h2>
			<p>
				tevsys obliga a los traders a respetar sus propias reglas, protege el capital sin excusas y deja trazabilidad con reportes MT5 oficiales.
			</p>
			<div class="feature-card__grid">
				<FeatureCard href="/company/contact" title="Precisión milimétrica" imgSrc="/assets/images/home/screenshots/landing-1">
				</FeatureCard>
				<FeatureCard href="/company/contact" title="HyperClose" imgSrc="/assets/images/home/screenshots/landing-2">
				</FeatureCard>
				<FeatureCard href="/company/contact" title="Evidencia verificable" imgSrc="/assets/images/home/screenshots/about">
				</FeatureCard>
			</div>
		</section>
	</Container>
</Layout>

<style>
	.feature-card__section {
		margin: var(--section-margin) auto;
	}
	.feature-card__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--theme-grid-gap);
	}
	@media (max-width: 768px) {
		.feature-card__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
