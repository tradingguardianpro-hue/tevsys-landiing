		position: absolute;
		top: 0;
		left: var(--x, 10%);
		width: max-content;
		font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
		font-size: clamp(0.62rem, 1.1vw, 0.72rem);
