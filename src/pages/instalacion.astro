---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Cómo instalar tevsys | Guía paso a paso',
	description:
		'Guía MT5 (~1 min 24 s): descarga demo, trading algorítmico, WebRequest con https://tevsys.io, copiar el EA a Experts y cargarlo en el gráfico.',
};

const guiasConfiguracion = [
	{
		label: 'Essential',
		title: 'Configuración',
		href: '/configuracion',
	},
	{
		label: 'Advanced / Pro',
		title: 'Configuración al instalar de lunes a viernes',
		href: '/configuracion-al-instalar',
	},
	{
		label: 'Advanced / Pro',
		title: 'Planificar la semana en sábado o domingo',
		href: '/configuracion-fin-de-semana',
	},
];

const bloquesLectura = [
	{
		n: 1,
		title: 'Descarga',
		detail: 'Abre el enlace del email y descarga el archivo. Luego abre MetaTrader 5.',
	},
	{
		n: 2,
		title: 'Prepara MT5',
		detail:
			'Herramientas → Opciones → Asesores Expertos: activa trading algorítmico y WebRequest. Añade https://tevsys.io (sin barra final). El vídeo lo muestra paso a paso.',
	},
	{
		n: 3,
		title: 'Instala y carga',
		detail:
			'Archivo → Abrir carpeta de datos → MQL5 → Experts. Copia el .ex5 del email, actualiza la lista en Navegador (Ctrl+N) y arrastra tevsys al gráfico.',
	},
];
---

<Layout seo={seo}>
	<Container>
		<section class="feature-hero">
			<p class="feature-kicker">Guía de instalación</p>
			<h1>Cómo instalar tevsys en MT5</h1>
			<p class="feature-hook">
				<span class="feature-hook__dot" aria-hidden="true"></span>Vídeo 1:24 — del enlace del email al EA en el gráfico.
			</p>
			<p class="feature-lead feature-lead--note">
				<strong>WebRequest</strong> (<code>https://tevsys.io</code>): recomendable en demo para no repetir el paso al
				comprar · <strong>obligatorio</strong> con licencia de pago (validación de clave).
			</p>
		</section>

		<section id="instalacion-video" class="feature-demo feature-demo--video">
			<div class="feature-demo__title">
				<span class="feature-hook__dot" aria-hidden="true"></span>
				<h2>Instalación rápida</h2>
			</div>
			<div class="demo-video demo-video--instalacion" id="instalacion-demo-container">
				<video id="instalacion-demo-video" controls preload="metadata" playsinline>
					<source src="/videos/features/instalacion-demo.mp4?v=20260605webreq" type="video/mp4" />
					Tu navegador no soporta reproducción de video HTML5.
				</video>
			</div>
		</section>

		<section class="feature-proof feature-proof--compact">
			<h2>Si prefieres leer</h2>
			<p class="instalacion-read-intro">Apoyo al vídeo — tres bloques, mismo orden.</p>
			<ol class="instalacion-phase-list">
				{
					bloquesLectura.map((bloque) => (
						<li>
							<div class="instalacion-phase">
								<span class="instalacion-phase__n">{bloque.n}</span>
								<div class="instalacion-phase__body">
									<strong class="instalacion-phase__title">{bloque.title}</strong>
									<p class="instalacion-phase__detail">{bloque.detail}</p>
								</div>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		<section id="configuracion" class="feature-demo feature-demo--next">
			<h2>Siguiente paso — Configuración</h2>
			<p class="feature-demo-hook">
				Con el EA en el gráfico verás la bienvenida y el panel. Elige la guía según tu plan y el día:
			</p>
			<ul class="guia-fork-list">
				{
					guiasConfiguracion.map((guia) => (
						<li>
							<a href={guia.href} class="guia-fork-link">
								<span class="guia-fork-link__label">{guia.label}</span>
								<span class="guia-fork-link__title">{guia.title}</span>
								<span class="guia-fork-link__arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="feature-cta">
			<h2>¿Necesitas la demo?</h2>
			<p>Rellena el formulario y te enviamos el enlace de descarga + esta guía.</p>
			<a href="/company/contact?flow=demo" class="feature-cta__button">Solicitar demo</a>
		</section>
	</Container>
</Layout>

<script>
	function initDemoExpand() {
		const video = document.getElementById('instalacion-demo-video');
		const container = document.getElementById('instalacion-demo-container');
		if (!video || !container) return;
		video.addEventListener('play', () => container.classList.add('demo-video--playing'));
		video.addEventListener('ended', () => container.classList.remove('demo-video--playing'));
	}
	document.addEventListener('DOMContentLoaded', initDemoExpand);
</script>

<style>
	.feature-hero,
	.feature-demo,
	.feature-proof,
	.feature-cta {
		margin: var(--section-margin) auto;
	}
	.feature-kicker {
		margin: 0 0 0.35rem;
		opacity: 0.8;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
	}
	.feature-hook {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-style: italic;
		font-weight: 600;
		opacity: 0.9;
		margin: 0 0 0.85rem;
		max-width: 52ch;
		line-height: 1.45;
	}
	.feature-hook__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #f5b041;
		flex-shrink: 0;
	}
	.feature-lead--note {
		margin: 0;
		padding: 0.75rem 0.9rem;
		border-radius: 0.5rem;
		border: 1px solid rgba(245, 176, 65, 0.35);
		background: rgba(245, 176, 65, 0.06);
		font-size: 0.98rem;
		max-width: 70ch;
		line-height: 1.55;
	}
	.feature-lead--note code {
		background: rgba(0, 0, 0, 0.25);
		padding: 0.1rem 0.35rem;
		border-radius: 0.25rem;
		font-size: 0.88em;
	}
	.feature-demo__title {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.85rem;
	}
	.feature-demo__title h2 {
		margin: 0;
		font-size: 1.35rem;
	}
	.feature-demo h2,
	.feature-proof h2,
	.feature-cta h2 {
		margin: 0 0 0.75rem;
		font-size: 1.35rem;
	}
	.feature-demo--video {
		max-width: 640px;
	}
	.feature-demo-hook {
		margin: 0 0 0.75rem;
		opacity: 0.9;
		max-width: 52ch;
		line-height: 1.5;
	}
	.demo-video--instalacion {
		outline: 1px solid rgba(245, 176, 65, 0.22);
		outline-offset: 4px;
		border-radius: var(--theme-shape-radius);
	}
	.demo-video--instalacion.demo-video--playing {
		max-width: none;
	}
	.feature-proof--compact {
		max-width: 44rem;
	}
	.instalacion-read-intro {
		margin: 0 0 0.85rem;
		font-size: 0.92rem;
		opacity: 0.72;
		line-height: 1.45;
	}
	.instalacion-phase-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.instalacion-phase {
		display: flex;
		gap: 0.85rem;
		align-items: flex-start;
		padding: 0.85rem 1rem;
		border-radius: 0.5rem;
		background: var(--theme-surface-1);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-left: 3px solid rgba(245, 176, 65, 0.45);
	}
	.instalacion-phase__n {
		flex-shrink: 0;
		width: 1.65rem;
		height: 1.65rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 50%;
		background: rgba(245, 176, 65, 0.15);
		color: #f5b041;
		font-weight: 700;
		font-size: 0.85rem;
	}
	.instalacion-phase__body {
		min-width: 0;
		flex: 1;
	}
	.instalacion-phase__title {
		display: block;
		font-size: 1rem;
		margin-bottom: 0.3rem;
		line-height: 1.35;
	}
	.instalacion-phase__detail {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.55;
		opacity: 0.88;
	}
	.guia-fork-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		max-width: 42rem;
	}
	.guia-fork-link {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.65rem;
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: var(--theme-surface-1);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.guia-fork-link:hover {
		border-color: rgba(245, 176, 65, 0.45);
		color: #f5b041;
	}
	.guia-fork-link__label {
		font-size: 0.78rem;
		font-weight: 500;
		opacity: 0.55;
		flex: 0 0 100%;
	}
	.guia-fork-link__title {
		font-weight: 600;
		font-size: 0.98rem;
		line-height: 1.35;
		flex: 1;
		min-width: 0;
	}
	.guia-fork-link__arrow {
		flex-shrink: 0;
		opacity: 0.55;
		font-size: 1.1rem;
	}
	.guia-fork-link:hover .guia-fork-link__arrow {
		opacity: 1;
		color: #f5b041;
	}
	.demo-video {
		background: #06080d;
		overflow: hidden;
	}
	.demo-video video {
		display: block;
		width: 100%;
	}
	.feature-cta {
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1.2rem;
		border: 1px solid var(--theme-surface-border);
		box-shadow: var(--theme-surface-elevated-shadow);
	}
	.feature-cta p {
		margin: 0 0 0.9rem;
		line-height: 1.5;
	}
</style>
