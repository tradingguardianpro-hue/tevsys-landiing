---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Cómo instalar tevsys | Guía paso a paso',
	description:
		'Guía MT5 (~1 min 24 s): descarga demo, trading algorítmico, WebRequest con https://tevsys.io, copiar el EA a Experts y cargarlo en el gráfico.',
};

const guiasConfiguracion = [
	{
		label: 'Essential',
		title: 'Configuración',
		href: '/configuracion',
	},
	{
		label: 'Advanced / Pro',
		title: 'Configuración al instalar de lunes a viernes',
		href: '/configuracion-al-instalar',
	},
	{
		label: 'Advanced / Pro',
		title: 'Planificar la semana en sábado o domingo',
		href: '/configuracion-fin-de-semana',
	},
];

const otrasGuias = [
	{ title: 'Guía Essential — configuración', href: '/configuracion' },
	{ title: 'Configuración al instalar (L–V)', href: '/configuracion-al-instalar' },
	{ title: 'Planificar la semana (S–D)', href: '/configuracion-fin-de-semana' },
];
---

<Layout seo={seo}>
	<Container>
		<section class="feature-hero">
			<p class="feature-kicker">Guía de instalación</p>
			<h1>Cómo instalar tevsys en MT5</h1>
			<p class="feature-hook">
				<span class="feature-hook__dot" aria-hidden="true"></span>Cuenta nueva, desde cero. Vídeo paso a paso.
			</p>
			<p class="feature-lead">
				Descarga el archivo desde el enlace del email, prepara MT5 y sigue el vídeo o los pasos de abajo.
				Cuando el EA esté en el gráfico, pasa a la guía de configuración que corresponda a tu plan y al día.
			</p>
			<p class="feature-lead feature-lead--note">
				<strong>WebRequest</strong> (<code>https://tevsys.io</code>): recomendable en demo para no repetir el paso al
				comprar · <strong>obligatorio</strong> con licencia de pago (validación de clave).
			</p>
		</section>

		<section id="instalacion-video" class="feature-demo">
			<h2>Vídeo — Instalación rápida</h2>
			<p class="instalacion-video-badge" role="status">
				<span class="instalacion-video-badge__icon" aria-hidden="true">▶</span>
				<span><strong>Vídeo en esta página</strong> — reproducción bajo este bloque.</span>
			</p>
			<p class="feature-demo-hook">1:24 min · trading algorítmico, WebRequest y carga del EA.</p>
			<div class="demo-video demo-video--compact demo-video--instalacion" id="instalacion-demo-container">
				<video id="instalacion-demo-video" controls preload="metadata">
					<source src="/videos/features/instalacion-demo.mp4?v=20260605webreq" type="video/mp4" />
					Tu navegador no soporta reproducción de video HTML5.
				</video>
			</div>
		</section>

		<section class="feature-proof">
			<h2>Pasos resumidos</h2>
			<p class="instalacion-steps-intro">
				Orden recomendado. Los pasos 3 y 4 preparan MT5; luego copias el archivo y cargas el EA.
			</p>
			<ol class="instalacion-step-list">
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">1</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">Descarga</strong>
							<p class="instalacion-step__detail">Usa el enlace que te enviamos por email.</p>
						</div>
					</div>
				</li>
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">2</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">Abre MetaTrader 5</strong>
						</div>
					</div>
				</li>
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">3</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">Trading algorítmico (siempre encendido)</strong>
							<p class="instalacion-step__detail">
								Herramientas → Opciones → <strong>Asesores Expertos</strong> → marca <em>Permitir operar algorítmico</em>.
							</p>
						</div>
					</div>
				</li>
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">4</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">WebRequest + dominio tevsys</strong>
							<p class="instalacion-step__detail">
								Misma pestaña <strong>Asesores Expertos</strong>: activa <em>Permitir WebRequest</em> y añade
								<code>https://tevsys.io</code> (sin barra final). El vídeo muestra este paso en detalle.
							</p>
						</div>
					</div>
				</li>
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">5</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">Carpeta del EA</strong>
							<p class="instalacion-step__detail">Archivo → Abrir carpeta de datos → <code>MQL5</code> → <code>Experts</code>.</p>
						</div>
					</div>
				</li>
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">6</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">Copia el .ex5</strong>
							<p class="instalacion-step__detail">Arrastra el <code>.ex5</code> que te enviamos por email a la carpeta Experts.</p>
						</div>
					</div>
				</li>
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">7</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">Actualiza la lista en MT5</strong>
							<p class="instalacion-step__detail">Navegador (Ctrl+N) → clic derecho en Experts → Actualizar.</p>
						</div>
					</div>
				</li>
				<li>
					<div class="instalacion-step">
						<span class="instalacion-step__n">8</span>
						<div class="instalacion-step__body">
							<strong class="instalacion-step__title">Carga en el gráfico</strong>
							<p class="instalacion-step__detail">Arrastra tevsys al gráfico o doble clic sobre el EA.</p>
						</div>
					</div>
				</li>
			</ol>
			<p class="instalacion-note">
				Tras cargar el EA: bienvenida, onboarding y panel listo para configurar.
			</p>
		</section>

		<section id="configuracion" class="feature-demo feature-demo--next">
			<h2>Siguiente paso — Configuración</h2>
			<p class="feature-demo-hook">El EA ya está en el gráfico. Elige según tu plan y el día:</p>
			<ul class="guia-fork-list">
				{
					guiasConfiguracion.map((guia) => (
						<li>
							<a href={guia.href} class="guia-fork-link">
								<span class="guia-fork-link__label">{guia.label}</span>
								<span class="guia-fork-link__title">{guia.title}</span>
								<span class="guia-fork-link__arrow" aria-hidden="true">→</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="feature-demo feature-demo--related">
			<h2>Otras guías</h2>
			<ul class="guia-related-links">
				{
					otrasGuias.map((guia) => (
						<li>
							<a href={guia.href}>{guia.title}</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="feature-cta">
			<h2>¿Necesitas la demo?</h2>
			<p>Rellena el formulario y te enviamos el enlace de descarga + esta guía.</p>
			<a href="/company/contact?flow=demo" class="feature-cta__button">Solicitar demo</a>
		</section>
	</Container>
</Layout>

<script>
	function initDemoExpand() {
		const video = document.getElementById('instalacion-demo-video');
		const container = document.getElementById('instalacion-demo-container');
		if (!video || !container) return;
		video.addEventListener('play', () => container.classList.add('demo-video--playing'));
		video.addEventListener('ended', () => container.classList.remove('demo-video--playing'));
	}
	document.addEventListener('DOMContentLoaded', initDemoExpand);
</script>

<style>
	.feature-hero,
	.feature-demo,
	.feature-proof,
	.feature-cta {
		margin: var(--section-margin) auto;
	}
	.feature-kicker {
		margin: 0 0 0.35rem;
		opacity: 0.8;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
	}
	.feature-hook {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-style: italic;
		font-weight: 600;
		opacity: 0.9;
		margin: 0 0 0.7rem;
	}
	.feature-hook__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #f5b041;
		flex-shrink: 0;
	}
	.feature-lead {
		max-width: 70ch;
		line-height: 1.55;
	}
	.feature-lead--note {
		margin-top: 0.85rem;
		padding: 0.75rem 0.9rem;
		border-radius: 0.5rem;
		border: 1px solid rgba(245, 176, 65, 0.35);
		background: rgba(245, 176, 65, 0.06);
		font-size: 0.98rem;
		max-width: 70ch;
	}
	.feature-lead--note code {
		background: rgba(0, 0, 0, 0.25);
		padding: 0.1rem 0.35rem;
		border-radius: 0.25rem;
		font-size: 0.88em;
	}
	.feature-demo h2,
	.feature-proof h2,
	.feature-cta h2 {
		margin: 0 0 0.75rem;
		font-size: 1.35rem;
	}
	.feature-demo-hook {
		margin: 0 0 0.75rem;
		opacity: 0.9;
		font-style: italic;
	}
	.instalacion-video-badge {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 0.65rem;
		padding: 0.55rem 0.85rem;
		border-radius: 0.5rem;
		border: 1px solid rgba(245, 176, 65, 0.45);
		background: rgba(245, 176, 65, 0.1);
		font-size: 0.95rem;
		line-height: 1.4;
		max-width: 42rem;
	}
	.instalacion-video-badge__icon {
		color: #f5b041;
		font-size: 1rem;
		line-height: 1;
	}
	.demo-video--instalacion {
		outline: 1px solid rgba(245, 176, 65, 0.25);
		outline-offset: 4px;
	}
	.instalacion-steps-intro {
		margin: 0 0 1rem;
		max-width: 52ch;
		line-height: 1.5;
		opacity: 0.88;
		font-size: 0.98rem;
	}
	.instalacion-step-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
		max-width: 40rem;
	}
	.instalacion-step {
		display: flex;
		gap: 0.75rem;
		align-items: flex-start;
		padding: 0.65rem 0.85rem;
		border-radius: 0.5rem;
		background: var(--theme-surface-1);
		border: 1px solid rgba(255, 255, 255, 0.06);
	}
	.instalacion-step__n {
		flex-shrink: 0;
		width: 1.75rem;
		height: 1.75rem;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.35rem;
		background: rgba(245, 176, 65, 0.2);
		color: #f5b041;
		font-weight: 700;
		font-size: 0.9rem;
	}
	.instalacion-step__body {
		min-width: 0;
		flex: 1;
	}
	.instalacion-step__title {
		display: block;
		font-size: 1rem;
		margin-bottom: 0.25rem;
		line-height: 1.35;
	}
	.instalacion-step__detail {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.55;
		opacity: 0.88;
	}
	.instalacion-step-list code {
		background: rgba(0, 0, 0, 0.25);
		padding: 0.12rem 0.4rem;
		border-radius: 0.25rem;
		font-size: 0.88em;
	}
	.instalacion-note {
		opacity: 0.9;
		font-style: italic;
		font-size: 0.95rem;
		max-width: 52ch;
	}
	.guia-fork-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		max-width: 42rem;
	}
	.guia-fork-link {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.65rem;
		padding: 0.75rem 1rem;
		border-radius: 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: var(--theme-surface-1);
		color: inherit;
		text-decoration: none;
		transition: border-color 0.15s ease, color 0.15s ease;
	}
	.guia-fork-link:hover {
		border-color: rgba(245, 176, 65, 0.45);
		color: #f5b041;
	}
	.guia-fork-link__label {
		font-size: 0.78rem;
		font-weight: 500;
		opacity: 0.55;
		flex: 0 0 100%;
	}
	.guia-fork-link__title {
		font-weight: 600;
		font-size: 0.98rem;
		line-height: 1.35;
		flex: 1;
		min-width: 0;
	}
	.guia-fork-link__arrow {
		flex-shrink: 0;
		opacity: 0.55;
		font-size: 1.1rem;
	}
	.guia-fork-link:hover .guia-fork-link__arrow {
		opacity: 1;
		color: #f5b041;
	}
	.feature-demo--related {
		max-width: 42rem;
	}
	.guia-related-links {
		margin: 0;
		padding-left: 1.25rem;
		line-height: 1.7;
	}
	.guia-related-links a {
		color: #f5b041;
		text-decoration: underline;
	}
	.demo-video {
		background: #06080d;
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
	}
	.demo-video--compact {
		max-width: 560px;
	}
	.demo-video--compact.demo-video--playing {
		max-width: none;
	}
	.demo-video video {
		display: block;
		width: 100%;
	}
	.feature-cta {
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1.2rem;
		border: 1px solid var(--theme-surface-border);
		box-shadow: var(--theme-surface-elevated-shadow);
	}
	.feature-cta p {
		margin: 0 0 0.9rem;
		line-height: 1.5;
	}
</style>
