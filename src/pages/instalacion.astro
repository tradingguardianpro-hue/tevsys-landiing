---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import '../styles/guia-operativa.css';

const seo = {
	title: 'Cómo instalar tevsys | Guía paso a paso',
	description:
		'Guía MT5 (~1 min 24 s): descarga demo, trading algorítmico, WebRequest con https://tevsys.io, copiar el EA a Experts y cargarlo en el gráfico.',
};

const guiasConfiguracion = [
	{
		label: 'Essential',
		title: 'Configuración',
		href: '/configuracion',
	},
	{
		label: 'Advanced / Pro',
		title: 'Configuración al instalar de lunes a viernes',
		href: '/configuracion-al-instalar',
	},
	{
		label: 'Advanced / Pro',
		title: 'Planificar la semana en sábado o domingo',
		href: '/configuracion-fin-de-semana',
	},
];

const bloquesLectura = [
	{
		n: 1,
		title: 'Descarga',
		detail: 'Abre el enlace del email y descarga el archivo. Luego abre MetaTrader 5.',
	},
	{
		n: 2,
		title: 'Prepara MT5',
		detail:
			'Herramientas → Opciones → Asesores Expertos: activa trading algorítmico y WebRequest.',
		urlLine: 'Añade https://tevsys.io en la lista (sin barra final). El vídeo lo muestra paso a paso.',
	},
	{
		n: 3,
		title: 'Instala y carga',
		detail:
			'Archivo → Abrir carpeta de datos → MQL5 → Experts. Copia el .ex5 del email, actualiza la lista en Navegador (Ctrl+N) y arrastra tevsys al gráfico.',
	},
];
---

<Layout seo={seo} bodyClass="page-guia-instalacion">
	<Container>
		<div class="guia-page">
			<section class="feature-hero guia-hero">
				<p class="guia-eyebrow">Guía de instalación</p>
				<h1>Cómo instalar tevsys en MT5</h1>
				<p class="feature-hook">
					<span class="feature-hook__dot" aria-hidden="true"></span>Vídeo 1:24 — del enlace del email al EA en el gráfico.
				</p>
				<p class="guia-note-box">
					<strong>WebRequest</strong> (<code>https://tevsys.io</code>): recomendable en demo para no repetir el paso al
					comprar · <strong>obligatorio</strong> con licencia de pago (validación de clave).
				</p>
			</section>

			<section id="instalacion-video" class="guia-video-panel">
				<div class="guia-video-panel__halo" aria-hidden="true"></div>
				<div class="guia-video-panel__inner">
					<header class="guia-section-head">
						<p class="guia-eyebrow">Vídeo</p>
						<h2>Instalación rápida</h2>
					</header>
					<div class="guia-embed guia-embed--chrome" id="instalacion-demo-container">
						<video id="instalacion-demo-video" controls preload="metadata" playsinline>
							<source src="/videos/features/instalacion-demo.mp4?v=20260605webreq" type="video/mp4" />
							Tu navegador no soporta reproducción de video HTML5.
						</video>
					</div>
				</div>
			</section>

			<section class="guia-read-section">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Apoyo al vídeo</p>
					<h2>Si prefieres leer</h2>
					<p class="guia-section-sub">Tres bloques, mismo orden.</p>
				</header>
				<div class="guia-read-panel">
					<ol class="guia-phase-list">
						{
							bloquesLectura.map((bloque) => (
								<li>
									<article class="guia-phase-card">
										<span class="guia-phase-card__n">{bloque.n}</span>
										<div class="guia-phase-card__body">
											<h3 class="guia-phase-card__title">{bloque.title}</h3>
											<p class="guia-phase-card__detail">{bloque.detail}</p>
											{bloque.urlLine && (
												<p class="guia-phase-card__url">
													{bloque.urlLine.split('https://tevsys.io')[0]}
													<code>https://tevsys.io</code>
													{bloque.urlLine.split('https://tevsys.io')[1]}
												</p>
											)}
										</div>
									</article>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section id="configuracion" class="guia-fork-panel">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Después de instalar</p>
					<h2>Siguiente paso — Configuración</h2>
					<p class="guia-section-sub guia-fork-hint">Elige tu guía:</p>
				</header>
				<ul class="guia-fork-list">
					{
						guiasConfiguracion.map((guia) => (
							<li>
								<a href={guia.href} class="guia-fork-link">
									<span class="guia-fork-link__label">{guia.label}</span>
									<span class="guia-fork-link__title">{guia.title}</span>
									<span class="guia-fork-link__arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</Container>
</Layout>

<script>
	function initDemoExpand() {
		const video = document.getElementById('instalacion-demo-video');
		const container = document.getElementById('instalacion-demo-container');
		if (!video || !container) return;
		video.addEventListener('play', () => container.classList.add('guia-embed--playing'));
		video.addEventListener('ended', () => container.classList.remove('guia-embed--playing'));
	}
	document.addEventListener('DOMContentLoaded', initDemoExpand);
</script>
