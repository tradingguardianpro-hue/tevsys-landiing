---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import settings from '../config/settings.js';

const seo = {
	title: 'Para quién | tevsys',
	description:
		'Precisión al límite, freno bajo presión, evidencia verificable — tevsys encaja en traders, academias y gestores que exigen trazabilidad en MT5.',
};

const corePerfiles = [
	{
		id: 'precision',
		label: 'Precisión',
		title: 'Exiges ceñir al límite pactado',
		hook: 'Cierre preciso cuando el mercado lo permite.',
		body: `Error medio ≈ 0,06 % · ${settings.documentedOperatives} operativas documentadas en cinco entornos.`,
		href: '/features/precision',
		accentLineMl: '0.05rem',
	},
	{
		id: 'hyperclose',
		label: 'HyperClose',
		title: 'Necesitas freno cuando la disciplina flaquea',
		hook: 'Parar de verdad — no solo intentarlo.',
		body: 'Cierre al instante si operas bloqueado, con registro de cada intento.',
		href: '/features/hyperclose',
		accentLineMl: '0.05rem',
	},
	{
		id: 'evidencia',
		label: 'Evidencia',
		title: 'Quieres contrastar MT5 y acta tevsys',
		hook: 'No confíes: comprueba.',
		body: 'Informe oficial, panel y logs que se cruzan — sin pedirte fe.',
		href: '/features/evidencia',
		accentLineMl: '0.05rem',
	},
	{
		id: 'sml',
		label: 'SML',
		title: 'Buscas más margen con reglas claras',
		hook: 'Recompensa opcional tras un día positivo.',
		body: 'Amplía margen con topes por plan · validación de escenarios en curso.',
		href: '/features/sml',
		accentLineMl: '0.05rem',
	},
];
---

<Layout seo={seo}>
	<div class="tevsys-feature-micro-surface tevsys-feature-micro-surface--para-quien">
		<Container>
			<section class="feature-hero para-quien-hero">
				<p class="feature-kicker">Para quién</p>
				<h1>
					No es un solo perfil. Es el
					<span class="tevsys-brand-accent-underline tevsys-brand-accent-underline--cuadro-entero">cuadro entero</span> en MT5.
				</h1>
				<p class="feature-hook">
					<span class="feature-hook__dot" aria-hidden="true"></span>
					Precisión, freno bajo presión y evidencia que se cruza — con las reglas que tú configuras.
				</p>
				<ul class="para-quien-audience" aria-label="Perfiles que encajan">
					<li>Desde quien empieza hasta quien exige cierre con precisión.</li>
					<li>Quien necesita freno bajo presión.</li>
					<li>Quien quiere saber qué pasa en la cuenta — trader, gestor o academia.</li>
				</ul>
			</section>

			<p class="tevsys-home-hero-bridge para-quien-bridge" aria-label="Capas del producto">
				<span class="tevsys-home-hero-bridge__text">Precisión · HyperClose · SML · Evidencia</span>
			</p>

			<section class="para-quien-profiles" aria-labelledby="para-quien-profiles-title">
				<h2 id="para-quien-profiles-title" class="para-quien-profiles__title">
					Cuatro capas ·
					<span class="tevsys-brand-accent-underline tevsys-brand-accent-underline--varios-perfiles">varios perfiles</span>
				</h2>
				<div class="para-quien-profiles__panel">
					<ul class="para-quien-profiles__grid">
					{
						corePerfiles.map((perfil) => (
							<li>
								<a class="para-quien-profile" href={perfil.href}>
									<span class="para-quien-profile__arrow" aria-hidden="true">→</span>
									<div class="para-quien-profile__head">
										<p class="para-quien-profile__label">{perfil.label}</p>
										<h3
											class="para-quien-profile__title para-quien-profile__title--accent-line"
											style={`--card-accent-line-ml: ${perfil.accentLineMl}`}
										>
											{perfil.title}
										</h3>
									</div>
									<p class="para-quien-profile__hook">{perfil.hook}</p>
									<p class="para-quien-profile__body">{perfil.body}</p>
									<span class="para-quien-profile__cta">Saber más</span>
								</a>
							</li>
						))
					}
				</ul>
				</div>
			</section>

			<section class="para-quien-equipos" aria-labelledby="para-quien-equipos-title">
				<p class="para-quien-equipos__kicker">Equipos e instituciones</p>
				<h2 id="para-quien-equipos-title" class="para-quien-equipos__title">
					Academias, prop firms y quien te audita
				</h2>
				<div class="para-quien-equipos__copy">
					<p class="para-quien-equipos__lead">Trazabilidad para revisar ejecución y límites.</p>
					<p class="para-quien-equipos__note">
						No auditamos tu estrategia. Instituciones, gestores externos y equipos tienen canal aparte.
					</p>
				</div>
				<div class="para-quien-equipos__links">
					<a class="para-quien-equipos__link" href="/company/empresas">Canal empresas</a>
					<a class="para-quien-equipos__link para-quien-equipos__link--muted" href="/auditoria-ia">Auditoría · próximamente</a>
				</div>
			</section>

			<p class="para-quien-map-line">
				¿Quieres el mapa completo?
				<a class="evidence-link" href="/como-funciona">Cómo funciona</a>
				— instalación, límites, cierre y evidencia.
			</p>

			<section class="feature-cta">
				<h2>¿Quieres probarlo en tu operativa?</h2>
				<p>Te guiamos para validar encaje real — demo Essential o contacto si necesitas Advanced o Pro.</p>
				<a href="/company/contact?flow=demo" class="feature-cta__button">Probar tevsys en demo</a>
			</section>
		</Container>
	</div>
</Layout>

<style>
	.para-quien-audience {
		margin: clamp(0.85rem, 2vw, 1.1rem) 0 0;
		padding: 0;
		list-style: none;
		max-width: 52ch;
	}
	.para-quien-audience li {
		position: relative;
		margin: 0 0 0.42rem;
		padding-left: 1.05rem;
		font-size: clamp(0.86rem, 1.35vw, 0.92rem);
		line-height: 1.48;
		opacity: 0.9;
	}
	.para-quien-audience li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.58em;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: rgba(228, 232, 240, 0.38);
	}
	html[data-theme='light'] .para-quien-audience li::before {
		background: rgba(80, 86, 98, 0.35);
	}
	.para-quien-audience li:last-child {
		margin-bottom: 0;
	}
	.tevsys-brand-accent-underline--cuadro-entero::after {
		/* Ancho ≈ «cuadro entero» + sobresalida derecha; inicio desplazado (familia /como-funciona). */
		width: min(calc(100% + 1.15rem), 13.5rem);
		margin: 0.36rem 0 0 0.62rem;
	}
	.tevsys-brand-accent-underline--varios-perfiles::after {
		width: min(calc(100% + 0.85rem), 10.5rem);
		height: 2px;
		margin: 0.28rem 0 0 0.48rem;
	}
	/* Subrayado ámbar → gris (familia home / como-funciona) */
	.tevsys-brand-accent-underline {
		display: inline-block;
		font-weight: 700;
		color: rgba(244, 246, 248, 0.98);
	}
	.tevsys-brand-accent-underline::after {
		content: '';
		display: block;
		width: min(9rem, calc(100% + 0.5rem));
		height: 3px;
		margin: 0.34rem 0 0 0.04rem;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			rgba(245, 176, 65, 0.95) 0%,
			rgba(148, 154, 168, 0.62) 72%,
			rgba(110, 116, 128, 0.35) 100%
		);
	}
	html[data-theme='light'] .tevsys-brand-accent-underline::after {
		background: linear-gradient(
			90deg,
			rgba(218, 155, 48, 0.9) 0%,
			rgba(120, 125, 138, 0.5) 75%,
			rgba(90, 95, 108, 0.28) 100%
		);
	}
	/* Puente mono — centrado como home */
	.para-quien-bridge.tevsys-home-hero-bridge {
		position: relative;
		z-index: 1;
		margin: 0;
		text-align: center;
		padding: clamp(0.65rem, 1.8vw, 1rem) 0 clamp(0.35rem, 1vw, 0.5rem);
	}
	.para-quien-bridge.tevsys-home-hero-bridge::before {
		content: '';
		display: block;
		width: min(7.5rem, 42vw);
		height: 1px;
		margin: 0 auto clamp(0.8rem, 1.5vw, 0.95rem);
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(228, 232, 240, 0.36) 50%,
			transparent 100%
		);
	}
	html[data-theme='light'] .para-quien-bridge.tevsys-home-hero-bridge::before {
		background: linear-gradient(
			90deg,
			transparent 0%,
			rgba(100, 106, 118, 0.32) 50%,
			transparent 100%
		);
	}
	.para-quien-bridge :global(.tevsys-home-hero-bridge__text) {
		font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
		font-size: clamp(0.72rem, 1.05vw, 0.8125rem);
		font-weight: 500;
		letter-spacing: 0.055em;
		color: rgba(228, 232, 240, 0.62);
		line-height: 1.45;
	}
	html[data-theme='light'] .para-quien-bridge :global(.tevsys-home-hero-bridge__text) {
		color: rgba(60, 66, 78, 0.72);
	}
	.para-quien-profiles {
		margin: clamp(1.65rem, 4.2vw, 2.35rem) 0 clamp(1.15rem, 3vw, 1.5rem);
		padding-top: clamp(0.35rem, 1vw, 0.55rem);
	}
	.para-quien-profiles__title {
		margin: 0 0 clamp(1.15rem, 2.8vw, 1.45rem);
		font-size: clamp(1.08rem, 2.3vw, 1.22rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-align: center;
	}
	.para-quien-profiles__panel {
		padding: clamp(1rem, 2.4vw, 1.35rem);
		border-radius: var(--feature-micro-radius, 0.85rem);
		background: linear-gradient(165deg, hsl(222, 14%, 6.5%), hsl(222, 12%, 4.8%));
		border: 1px solid rgba(255, 255, 255, 0.07);
		box-shadow:
			0 22px 52px -36px rgba(0, 0, 0, 0.62),
			inset 0 1px 0 rgba(255, 255, 255, 0.04),
			0 0 0 1px rgba(245, 176, 65, 0.05);
	}
	html[data-theme='light'] .para-quien-profiles__panel {
		background: linear-gradient(165deg, hsl(222, 10%, 97%), hsl(220, 8%, 94%));
		border-color: rgba(15, 18, 28, 0.07);
		box-shadow:
			0 16px 40px -28px rgba(15, 18, 28, 0.18),
			inset 0 1px 0 rgba(255, 255, 255, 0.9);
	}
	.para-quien-profiles__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1rem, 2.5vw, 1.35rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (max-width: 640px) {
		.para-quien-profiles__grid {
			grid-template-columns: 1fr;
		}
	}
	.para-quien-profile {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.52rem;
		height: 100%;
		padding: clamp(1.1rem, 2.4vw, 1.35rem) clamp(1.05rem, 2.3vw, 1.25rem) 1.15rem;
		border-radius: calc(var(--feature-micro-radius, 0.85rem) - 0.08rem);
		background: linear-gradient(162deg, hsl(222, 13%, 8.5%), hsl(222, 11%, 6%));
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-left: 2px solid rgba(245, 176, 65, 0.42);
		box-shadow:
			0 20px 48px -30px rgba(0, 0, 0, 0.58),
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
			inset 3px 0 12px -8px rgba(245, 176, 65, 0.12);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 200ms ease,
			box-shadow 200ms ease,
			transform 200ms ease;
	}
	html[data-theme='light'] .para-quien-profile {
		background: linear-gradient(162deg, hsl(222, 11%, 98%), hsl(220, 9%, 95%));
		border-color: rgba(15, 18, 28, 0.09);
		border-left-color: rgba(184, 120, 20, 0.45);
		box-shadow:
			0 14px 36px -26px rgba(15, 18, 28, 0.22),
			inset 0 1px 0 rgba(255, 255, 255, 0.92);
	}
	.para-quien-profile:hover {
		border-color: rgba(245, 176, 65, 0.42);
		border-left-color: rgba(245, 176, 65, 0.78);
		box-shadow:
			0 22px 48px -28px rgba(0, 0, 0, 0.62),
			inset 0 1px 0 rgba(255, 255, 255, 0.07),
			0 0 0 1px rgba(245, 176, 65, 0.14),
			0 0 32px rgba(245, 176, 65, 0.08);
		transform: translateY(-3px);
	}
	.para-quien-profile__arrow {
		position: absolute;
		right: 0.9rem;
		bottom: 0.9rem;
		font-size: 1.1rem;
		opacity: 0.4;
		transition: opacity 160ms ease, color 160ms ease, transform 160ms ease;
	}
	.para-quien-profile:hover .para-quien-profile__arrow {
		opacity: 1;
		color: #f5b041;
		transform: translate(2px, -2px);
	}
	.para-quien-profile__head {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.para-quien-profile__label {
		margin: 0;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #f5b041;
	}
	html[data-theme='light'] .para-quien-profile__label {
		color: #b87814;
	}
	.para-quien-profile__title {
		margin: 0;
		padding-right: 1.75rem;
		font-size: clamp(1.02rem, 2.25vw, 1.12rem);
		font-weight: 700;
		line-height: 1.35;
		letter-spacing: -0.018em;
	}
	.para-quien-profile__title--accent-line::after {
		content: '';
		display: block;
		width: 3.75rem;
		height: 2px;
		margin: 0.36rem 0 0 0.72rem;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			rgba(245, 176, 65, 0.92) 0%,
			rgba(148, 154, 168, 0.58) 72%,
			rgba(110, 116, 128, 0.32) 100%
		);
	}
	.para-quien-profile__hook {
		margin: 0;
		font-size: 0.88rem;
		font-style: italic;
		line-height: 1.45;
		opacity: 0.92;
		color: rgba(244, 246, 248, 0.94);
	}
	html[data-theme='light'] .para-quien-profile__hook {
		color: rgba(28, 32, 42, 0.88);
	}
	.para-quien-profile__body {
		margin: 0;
		flex: 1;
		font-size: 0.84rem;
		line-height: 1.5;
		opacity: 0.82;
	}
	.para-quien-profile__cta {
		margin-top: 0.15rem;
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		opacity: 0.7;
	}
	.para-quien-profile:hover .para-quien-profile__cta {
		opacity: 1;
		color: #f5b041;
	}
	.para-quien-equipos {
		margin: clamp(1.35rem, 3.2vw, 1.85rem) 0 clamp(1.25rem, 3vw, 1.65rem);
		padding: clamp(1.45rem, 3.2vw, 2rem) clamp(1.25rem, 3vw, 1.75rem);
		border-radius: var(--feature-micro-radius, 0.85rem);
		border: 1px solid rgba(245, 176, 65, 0.22);
		background: linear-gradient(148deg, rgba(245, 176, 65, 0.06), rgba(12, 14, 18, 0.5));
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.04),
			0 0 0 1px rgba(245, 176, 65, 0.05);
		text-align: center;
	}
	html[data-theme='light'] .para-quien-equipos {
		border-color: rgba(180, 120, 20, 0.22);
		background: linear-gradient(148deg, rgba(245, 176, 65, 0.08), rgba(248, 249, 252, 0.98));
	}
	.para-quien-equipos__kicker {
		margin: 0 0 0.55rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(245, 176, 65, 0.82);
	}
	html[data-theme='light'] .para-quien-equipos__kicker {
		color: rgba(160, 105, 18, 0.88);
	}
	.para-quien-equipos__title {
		margin: 0 0 clamp(1rem, 2.4vw, 1.25rem);
		font-size: clamp(1.06rem, 2.25vw, 1.18rem);
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.35;
	}
	.para-quien-equipos__copy {
		display: flex;
		flex-direction: column;
		gap: clamp(0.65rem, 1.6vw, 0.85rem);
		margin: 0 auto clamp(1.15rem, 2.6vw, 1.45rem);
		max-width: 44ch;
	}
	.para-quien-equipos__lead {
		margin: 0;
		font-size: clamp(0.92rem, 1.5vw, 0.98rem);
		line-height: 1.55;
		font-weight: 600;
		opacity: 0.96;
	}
	.para-quien-equipos__note {
		margin: 0;
		font-size: clamp(0.86rem, 1.35vw, 0.92rem);
		line-height: 1.58;
		opacity: 0.78;
	}
	.para-quien-equipos__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem 1.5rem;
		padding-top: clamp(0.85rem, 2vw, 1.05rem);
		border-top: 1px solid rgba(228, 232, 240, 0.1);
	}
	html[data-theme='light'] .para-quien-equipos__links {
		border-top-color: rgba(60, 66, 78, 0.12);
	}
	.para-quien-equipos__link {
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.para-quien-equipos__link--muted {
		font-weight: 500;
		opacity: 0.78;
	}
	.para-quien-equipos__link:hover {
		color: #f5b041;
		opacity: 1;
	}
	.para-quien-map-line {
		margin: 0 0 clamp(1.25rem, 3vw, 1.75rem);
		max-width: 54ch;
		font-size: 0.9rem;
		line-height: 1.55;
		opacity: 0.88;
		text-align: center;
		margin-left: auto;
		margin-right: auto;
	}
	.feature-cta {
		margin: var(--section-margin) auto;
	}
</style>
