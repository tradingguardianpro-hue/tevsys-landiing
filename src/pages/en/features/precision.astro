		height: 0.45rem;
		border-radius: 50%;
		background: #f5b041;
		flex-shrink: 0;
	}

	#precision-volatilidad .feature-demo__title--primary-demo {
		margin-bottom: 0.75rem;
	}
	#precision-demo > h2,
	#precision-volatilidad > h2 {
		margin: 0 0 0.65rem;
		font-size: 1.35rem;
	}
	.feature-demo-youtube-more {
		margin: 0.55rem 0 0;
		font-size: 0.92rem;
		opacity: 0.88;
	}
	.feature-demo-youtube-more a {
		color: #f5b041;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.feature-demo-youtube-more a:hover {
		color: #f7c050;
	}
	.feature-demo-youtube-more__hint {
		opacity: 0.72;
	}
	.demo-edit-note .evidence-link {
		font-style: normal;
	}
	.feature-demo--hero {
		position: relative;
	}
	.feature-demo--hero::before {
		content: '';
