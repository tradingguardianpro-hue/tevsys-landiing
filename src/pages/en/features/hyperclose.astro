---
import { Container } from '@components/odyssey-theme';
import Layout from '../../../layouts/Page.astro';

const seo = {
	title: 'HyperClose | tevsys',
	description:
		'See how HyperClose closes in milliseconds when you try to trade while locked.',
};
---

<Layout seo={seo} lang="en">
	<div class="tevsys-feature-micro-surface tevsys-feature-micro-surface--hyperclose">
	<Container>
		<section class="feature-hero">
			<p class="feature-kicker">Protection feature</p>
			<h1>
				HyperClose: when your discipline fails, HyperClose <span class="feature-title__accent">doesn’t.</span>
			</h1>
			<p class="feature-hook">
				<span class="feature-hook__dot" aria-hidden="true"></span><span class="feature-title__accent">Close in milliseconds.</span> Until the next window (day or week), no shortcuts.
			</p>
			<p class="feature-lead">
				Trading while locked triggers an instant close; what happens is traced so you can verify it.
			</p>
			<p class="feature-extreme-note">
				This is not the close when you hit your limit — it is the brake if, already in STOP, you try to open again.
			</p>
		</section>

		<section id="hyperclose-demo" class="feature-demo feature-demo--hero">
			<div class="hyperclose-multichart">
				<p class="feature-hook hyperclose-multichart__lead">
					<span class="feature-hook__dot" aria-hidden="true"></span>
					<span>One chart for tevsys. Your whole account, protected.</span>
				</p>
				<p class="hyperclose-multichart__sub">Protection alerts appear on all your open charts.</p>
			</div>
			<h2>Demo — millimetric precision + HyperClose (2:23)</h2>
			<p class="feature-demo-hook">
				15 lots · GER40 · −1% limit · <strong class="feature-title__accent">€1.31 deviation</strong> · Wall Street open · <strong class="feature-title__accent">HyperClose in 3 levels</strong>.
			</p>
			<p class="demo-edit-note">On-screen EA UI may still appear in Spanish.</p>
			<div class="demo-video demo-video--hero demo-video--hero-elegant" id="hyperclose-demo-container">
				<video id="hyperclose-demo-video" controls preload="metadata" playsinline
					poster="/videos/features/hyperclose-demo-poster.jpg?v=20260816">
					<source src="/videos/features/hyperclose-demo.mp4" type="video/mp4" />
					Your browser does not support HTML5 video.
				</video>
			</div>
			<p class="demo-edit-note">
				<strong>Edited video:</strong> we show the moments that matter in the flow (approaching the limit, close, lock, HyperClose). You may see a <strong>clock jump</strong> in the terminal between cuts: the original recording was longer. What lets you verify behaviour rigorously is the <strong>MT5 report</strong> and the history/HTML in the accordion below.
			</p>
			<p class="feature-demo-youtube-more">
				<a href="/videos-cierre-youtube">More close cases</a>
				<span class="feature-demo-youtube-more__hint"> — list with links and titles.</span>
			</p>
			<details class="proof-accordion hyperclose-demo-evidence">
				<summary class="proof-capture-link">Verify it yourself — MT5 report, screenshots and history</summary>
				<div class="hyperclose-demo-evidence__text">
					<div class="hyperclose-mt5-captures proof-gallery">
						<p class="proof-gallery__hint">
							Official MT5 report (same account as the video). Report period covering the recorded session and, where applicable, later trades. Click to enlarge.
						</p>
						<div class="proof-gallery__grid">
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Summary</p>
								<p class="proof-gallery__title">Overview</p>
								<p class="proof-gallery__desc">Global view: net profit, balance and ratios for the period selected in MT5.</p>
								<a
									class="proof-gallery__zoom"
									href="/images/evidence/hyperclose-demo-informe-summary.png"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Open Summary screenshot full size"
								>
									<img
										class="proof-gallery__image"
										src="/images/evidence/hyperclose-demo-informe-summary.png"
										alt="MT5 HyperClose demo report: Summary tab."
										loading="lazy"
										width="1200"
										height="800"
										decoding="async"
									/>
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Profit &amp; Loss</p>
								<p class="proof-gallery__title">Profit and loss</p>
								<p class="proof-gallery__desc">Gross/net breakdown and time distribution over the period.</p>
								<a
									class="proof-gallery__zoom"
									href="/images/evidence/hyperclose-demo-informe-profit-loss.png"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Open Profit and Loss screenshot full size"
								>
									<img
										class="proof-gallery__image"
										src="/images/evidence/hyperclose-demo-informe-profit-loss.png"
										alt="MT5 HyperClose demo report: Profit and Loss tab."
										loading="lazy"
										width="1200"
										height="800"
										decoding="async"
									/>
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Long &amp; Short</p>
								<p class="proof-gallery__title">Longs and shorts</p>
								<p class="proof-gallery__desc">Trade and volume distribution by direction over the period.</p>
								<a
									class="proof-gallery__zoom"
									href="/images/evidence/hyperclose-demo-informe-long-short.png"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Open Long and Short screenshot full size"
								>
									<img
										class="proof-gallery__image"
										src="/images/evidence/hyperclose-demo-informe-long-short.png"
										alt="MT5 HyperClose demo report: Long and Short tab."
										loading="lazy"
										width="1200"
										height="800"
										decoding="async"
									/>
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Symbols</p>
								<p class="proof-gallery__title">Symbols</p>
								<p class="proof-gallery__desc">Main instrument (Ger40) and result attributed by symbol.</p>
								<a
									class="proof-gallery__zoom"
									href="/images/evidence/hyperclose-demo-informe-symbols.png"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Open Symbols screenshot full size"
								>
									<img
										class="proof-gallery__image"
										src="/images/evidence/hyperclose-demo-informe-symbols.png"
										alt="MT5 HyperClose demo report: Symbols tab."
										loading="lazy"
										width="1200"
										height="800"
										decoding="async"
									/>
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Risks</p>
								<p class="proof-gallery__title">Risks</p>
								<p class="proof-gallery__desc">Drawdown, best/worst trades and risk metrics for the period.</p>
								<a
									class="proof-gallery__zoom"
									href="/images/evidence/hyperclose-demo-informe-risks.png"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Open Risks screenshot full size"
								>
									<img
										class="proof-gallery__image"
										src="/images/evidence/hyperclose-demo-informe-risks.png"
										alt="MT5 HyperClose demo report: Risks tab."
										loading="lazy"
										width="1200"
										height="800"
										decoding="async"
									/>
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">History</p>
								<p class="proof-gallery__title">Toolbox — History</p>
								<p class="proof-gallery__desc">
									Same-day list: close of the trade in the video and later closes if you tested while locked (e.g. day total −€1,146.40 vs −€1,066.05 in the HTML exported earlier alone).
								</p>
								<a
									class="proof-gallery__zoom"
									href="/images/evidence/hyperclose-demo-mt5-historial-hoy.png"
									target="_blank"
									rel="noopener noreferrer"
									aria-label="Open same-day history screenshot full size"
								>
									<img
										class="proof-gallery__image"
										src="/images/evidence/hyperclose-demo-mt5-historial-hoy.png"
										alt="MT5: same-day history in Toolbox, Ger40 trades."
										loading="lazy"
										width="1200"
										height="800"
										decoding="async"
									/>
								</a>
							</article>
						</div>
					</div>
					<p class="hyperclose-demo-evidence__html-row">
						<a
							class="proof-capture-link"
							href="/docs/evidencia-hyperclose-demo-historial-transacciones.html"
							target="_blank"
							rel="noopener noreferrer"
						>
							Open HTML history for this demo <span class="proof-link-meta">HTML</span>
						</a>
					</p>
					<p class="demo-edit-note hyperclose-demo-evidence__evidencia-hint">
						First time with report tabs?
						<a class="proof-capture-link" href="/en/features/evidencia#evidencia-informe-mt5">Example on another account (100k demo)</a>.
					</p>
					<p class="demo-edit-note hyperclose-demo-evidence__mt5-note">
						<strong>MT5 vs HTML:</strong> the HTML is an export at the <strong>exact close moment</strong> of the trade in the video. MT5 reports and history over a range that covers what came after <strong>also include</strong> the trades that show <strong>how HyperClose closes</strong> when you try to trade while locked.
					</p>
				</div>
			</details>
		</section>

		<section class="feature-proof">
			<h2>What you can verify</h2>
			<ul>
				<li><a class="evidence-link" href="#hyperclose-demo">Automatic close in milliseconds when you try to trade while locked.</a></li>
				<li><a class="evidence-link" href="#hyperclose-semaphore">Progressive responsibility semaphore on repeat attempts (3 levels).</a></li>
				<li><a class="evidence-link" href="#hyperclose-off-demo">Protection on an OFF day with automatic rotation and the same close logic.</a></li>
			</ul>
		</section>

		<section id="hyperclose-semaphore" class="feature-proof-detail">
			<h3>Responsibility semaphore</h3>
			<div class="hyperclose-semaphore-intro">
				<p class="feature-proof-subtitle">Three warning levels if you repeat the attempt</p>
				<p class="feature-proof-lead hyperclose-semaphore-intro__line">
					You already hit the limit; the panel stays in STOP.
				</p>
				<p class="feature-proof-lead hyperclose-semaphore-intro__line">
					If you still try to trade, the close is immediate and the modal escalates:
				</p>
				<ul class="hyperclose-semaphore-levels">
					<li><strong>1st semaphore</strong> — sistema bloqueado (system locked)</li>
					<li><strong>2nd semaphore</strong> — advertencia por reiteración (repeat-attempt warning)</li>
					<li><strong>3rd semaphore</strong> — exención de responsabilidad (liability disclaimer)</li>
				</ul>
			</div>
			<figure class="hyperclose-semaphore-collage">
				<a
					class="hyperclose-semaphore-collage__zoom"
					href="/images/evidence/hyperclose-semaforos-collage-panel-modales.png"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Open STOP panel and three-semaphore collage full size"
				>
					<img
						class="hyperclose-semaphore-collage__image"
						src="/images/evidence/hyperclose-semaforos-collage-panel-modales.png"
						alt="HyperClose: panel in STOP and three semaphore modals (1st system locked, 2nd warning, 3rd disclaimer) with arrows marking each level."
						loading="lazy"
						width="1920"
						height="1080"
						decoding="async"
					/>
				</a>
				<figcaption class="hyperclose-semaphore-collage__caption">
					<span class="hyperclose-semaphore-collage__caption-label">See in video:</span>
					<span class="hyperclose-semaphore-collage__demo-links">
						<a class="proof-capture-link" href="#hyperclose-demo">HyperClose demo · 15 lots and semaphore (2:23)</a>
						<span class="hyperclose-semaphore-collage__demo-sep" aria-hidden="true">·</span>
						<a class="proof-capture-link" href="/en/como-funciona?play=1#evidencia-nasdaq-100">Nasdaq 100 — live session (~3:35)</a>
					</span>
				</figcaption>
			</figure>
		</section>

		<!-- PENDIENTE jun 2026: collage día OFF (mismo criterio que #hyperclose-semaphore) + capturas composito modal+panel regrabadas en terminal (tevsys con día OFF, intento operar); mantener vídeo actual y acordeón de escenarios. -->
		<section id="hyperclose-off" class="feature-proof-detail">
			<h3>Automatic rotation and protected OFF day</h3>
			<div class="hyperclose-semaphore-intro hyperclose-off-intro">
				<p class="feature-proof-subtitle">When the day changes, tevsys takes control</p>
				<p class="feature-proof-lead hyperclose-semaphore-intro__line">
					OFF day with limits locked: green padlock and protected panel from the first live tick.
				</p>
				<p class="feature-proof-lead hyperclose-semaphore-intro__line">
					If you still try to trade, the close is immediate and the modal escalates — the same logic as when limits are hit.
				</p>
			</div>
			<div id="hyperclose-off-demo" class="demo-video demo-video--compact hyperclose-off-demo" tabindex="-1">
				<video id="hyperclose-off-demo-video" controls preload="metadata">
					<source src="/videos/features/tevsys-rotacion-automatica-dia-off.mp4" type="video/mp4" />
					Your browser does not support HTML5 video.
				</video>
			</div>
			<details class="proof-accordion">
				<summary class="proof-capture-link">Screenshots of OFF-day scenarios</summary>
				<div class="proof-gallery">
					<p class="proof-gallery__hint">Setup, protected panel and modals when you try to trade. Click each capture to view full size.</p>
					<div class="proof-gallery__grid">
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Setup</p>
							<p class="proof-gallery__title">Protection cannot be activated</p>
							<p class="proof-gallery__desc">Day set as OFF. If you try to lock limits, the system blocks it. To trade that day, first clear the OFF day in Inputs (F7), then set limits and lock. Without that step, there is no active protection.</p>
							<p class="proof-gallery__caption">🔓 Grey padlock (lower-left corner of the chart) = no protection. Configure and lock.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/hyperclose-dias-off-modal-00-config.png" target="_blank" rel="noopener noreferrer" aria-label="Open OFF-day setup modal full size">
								<picture><source type="image/webp" srcset="/images/evidence/hyperclose-dias-off-modal-00-config.webp" /><img class="proof-gallery__image" src="/images/evidence/hyperclose-dias-off-modal-00-config.png" alt="OFF-day modal: protection cannot be activated." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Protected panel</p>
							<p class="proof-gallery__title">OFF day with limits locked</p>
							<p class="proof-gallery__desc">Day set as OFF and limits previously locked. WEEK padlocks show active protection; the button shows «DÍA OFF · Protegido» (OFF day · Protected). Floating today 0.00% because nothing was traded. If you try to open a trade, the system closes immediately and shows the modals.</p>
							<p class="proof-gallery__caption">🔒 Green padlock (lower-left corner of the chart) = active protection.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/hyperclose-dias-off-panel-protegido.png" target="_blank" rel="noopener noreferrer" aria-label="Open protected OFF-day panel full size">
								<picture><source type="image/webp" srcset="/images/evidence/hyperclose-dias-off-panel-protegido.webp" /><img class="proof-gallery__image" src="/images/evidence/hyperclose-dias-off-panel-protegido.png" alt="OFF-day panel: protected with limits locked." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Level 1</p>
							<p class="proof-gallery__title">Educational</p>
							<p class="proof-gallery__desc">First attempt to trade on an OFF day with limits locked. The system closes the trade immediately and shows a reminder: this day is configured as OFF, tevsys protects that decision and closes automatically. Options: wait until tomorrow or reconfigure ON/OFF days over the weekend.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/hyperclose-dias-off-modal-01.png" target="_blank" rel="noopener noreferrer" aria-label="Open OFF-day level 1 modal full size">
								<picture><source type="image/webp" srcset="/images/evidence/hyperclose-dias-off-modal-01.webp" /><img class="proof-gallery__image" src="/images/evidence/hyperclose-dias-off-modal-01.png" alt="OFF-day level 1 modal: educational." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Level 2</p>
							<p class="proof-gallery__title">Warning</p>
							<p class="proof-gallery__desc">Second attempt to trade on an OFF day. Stronger tone: commissions and spreads are on you. The system does not take responsibility for losses from repeated attempts. The close remains immediate on every attempt.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/hyperclose-dias-off-modal-02.png" target="_blank" rel="noopener noreferrer" aria-label="Open OFF-day level 2 modal full size">
								<picture><source type="image/webp" srcset="/images/evidence/hyperclose-dias-off-modal-02.webp" /><img class="proof-gallery__image" src="/images/evidence/hyperclose-dias-off-modal-02.png" alt="OFF-day level 2 modal: warning." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Level 3</p>
							<p class="proof-gallery__title">Final clause</p>
							<p class="proof-gallery__desc">Third attempt on an OFF day. Liability disclaimer: tevsys is not responsible for commissions, spreads or losses from repeated attempts. Last warning of the day. From the fourth attempt onward, only logs record it — no more popups.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/hyperclose-dias-off-modal-03.png" target="_blank" rel="noopener noreferrer" aria-label="Open OFF-day level 3 modal full size">
								<picture><source type="image/webp" srcset="/images/evidence/hyperclose-dias-off-modal-03.webp" /><img class="proof-gallery__image" src="/images/evidence/hyperclose-dias-off-modal-03.png" alt="OFF-day level 3 modal: final clause." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
					</div>
				</div>
			</details>
		</section>

		<section class="feature-cta">
			<h2>Want to validate HyperClose in your own trading?</h2>
			<p>We walk through the full protocol in your context and show you the proofs to check it.</p>
			<a href="/en/company/contact?feature=hyperclose&flow=demo" class="feature-cta__button">Try HyperClose in demo</a>
		</section>
	</Container>
	</div>
</Layout>

<script>
	function playDemoIfTarget() {
		const params = new URLSearchParams(window.location.search);
		const fromHero = params.get('src') === 'hero';
		const hash = window.location.hash;
		if (hash === '#hyperclose-demo') {
			const video = document.getElementById('hyperclose-demo-video');
			if (video && !fromHero) video.play().catch(() => {});
		} else if (hash === '#hyperclose-off-demo') {
			const video = document.getElementById('hyperclose-off-demo-video');
			if (video) video.play().catch(() => {});
		}
	}
	function initDemoExpand() {
		[['hyperclose-demo-video', 'hyperclose-demo-container'], ['hyperclose-off-demo-video', 'hyperclose-off-demo']].forEach(([vidId, ctnId]) => {
			const video = document.getElementById(vidId);
			const container = document.getElementById(ctnId);
			if (video && container) {
				video.addEventListener('play', () => container.classList.add('demo-video--playing'));
				video.addEventListener('ended', () => container.classList.remove('demo-video--playing'));
			}
		});
	}
	document.addEventListener('DOMContentLoaded', () => {
		playDemoIfTarget();
		initDemoExpand();
	});
	window.addEventListener('hashchange', playDemoIfTarget);
</script>

<style>
	.feature-hero,
	.feature-demo,
	.feature-proof,
	.feature-proof-detail,
	.feature-cta {
		margin: var(--section-margin) auto;
	}
	.feature-kicker {
		margin: 0 0 0.35rem;
		opacity: 0.8;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
	}
	.feature-hero h1 {
		max-width: min(44ch, 100%);
	}
	.feature-title__accent {
		color: #f5b041;
		font-weight: 700;
	}
	.feature-hook {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-style: italic;
		font-weight: 600;
		opacity: 0.9;
		margin: 0 0 0.7rem;
	}
	.feature-hook__dot {
		width: 0.45rem;
		height: 0.45rem;
