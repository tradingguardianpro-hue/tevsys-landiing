---
import { Container } from '@components/odyssey-theme';
import Layout from '../../../layouts/Page.astro';
import settings from '../../../config/settings.js';
import EvidenceImageLightbox from '../../../components/core/EvidenceImageLightbox.astro';

const seo = {
	title: 'Verifiable evidence | tevsys',
	description:
		'MT5 certifies execution; tevsys documents the logic. Demo, official report, exportable history and a logs guide so you can check it yourself.',
};
---

<Layout seo={seo} lang="en">
	<div class="tevsys-feature-micro-surface tevsys-feature-micro-surface--evidencia">
	<Container>
		<section class="feature-hero">
			<p class="feature-kicker">Transparency feature</p>
			<h1>Verifiable evidence: no "<span class="feature-title__accent">we believe</span>" here.</h1>
			<p class="feature-hook"><span class="feature-hook__dot" aria-hidden="true"></span>If it cannot be shown, it does not count.</p>
			<p class="feature-lead">
				Real <span class="feature-title__accent">double traceability</span>: tevsys records the internal logic and MT5 certifies the official execution.
			</p>
		</section>

		<section id="evidencia-demo" class="feature-demo feature-demo--hero">
			<h2>Quick demo — 100k account (~1 min 30 s)</h2>
			<p class="feature-demo-hook">
				€100,000 · GER40 · 10 lots · −1 % limit · <strong class="feature-title__accent">€2.28 deviation (0.0023 %)</strong> · London open.
			</p>
			<div class="demo-video demo-video--hero demo-video--hero-elegant" id="evidencia-demo-container">
				<video id="evidencia-demo-video" controls preload="metadata" playsinline
					poster="/videos/features/evidencia-100k-ger40-londres-poster.jpg?v=20260827">
					<source src="/videos/features/evidencia-100k-ger40-londres.mp4?v=20260827" type="video/mp4" />
					Your browser does not support HTML5 video.
				</video>
			</div>
			<p class="feature-demo-attrib">
				Attribution · tevsys −1.0023 % · execution 0.00 p.p. · 34 ms
			</p>
			<p class="demo-edit-note">
				<strong>Edited video:</strong> key close moments; there may be a <strong>clock jump</strong> between cuts.
				MT5 cash close: <strong>−€1,002.28</strong>.
			</p>

			<div id="evidencia-informe-mt5" class="evidencia-demo-informe">
				<h3 class="evidencia-demo-informe__title">Official MT5 report — check the trade yourself</h3>
				<p class="evidencia-demo-informe__subtitle">Generated by MetaTrader 5, not by tevsys · Infinox demo #100129406</p>
				<p class="evidencia-demo-informe__lead">
					Same session as the video · €100,000 · GER40 · 10 lots · −1 % limit · documented loss{' '}
					<strong class="feature-title__accent">−€1,002.28 (−1.01 %)</strong> · five tabs, unedited.
				</p>
				<details class="proof-accordion">
					<summary class="proof-capture-link">View the 5 report tabs</summary>
					<div class="proof-gallery">
						<p class="proof-gallery__hint">Click each capture to open it full size.</p>
						<div class="proof-gallery__grid">
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Summary</p>
								<p class="proof-gallery__title">Overview</p>
								<p class="proof-gallery__desc">Total loss −€1,002.28 · balance €98,997.72 · max drawdown 1.01 %. One trade in the period.</p>
								<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-resumen.png?v=20260828hd" target="_blank" rel="noopener noreferrer" aria-label="Open Summary capture full size">
									<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-resumen.png?v=20260828hd" alt="MT5 100k London report: Summary — loss −€1,002.28, balance €98,997.72." loading="lazy" width="800" height="600" decoding="async" />
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Profit &amp; Loss</p>
								<p class="proof-gallery__title">Loss breakdown</p>
								<p class="proof-gallery__desc">Net loss −€1,002.28. No profits, commissions, swaps or dividends. Peak falls on 27 Aug ~09:00 · manual trade.</p>
								<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-profitloss.png?v=20260828hd" target="_blank" rel="noopener noreferrer" aria-label="Open Profit & Loss capture full size">
									<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-profitloss.png?v=20260828hd" alt="MT5 100k London report: Profit & Loss — loss −€1,002.28." loading="lazy" width="800" height="600" decoding="async" />
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Long &amp; Short</p>
								<p class="proof-gallery__title">Trade distribution</p>
								<p class="proof-gallery__desc">1 trade · 100 % buys (Long) · manual. No robots or signals. Net result −€1,002.28.</p>
								<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-longshort.png?v=20260828hd" target="_blank" rel="noopener noreferrer" aria-label="Open Long & Short capture full size">
									<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-longshort.png?v=20260828hd" alt="MT5 100k London report: Long & Short — 1 manual buy." loading="lazy" width="800" height="600" decoding="async" />
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Symbols</p>
								<p class="proof-gallery__title">Traded instrument</p>
								<p class="proof-gallery__desc">GER40 as the only symbol (CFD). All period loss in that session — London open from the video.</p>
								<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-symbols.png?v=20260828hd" target="_blank" rel="noopener noreferrer" aria-label="Open Symbols capture full size">
									<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-symbols.png?v=20260828hd" alt="MT5 100k London report: Symbols — GER40, −€1,002.28." loading="lazy" width="800" height="600" decoding="async" />
								</a>
							</article>
							<article class="proof-gallery__item">
								<p class="proof-gallery__step">Risks</p>
								<p class="proof-gallery__title">Drawdown and risk</p>
								<p class="proof-gallery__desc">Worst trade −€1,002.28 · drawdown 1.01 %. Balance after close €98,997.72 — single drop on the curve.</p>
								<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-risks.png?v=20260828hd" target="_blank" rel="noopener noreferrer" aria-label="Open Risks capture full size">
									<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-risks.png?v=20260828hd" alt="MT5 100k London report: Risks — drawdown 1.01 %." loading="lazy" width="800" height="600" decoding="async" />
								</a>
							</article>
						</div>
					</div>
				</details>
			</div>
		</section>

		<section class="feature-proof">
			<h2>What you can check</h2>
			<ul>
				<li>
					<a class="evidence-link" href="#evidencia-demo">100k demo + MT5 report for the same trade.</a>
				</li>
				<li>
					<a class="evidence-link" href="#evidence-audit">Two layers: MT5 what happened · tevsys why.</a>
				</li>
				<li>
					<a class="evidence-link" href="#evidencia-contencion-489">Precision when it can, containment under stress: ~111 ms sweep, six positions.</a>
				</li>
				<li>
					<a class="evidence-link" href="#movimiento-de-caja">Capital and risk: if account money changes, the pact is signed again.</a>
				</li>
				<li>
					<a class="evidence-link" href="#evidencia-4-56">Extreme Essential case: 100 lots, documented close deviation (+€95).</a>
				</li>
				<li>
					<a class="evidence-link" href="#evidencia-html-transacciones">Exportable history from MT5 (positions, orders, result).</a>
				</li>
				<li>
					<a class="evidence-link" href="#evidencia-logs">MT5 logs guide — small-account session (context on Precision).</a>
				</li>
			</ul>
		</section>

		<section id="evidence-audit" class="feature-proof-detail evidencia-dos-capas">
			<h3>Two layers that cross-check</h3>
			<p class="feature-proof-subtitle">MT5 certifies · tevsys documents</p>
			<p class="feature-proof-lead">
				We do not write the evidence ourselves. MT5 leaves the official result; tevsys leaves the why. You cross both and decide if it adds up.
			</p>

			<div class="evidence-grid">
				<article class="audit-card evidence-grid__card">
					<h4 class="audit-card__title">MT5 — what happened</h4>
					<p class="audit-card__body">
						Time, price, volume and result. Official report, independent of tevsys.
					</p>
				</article>
				<article class="audit-card evidence-grid__card">
					<h4 class="audit-card__title">tevsys — why</h4>
					<p class="audit-card__body">
						What you set when you locked, when the limit was crossed and why it closed — in auditable logs and on the panel.
					</p>
				</article>
			</div>

			<div class="evidencia-tevsys-resumen">
				<p class="evidencia-tevsys-resumen__name">tevsys</p>
				<p class="evidencia-tevsys-resumen__tagline">
					We do not ask for faith: we show you what happens.
				</p>
				<ul class="evidencia-tevsys-resumen__capas" aria-label="What tevsys does — short">
					<li class="evidencia-tevsys-capas__row">
						<span class="evidencia-tevsys-capas__label">Precision</span>
						<span class="evidencia-tevsys-capas__tip">Close at the agreed limit · {settings.documentedOperatives} ops · ≈ 0.06 %</span>
					</li>
					<li class="evidencia-tevsys-capas__row">
						<span class="evidencia-tevsys-capas__label">HyperClose</span>
						<span class="evidencia-tevsys-capas__tip">Instant close if you try to trade while locked</span>
					</li>
					<li class="evidencia-tevsys-capas__row">
						<span class="evidencia-tevsys-capas__label">SML</span>
						<span class="evidencia-tevsys-capas__tip">More room after a positive day · validation in progress</span>
					</li>
					<li class="evidencia-tevsys-capas__row">
						<span class="evidencia-tevsys-capas__label">Evidence</span>
						<span class="evidencia-tevsys-capas__tip">MT5 report and logs that cross-check · maximum transparency</span>
					</li>
				</ul>
				<p class="evidencia-tevsys-resumen__link">
					<a class="proof-capture-link" href="/en/features/precision#precision-stats">
						Essential · 0.002 p.p. deviation → Precision
						<span class="proof-link-meta">Precision</span>
					</a>
				</p>
			</div>
		</section>

		<section class="feature-proof-detail feature-proof-detail--contencion">
			<div class="evidencia-contencion-head">
				<h3 id="evidencia-contencion-489" class="evidencia-contencion-title">
					Precision when it can — containment when it must — traceability always
				</h3>
				<p class="evidencia-contencion-bridge" aria-label="Context of the documented case">
					<span class="evidencia-contencion-bridge__text">tevsys under extreme stress</span>
				</p>
			</div>
			<p class="feature-proof-lead evidencia-contencion-hook">
				Limit <strong>+0.50 %</strong>. <strong>tevsys</strong> read <strong>+0.65 %</strong> in
				<strong class="feature-title__accent">~111 ms</strong>. The day closed at
				<strong class="feature-title__accent">+1.04 %</strong>. Automatic lock.
			</p>

			<p class="evidencia-contencion-kpi" aria-label="Scale of the documented move">
				<span class="evidencia-contencion-kpi__ms">111 ms</span>
				<span class="evidencia-contencion-kpi__sep" aria-hidden="true">·</span>
				<span>+0.46 p.p. in one tick</span>
				<span class="evidencia-contencion-kpi__sep" aria-hidden="true">·</span>
				<span>6×2.5 lots</span>
				<span class="evidencia-contencion-kpi__sep" aria-hidden="true">·</span>
				<span>GER40 · Jun 2026</span>
			</p>
			<p class="evidencia-contencion-outlier-note">
				Documented extreme case, separate — not included in the ≈ 0.06 % mean error.
			</p>

			<figure class="evidencia-contencion-figure evidencia-contencion-figure--panel">
				<figcaption class="evidencia-contencion-figure__cap">
					Panel after the close — day result <strong>+1.04 %</strong> and lock until rotation.
				</figcaption>
				<a
					class="evidencia-contencion-figure__zoom"
					href="/images/evidence/evidencia-489-panel-stop.png"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Open panel capture full size"
				>
					<img
						class="evidencia-contencion-figure__img"
						src="/images/evidence/evidencia-489-panel-stop.png"
						alt="tevsys panel in STOP: daily profit +1.04 % after automatic multi-position close."
						loading="lazy"
						width="411"
						height="697"
						decoding="async"
					/>
				</a>
			</figure>

			<div class="evidencia-contencion-split" aria-label="Episode sequence">
				<div class="evidencia-contencion-steps">
					<article class="evidencia-contencion-step">
						<p class="evidencia-contencion-step__label">Agreed limit</p>
						<p class="evidencia-contencion-step__value">+0.50 %</p>
						<p class="evidencia-contencion-step__detail">Daily profit you configured before trading.</p>
					</article>
					<article class="evidencia-contencion-step evidencia-contencion-step--accent">
						<p class="evidencia-contencion-step__label">Reading at trigger</p>
						<p class="evidencia-contencion-step__value">+0.65 %</p>
						<p class="evidencia-contencion-step__detail">
							In <strong>~111 ms</strong> the market moved from +0.19 % to +0.65 % (whip toward Asia high).
							On the <strong>next evaluable tick</strong>, tevsys detects the cross and <strong>fires the close</strong>
							of all six positions. That +0.65 % is tevsys’s reading at that instant — <em>not</em> yet the final day result.
						</p>
					</article>
					<article class="evidencia-contencion-step">
						<p class="evidencia-contencion-step__label">Day close</p>
						<p class="evidencia-contencion-step__value evidencia-contencion-highlight">+1.04 %</p>
						<p class="evidencia-contencion-step__detail">
							While price kept running, the six orders fill in the same second.
							The day crystallizes at <strong>+1.04 %</strong> (panel and MT5 report). Lock until rotation.
						</p>
					</article>
				</div>
				<figure class="evidencia-contencion-figure evidencia-contencion-figure--side">
					<figcaption class="evidencia-contencion-figure__cap">
						M2 chart — sweep toward <strong>MAX ASIA</strong> (~111 ms). Annotation to read the sweep.
					</figcaption>
					<a
						class="evidencia-contencion-figure__zoom evidencia-contencion-figure__zoom--chart"
						href="/images/evidence/evidencia-489-sweep-web.png"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Open sweep capture full size"
					>
						<img
							class="evidencia-contencion-figure__img evidencia-contencion-figure__img--chart"
							src="/images/evidence/evidencia-489-sweep-web.png"
							alt="GER40 M2 chart: liquidity sweep wick above MAX ASIA, labeled sweep."
							loading="lazy"
							width="493"
							height="256"
							decoding="async"
						/>
					</a>
				</figure>
			</div>

			<p class="evidencia-contencion-cta">
				<a class="proof-capture-link" href="/en/company/contact?feature=evidence&flow=demo">
					Want the forensic detail? Write to us <span class="proof-link-meta">Contact</span>
				</a>
			</p>
		</section>

		<section id="movimiento-de-caja" class="feature-proof-detail feature-proof-detail--cashflow">
			<div class="evidencia-contencion-head">
				<p class="evidencia-cashflow-eyebrow">Capital and risk</p>
				<h3 id="evidencia-movimiento-caja-title" class="evidencia-contencion-title evidencia-cashflow-title">
					Risk is measured on
					<span class="feature-title__accent">real capital</span>
				</h3>
			</div>
			<p class="feature-proof-lead evidencia-cashflow-body">
				In tevsys we understand that risk{' '}
				<span class="feature-title__accent">depends on account capital</span>. If you withdraw or deposit money,
				the capital has changed — and that <span class="feature-title__accent">is not trading</span>. That is why
				protection resets: a risk pact anchored to a balance that no longer exists makes no sense. You confirm the
				notice and set and lock limits again on the{' '}
				<span class="feature-title__accent">current balance</span>. New capital means you must re-agree the risk.
			</p>
			<p class="evidencia-cashflow-note">
				No smoke: we do not promise returns; we do align the risk reading with your account.
			</p>
			<EvidenceImageLightbox
				src="/images/evidence/evidencia-movimiento-caja-retiro-800-full.png"
				alt="tevsys cash-movement modal — €800 withdrawal: protection reset; new capital means you must re-agree risk."
				caption="Documented withdrawal · €800 · live account"
				figureClass="evidencia-cashflow-figure"
				triggerClass="evidencia-cashflow-figure__zoom"
				imgClass="evidencia-cashflow-figure__img"
				capClass="evidencia-cashflow-figure__cap"
			/>
			<p class="evidencia-contencion-cta">
				<a class="proof-capture-link" href="/en/como-funciona#movimiento-de-caja">
					How it looks in the product flow <span class="proof-link-meta">How it works</span>
				</a>
			</p>
		</section>

		<section id="evidencia-4-56" class="feature-proof-detail">
			<h3>Our Essential build — extreme case: 100 lots</h3>
			<p class="feature-proof-subtitle">Evidence via captures, MT5 report and panel</p>
			<p class="feature-proof-lead">
				~€102k · GER40 · +4 % limit · close +€4,095.10 · <strong class="feature-title__accent">+€95 deviation</strong> · 0.01 % buffer at extreme lot size.
			</p>
			<details class="proof-accordion">
				<summary class="proof-capture-link">View captures (7) <span class="proof-link-meta">CAPTURES</span></summary>
				<div class="proof-gallery">
					<p class="proof-gallery__hint">Click each capture to open it full size.</p>
					<div class="proof-gallery__grid">
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">1. Summary</p>
							<p class="proof-gallery__title">MT5 Summary</p>
							<p class="proof-gallery__desc">Total Net Profit +€6,474.20. Profit Factor 4.04. Max DD 1.32%.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-4.56-01-resumen.png" target="_blank" rel="noopener noreferrer" aria-label="Open Summary capture full size">
								<picture><source type="image/webp" srcset="/images/evidence/evidencia-4.56-01-resumen.webp" /><img class="proof-gallery__image" src="/images/evidence/evidencia-4.56-01-resumen.png" alt="Trade 4.56: MT5 Summary — Total Net Profit +€6,474.20." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">2. Profit & Loss</p>
							<p class="proof-gallery__title">P&L</p>
							<p class="proof-gallery__desc">Gross Profit +8,606.20. Gross Loss −2,132.00. Net +6,474.20.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-4.56-02-pnl.png" target="_blank" rel="noopener noreferrer" aria-label="Open P&L capture full size">
								<picture><source type="image/webp" srcset="/images/evidence/evidencia-4.56-02-pnl.webp" /><img class="proof-gallery__image" src="/images/evidence/evidencia-4.56-02-pnl.png" alt="Trade 4.56: Profit & Loss." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">3. Long & Short</p>
							<p class="proof-gallery__title">Distribution</p>
							<p class="proof-gallery__desc">69 Long, 3 Short. 72 manual trades.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-4.56-03-long-short.png" target="_blank" rel="noopener noreferrer" aria-label="Open Long & Short capture full size">
								<picture><source type="image/webp" srcset="/images/evidence/evidencia-4.56-03-long-short.webp" /><img class="proof-gallery__image" src="/images/evidence/evidencia-4.56-03-long-short.png" alt="Trade 4.56: Long & Short." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">4. Symbols</p>
							<p class="proof-gallery__title">GER40</p>
							<p class="proof-gallery__desc">100% activity on Ger40. Net profit +6,474.20.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-4.56-04-symbols.png" target="_blank" rel="noopener noreferrer" aria-label="Open Symbols capture full size">
								<picture><source type="image/webp" srcset="/images/evidence/evidencia-4.56-04-symbols.webp" /><img class="proof-gallery__image" src="/images/evidence/evidencia-4.56-04-symbols.png" alt="Trade 4.56: Symbols — GER40." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">5. Risks</p>
							<p class="proof-gallery__title">Best trade</p>
							<p class="proof-gallery__desc">Best trade: +€4,095.10. 4% bar in profit distribution.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-4.56-05-riesgos.png" target="_blank" rel="noopener noreferrer" aria-label="Open Risks capture full size">
								<picture><source type="image/webp" srcset="/images/evidence/evidencia-4.56-05-riesgos.webp" /><img class="proof-gallery__image" src="/images/evidence/evidencia-4.56-05-riesgos.png" alt="Trade 4.56: Risks — Best trade €4,095.10." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">6. History</p>
							<p class="proof-gallery__title">100-lot trade</p>
							<p class="proof-gallery__desc">SELL 100 @ 22804.801 → close +€4,095.10. 20/03/2026 11:50:07.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-4.56-06-historial.png" target="_blank" rel="noopener noreferrer" aria-label="Open History capture full size">
								<picture><source type="image/webp" srcset="/images/evidence/evidencia-4.56-06-historial.webp" /><img class="proof-gallery__image" src="/images/evidence/evidencia-4.56-06-historial.png" alt="Trade 4.56: History — 100 lots, +€4,095.10." loading="lazy" width="800" height="600" decoding="async" /></picture>
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">7. TEV·sys panel</p>
