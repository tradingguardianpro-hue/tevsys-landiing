<script>
	function initDemoExpand() {
		[['evidencia-demo-video', 'evidencia-demo-container'], ['evidencia-logs-video', 'evidencia-logs-container']].forEach(([vidId, ctnId]) => {
			const video = document.getElementById(vidId);
			const container = document.getElementById(ctnId);
			if (video && container) {
				video.addEventListener('play', () => container.classList.add('demo-video--playing'));
				video.addEventListener('ended', () => container.classList.remove('demo-video--playing'));
			}
		});
	}
	function scrollContencionAnchor() {
		if (window.location.hash !== '#evidencia-contencion-489') return;
		const title = document.getElementById('evidencia-contencion-489');
		if (!title) return;
		const section = title.closest('.feature-proof-detail--contencion') || title;
		const header = document.getElementById('odysseyNavHeader');
		const headerH = header ? Math.ceil(header.getBoundingClientRect().height) : 64;
		const gap = 8;
		const scrollY = window.scrollY;
		const titleTopAbs = title.getBoundingClientRect().top + scrollY;
		/* Titular bajo la nav. */
		let top = titleTopAbs - headerH - gap;
		/*
		 * Pie anterior (Essential → Precisión): debe quedar POR ENCIMA del viewport,
		 * no “bajo la nav” (eso lo dejaba visible). Antes: prevBottom - headerH → bug.
		 */
		const prev = section.previousElementSibling;
		if (prev) {
			const prevBottomAbs = prev.getBoundingClientRect().bottom + scrollY;
			const clearPrev = prevBottomAbs + 12;
			if (clearPrev > top) top = clearPrev;
		}
		window.scrollTo({ top: Math.max(0, top), behavior: 'auto' });
		section.classList.add('is-hash-arrive');
		window.clearTimeout(scrollContencionAnchor._auraTimer);
		scrollContencionAnchor._auraTimer = window.setTimeout(() => {
			section.classList.remove('is-hash-arrive');
		}, 2200);
	}
	function scheduleContencionScroll() {
		scrollContencionAnchor();
		requestAnimationFrame(() => {
			scrollContencionAnchor();
			requestAnimationFrame(scrollContencionAnchor);
		});
	}
	function openAccordionIfTarget() {
		const hash = window.location.hash;
		if (!hash || hash === '#evidencia-contencion-489') return;
		const section = document.querySelector(hash);
		if (!section) return;
		const details = section.querySelector('details.proof-accordion');
		if (details) details.setAttribute('open', '');
	}
	document.addEventListener('DOMContentLoaded', () => {
		initDemoExpand();
		openAccordionIfTarget();
		scheduleContencionScroll();
	});
	window.addEventListener('load', scheduleContencionScroll);
	window.addEventListener('hashchange', () => {
		openAccordionIfTarget();
		scheduleContencionScroll();
	});
</script>
