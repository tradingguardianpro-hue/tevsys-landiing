---
import Layout from '../../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const seo = {
	title: 'Request received | tevsys',
	description: 'We received your request. We will reply within 24h.',
};
---

<Layout seo={seo} lang="en">
	<Container>
		<section class="contact-thank-you">
			<h1>Thanks for your interest in tevsys</h1>
			<p id="thankYouMain">
				We received your request. We will reply within 24 hours with the steps to access the demo.
			</p>
			<p id="thankYouAccesoNote" class="contact-thank-you__acceso-note" hidden>
				Essential is ready; Advanced and Pro are in development. We will tell you the next step for your profile.
			</p>
			<div id="thankYouDevNote" class="contact-thank-you__dev-block" hidden>
				<p class="contact-thank-you__dev-title">We added you to the waitlist.</p>
				<p class="contact-thank-you__dev-text">Meanwhile, the available demo is Essential.</p>
			</div>
			<p id="thankYouSpamNote" class="contact-thank-you__note">
				Check your inbox (and spam, just in case).
			</p>
			<a href="/en/" class="contact-thank-you__link">Back to home</a>
		</section>
		<script is:inline>
			(() => {
				const params = new URLSearchParams(window.location.search);
				const main = document.getElementById('thankYouMain');
				const accesoNote = document.getElementById('thankYouAccesoNote');
				const spamNote = document.getElementById('thankYouSpamNote');
				const devBlock = document.getElementById('thankYouDevNote');
				const plan = (params.get('plan') || '').toLowerCase();
				const flow = params.get('flow') || '';

				if (flow === 'lista') {
					if (main) main.textContent = 'We added you to the waitlist.';
					if (devBlock) {
						const title = devBlock.querySelector('.contact-thank-you__dev-title');
						const text = devBlock.querySelector('.contact-thank-you__dev-text');
						if (title)
							title.textContent = 'We will email you when Advanced and Pro are available.';
						if (text) text.textContent = 'Meanwhile, the Essential demo is ready to try.';
						devBlock.hidden = false;
					}
				} else if (flow === 'auditoria-ia') {
					if (main) {
						main.textContent =
							'We received your request. We will write shortly with the next step: sending the evidence pack (guide and requirements).';
					}
				} else if (flow === 'pregunta') {
					if (main) {
						main.textContent =
							'We received your question. We reply within 24 hours — no commitment.';
					}
					if (spamNote) {
						spamNote.textContent =
							'Check your inbox (and spam). If you later want the demo, go back to Contact and choose that path.';
					}
				} else if (flow === 'demo') {
					if (main) {
						main.textContent =
							'We received your Essential demo request. Within 24 hours we send the link plus install and setup guides.';
					}
					if (spamNote) {
						spamNote.textContent =
							'Check your inbox and spam folder: the demo and guides arrive there.';
					}
				} else if (plan === 'advanced') {
					if (main) {
						main.textContent =
							'We received your Advanced demo request. Within 24 hours we reply with the link and guides.';
					}
					if (spamNote) {
						spamNote.textContent =
							'Check your inbox and spam folder: the demo and guides arrive there.';
					}
					if (devBlock) devBlock.hidden = true;
				} else if (plan === 'pro') {
					if (main) main.textContent = 'We received your request. We will reply within 24 hours.';
					if (devBlock) {
						const title = devBlock.querySelector('.contact-thank-you__dev-title');
						if (title) title.textContent = 'We added you to the Pro waitlist.';
						devBlock.hidden = false;
					}
				} else if (flow === 'acceso') {
					if (main) main.textContent = 'We received your request. We will reply within 24 hours.';
					if (accesoNote) accesoNote.hidden = false;
				}
			})();
		</script>
	</Container>
</Layout>

<style>
	.contact-thank-you {
		min-height: 50vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 3rem 1rem;
	}
	.contact-thank-you h1 {
		margin-bottom: 1rem;
		font-size: 1.75rem;
	}
	.contact-thank-you p {
		margin-bottom: 0.75rem;
		max-width: 36ch;
	}
	.contact-thank-you__acceso-note {
		font-size: 0.95rem;
		opacity: 0.95;
		font-style: italic;
	}
	.contact-thank-you__dev-block {
		margin: 1.5rem 0;
		padding: 1.25rem 1.5rem;
		max-width: 36ch;
		border: 1px solid rgba(245, 176, 65, 0.4);
		border-radius: 0.5rem;
		background: rgba(245, 176, 65, 0.08);
	}
	.contact-thank-you__dev-title {
		font-weight: 600;
		margin-bottom: 0.35rem;
	}
	.contact-thank-you__dev-text {
		font-style: italic;
		opacity: 0.95;
		margin-bottom: 0;
	}
	.contact-thank-you__note {
		font-size: 0.95rem;
		opacity: 0.9;
	}
	.contact-thank-you__link {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.6rem 1.25rem;
		background: var(--theme-primary, #f5b041);
		color: var(--theme-on-primary, #0a0a0a);
		text-decoration: none;
		border-radius: 0.5rem;
		font-weight: 600;
	}
	.contact-thank-you__link:hover {
		opacity: 0.9;
	}
</style>
