				anchorId: 'videoclip-off',
				videoSrc: '/videos/como-funciona/tevsys-mc-dia-off-30s.mp4?v=20260817b',
				posterSrc: '/videos/como-funciona/tevsys-mc-dia-off-30s-poster.jpg?v=20260817b',
				videoLabel: 'Microclip ~22 s — day OFF and trade attempt (MC-CF-001)',
				ctaLabel: 'Watch clip',
			},
		],
	},
	{
		id: 'rama-operacion',
		title: 'Trade in progress',
		announcement:
			'Open trade and protection still on — weekends too. Midnight does not drop your lock. Clips ~30 s.',
		clips: [],
		groups: [
			{
				id: 'rama-operacion-sin-sml',
				title: 'Without SML active',
				clips: [
					{
						title: 'Did you arrive with an open trade?',
						anchorId: 'videoclip-pasiva',
						videoSrc: '/videos/como-funciona/tevsys-mc-observacion-pasiva-30s.mp4?v=20260819',
						posterSrc: '/videos/como-funciona/tevsys-mc-observacion-pasiva-30s-poster.jpg?v=20260819',
