/** “From zero…”: underline only under the core (asymmetric vs “same story” above). */
const zeroTitleMatch = /^From\s+(.+)$/u.exec(zeroToProtected.title);
const zeroTitlePrefix = zeroTitleMatch ? 'From' : '';
const zeroTitleCore = zeroTitleMatch ? zeroTitleMatch[1] : zeroToProtected.title;

---

<Layout seo={seo} lang="en" bodyClass="page-como-funciona">
	<Container>
		<div class="how-intro-stage how-intro-stage--stage">
			<div class="how-intro-stage__bg" aria-hidden="true"></div>
			<div class="how-intro-stage__inner">
				<section class="how-hero how-hero--tight" aria-labelledby="how-hero-title">
					<h1 id="how-hero-title">How <span class="how-accent">tevsys</span> works</h1>
				</section>

				<section class="how-presentation" aria-labelledby="how-presentation-title">
					<header class="how-section-head">
						<p class="how-eyebrow how-eyebrow--center">Presentation</p>
						<h2 id="how-presentation-title">
							Four minutes of <span class="how-present-title__accent">a live MT5 session</span>
						</h2>
						<p class="how-section-sub">
							We show the product running — live session, precision and evidence.
							<br />
							<span class="how-section-sub__line2">Check it yourself.</span>
							<br />
							<span class="how-section-sub__line2">On-screen EA UI may still appear in Spanish.</span>
						</p>
					</header>
					<div class="how-pair-grid how-pair-grid--single">
						<article class="how-pair-cell" id={presentationLeadVideo.id}>
							<header class="how-block-head how-block-head--compact">
								<p class="how-eyebrow">{presentationLeadVideo.partLabel}</p>
								<h3>{presentationLeadVideo.title}</h3>
								<p class="how-block-lead">{presentationLeadVideo.blurb}</p>
								<div class="how-block-attribution-wrap">
									<span class="how-block-attribution__badge">Attribution</span>
									<p class="how-block-attribution">{presentationLeadVideo.attributionBlurb}</p>
								</div>
								<a
									href={presentationLeadVideo.youtubeWatch}
									class="how-text-link how-text-link--presentation-yt"
									target="_blank"
									rel="noopener noreferrer">
									Open on YouTube →
								</a>
							</header>
							<div class="how-embed how-embed--chrome">
								<video
									id="evidencia-nasdaq-100-video"
									controls
									preload="metadata"
									playsinline
									poster={presentationLeadVideo.posterSrc}
									title={presentationLeadVideo.title}>
									<source src={presentationLeadVideo.videoSrc} type="video/mp4" />
									Your browser does not support HTML5 video.
								</video>
							</div>
							<script is:inline>
								(() => {
									if (new URLSearchParams(window.location.search).get('play') !== '1') return;
									const video = document.getElementById('evidencia-nasdaq-100-video');
									if (!(video instanceof HTMLVideoElement)) return;
									video.removeAttribute('poster');
									video.preload = 'auto';
								})();
							</script>
							<p class="how-doc-session-jump">
								<a href={`#${sessionDocumentation.id}`} class="how-text-link how-doc-session-jump__link">
									What documentation sits behind this video →
								</a>
							</p>
						</article>
					</div>

					<section
						id={sessionDocumentation.id}
						class="how-doc-session"
						aria-labelledby="how-doc-session-title">
						<header class="how-doc-session__head">
							<p class="how-eyebrow how-eyebrow--center">Transparency</p>
							<h3 id="how-doc-session-title" class="how-doc-session__title">
								What sits behind this video —{' '}
								<span class="how-present-title__accent">Nasdaq 100 · 10 lots · −1%</span>
							</h3>
							<p class="how-doc-session__edited">
								Dead time cut; the clock may jump between shots. Same session of 21 Aug 2026 —
								check it in MT5 and against the sources below.
							</p>
						</header>

						<ol class="how-doc-session__steps" aria-label="Session order">
							{
								sessionDocumentation.timelineSteps.map((step) => (
									<li class="how-doc-session__step">
										<span class="how-doc-session__step-time">{step.time}</span>
										<span class="how-doc-session__step-body">
											{step.label}
											{step.detail ? (
												<span class="how-doc-session__step-detail"> · {step.detail}</span>
											) : null}
										</span>
									</li>
								))
							}
						</ol>

						<div class="how-doc-session__attribution" aria-labelledby="how-doc-attribution-title">
							<p class="how-doc-session__attribution-daylead">{sessionDocumentation.attribution.dayLead}</p>
							<p id="how-doc-attribution-title" class="how-doc-session__attribution-kicker">
								{sessionDocumentation.attribution.headline}
							</p>
							<p class="how-doc-session__attribution-stats">
								<span class="how-doc-session__attribution-pill">tevsys {sessionDocumentation.attribution.tevsys}</span>
								<span class="how-doc-session__attribution-pill">execution {sessionDocumentation.attribution.broker}</span>
								<span class="how-doc-session__attribution-pill">{sessionDocumentation.attribution.ms}</span>
							</p>
							<p class="how-doc-session__attribution-foot">{sessionDocumentation.attribution.footnote}</p>
						</div>

						<ul class="how-doc-session__sources">
							{
								sessionDocumentation.sources.map((source) => (
									<li class="how-doc-session__source">
										<p class="how-doc-session__source-title">{source.title}</p>
										<p class="how-doc-session__source-text">{source.text}</p>
									</li>
								))
							}
						</ul>

						<div class="how-doc-session__foot">
							<p class="how-doc-session__note">
								Internal code <span class="how-doc-session__mono">TVS-…</span> per case. This is not a paid audit
								(coming soon): a real demo-account session, documented honestly. Extended pack (report +
								logs) available on request to professionals.
							</p>
							<div class="how-doc-session__actions">
								<a href="/en/company/contact?flow=demo" class="how-side-cta">
									Download demo
								</a>
								<a href="/en/company/contact?flow=auditoria-ia" class="how-side-cta how-side-cta--ghost">
									Request dossier
								</a>
							</div>
						</div>
					</section>
				</section>
			</div>
		</div>

		<p class="how-act-cut" role="presentation">
			<span class="how-act-cut__label">After the evidence</span>
			<span class="how-act-cut__line" aria-hidden="true"></span>
		</p>

		<div class="how-mid-act how-mid-act--stage">
			<div class="how-mid-act__shell" aria-hidden="true"></div>
			<div class="how-mid-act__glow" aria-hidden="true"></div>
			<div class="how-mid-act__inner">
		<section class="how-desde-cero how-desde-cero--stage" id={desdeCeroGuide.id} aria-labelledby="how-desde-cero-title">
			<div class="how-desde-cero__halo" aria-hidden="true"></div>
			<div class="how-desde-cero__inner">
				<header class="how-section-head">
					<p class="how-eyebrow how-eyebrow--center">{desdeCeroGuide.eyebrow}</p>
					<h2 id="how-desde-cero-title">
						From <span class="how-present-title__accent">{desdeCeroGuide.titleAccent}</span>, always
						<span class="how-zero-duration"> ({desdeCeroGuide.durationLabel})</span>
					</h2>
					<p class="how-section-sub">{desdeCeroGuide.blurb}</p>
				</header>
				<article class="how-pair-cell how-desde-cero__cell">
					<div class="how-embed how-embed--chrome">
						<video
							id="desde-cero-video"
							controls
							preload="metadata"
							playsinline
							poster={desdeCeroGuide.posterSrc}
							title={desdeCeroGuide.videoLabel}>
							<source src={desdeCeroGuide.videoSrc} type="video/mp4" />
							Your browser does not support HTML5 video.
						</video>
					</div>
				</article>
			</div>
		</section>

		<section
			class="how-puesta-marcha how-puesta-marcha--stage"
			id={puestaEnMarchaLegend.id}
			aria-labelledby="how-puesta-marcha-title">
			<div class="how-puesta-marcha__halo" aria-hidden="true"></div>
			<div class="how-puesta-marcha__stage-inner">
				<header class="how-section-head">
					<p class="how-eyebrow how-eyebrow--center">{puestaEnMarchaLegend.eyebrow}</p>
					<h2 id="how-puesta-marcha-title" class="how-puesta-marcha__lead">
