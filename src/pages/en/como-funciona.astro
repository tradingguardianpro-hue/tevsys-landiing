const sessionDocumentation = {
	id: 'documentacion-sesion-nasdaq',
	timelineSteps: [
		{ time: '15:36', label: 'Panel and limits' },
		{ time: '16:19:13', label: 'Close at −1%', detail: '−1,001.70 USD' },
		{ time: '16:19–16:20', label: 'Eight HyperClose' },
		{ time: '22:03', label: 'HTML report exported' },
	],
	attribution: {
		headline: 'Close at the limit — tevsys vs execution attribution',
		/** Mail 10 Barmenteros: day/HyperClose explanation BEFORE the pills (no props mention). */
