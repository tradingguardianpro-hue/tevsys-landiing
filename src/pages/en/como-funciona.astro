	html[data-theme='light'] .how-more--stage .how-embed-placeholder--clip-teaser {
		background:
			radial-gradient(ellipse 85% 70% at 50% 38%, rgba(245, 176, 65, 0.14) 0%, transparent 55%),
			linear-gradient(155deg, rgba(252, 250, 246, 0.98) 0%, rgba(236, 238, 244, 0.94) 55%, rgba(228, 231, 238, 1) 100%);
		border-color: rgba(218, 155, 48, 0.28);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 8px 22px rgba(0, 0, 0, 0.06);
