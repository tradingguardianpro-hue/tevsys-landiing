				videoSrc: '/videos/como-funciona/tevsys-mc-limite-hyperclose-30s.mp4?v=20260818',
				posterSrc: '/videos/como-funciona/tevsys-mc-limite-hyperclose-30s-poster.jpg?v=20260818',
				videoLabel: 'Microclip ~34 s — profit limit and HyperClose (MC-CF-025)',
