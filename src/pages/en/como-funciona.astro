<script is:inline>
	(() => {
		const params = new URLSearchParams(window.location.search);
		if (params.get('play') !== '1') return;

		const video = document.getElementById('evidencia-nasdaq-100-video');
		const anchor = document.getElementById('evidencia-nasdaq-100');
		if (!video || !(video instanceof HTMLVideoElement)) return;

		video.removeAttribute('poster');
		video.preload = 'auto';

		const resetHorizontal = () => {
			window.scrollTo(window.scrollX, window.scrollY);
			document.documentElement.scrollLeft = 0;
			document.body.scrollLeft = 0;
		};

		const scrollToEvidence = () => {
			(anchor || video).scrollIntoView({ behavior: 'smooth', block: 'start', inline: 'nearest' });
			resetHorizontal();
			requestAnimationFrame(resetHorizontal);
			setTimeout(resetHorizontal, 320);
		};

		const tryPlay = () => {
			scrollToEvidence();
			const p = video.play();
			if (p && typeof p.catch === 'function') {
				p.catch(() => {
					video.muted = true;
					video.play().catch(() => {});
				});
			}
		};

		if (video.readyState >= 2) tryPlay();
		else video.addEventListener('loadeddata', tryPlay, { once: true });
	})();
</script>

