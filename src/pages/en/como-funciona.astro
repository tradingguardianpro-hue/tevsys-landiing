/** Long walkthrough in one video: leave `embedUrl` empty until YouTube URL (nocookie/embed). Optional `watchHref` for “Open on YouTube”. */
const zeroToProtected = {
	title: 'From zero to protected',
	durationLabel: '~X min',
	blurb: 'Step-by-step install + panel (compact / expanded) + setup until you are protected.',
	embedUrl: '',
	watchHref: '',
};

/** Tras «Esto no es todo…»: mismo puente de cuatro piezas que la home (orden portada). Query distinta en MP4 duplicado para que el navegador pinte bien dos `<video>`. */
const homeBridgeCards: {
	title: string;
	blurb: string;
	href: string;
	cta: string;
	/** Mismo MP4 que en la micro `/features/*`; omitir = card solo texto (p. ej. SML hasta tener corte). */
	featureVideoSrc?: string;
	/** JPG mid-clip (canon posters) — no caja negra en el puente de 4 piezas. */
	posterSrc?: string;
	videoLabel?: string;
	/** Borde placeholder con pulso muy suave (p. ej. SML sin MP4). Respeta prefers-reduced-motion. */
	placeholderPulse?: boolean;
}[] = [
	{
		title: 'Close precision',
		blurb: 'Documented mean error, real sessions and MT5 execution conditions.',
		href: '/en/features/precision',
		cta: 'Go to precision',
		/** Same MP4 as the large hero embed on `/en/features/precision` — quick demo 100k account. */
		/** `?bridge=…` avoids two `<video>` with the same `src` on one page (some browsers fail to paint/play the second). */
		featureVideoSrc: '/videos/features/evidencia-100k-ger40-londres.mp4?v=20260827&bridge=precision',
		posterSrc: '/videos/features/evidencia-100k-ger40-londres-poster.jpg?v=20260827',
