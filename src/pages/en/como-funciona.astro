	/* Placeholders del grid de clips: algo de color sin thumb de YouTube (recordatorio “habrá vídeo”). */
	html[data-theme='dark'] .how-more--stage .how-embed-placeholder--clip-teaser {
		background:
			radial-gradient(ellipse 85% 70% at 50% 38%, rgba(245, 176, 65, 0.11) 0%, transparent 58%),
			linear-gradient(155deg, rgba(58, 62, 74, 0.95) 0%, rgba(28, 30, 38, 0.92) 48%, rgba(14, 15, 20, 0.98) 100%);
		border-color: rgba(245, 176, 65, 0.22);
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
