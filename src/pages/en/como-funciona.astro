	.how-more--stage .how-eyebrow--chapter-kicker {
		color: #f5b041;
		opacity: 1;
		letter-spacing: 0.11em;
	}

	html[data-theme='light'] .how-more--stage .how-eyebrow--chapter-kicker {
		color: #c98a2e;
	}

	/* Gancho tipo frase (no todo en mayúsculas); centrado como FUNCIONALIDADES ÚNICAS / Primero · Auditoría. */
	.how-eyebrow--sentence-kicker {
		display: block;
		width: 100%;
		text-align: center;
		text-transform: none;
		letter-spacing: 0.02em;
		font-weight: 700;
		font-size: clamp(0.84rem, 2.15vw, 0.98rem);
		line-height: 1.35;
		opacity: 0.96;
		max-width: min(28rem, 94vw);
		margin-left: auto;
		margin-right: auto;
	}

	.how-chapter__head--extras {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		width: 100%;
	}

	.how-chapter__head--extras .how-present-title__accent::after {
		margin-left: auto;
		margin-right: auto;
	}

	/* Gancho «¿Creías…?»: mismo ancho útil que el resto del bloque (evita sensación de descentrado). */
	.how-chapter__head--extras .how-eyebrow--sentence-kicker {
		max-width: 100%;
		width: 100%;
	}

	.how-more--stage .how-chapter__head--extras .how-eyebrow--sentence-kicker.how-eyebrow--chapter-kicker {
		letter-spacing: 0.02em;
	}

	/* Índice videoteca: panel elevado (mapa de clips) — subrayados del título H4 se mantienen en `__title-accent`. */
	.how-videoteca-index {
		margin: clamp(0.55rem, 1.8vw, 0.85rem) auto 0;
		max-width: min(48rem, 100%);
		width: 100%;
		padding: clamp(1.05rem, 2.9vw, 1.45rem) clamp(1.05rem, 2.8vw, 1.45rem) clamp(1.1rem, 3vw, 1.5rem);
		border-radius: clamp(0.55rem, 1.15vw, 0.85rem);
		border: 1px solid rgba(245, 176, 65, 0.38);
		background: linear-gradient(
			165deg,
			rgba(48, 50, 60, 0.96) 0%,
			rgba(24, 26, 32, 0.94) 42%,
			rgba(10, 11, 15, 0.98) 100%
		);
		box-sizing: border-box;
		position: relative;
		overflow: hidden;
		text-align: left;
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.5),
			0 16px 48px rgba(0, 0, 0, 0.45),
			0 0 56px rgba(245, 176, 65, 0.08),
			inset 0 1px 0 rgba(245, 176, 65, 0.16);
	}

	.how-videoteca-index::after {
		content: '';
		position: absolute;
		top: 0;
		right: -8%;
		width: 42%;
		height: 100%;
		pointer-events: none;
		background: radial-gradient(
			ellipse at right center,
			rgba(245, 176, 65, 0.1) 0%,
			rgba(140, 150, 170, 0.05) 38%,
			transparent 72%
		);
	}

	html[data-theme='light'] .how-videoteca-index {
		border-color: rgba(218, 155, 48, 0.42);
		background: linear-gradient(165deg, rgba(255, 255, 255, 0.97) 0%, rgba(248, 246, 252, 0.94) 55%, rgba(238, 240, 246, 0.99) 100%);
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.06),
			0 14px 36px rgba(0, 0, 0, 0.1),
			0 0 40px rgba(245, 176, 65, 0.1),
			inset 0 1px 0 rgba(255, 255, 255, 0.95);
	}

	html[data-theme='light'] .how-videoteca-index::after {
		background: radial-gradient(ellipse at right center, rgba(245, 190, 80, 0.12) 0%, rgba(90, 98, 118, 0.04) 45%, transparent 70%);
	}

	.how-videoteca-index__title {
		position: relative;
		z-index: 1;
		margin: 0 0 clamp(0.7rem, 2.1vw, 0.95rem);
		font-size: clamp(1.02rem, 2.25vw, 1.14rem);
		font-weight: 700;
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: rgba(235, 238, 246, 0.98);
		text-align: center;
	}

	html[data-theme='light'] .how-videoteca-index__title {
		color: var(--theme-on-bg, #111);
	}

	/* Barra bajo «ué quieres ver?…» (no bajo «¿Q») — intocable salvo petición explícita del fundador. */
	.how-videoteca-index__title-accent {
		display: inline-block;
		text-align: left;
		position: relative;
		z-index: 1;
	}

	.how-videoteca-index__title-accent::after {
		content: '';
		display: block;
		width: min(22rem, calc(100% - 0.65rem));
		height: 3px;
		margin: 0.36rem 0 0 0.65rem;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			rgba(245, 176, 65, 0.95) 0%,
			rgba(148, 154, 168, 0.62) 72%,
			rgba(110, 116, 128, 0.35) 100%
		);
	}

	html[data-theme='light'] .how-videoteca-index__title-accent::after {
		background: linear-gradient(
			90deg,
			rgba(218, 155, 48, 0.9) 0%,
			rgba(120, 125, 138, 0.5) 75%,
			rgba(90, 95, 108, 0.28) 100%
		);
	}

	.how-videoteca-index__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Cuatro enlaces fijos: 2×2 desde ~520px; una columna en móvil (orden de lectura claro). */
	.how-videoteca-index__list--deck {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr;
		gap: clamp(0.55rem, 1.8vw, 0.75rem);
	}

	@media (min-width: 520px) {
		.how-videoteca-index__list--deck {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(0.65rem, 2vw, 0.9rem);
		}
	}

	.how-videoteca-index__list--more {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.45rem;
		margin: 0.55rem 0 0;
		padding: 0;
	}

	.how-videoteca-index__item {
		margin: 0;
		padding: 0.42rem 0.55rem 0.42rem 0.85rem;
		border-left: 2px solid rgba(140, 150, 170, 0.28);
		border-radius: 0.35rem;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.028), rgba(255, 255, 255, 0));
		transition: border-color 0.2s ease, background-color 0.2s ease;
		box-sizing: border-box;
	}

	.how-videoteca-index__item--deck {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 0.5rem;
		min-height: 100%;
		margin: 0;
		padding: clamp(0.55rem, 1.8vw, 0.72rem) 0.6rem clamp(0.55rem, 1.8vw, 0.72rem) 0.9rem;
	}

	.how-videoteca-index__item::before {
		content: '';
		display: inline-block;
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 50%;
		background: rgba(155, 165, 188, 0.82);
		margin-right: 0.52rem;
		vertical-align: middle;
	}

	/* Punto a la altura de la primera línea del enlace (no encima del texto). */
	.how-videoteca-index__item--deck::before {
		flex-shrink: 0;
		margin-right: 0;
		margin-top: 0.32em;
		vertical-align: unset;
	}

	.how-videoteca-index__item:hover {
		border-left-color: rgba(170, 180, 200, 0.48);
		background: linear-gradient(90deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0));
	}

	html[data-theme='light'] .how-videoteca-index__item {
		border-left-color: rgba(110, 118, 135, 0.35);
		background: linear-gradient(90deg, rgba(0, 0, 0, 0.03), rgba(255, 255, 255, 0));
	}

	html[data-theme='light'] .how-videoteca-index__item:hover {
		border-left-color: rgba(90, 98, 118, 0.45);
		background: linear-gradient(90deg, rgba(0, 0, 0, 0.045), rgba(255, 255, 255, 0));
	}

	html[data-theme='light'] .how-videoteca-index__item::before {
		background: rgba(95, 105, 125, 0.62);
	}

	.how-videoteca-index__link {
		font-size: 0.86rem;
		font-weight: 600;
		line-height: 1.42;
		text-decoration: underline;
		text-decoration-thickness: 0.06em;
		text-underline-offset: 2.5px;
		color: rgba(232, 236, 248, 0.96);
		transition: color 0.15s ease;
		vertical-align: middle;
	}

	.how-videoteca-index__link--deck {
		flex: 1;
		min-width: 0;
		display: block;
		vertical-align: unset;
		line-height: 1.38;
	}

	.how-videoteca-index__link:hover {
		color: rgba(248, 250, 252, 1);
	}

	html[data-theme='light'] .how-videoteca-index__link {
		color: rgba(34, 40, 54, 0.94);
	}

	html[data-theme='light'] .how-videoteca-index__link:hover {
		color: rgba(18, 22, 32, 1);
	}

	.how-videoteca-index__link:focus-visible {
		outline: 2px solid rgba(245, 176, 65, 0.6);
		outline-offset: 3px;
		border-radius: 0.2rem;
	}

	html[data-theme='light'] .how-videoteca-index__link:focus-visible {
		outline-color: rgba(218, 155, 48, 0.75);
	}

	/* Franja inferior fija: siempre se ve la acción «Ver más clips» o el texto prospectivo. */
	.how-videoteca-index__footer {
		position: relative;
		z-index: 1;
		margin-top: clamp(0.85rem, 2.5vw, 1.15rem);
		padding-top: clamp(0.75rem, 2.2vw, 1rem);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	html[data-theme='light'] .how-videoteca-index__footer {
		border-top-color: rgba(0, 0, 0, 0.1);
	}

	.how-videoteca-index__footer-soon {
		text-align: center;
		max-width: 26rem;
		margin: 0 auto;
	}

	.how-videoteca-index__footer-kicker {
		margin: 0 0 0.35rem;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(245, 176, 65, 0.75);
	}

	html[data-theme='light'] .how-videoteca-index__footer-kicker {
		color: rgba(190, 130, 42, 0.88);
	}

	.how-videoteca-index__footer-primary {
		margin: 0 0 0.45rem;
		font-size: clamp(0.95rem, 2.2vw, 1.05rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: rgba(248, 250, 252, 0.98);
	}

	html[data-theme='light'] .how-videoteca-index__footer-primary {
		color: rgba(22, 26, 38, 0.96);
	}

	.how-videoteca-index__footer-sub {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.48;
		opacity: 0.82;
		color: rgba(210, 216, 228, 0.92);
	}

	html[data-theme='light'] .how-videoteca-index__footer-sub {
		color: rgba(58, 62, 74, 0.88);
		opacity: 1;
	}

	.how-videoteca-index__more--panel {
		margin: 0;
		border: 0;
		padding: 0;
	}

	.how-videoteca-index__more-lead {
		margin: 0.5rem 0 0;
		font-size: 0.78rem;
		line-height: 1.45;
		text-align: center;
		opacity: 0.78;
		color: rgba(200, 206, 220, 0.9);
	}

	html[data-theme='light'] .how-videoteca-index__more-lead {
		color: rgba(72, 78, 92, 0.88);
	}

	.how-videoteca-index__summary {
		cursor: pointer;
		list-style: none;
	}

	.how-videoteca-index__summary::-webkit-details-marker {
		display: none;
	}

	.how-videoteca-index__summary::marker {
		content: '';
	}

	.how-videoteca-index__summary--cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 100%;
		max-width: 20rem;
		margin: 0 auto;
		padding: 0.62rem 1rem;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-align: center;
		color: rgba(18, 20, 26, 0.95);
		text-decoration: none;
		border-radius: 0.45rem;
		border: 1px solid rgba(245, 176, 65, 0.45);
		background: linear-gradient(180deg, rgba(245, 196, 128, 0.95) 0%, rgba(218, 155, 48, 0.88) 100%);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.35) inset, 0 6px 18px rgba(0, 0, 0, 0.22);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease,
			filter 0.15s ease;
	}

	.how-videoteca-index__summary--cta::after {
		content: '▾';
		font-size: 0.65em;
		opacity: 0.85;
		margin-left: 0.15rem;
	}

	.how-videoteca-index__more--panel[open] .how-videoteca-index__summary--cta::after {
		content: '▴';
	}

	.how-videoteca-index__summary--cta:hover {
		filter: brightness(1.05);
		transform: translateY(-1px);
	}

	.how-videoteca-index__summary--cta:focus-visible {
		outline: 2px solid rgba(245, 176, 65, 0.75);
		outline-offset: 3px;
	}

	html[data-theme='light'] .how-videoteca-index__summary--cta {
		color: rgba(18, 20, 26, 0.95);
		border-color: rgba(200, 140, 45, 0.55);
		background: linear-gradient(180deg, rgba(252, 220, 160, 0.98) 0%, rgba(235, 175, 65, 0.92) 100%);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.65) inset, 0 4px 14px rgba(0, 0, 0, 0.08);
	}

	@media (prefers-reduced-motion: reduce) {
		.how-videoteca-index__summary--cta:hover {
			transform: none;
		}
	}

	/* Salto por ancla: no pegar el título bajo el header fijo. */
	.how-more-cell[id^='videoclip-'] {
		scroll-margin-top: clamp(4rem, 12vh, 6rem);
	}

	/*
	 * Retroiluminación al llegar por ancla desde el índice (lista + «Ver más clips»).
	 * Misma idea que `#precision-demo:target` en `features/precision.astro`.
	 */
	html[data-theme='dark'] .how-more-grid--practical .how-more-cell--practical-clip[id^='videoclip-']:not(.how-more-cell--audit-clip):target {
		border-color: rgba(245, 176, 65, 0.55) !important;
		box-shadow:
			0 0 0 2px rgba(245, 176, 65, 0.38),
			0 0 42px rgba(245, 176, 65, 0.16),
			inset 0 1px 0 rgba(255, 255, 255, 0.06);
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	html[data-theme='light'] .how-more-grid--practical .how-more-cell--practical-clip[id^='videoclip-']:not(.how-more-cell--audit-clip):target {
		border-color: rgba(218, 155, 48, 0.52) !important;
		box-shadow:
			0 0 0 2px rgba(218, 155, 48, 0.32),
			0 0 36px rgba(245, 176, 65, 0.12),
			0 8px 22px rgba(0, 0, 0, 0.06),
			inset 0 1px 0 rgba(255, 255, 255, 0.92);
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	html[data-theme='dark'] .how-more-grid--practical .how-more-cell--practical-clip.how-more-cell--audit-clip[id^='videoclip-']:target {
		border-color: rgba(100, 196, 255, 0.52) !important;
		box-shadow:
			0 0 0 2px rgba(100, 196, 255, 0.36),
			0 0 48px rgba(100, 196, 255, 0.18),
			inset 0 1px 0 rgba(255, 255, 255, 0.06);
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	html[data-theme='light'] .how-more-grid--practical .how-more-cell--practical-clip.how-more-cell--audit-clip[id^='videoclip-']:target {
		border-color: rgba(70, 155, 205, 0.52) !important;
		box-shadow:
			0 0 0 2px rgba(100, 196, 255, 0.3),
			0 0 36px rgba(100, 196, 255, 0.14),
			0 8px 22px rgba(0, 0, 0, 0.06),
			inset 0 1px 0 rgba(255, 255, 255, 0.92);
		transition:
			border-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.how-audit-chapter__frame {
		max-width: min(46rem, 100%);
		margin: 0 auto clamp(1.15rem, 3.25vw, 1.85rem);
	}

	html[data-theme='dark'] .how-audit-chapter .how-embed-placeholder--zero-teaser {
		border-color: rgba(100, 196, 255, 0.34);
		box-shadow:
			inset 0 0 0 1px rgba(100, 196, 255, 0.08),
			inset 0 1px 0 rgba(255, 255, 255, 0.06),
			0 0 0 1px rgba(0, 0, 0, 0.28),
			0 14px 38px rgba(0, 0, 0, 0.36),
			0 0 44px rgba(100, 196, 255, 0.09);
	}

	html[data-theme='light'] .how-audit-chapter .how-embed-placeholder--zero-teaser {
		border-color: rgba(100, 196, 255, 0.36);
		box-shadow:
			inset 0 0 0 1px rgba(100, 196, 255, 0.07),
			inset 0 1px 0 rgba(255, 255, 255, 0.92),
			0 10px 28px rgba(0, 0, 0, 0.07),
			0 0 36px rgba(100, 196, 255, 0.1);
	}

	/* Tres comportamientos extra: misma familia visual que el puente 2×2 (ámbar / tarjetas). */
	.how-chapter--extras {
		margin: clamp(0.85rem, 2.8vw, 1.35rem) auto clamp(1rem, 3.2vw, 1.55rem);
		max-width: min(56rem, 100%);
		padding-top: clamp(0.15rem, 1vw, 0.45rem);
	}

	.how-chapter--extras-index-only {
		margin-top: clamp(0.55rem, 2vw, 1rem);
	}

	/* Tres ramas microclips (16 ago 2026) */
	.how-microclip-ramas {
		max-width: min(56rem, 100%);
		margin: clamp(0.75rem, 2.4vw, 1.35rem) auto clamp(1.25rem, 3.5vw, 2rem);
