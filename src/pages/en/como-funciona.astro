	/* "Siguiente nivel": misma familia negra que Capital/Puesta (30 ago). */
	.how-more.how-more--stage {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		box-sizing: border-box;
		width: 100%;
		max-width: min(56rem, 100%);
		margin: 0 auto clamp(2.25rem, 8vh, 4.5rem);
		padding: 0;
		border-radius: clamp(1.75rem, 7vw, 3.25rem);
		background: transparent;
		box-shadow: none;
	}

	.how-more__shell {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		border-radius: inherit;
	}

	html[data-theme='dark'] .how-more__shell {
		background: linear-gradient(180deg, hsl(222 20% 2.2%) 0%, hsl(222 22% 1.5%) 100%);
		box-shadow: inset 0 0 clamp(2.5rem, 9vw, 5.5rem) rgba(0, 0, 0, 0.55);
	}

	html[data-theme='light'] .how-more__shell {
		background: linear-gradient(180deg, #f0eee9 0%, #e8e5df 100%);
		box-shadow: inset 0 0 clamp(2.5rem, 9vw, 5rem) rgba(0, 0, 0, 0.07);
	}

	.how-more__glow {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		border-radius: inherit;
	}

	/* Halo cabecera — misma familia Capital / Puesta / Desde cero (luz arriba, lados apagados). */
	html[data-theme='dark'] .how-more__glow {
		background:
			radial-gradient(ellipse 62% 26% at 50% 8%, rgba(88, 98, 118, 0.2) 0%, transparent 52%),
			radial-gradient(ellipse 72% 38% at 50% 20%, rgba(42, 48, 62, 0.26) 0%, transparent 58%),
			radial-gradient(ellipse 88% 36% at 50% 72%, rgba(28, 32, 42, 0.08) 0%, transparent 55%);
	}

	html[data-theme='light'] .how-more__glow {
		background:
			radial-gradient(ellipse 60% 26% at 50% 10%, rgba(0, 0, 0, 0.03) 0%, transparent 50%),
			radial-gradient(ellipse 70% 34% at 50% 22%, rgba(0, 0, 0, 0.02) 0%, transparent 55%);
	}

	.how-more__inner {
		position: relative;
		z-index: 1;
		overflow: visible;
		padding: clamp(1.1rem, 3.5vw, 1.85rem) clamp(0.75rem, 2.5vw, 1.15rem) clamp(1.65rem, 4.5vw, 2.45rem);
	}

	.how-more__bg,
	.how-more__sweep {
		display: none;
	}

	/* Contraste en oscuro: títulos y cuerpo menos “gris sumido”; tarjetas un peldaño más claras que el fondo del stage. */
	html[data-theme='dark'] .how-more--stage .how-eyebrow {
		opacity: 0.88;
		color: rgba(244, 246, 248, 0.92);
	}

	html[data-theme='dark'] .how-more--stage .how-section-head h2 {
		color: rgba(255, 255, 255, 0.98);
	}

	/* Subrayado: empieza bajo «no» y cubre hasta el final de «…en vivo» (ancla = desde «no es todo:»). */
	.how-more--stage .how-more__head h2 .how-more-main-title__underline-anchor {
		display: inline-block;
		text-align: left;
	}

	.how-more--stage .how-more__head h2 .how-more-main-title__underline-anchor::after {
		content: '';
		display: block;
		width: 100%;
		height: 3px;
		margin: 0.42rem 0 0;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			rgba(245, 176, 65, 0.95) 0%,
			rgba(148, 154, 168, 0.62) 72%,
			rgba(110, 116, 128, 0.35) 100%
		);
	}

	html[data-theme='light'] .how-more--stage .how-more__head h2 .how-more-main-title__underline-anchor::after {
		background: linear-gradient(
			90deg,
			rgba(218, 155, 48, 0.9) 0%,
			rgba(120, 125, 138, 0.5) 75%,
			rgba(90, 95, 108, 0.28) 100%
		);
