			'Quick demo — 100k GER40 London account (~1 min 30 s). Same hero video as the Precision micro page.',
	},
	{
		title: 'HyperClose',
		blurb: 'Lock under pressure: trade attempt after a hit limit, with live logging.',
		href: '/en/features/hyperclose',
		cta: 'Go to HyperClose',
		featureVideoSrc: '/videos/features/hyperclose-demo.mp4',
		posterSrc: '/videos/features/hyperclose-demo-poster.jpg?v=20260816',
		videoLabel: 'HyperClose demo — same file as on the HyperClose micro page.',
	},
	{
		title: 'SML — Smart Money Lock',
		blurb: 'Optional risk/reward layer with status visible on the panel.',
		href: '/en/features/sml',
		cta: 'Go to SML',
		placeholderPulse: true,
	},
	{
		title: 'Verifiable evidence',
		blurb: 'Reports, HTML and traces you can check against the terminal.',
		href: '/en/features/evidencia',
		cta: 'Go to evidence',
		featureVideoSrc: '/videos/features/evidencia-100k-ger40-londres.mp4?v=20260827&bridge=evidencia',
		posterSrc: '/videos/features/evidencia-100k-ger40-londres-poster.jpg?v=20260827',
		videoLabel: 'Quick demo — 100k GER40 London account (~1 min 30 s). Same file as on the Evidence micro page.',
	},
];

/** Microclips — tres ramas (canon 16 ago 2026 · CATALOGO § Tres ramas). */
type MicroClipCard = {
	title: string;
	anchorId: string;
	videoSrc?: string;
	/** Frame JPG — evita caja gris del `<video preload="none">` antes de play. */
	posterSrc?: string;
	/** Still / captura de escenario (sin MP4) — no fingir vídeo. */
	stillSrc?: string;
	stillAlt?: string;
	stillCaption?: string;
	videoLabel?: string;
	ctaLabel?: string;
};

type MicroclipGroup = {
	id: string;
	/** Etiqueta corta y clara (p. ej. Sin SML activo / SML activo). */
	title: string;
	clips: MicroClipCard[];
};

type MicroclipBranch = {
	id: string;
	title: string;
	/** Anuncio de rama; vacío si el título del clip ya lo dice (evita eco). */
	announcement?: string;
	/** Clips planos (ramas 1–2). Si hay `groups`, se ignora en favor de los grupos. */
	clips: MicroClipCard[];
	/** Subbloques con etiqueta (rama Operación en curso: Sin SML / SML activo). */
	groups?: MicroclipGroup[];
};

/** Visible legend: install + one-minute limits (high click intent). MP4 home = /configuracion. */
const puestaEnMarchaLegend = {
	id: 'puesta-en-marcha',
	eyebrow: 'Getting started',
	leadBefore: 'Install and set your ',
	leadAccent: 'limits',
	links: [
		{
			href: '/en/configuracion#configurar-limites',
			label: 'How to set your limits in one minute',
			primary: true,
		},
		{ href: '/en/instalacion', label: 'Install (web / license)', primary: false },
		{ href: '/en/instalacion-market', label: 'Install from Market', primary: false },
	],
};

/**
 * Emoción / identidad UI — tras las 4 piezas, antes del corte de auditoría.
 * Misma cáscara que Puesta en marcha. Publicado 21 ago (~32 s).
 */
/**
 * Panel mimetizado — tras 4 piezas, antes auditoría.
 * Clip 1 (publicado): fondo negro. Clip 2 (publicado 30 ago): chart + panel tema claro,
 * estilo web como Precisión Nasdaq (`how-siente-embed--light` / poster soft) — NO entra en rejilla microclips.
 */
const comoSeSienteLegend = {
	id: 'como-se-siente',
	eyebrow: 'Panel',
	leadBefore: 'Blend the panel ',
	leadAccent: 'to your taste',
	blurb: 'Tune border and colours — or keep it discreet, floating on the chart. When you lock protection, three flashes still fire even if it is blended in.',
	ctaLabel: 'See the blended panel',
	durationLabel: '~32 s',
	videoSrc: '/videos/como-funciona/tevsys-mc-panel-mimetizado-30s.mp4?v=20260821',
	posterSrc: '/videos/como-funciona/tevsys-mc-panel-mimetizado-30s-poster.jpg?v=20260821',
	videoLabel: 'Microclip ~32 s — blended panel and three flashes on lock',
	/** Second clip under the first — light theme (published 30 Aug). */
	lightClip: {
		id: 'panel-mimetizado-claro',
		eyebrow: 'Also on a light theme',
		blurb: 'Same panel on a light chart — if you trade on white, it still reads clean.',
		ctaLabel: 'See on a light background',
		durationLabel: '~36 s',
		videoSrc: '/videos/como-funciona/tevsys-mc-panel-mimetizado-claro-30s.mp4?v=20260830',
		posterSrc: '/videos/como-funciona/tevsys-mc-panel-mimetizado-claro-30s-poster.jpg?v=20260830',
		videoLabel: 'Blended panel on light theme (~36 s)',
	},
};

const microclipBranches: MicroclipBranch[] = [
	{
		id: 'rama-preparar',
		title: 'Prepare protection',
		announcement: 'Rules ready. Lock not on yet. Clips ~30 s.',
		clips: [
			{
				title: 'Weekend: leave protection ready for Monday',
				anchorId: 'videoclip-programado-lunes',
				videoSrc: '/videos/como-funciona/tevsys-mc-programado-lunes-30s-II.mp4?v=20260820',
				posterSrc: '/videos/como-funciona/tevsys-mc-programado-lunes-30s-II-poster.jpg?v=20260820',
				videoLabel: 'Microclip ~30 s — GUARDAR → PROGRAMADO · LUNES (MC-CF-021)',
				ctaLabel: 'Watch clip',
			},
			{
				title: 'Wrong limit? — tevsys tells you',
				anchorId: 'videoclip-corrige-errores',
				videoSrc: '/videos/como-funciona/tevsys-mc-corrige-errores-30s.mp4?v=20260821',
				posterSrc: '/videos/como-funciona/tevsys-mc-corrige-errores-30s-poster.jpg?v=20260821',
				videoLabel: 'Microclip ~30 s — CORRIGE ERRORES (MC-CF-020)',
				ctaLabel: 'Watch clip',
			},
		],
	},
	{
		id: 'rama-protegido',
		title: 'You are protected',
		announcement: 'Limits active. What happens if you trade or tweak. Clips ~30 s.',
		clips: [
			{
				title: 'What if you keep trying after hitting your limit?',
