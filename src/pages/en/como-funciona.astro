		color: #fff;
	}

	html[data-theme='dark'] .how-more-lead__note {
		color: rgba(230, 233, 240, 0.88);
		opacity: 1;
	}

	html[data-theme='dark'] .how-more--stage .how-more-cell--video {
		background: rgba(54, 58, 70, 0.94);
		border-color: rgba(255, 255, 255, 0.12);
		box-shadow:
			0 10px 28px rgba(0, 0, 0, 0.22),
			inset 0 1px 0 rgba(255, 255, 255, 0.05);
