			animation-timing-function: ease-in-out;
		}
		22% {
			background-position: 50% 38%;
			animation-timing-function: ease-in-out;
		}
		48% {
			background-position: 50% 72%;
			animation-timing-function: ease-in-out;
		}
		70% {
			background-position: 50% 22%;
			animation-timing-function: ease-in-out;
		}
		88% {
			background-position: 50% 88%;
			animation-timing-function: ease-in-out;
