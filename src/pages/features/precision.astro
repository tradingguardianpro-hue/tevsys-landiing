		height: auto;
		border-radius: var(--theme-shape-radius);
	}
	.proof-gallery__hint {
		margin: 0 0 0.75rem;
		font-size: 0.88rem;
		opacity: 0.82;
	}
	.proof-gallery__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.proof-gallery__item {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.6rem;
		padding: 0.7rem;
	}
	.proof-gallery__step {
		margin: 0 0 0.2rem;
		font-size: 0.78rem;
		opacity: 0.8;
	}
	.proof-gallery__title {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.35;
	}
	.proof-gallery__placeholder {
		min-height: 96px;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 0.45rem;
		border: 1px dashed rgba(245, 176, 65, 0.45);
		background: rgba(245, 176, 65, 0.07);
		color: rgba(245, 176, 65, 0.95);
		font-size: 0.82rem;
