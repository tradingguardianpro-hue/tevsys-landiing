	}
	.proof-accordion {
		margin: 0.45rem 0 0;
	}
	.proof-accordion summary {
		list-style: none;
	}
	.proof-accordion summary::-webkit-details-marker {
		display: none;
	}
	.proof-gallery {
		margin: 0.75rem 0 0;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1rem 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.proof-gallery h3 {
		margin: 0 0 0.7rem;
