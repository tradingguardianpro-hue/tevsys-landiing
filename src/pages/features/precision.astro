		margin: 0 0 0.9rem;
		line-height: 1.5;
	}
	.feature-cta__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 0.95rem;
		border-radius: 1.4rem;
		background: #f5b041;
		color: #1a1510;
		font-weight: 600;
		text-decoration: none;
	}
	.feature-cta__button:hover {
		background: #f7c050;
	}
</style>
