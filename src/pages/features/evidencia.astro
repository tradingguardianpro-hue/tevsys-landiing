---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
	title: 'Evidencia verificable | tevsys',
	description: 'Comprueba cómo tevsys deja trazabilidad de cierres, bloqueos y rotaciones con panel, logs y reporte oficial.',
};
---

<Layout seo={seo}>
	<Container>
		<section class="feature-hero">
			<p class="feature-kicker">Feature de transparencia</p>
			<h1>Evidencia verificable: aquí no hay "creemos".</h1>
			<p class="feature-hook"><span class="feature-hook__dot" aria-hidden="true"></span>Lo que no se puede demostrar, no cuenta.</p>
			<p class="feature-lead">Cada cierre y cada bloqueo queda registrado en panel, logs y reporte oficial MT5.</p>
		</section>

		<section id="evidencia-demo" class="feature-demo">
			<h2>Demo rápida — Cuenta 100k (1 min 41 s)</h2>
			<p class="feature-demo-hook">100.000€ · 20 lotes · Apertura Wall Street · Error: 0,0072%</p>
			<div class="demo-video demo-video--compact" id="evidencia-demo-container">
				<video id="evidencia-demo-video" controls preload="metadata">
					<source src="/videos/features/evidencia-100k-perdida.mp4" type="video/mp4" />
					Tu navegador no soporta reproducción de video HTML5.
				</video>
			</div>
			<p class="demo-edit-note">Vídeo editado para mostrar los momentos clave. Operativa completa verificable en informe MT5.</p>
			<details id="evidencia-informe-mt5" class="proof-accordion">
				<summary class="proof-capture-link">Informe oficial MT5 — comprueba esta operativa tú mismo</summary>
				<div class="proof-gallery">
					<p class="proof-gallery__hint">Informe completo generado por MetaTrader 5. Todas las pestañas, sin editar. Cuenta 100.000€, 2 compras de 10 lotes GER40, cierre por límite -1%. Haz clic en cada captura para verla en tamaño completo.</p>
					<div class="proof-gallery__grid">
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Summary</p>
							<p class="proof-gallery__title">Resumen general</p>
							<p class="proof-gallery__desc">Pérdida total: -1.007,20€. Balance final: 98.992,80€. Drawdown máximo: 1,01%.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-resumen.png" target="_blank" rel="noopener noreferrer" aria-label="Abrir captura Summary en tamaño completo">
								<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-resumen.png" alt="Informe MT5 100k: Summary — pérdida -1.007,20€, balance 98.992,80€." loading="lazy" />
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Profit & Loss</p>
							<p class="proof-gallery__title">Desglose de pérdidas</p>
							<p class="proof-gallery__desc">Loss: -1.007,20€. Sin comisiones, sin swaps, sin dividendos. Resultado neto: -1,01%.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-profitloss.png" target="_blank" rel="noopener noreferrer" aria-label="Abrir captura Profit & Loss en tamaño completo">
								<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-profitloss.png" alt="Informe MT5 100k: Profit & Loss — desglose de pérdida -1.007,20€." loading="lazy" />
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Long & Short</p>
							<p class="proof-gallery__title">Distribución de operaciones</p>
							<p class="proof-gallery__desc">100% Long Trades. 2 operaciones manuales. Sin robots ni señales.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-longshort.png" target="_blank" rel="noopener noreferrer" aria-label="Abrir captura Long & Short en tamaño completo">
								<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-longshort.png" alt="Informe MT5 100k: Long & Short — 2 compras manuales." loading="lazy" />
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Symbols</p>
							<p class="proof-gallery__title">Activo operado</p>
							<p class="proof-gallery__desc">GER40 como único activo. 2 operaciones concentradas en el mismo momento.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-symbols.png" target="_blank" rel="noopener noreferrer" aria-label="Abrir captura Symbols en tamaño completo">
								<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-symbols.png" alt="Informe MT5 100k: Symbols — GER40, -1.007,20€." loading="lazy" />
							</a>
						</article>
						<article class="proof-gallery__item">
							<p class="proof-gallery__step">Risks</p>
							<p class="proof-gallery__title">Drawdown y riesgo</p>
							<p class="proof-gallery__desc">Worst trade: -530,50€. Max. consecutive loss: -1.007,20€. Corte limpio visible en el gráfico.</p>
							<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-informe-risks.png" target="_blank" rel="noopener noreferrer" aria-label="Abrir captura Risks en tamaño completo">
								<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-informe-risks.png" alt="Informe MT5 100k: Risks — drawdown y worst trade." loading="lazy" />
							</a>
						</article>
					</div>
				</div>
			</details>
			<details id="evidencia-html-transacciones" class="proof-accordion">
				<summary class="proof-capture-link">Historial de transacciones — detalle por operación</summary>
				<div class="proof-gallery">
					<p class="proof-gallery__hint">Informe HTML exportado directamente desde MetaTrader 5. Posiciones, órdenes, transacciones, balance y resultados. Datos clave marcados en amarillo.</p>
					<a class="proof-gallery__zoom" href="/images/evidence/evidencia-100k-html-transacciones.png" target="_blank" rel="noopener noreferrer" aria-label="Abrir historial de transacciones en tamaño completo">
						<img class="proof-gallery__image" src="/images/evidence/evidencia-100k-html-transacciones.png" alt="Historial de transacciones MT5 100k: posiciones, órdenes, balance 98.992,80€, reducción 1,01%." loading="lazy" />
					</a>
					<p style="margin-top: 1rem;">
						<a class="proof-capture-link" href="/docs/evidencia-100k-historial-transacciones.html" target="_blank" rel="noopener noreferrer">
							Abrir informe HTML original <span class="proof-link-meta">HTML</span>
						</a>
					</p>
				</div>
			</details>
			<p style="margin-top: 0.75rem;">
				<a class="proof-capture-link" href="/features/precision#precision-logs-guide">
					¿Quieres ver los logs de esta operativa? Guía visual de logs en MT5 <span class="proof-link-meta">VIDEO</span>
				</a>
			</p>
		</section>

		<section id="evidence-audit" class="feature-proof-detail">
			<h3>Auditoría: la prueba no es nuestra</h3>
			<p class="feature-hook"><span class="feature-hook__dot" aria-hidden="true"></span>MetaTrader documenta. tevsys ejecuta.</p>
			<p><span class="audit-label">Para quién</span> Para ti, que quieres verte con datos y no con sensaciones. Y para gestoras, prop firms o cualquiera que gestione capital ajeno y necesite demostrar que el límite se cumplió.</p>
			<p><span class="audit-label">Dos capas de evidencia</span> MT5 documenta qué ocurrió: hora, precio, volumen, resultado. Informe oficial, independiente de tevsys. Los logs propios de tevsys documentan por qué: el cálculo, el límite, la decisión de cierre. Dos fuentes. Una verificación.</p>
			<p><span class="audit-label">Todo lo de arriba es la prueba</span> El vídeo, el informe MT5 y las transacciones que acabas de ver son un ejemplo real. Tenemos 50 más, documentadas con el mismo nivel de detalle.</p>
			<p>
				<a class="proof-capture-link" href="/features/precision#precision-49-evidence">
					Ver las 50 operativas documentadas (Precisión)
				</a>
			</p>
		</section>

		<section class="feature-cta">
			<h2>¿Quieres verlo en tu caso?</h2>
			<p>Te enseñamos la trazabilidad aplicada a tu operativa para que decidas con evidencia, no con promesas.</p>
			<a href="/company/contact?feature=evidence&flow=demo" class="feature-cta__button">Probar evidencia en demo</a>
		</section>
	</Container>
</Layout>

<style>
	.feature-hero,
	.feature-demo,
	.feature-proof,
	.feature-cta {
		margin: var(--section-margin) auto;
	}
	.feature-kicker {
		margin: 0 0 0.35rem;
		opacity: 0.8;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
	}
	.feature-hero h1 {
		margin: 0 0 0.65rem;
		font-size: clamp(1.8rem, 4.2vw, 2.7rem);
	}
	.feature-hook {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-style: italic;
		font-weight: 600;
		opacity: 0.9;
		margin: 0 0 0.7rem;
	}
	.feature-hook__dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #f5b041;
		flex-shrink: 0;
	}
	.feature-lead {
		max-width: 70ch;
		line-height: 1.55;
	}
	.feature-trace-note {
		max-width: 72ch;
		line-height: 1.5;
		opacity: 0.86;
		margin: 0.35rem 0 0;
	}
	#evidencia-demo {
		scroll-margin-top: 5.5rem;
	}
	.feature-demo-hook {
		margin: 0 0 0.75rem;
		font-style: italic;
		opacity: 0.9;
	}
	.feature-demo h2,
	.feature-proof h2,
	.feature-cta h2 {
		margin: 0 0 0.65rem;
		font-size: 1.35rem;
	}
	.demo-placeholder {
		background: var(--theme-surface-1);
		border: 1px solid rgba(245, 176, 65, 0.28);
		border-radius: var(--theme-shape-radius);
		padding: 1rem 1.1rem;
	}
	.demo-video {
		background: #06080d;
		border: 1px solid rgba(245, 176, 65, 0.3);
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		margin-bottom: 0.75rem;
	}
	.demo-video--compact {
		max-width: 420px;
		margin-left: auto;
		margin-right: auto;
		transition: max-width 0.35s ease;
	}
	.demo-video--compact.demo-video--playing {
		max-width: none;
	}
	.demo-video video {
		display: block;
		width: 100%;
		height: auto;
	}
	.demo-placeholder p {
		margin: 0 0 0.45rem;
		line-height: 1.5;
	}
	.demo-placeholder p:last-child {
		margin-bottom: 0;
	}
	.demo-note {
		opacity: 0.8;
		font-size: 0.95rem;
	}
	.demo-edit-note {
		margin: 0.5rem 0 0;
		font-size: 0.9rem;
		opacity: 0.82;
	}
	.feature-proof ul {
		margin: 0;
		padding-left: 1.1rem;
	}
	.feature-proof li {
		margin-bottom: 0.45rem;
		line-height: 1.5;
	}
	.evidence-link {
		color: #ffffff;
		text-decoration: underline;
		text-underline-offset: 2px;
		transition: color 0.2s ease;
		cursor: pointer;
	}
	.evidence-link:hover {
		color: #f5b041;
	}
	.evidence-link:focus-visible {
		outline: 2px solid #f5b041;
		outline-offset: 3px;
		border-radius: 0.2rem;
	}
	.feature-proof-detail {
		margin: 1rem 0 0;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1rem 1.1rem;
		scroll-margin-top: 5.5rem;
		transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
		border: 1px solid transparent;
	}
	.feature-proof-detail h3 {
		margin: 0 0 0.45rem;
		font-size: 1.05rem;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}
	.feature-proof-detail h3::before {
		content: '';
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: #f5b041;
		flex-shrink: 0;
	}
	.feature-proof-detail p {
		margin: 0.45rem 0 0;
		line-height: 1.5;
	}
	.feature-proof-detail p:first-of-type {
		margin-top: 0;
	}
	.audit-label {
		display: block;
		color: #f5b041;
		font-weight: 700;
		font-size: 0.88rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.2rem;
	}
	.feature-proof-detail:target {
		border-color: rgba(245, 176, 65, 0.55);
		background: rgba(245, 176, 65, 0.08);
		box-shadow: 0 0 0 1px rgba(245, 176, 65, 0.25);
	}
	.proof-capture-link {
		color: #f5b041;
		text-decoration: underline;
		text-underline-offset: 2px;
		transition: color 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.proof-capture-link:hover {
		color: #f7c050;
	}
	.proof-capture-link:focus-visible {
		outline: 2px solid #f5b041;
		outline-offset: 3px;
		border-radius: 0.2rem;
	}
	.proof-link-meta {
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		padding: 0.08rem 0.38rem;
		border-radius: 999px;
		border: 1px solid rgba(245, 176, 65, 0.55);
		background: rgba(245, 176, 65, 0.12);
		color: #f7c050;
		line-height: 1.2;
	}
	.proof-accordion {
		margin: 0.45rem 0 0;
	}
	.proof-accordion summary {
		list-style: none;
	}
	.proof-accordion summary::-webkit-details-marker {
		display: none;
	}
	.proof-gallery {
		margin: 0.75rem 0 0;
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1rem 1.1rem;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.proof-gallery__hint {
		margin: 0 0 0.75rem;
		font-size: 0.88rem;
		opacity: 0.82;
	}
	.proof-gallery__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
	}
	.proof-gallery__item {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.6rem;
		padding: 0.7rem;
	}
	.proof-gallery__step {
		margin: 0 0 0.2rem;
		font-size: 0.78rem;
		opacity: 0.8;
	}
	.proof-gallery__title {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.35;
	}
	.proof-gallery__desc {
		margin: 0 0 0.5rem;
		font-size: 0.82rem;
		line-height: 1.4;
		opacity: 0.9;
	}
	.proof-gallery__image {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.45rem;
		border: 1px solid rgba(255, 255, 255, 0.1);
		background: #0a0d13;
	}
	.proof-gallery__zoom {
		display: block;
		border-radius: 0.45rem;
		overflow: hidden;
		cursor: zoom-in;
	}
	.proof-gallery__zoom:focus-visible {
		outline: 2px solid #f5b041;
		outline-offset: 2px;
	}
	@media (max-width: 768px) {
		.proof-gallery__grid {
			grid-template-columns: 1fr;
		}
	}
	.feature-cta {
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1.2rem;
	}
	.feature-cta p {
		margin: 0 0 0.9rem;
		line-height: 1.5;
	}
	.feature-cta__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem 0.95rem;
		border-radius: 1.4rem;
		background: #f5b041;
		color: #1a1510;
		font-weight: 600;
		text-decoration: none;
	}
	.feature-cta__button:hover {
		background: #f7c050;
	}
</style>

<script>
	function initDemoExpand() {
		const video = document.getElementById('evidencia-demo-video');
		const container = document.getElementById('evidencia-demo-container');
		if (!video || !container) return;
		video.addEventListener('play', () => container.classList.add('demo-video--playing'));
		video.addEventListener('ended', () => container.classList.remove('demo-video--playing'));
	}
	document.addEventListener('DOMContentLoaded', () => {
		initDemoExpand();
	});
</script>
