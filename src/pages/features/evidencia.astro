<script>
	function playDemoIfTarget() {
		if (window.location.hash !== '#evidencia-demo') return;
		const video = document.getElementById('evidencia-demo-video');
		if (video) {
			video.play().catch(() => {});
		}
	}
	function initDemoExpand() {
		[['evidencia-demo-video', 'evidencia-demo-container'], ['evidencia-logs-video', 'evidencia-logs-container']].forEach(([vidId, ctnId]) => {
			const video = document.getElementById(vidId);
			const container = document.getElementById(ctnId);
			if (video && container) {
				video.addEventListener('play', () => container.classList.add('demo-video--playing'));
				video.addEventListener('ended', () => container.classList.remove('demo-video--playing'));
			}
		});
	}
	function openInformeMt5IfTarget() {
		if (window.location.hash !== '#evidencia-informe-mt5') return;
		const section = document.getElementById('evidencia-informe-mt5');
		const details = section && section.querySelector('details.proof-accordion');
		if (details) details.setAttribute('open', '');
	}
	document.addEventListener('DOMContentLoaded', () => {
		playDemoIfTarget();
		initDemoExpand();
		openInformeMt5IfTarget();
	});
	window.addEventListener('hashchange', () => {
		playDemoIfTarget();
		openInformeMt5IfTarget();
	});
</script>
