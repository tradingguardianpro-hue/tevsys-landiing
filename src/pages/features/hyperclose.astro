		align-items: center;
		gap: 0.45rem;
	}
	.feature-proof-detail h3::before {
		content: '';
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: #f5b041;
		flex-shrink: 0;
	}
	.feature-proof-detail p {
		margin: 0;
		line-height: 1.5;
	}
	.feature-proof-subtitle {
		margin: -0.1rem 0 0.5rem !important;
		font-size: 0.94rem;
		font-style: italic;
		font-weight: 600;
		opacity: 0.9;
	}
	.feature-proof-detail:target {
		border-color: rgba(245, 176, 65, 0.55);
		background: rgba(245, 176, 65, 0.08);
		box-shadow: 0 0 0 1px rgba(245, 176, 65, 0.25);
	}
