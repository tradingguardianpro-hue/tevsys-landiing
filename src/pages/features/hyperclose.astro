		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 0.6rem;
		padding: 0.7rem;
	}
	.proof-gallery__step {
		margin: 0 0 0.2rem;
		font-size: 0.78rem;
		opacity: 0.8;
	}
	.proof-gallery__title {
		margin: 0 0 0.25rem;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.35;
	}
	.proof-gallery__desc {
		margin: 0 0 0.5rem;
		font-size: 0.82rem;
		opacity: 0.88;
		line-height: 1.4;
	}
	.proof-gallery__image {
		display: block;
		width: 100%;
