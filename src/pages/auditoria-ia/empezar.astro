---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
	title: 'Antes del pack: tres pasos | Auditoría tevsys',
	description:
		'ID tevsys (TVS-…) y tres piezas del pack: logs, captura, informe MT5. Comprobación local en tu navegador.',
};
---

<Layout seo={seo}>
	<div class="audit-page-motion-off" aria-hidden="true"></div>
	<Container>
		<div class="tevsys-home-band tevsys-home-band--cards audit-step-band">
			<section class="audit-step-hero audit-step-hero--lite">
				<p class="audit-step-kicker">Auditoría con IA</p>
				<h1 class="audit-step-hero-title">Tres pasos</h1>
				<div class="audit-step-hero-title-accent" aria-hidden="true"></div>
				<p class="audit-step-lead audit-step-lead--one">Tu ID arriba. Tres piezas del pack abajo. Comprobación local.</p>
			</section>

			<div class="audit-step-preface" role="region" aria-labelledby="audit-step-preface-title">
				<p id="audit-step-preface-title" class="audit-step-preface__title">Eres cliente de tevsys</p>
				<p class="audit-step-preface__body">
					<span class="audit-step-preface__dots" aria-hidden="true">···</span>
					<span class="audit-step-preface__body-text">
						<strong>Necesitamos tu ID</strong> (<strong>TVS-…</strong>): en el <strong>panel expandido</strong> (botón
						<strong>ID</strong>) y en el <strong>correo</strong> que te enviamos con la <strong>licencia</strong>.
					</span>
				</p>
				<p class="audit-step-preface__body">
					<span class="audit-step-preface__dots" aria-hidden="true">···</span>
					<span class="audit-step-preface__body-text">
						<strong>Cópialo y consérvalo.</strong> Cuando abramos el envío: <strong>elegibilidad</strong> y seguimiento.
					</span>
				</p>
				<p class="audit-step-preface__body">
					<span class="audit-step-preface__dots" aria-hidden="true">···</span>
					<span class="audit-step-preface__body-text">
						¿Aún no eres cliente?
						<a class="audit-step-preface__link" href="/company/contact?flow=demo">Demo y contacto</a>
					</span>
				</p>
			</div>

			<ol class="audit-step-cards audit-step-cards--lite audit-step-cards--solo" aria-label="Tres pasos antes del pack">
				<li class="audit-step-card">
					<span class="audit-step-num" aria-hidden="true">1</span>
					<p class="audit-step-line">
						<strong>Logs de tevsys — qué te pediremos:</strong> una carpeta o archivos claros del
						<strong>mismo periodo</strong>, sin mezclar otra sesión.
						<span class="audit-step-preface__muted">Vídeo (próximamente): cómo localizarlos antes de arrastrar.</span>
					</p>
				</li>
				<li class="audit-step-card">
					<span class="audit-step-num" aria-hidden="true">2</span>
					<p class="audit-step-line">
						<strong>Captura del panel</strong> en el gráfico: tevsys legible, periodo visible y misma ventana temporal
						que el informe MT5 (PC y panel visibles, como en la guía del pack).
					</p>
				</li>
				<li class="audit-step-card">
					<span class="audit-step-num" aria-hidden="true">3</span>
					<p class="audit-step-line">
						<strong>Informe HTML MT5</strong> del mismo periodo. <strong>Fechas, cuenta auditada y foco</strong> del
						caso los completas en la pantalla siguiente (validación local en tu navegador).
					</p>
				</li>
			</ol>

			<p class="audit-step-note" role="status">
				Siguiente pantalla: comprobación <strong>solo en tu navegador</strong> (sin subida a servidores tevsys). Con el
				servicio activo: <strong>canal de envío</strong> y reglas de <strong>elegibilidad</strong> con tu ID.
			</p>

			<div class="audit-step-ctas">
				<a class="audit-step-cta audit-step-cta--primary" href="/auditoria-ia/pack">Comprobar en tu equipo</a>
				<a class="audit-step-cta audit-step-cta--secondary" href="/auditoria-ia">Volver a Auditoría IA</a>
			</div>
		</div>
	</Container>
</Layout>

<style>
	.audit-step-band {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		padding-bottom: clamp(2rem, 5vw, 3.5rem);
	}
	.audit-step-hero--lite {
		margin-bottom: clamp(0.65rem, 1.6vw, 0.95rem) !important;
	}
	.audit-step-preface {
		max-width: 52rem;
		margin: 0 auto clamp(1.15rem, 2.8vw, 1.65rem);
		padding: clamp(1rem, 2.2vw, 1.25rem) clamp(0.95rem, 2.2vw, 1.15rem);
		border-radius: 0.85rem;
		border: 1px solid rgba(100, 196, 255, 0.22);
		border-left: 3px solid rgba(100, 196, 255, 0.55);
		background: linear-gradient(
			105deg,
			rgba(100, 196, 255, 0.065) 0%,
			rgba(6, 8, 13, 0.48) 45%,
			rgba(6, 8, 13, 0.32) 100%
		);
		box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset;
	}
	.audit-step-preface__title {
		margin: 0 0 clamp(0.65rem, 1.6vw, 0.85rem);
		font-size: clamp(0.78rem, 1.45vw, 0.88rem);
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		line-height: 1.3;
		color: rgba(172, 224, 255, 0.96);
	}
	.audit-step-preface__body {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		margin: 0 0 clamp(0.85rem, 2.2vw, 1.15rem);
		font-size: 0.88rem;
		font-weight: 600;
		line-height: 1.52;
		color: rgba(236, 244, 255, 0.94);
		opacity: 0.96;
	}
	.audit-step-preface__dots {
		flex: 0 0 auto;
		margin-top: 0.1em;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		line-height: 1.5;
		color: rgba(100, 196, 255, 0.95);
	}
	.audit-step-preface__body-text {
		flex: 1 1 auto;
		min-width: 0;
	}
	.audit-step-preface__body:last-of-type {
		margin-bottom: 0;
	}
	.audit-step-preface__body strong {
		color: rgba(248, 252, 255, 0.98);
		font-weight: 800;
	}
	.audit-step-preface__link {
		color: rgba(153, 218, 255, 0.98);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}
	.audit-step-preface__link:hover {
		color: rgba(190, 232, 255, 1);
	}
	.audit-step-preface__muted {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.82rem;
		font-weight: 600;
		opacity: 0.72;
		line-height: 1.4;
	}
	.audit-step-cards--lite .audit-step-card {
		padding: 0.72rem 0.85rem;
		gap: 0.65rem 0.85rem;
		align-items: center;
	}
	.audit-step-cards--solo .audit-step-line {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.38;
		color: rgba(236, 244, 255, 0.98);
	}
	.audit-step-cards--solo .audit-step-line strong {
		color: rgba(244, 250, 255, 0.99);
		font-weight: 800;
	}
	.audit-step-lead--one {
		font-size: 0.9rem;
		font-weight: 600;
		opacity: 0.88;
	}
	.audit-step-hero {
		max-width: 48rem;
		margin: var(--section-margin) auto clamp(1.25rem, 3vw, 1.75rem);
		padding: clamp(1rem, 2.2vw, 1.35rem) clamp(1rem, 2.4vw, 1.5rem);
		border-radius: 1rem;
		border: 1px solid rgba(100, 196, 255, 0.28);
		background:
			linear-gradient(180deg, rgba(6, 8, 13, 0.52) 0%, rgba(6, 8, 13, 0.38) 100%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.006) 100%);
		box-shadow: 0 0 0 1px rgba(100, 196, 255, 0.08) inset;
	}
	.audit-step-kicker {
		margin: 0 0 0.45rem;
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: rgba(153, 218, 255, 0.96);
	}
	/* Misma familia que hero / «Tu dictamen…» en auditoria-ia: título más presente + barra bicolor */
	.audit-step-hero-title {
		margin: 0 0 0.42rem;
		font-size: clamp(1.45rem, 2.8vw, 2rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.22;
		color: rgba(236, 244, 255, 0.99);
	}
	.audit-step-hero-title-accent {
		height: 3px;
		width: min(11rem, 52%);
		margin: 0 0 0.72rem;
		border-radius: 999px;
		background: linear-gradient(90deg, rgba(245, 176, 65, 0.95) 0%, rgba(100, 196, 255, 0.75) 100%);
	}
	.audit-step-lead {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.55;
		opacity: 0.94;
		max-width: 42rem;
	}
	.audit-step-cards {
		list-style: none;
		margin: 0 auto clamp(1.25rem, 3vw, 2rem);
		padding: 0;
		max-width: 52rem;
		display: grid;
		gap: 0.75rem;
	}
	.audit-step-card {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem 1rem;
		align-items: start;
		padding: 1rem 1.1rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(100, 196, 255, 0.24);
		background: linear-gradient(180deg, rgba(100, 196, 255, 0.07) 0%, rgba(100, 196, 255, 0.02) 100%);
	}
	.audit-step-num {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		font-size: 0.85rem;
		font-weight: 800;
		color: rgba(255, 247, 234, 0.96);
		background: rgba(100, 196, 255, 0.55);
		flex-shrink: 0;
	}
	.audit-step-note {
		max-width: 48rem;
		margin: 0 auto 1rem;
		padding: 0.55rem 0.75rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(176, 186, 204, 0.28);
		background: rgba(255, 255, 255, 0.03);
		font-size: 0.82rem;
		line-height: 1.42;
		opacity: 0.82;
	}
	.audit-step-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		justify-content: center;
		max-width: 52rem;
		margin: 0 auto;
	}
	.audit-step-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.55rem 1.05rem;
		border-radius: 0.65rem;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.audit-step-cta--primary {
		border: 1px solid rgba(100, 196, 255, 0.52);
		color: rgba(232, 247, 255, 0.98);
		background: rgba(100, 196, 255, 0.14);
	}
	.audit-step-cta--primary:hover {
		background: rgba(100, 196, 255, 0.22);
		border-color: rgba(100, 196, 255, 0.72);
	}
	.audit-step-cta--secondary {
		border: 1px solid rgba(100, 196, 255, 0.32);
		color: rgba(221, 243, 255, 0.94);
		background: rgba(100, 196, 255, 0.06);
	}
	.audit-step-cta--secondary:hover {
		background: rgba(100, 196, 255, 0.12);
		border-color: rgba(100, 196, 255, 0.55);
	}
	@media (max-width: 520px) {
		.audit-step-card {
			grid-template-columns: 1fr;
		}
		.audit-step-num {
			width: 1.75rem;
			height: 1.75rem;
			font-size: 0.8rem;
		}
	}
</style>
