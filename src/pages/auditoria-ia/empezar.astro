---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
	title: 'Antes del pack: checklist | Auditoría tevsys',
	description:
		'Cuatro piezas del pack mínimo de auditoría tevsys. Después, comprobación local de archivos en tu navegador.',
};
---

<Layout seo={seo}>
	<div class="audit-page-motion-off" aria-hidden="true"></div>
	<Container>
		<div class="tevsys-home-band tevsys-home-band--cards audit-step-band">
			<section class="audit-step-hero audit-step-hero--lite">
				<p class="audit-step-kicker">Auditoría con IA</p>
				<h1>Cuatro cosas</h1>
				<p class="audit-step-lead audit-step-lead--one">Esto es lo mínimo.</p>
			</section>

			<ol class="audit-step-cards audit-step-cards--lite audit-step-cards--solo" aria-label="Pack mínimo">
				<li class="audit-step-card">
					<span class="audit-step-num" aria-hidden="true">1</span>
					<p class="audit-step-line">Logs tevsys del periodo.</p>
				</li>
				<li class="audit-step-card">
					<span class="audit-step-num" aria-hidden="true">2</span>
					<p class="audit-step-line">Captura del panel en el gráfico.</p>
				</li>
				<li class="audit-step-card">
					<span class="audit-step-num" aria-hidden="true">3</span>
					<p class="audit-step-line">Informe HTML MT5 del mismo periodo.</p>
				</li>
				<li class="audit-step-card">
					<span class="audit-step-num" aria-hidden="true">4</span>
					<p class="audit-step-line">Fechas, cuenta auditada y foco — en la pantalla siguiente.</p>
				</li>
			</ol>

			<p class="audit-step-note" role="status">
				Con el servicio: <strong>canal de envío</strong>, <strong>ID</strong> y elegibilidad.
			</p>

			<div class="audit-step-ctas">
				<a class="audit-step-cta audit-step-cta--primary" href="/auditoria-ia/pack">Comprobar en tu equipo</a>
				<a class="audit-step-cta audit-step-cta--secondary" href="/auditoria-ia">Volver a Auditoría IA</a>
			</div>
		</div>
	</Container>
</Layout>

<style>
	.audit-step-band {
		position: relative;
		isolation: isolate;
		overflow-x: clip;
		padding-bottom: clamp(2rem, 5vw, 3.5rem);
	}
	.audit-step-hero--lite {
		margin-bottom: clamp(0.85rem, 2vw, 1.15rem) !important;
	}
	.audit-step-cards--lite .audit-step-card {
		padding: 0.72rem 0.85rem;
		gap: 0.65rem 0.85rem;
		align-items: center;
	}
	.audit-step-cards--solo .audit-step-line {
		margin: 0;
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.38;
		color: rgba(236, 244, 255, 0.98);
	}
	.audit-step-lead--one {
		font-size: 0.9rem;
		font-weight: 600;
		opacity: 0.88;
	}
	.audit-step-hero {
		max-width: 48rem;
		margin: var(--section-margin) auto clamp(1.25rem, 3vw, 1.75rem);
		padding: clamp(1rem, 2.2vw, 1.35rem) clamp(1rem, 2.4vw, 1.5rem);
		border-radius: 1rem;
		border: 1px solid rgba(100, 196, 255, 0.28);
		background:
			linear-gradient(180deg, rgba(6, 8, 13, 0.52) 0%, rgba(6, 8, 13, 0.38) 100%),
			linear-gradient(180deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.006) 100%);
		box-shadow: 0 0 0 1px rgba(100, 196, 255, 0.08) inset;
	}
	.audit-step-kicker {
		margin: 0 0 0.45rem;
		font-size: 0.76rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: rgba(153, 218, 255, 0.96);
	}
	.audit-step-hero h1 {
		margin: 0 0 0.55rem;
		font-size: clamp(1.35rem, 2.6vw, 1.85rem);
		letter-spacing: -0.02em;
		line-height: 1.22;
	}
	.audit-step-lead {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.55;
		opacity: 0.94;
		max-width: 42rem;
	}
	.audit-step-cards {
		list-style: none;
		margin: 0 auto clamp(1.25rem, 3vw, 2rem);
		padding: 0;
		max-width: 52rem;
		display: grid;
		gap: 0.75rem;
	}
	.audit-step-card {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem 1rem;
		align-items: start;
		padding: 1rem 1.1rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(100, 196, 255, 0.24);
		background: linear-gradient(180deg, rgba(100, 196, 255, 0.07) 0%, rgba(100, 196, 255, 0.02) 100%);
	}
	.audit-step-num {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		font-size: 0.85rem;
		font-weight: 800;
		color: rgba(255, 247, 234, 0.96);
		background: rgba(100, 196, 255, 0.55);
		flex-shrink: 0;
	}
	.audit-step-note {
		max-width: 48rem;
		margin: 0 auto 1rem;
		padding: 0.55rem 0.75rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(176, 186, 204, 0.28);
		background: rgba(255, 255, 255, 0.03);
		font-size: 0.82rem;
		line-height: 1.42;
		opacity: 0.82;
	}
	.audit-step-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		justify-content: center;
		max-width: 52rem;
		margin: 0 auto;
	}
	.audit-step-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.55rem 1.05rem;
		border-radius: 0.65rem;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}
	.audit-step-cta--primary {
		border: 1px solid rgba(100, 196, 255, 0.52);
		color: rgba(232, 247, 255, 0.98);
		background: rgba(100, 196, 255, 0.14);
	}
	.audit-step-cta--primary:hover {
		background: rgba(100, 196, 255, 0.22);
		border-color: rgba(100, 196, 255, 0.72);
	}
	.audit-step-cta--secondary {
		border: 1px solid rgba(100, 196, 255, 0.32);
		color: rgba(221, 243, 255, 0.94);
		background: rgba(100, 196, 255, 0.06);
	}
	.audit-step-cta--secondary:hover {
		background: rgba(100, 196, 255, 0.12);
		border-color: rgba(100, 196, 255, 0.55);
	}
	@media (max-width: 520px) {
		.audit-step-card {
			grid-template-columns: 1fr;
		}
		.audit-step-num {
			width: 1.75rem;
			height: 1.75rem;
			font-size: 0.8rem;
		}
	}
</style>
