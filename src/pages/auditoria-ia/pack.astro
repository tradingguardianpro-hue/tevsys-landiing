---
import { Container } from '@components/odyssey-theme';
import Layout from '../../layouts/Page.astro';

const seo = {
	title: 'Preparar pack de auditoría | tevsys',
	description:
		'Prepara tu pack de auditoría en un solo paso: logs, captura de panel e informe MT5. Flujo guiado para traders, academias y equipos.',
};
---

<Layout seo={seo}>
	<Container>
		<section class="pack-hero">
			<p class="pack-kicker">Auditoría con IA · Pack de evidencia</p>
			<h1>Arrastra aquí tus archivos y valida tu pack</h1>
			<p class="pack-subtitle">Te guiamos para que envíes todo completo: logs, captura del panel e informe MT5 del mismo periodo.</p>
		</section>

		<section class="pack-dropzone-wrap">
			<div id="pack-dropzone" class="pack-dropzone" role="button" tabindex="0" aria-label="Zona para arrastrar archivos">
				<p class="pack-dropzone-title">Arrastra tus archivos aquí</p>
				<p class="pack-dropzone-sub">o haz clic para seleccionarlos desde tu equipo</p>
				<input id="pack-file-input" type="file" multiple accept=".log,.txt,.png,.jpg,.jpeg,.html,.htm,.zip" />
			</div>
			<div class="pack-format-chips" aria-label="Formatos permitidos">
				<span class="pack-chip">LOG / TXT</span>
				<span class="pack-chip">PNG / JPG</span>
				<span class="pack-chip">HTML / HTM</span>
				<span class="pack-chip">ZIP</span>
			</div>
			<p class="pack-trust">Tus archivos solo se usarán para esta auditoría.</p>
		</section>

		<section class="pack-check">
			<h2>Checklist mínimo</h2>
			<ul>
				<li id="req-logs" class="pack-req is-pending">Logs del periodo auditado.</li>
				<li id="req-panel" class="pack-req is-pending">Captura del panel con fecha/hora visible.</li>
				<li id="req-report" class="pack-req is-pending">Informe HTML MT5 del mismo periodo.</li>
				<li id="req-context" class="pack-req is-manual">Periodo + cuenta auditada + objetivo de revisión.</li>
			</ul>
			<div class="pack-manual">
				<h3>Datos de contraste (formulario mínimo)</h3>
				<div class="pack-manual-grid">
					<label class="pack-field">
						<span>Periodo desde</span>
						<input id="audit-from" type="datetime-local" />
					</label>
					<label class="pack-field">
						<span>Periodo hasta</span>
						<input id="audit-to" type="datetime-local" />
					</label>
					<label class="pack-field">
						<span>Cuenta auditada (login o ID visible)</span>
						<input id="audit-account" type="text" placeholder="Ej. 541239763" />
					</label>
					<label class="pack-field">
						<span>Objetivo principal de auditoría</span>
						<select id="audit-focus">
							<option value="">Selecciona objetivo</option>
							<option value="precision">Precisión de cierre</option>
							<option value="disciplina">Disciplina y cumplimiento</option>
							<option value="bloqueos">Bloqueos / HyperClose</option>
							<option value="sml">Comportamiento SML</option>
						</select>
					</label>
				</div>
			</div>
			<p id="pack-status" class="pack-status">Aún no hay archivos cargados.</p>
			<div class="pack-files">
				<h3>Archivos detectados</h3>
				<ul id="pack-file-list">
					<li class="pack-file-empty">No hay archivos todavía.</li>
				</ul>
			</div>
			<div class="pack-cta-row">
				<a id="pack-contact-cta" class="pack-cta pack-cta--primary is-disabled" href="/company/contact?flow=auditoria-ia&step=pack" aria-disabled="true">Continuar por contacto</a>
				<a class="pack-cta pack-cta--secondary" href="/auditoria-ia">Volver a auditoría IA</a>
			</div>
		</section>
	</Container>
</Layout>

<script>
	const dropzone = document.getElementById('pack-dropzone');
	const fileInput = document.getElementById('pack-file-input');
	const fileList = document.getElementById('pack-file-list');
	const status = document.getElementById('pack-status');
	const contactCta = document.getElementById('pack-contact-cta');
	const auditFrom = document.getElementById('audit-from');
	const auditTo = document.getElementById('audit-to');
	const auditAccount = document.getElementById('audit-account');
	const auditFocus = document.getElementById('audit-focus');

	if (dropzone && fileInput && fileList && status && contactCta && auditFrom && auditTo && auditAccount && auditFocus) {
		const allFiles = new Map();

		const hasLogs = (name) => /\.(log|txt|zip)$/i.test(name);
		const hasPanel = (name) => /\.(png|jpe?g)$/i.test(name);
		const hasReport = (name) => /\.html?$/i.test(name);

		const setReqState = (id, ok) => {
			const el = document.getElementById(id);
			if (!el) return;
			el.classList.toggle('is-ok', ok);
			el.classList.toggle('is-pending', !ok);
		};

		const setReqManual = (id, ok) => {
			const el = document.getElementById(id);
			if (!el) return;
			el.classList.remove('is-ok', 'is-pending', 'is-manual-ok');
			el.classList.add(ok ? 'is-manual-ok' : 'is-manual');
		};

		const hasManualContext = () => {
			const from = String(auditFrom.value || '').trim();
			const to = String(auditTo.value || '').trim();
			const account = String(auditAccount.value || '').trim();
			const focus = String(auditFocus.value || '').trim();
			return Boolean(from && to && account && focus);
		};

		const updateUi = () => {
			const names = [...allFiles.keys()];
			const logOk = names.some((name) => hasLogs(name));
			const panelOk = names.some((name) => hasPanel(name));
			const reportOk = names.some((name) => hasReport(name));

			setReqState('req-logs', logOk);
			setReqState('req-panel', panelOk);
			setReqState('req-report', reportOk);
			const manualOk = hasManualContext();
			setReqManual('req-context', manualOk);

			fileList.innerHTML = '';
			if (!names.length) {
				const li = document.createElement('li');
				li.className = 'pack-file-empty';
				li.textContent = 'No hay archivos todavía.';
				fileList.appendChild(li);
				status.textContent = 'Aún no hay archivos cargados.';
				contactCta.classList.add('is-disabled');
				contactCta.setAttribute('aria-disabled', 'true');
				return;
			}

			names.forEach((name) => {
				const li = document.createElement('li');
				li.textContent = name;
				fileList.appendChild(li);
			});

			const complete = logOk && panelOk && reportOk;
			const manualOk = hasManualContext();
			const ready = complete && manualOk;
			status.textContent = complete
				? (manualOk
					? 'Pack completo y contextualizado. Ya puedes continuar por contacto.'
					: 'Pack técnico completo. Falta completar el formulario mínimo de contraste.')
				: 'Pack parcial. Falta al menos una pieza obligatoria del checklist.';

			contactCta.classList.toggle('is-disabled', !ready);
			contactCta.setAttribute('aria-disabled', String(!ready));
		};

		const ingestFiles = (files) => {
			[...files].forEach((file) => allFiles.set(file.name, file));
			updateUi();
		};

		const openPicker = () => fileInput.click();

		dropzone.addEventListener('click', openPicker);
		dropzone.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				openPicker();
			}
		});

		fileInput.addEventListener('change', (e) => {
			const target = e.target;
			if (!target.files) return;
			ingestFiles(target.files);
			target.value = '';
		});

		[auditFrom, auditTo, auditAccount, auditFocus].forEach((field) => {
			field.addEventListener('input', updateUi);
			field.addEventListener('change', updateUi);
		});

		['dragenter', 'dragover'].forEach((evtName) => {
			dropzone.addEventListener(evtName, (e) => {
				e.preventDefault();
				dropzone.classList.add('is-drag');
			});
		});

		['dragleave', 'drop'].forEach((evtName) => {
			dropzone.addEventListener(evtName, (e) => {
				e.preventDefault();
				dropzone.classList.remove('is-drag');
			});
		});

		dropzone.addEventListener('drop', (e) => {
			const dt = e.dataTransfer;
			if (!dt?.files?.length) return;
			ingestFiles(dt.files);
		});

		contactCta.addEventListener('click', (e) => {
			if (contactCta.classList.contains('is-disabled')) {
				e.preventDefault();
				return;
			}
			const params = new URLSearchParams({
				flow: 'auditoria-ia',
				step: 'pack',
				period_from: auditFrom.value,
				period_to: auditTo.value,
				account: auditAccount.value,
				focus: auditFocus.value,
			});
			contactCta.setAttribute('href', `/company/contact?${params.toString()}`);
		});
	}
</script>

<style>
	.pack-hero,
	.pack-dropzone-wrap,
	.pack-check {
		margin: var(--section-margin) auto;
	}
	.pack-hero {
		max-width: 54rem;
		padding: 0;
		position: relative;
		isolation: isolate;
	}
	.pack-hero::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		width: clamp(520px, 80vw, 980px);
		height: clamp(300px, 45vw, 580px);
		z-index: -1;
		pointer-events: none;
		background: radial-gradient(ellipse, rgba(100, 196, 255, 0.32) 0%, rgba(100, 196, 255, 0.16) 36%, rgba(100, 196, 255, 0.05) 56%, rgba(100, 196, 255, 0) 74%);
		filter: blur(18px);
	}
	.pack-kicker {
		margin: 0 0 0.45rem;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		color: rgba(153, 218, 255, 0.96);
	}
	.pack-hero h1 {
		margin: 0 0 0.65rem;
		font-size: clamp(1.45rem, 2.8vw, 2rem);
		line-height: 1.2;
	}
	.pack-subtitle {
		margin: 0;
		opacity: 0.9;
		line-height: 1.5;
	}
	.pack-dropzone-wrap {
		max-width: 54rem;
	}
	.pack-dropzone {
		border: 1px dashed rgba(168, 180, 199, 0.72);
		border-radius: 0.95rem;
		background: linear-gradient(180deg, rgba(158, 167, 183, 0.12) 0%, rgba(158, 167, 183, 0.04) 100%);
		padding: clamp(1.2rem, 3.5vw, 1.85rem);
		text-align: center;
		cursor: pointer;
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}
	.pack-dropzone.is-drag {
		border-color: rgba(100, 196, 255, 0.8);
		background: linear-gradient(180deg, rgba(100, 196, 255, 0.18) 0%, rgba(100, 196, 255, 0.06) 100%);
	}
	.pack-dropzone-title {
		margin: 0 0 0.4rem;
		font-size: 1.06rem;
		font-weight: 700;
	}
	.pack-dropzone-sub {
		margin: 0;
		opacity: 0.82;
	}
	#pack-file-input {
		display: none;
	}
	.pack-format-chips {
		margin-top: 0.66rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.pack-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.2rem 0.54rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		border: 1px solid rgba(154, 165, 182, 0.45);
		background: rgba(158, 167, 183, 0.11);
		color: rgba(225, 232, 243, 0.95);
	}
	.pack-trust {
		margin: 0.56rem 0 0;
		font-size: 0.85rem;
		opacity: 0.88;
		color: rgba(218, 226, 238, 0.92);
	}
	.pack-check {
		max-width: 54rem;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 0.95rem;
		background: rgba(255, 255, 255, 0.015);
		padding: 1rem 1.05rem 1.1rem;
	}
	.pack-check h2 {
		margin: 0 0 0.7rem;
	}
	.pack-manual {
		margin: 0.72rem 0 0.85rem;
		padding: 0.76rem 0.82rem;
		border: 1px solid rgba(172, 180, 196, 0.22);
		border-radius: 0.72rem;
		background: linear-gradient(180deg, rgba(130, 138, 152, 0.09) 0%, rgba(130, 138, 152, 0.03) 100%);
	}
	.pack-manual h3 {
		margin: 0 0 0.58rem;
		font-size: 0.92rem;
		opacity: 0.9;
	}
	.pack-manual-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
	}
	.pack-field {
		display: grid;
		gap: 0.28rem;
	}
	.pack-field span {
		font-size: 0.78rem;
		opacity: 0.86;
	}
	.pack-field input,
	.pack-field select {
		width: 100%;
		border-radius: 0.52rem;
		border: 1px solid rgba(173, 182, 200, 0.34);
		background: rgba(16, 20, 28, 0.78);
		color: rgba(232, 239, 250, 0.96);
		padding: 0.42rem 0.52rem;
		font-size: 0.84rem;
	}
	.pack-field input:focus,
	.pack-field select:focus {
		outline: none;
		border-color: rgba(100, 196, 255, 0.72);
		box-shadow: 0 0 0 1px rgba(100, 196, 255, 0.22);
	}
	.pack-check ul {
		margin: 0;
		padding-left: 0;
		line-height: 1.62;
		list-style: none;
	}
	.pack-req {
		position: relative;
		padding-left: 1.5rem;
		margin-bottom: 0.34rem;
	}
	.pack-req::before {
		content: '•';
		position: absolute;
		left: 0.2rem;
		top: 0.02rem;
		font-weight: 700;
		font-size: 1.02rem;
		color: rgba(100, 196, 255, 0.95);
	}
	.pack-req::after {
		content: 'Pendiente';
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-left: 0.5rem;
		padding: 0.03rem 0.4rem;
		border-radius: 999px;
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		border: 1px solid rgba(100, 196, 255, 0.45);
		background: rgba(100, 196, 255, 0.11);
		color: rgba(205, 234, 255, 0.94);
	}
	.pack-req.is-ok::before {
		content: '✓';
		color: rgba(134, 226, 168, 0.98);
	}
	.pack-req.is-ok::after {
		content: 'OK';
		border-color: rgba(134, 226, 168, 0.56);
		background: rgba(134, 226, 168, 0.13);
		color: rgba(190, 246, 209, 0.96);
	}
	.pack-req.is-manual::before {
		content: '•';
		color: rgba(168, 178, 198, 0.95);
	}
	.pack-req.is-manual::after {
		content: 'Dato manual';
		border-color: rgba(168, 178, 198, 0.48);
		background: rgba(168, 178, 198, 0.13);
		color: rgba(218, 226, 239, 0.95);
	}
	.pack-req.is-manual-ok::before {
		content: '✓';
		color: rgba(134, 226, 168, 0.98);
	}
	.pack-req.is-manual-ok::after {
		content: 'OK';
		border-color: rgba(134, 226, 168, 0.56);
		background: rgba(134, 226, 168, 0.13);
		color: rgba(190, 246, 209, 0.96);
	}
	.pack-status {
		margin: 0.82rem 0 0.66rem;
		font-weight: 600;
	}
	.pack-files {
		border: 1px solid rgba(100, 196, 255, 0.22);
		border-radius: 0.75rem;
		background: rgba(100, 196, 255, 0.06);
		padding: 0.78rem 0.85rem;
	}
	.pack-files h3 {
		margin: 0 0 0.48rem;
		font-size: 0.95rem;
	}
	.pack-files ul {
		margin: 0;
		padding-left: 1rem;
	}
	.pack-file-empty {
		opacity: 0.75;
	}
	.pack-cta-row {
		margin-top: 0.9rem;
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.pack-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.56rem 0.95rem;
		border-radius: 0.65rem;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease;
	}
	.pack-cta--primary {
		border: 1px solid rgba(100, 196, 255, 0.5);
		color: rgba(232, 247, 255, 0.98);
		background: rgba(100, 196, 255, 0.14);
	}
	.pack-cta--primary:hover {
		background: rgba(100, 196, 255, 0.2);
		border-color: rgba(100, 196, 255, 0.72);
	}
	.pack-cta--primary:not(.is-disabled) {
		background: rgba(100, 196, 255, 0.22);
		border-color: rgba(100, 196, 255, 0.78);
		box-shadow: 0 0 0 1px rgba(100, 196, 255, 0.18) inset;
	}
	.pack-cta--secondary {
		border: 1px solid rgba(100, 196, 255, 0.34);
		color: rgba(221, 243, 255, 0.95);
		background: rgba(100, 196, 255, 0.08);
	}
	.pack-cta--secondary:hover {
		background: rgba(100, 196, 255, 0.13);
	}
	.pack-cta.is-disabled {
		opacity: 0.45;
		cursor: not-allowed;
		pointer-events: auto;
	}
	@media (max-width: 768px) {
		.pack-hero::before {
			width: clamp(440px, 110vw, 760px);
		}
		.pack-manual-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
