---
import Layout from '../../layouts/Page.astro';

const seo = {
  title: 'Redirigiendo a evidencia | tevsys',
  description: 'Ruta puente para acceso rapido a evidencia.',
};
---

<Layout seo={seo}>
  <section class="go-redirect">
    <p>Redirigiendo a evidencia...</p>
    <p>
      Si no redirige automaticamente, pulsa aqui:
      <a href="/features/hyperclose#hyperclose-demo">ver evidencia</a>.
    </p>
  </section>
</Layout>

<script>
  // Dejamos un margen corto para que Vercel Analytics registre esta ruta.
  window.setTimeout(() => {
    window.location.replace('/features/hyperclose#hyperclose-demo');
  }, 320);
</script>

<noscript>
  <meta http-equiv="refresh" content="0;url=/features/hyperclose#hyperclose-demo" />
</noscript>

<style>
  .go-redirect {
    padding: 2rem 1rem;
    text-align: center;
    color: rgba(244, 246, 248, 0.9);
  }
</style>
