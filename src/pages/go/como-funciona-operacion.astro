<!doctype html>
<html lang="es" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Redirigiendo a Medianoche · operación abierta</title>
    <style>
      html,
      body {
        margin: 0;
        width: 100%;
        height: 100%;
        background: #06080d;
        overflow: hidden;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }
    </style>
  </head>
  <body>
    <p class="sr-only">Redirigiendo a Cómo funciona — guía overnight laborable.</p>
    <script>
      import { inject, track } from '@vercel/analytics';
      inject({
        beforeSend: (event) => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('va-disable')) {
            return null;
          }
          return event;
        },
      });
      try {
        track('Swing Go Landing', { path: '/go/como-funciona-operacion' });
      } catch {
        /* analytics optional in local */
      }
      window.setTimeout(() => {
        window.location.replace('/como-funciona#overnight-laborable');
      }, 280);
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/como-funciona#overnight-laborable" />
      <a href="/como-funciona#overnight-laborable">Ver operación abierta que cruza días — sigues protegido</a>
    </noscript>
  </body>
</html>
