---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import '../styles/guia-operativa.css';

const seo = {
	title: 'Configuración al instalar | tevsys Advanced y Pro',
	description:
		'Tras cargar el EA entre semana (lunes–viernes): F7, Bloquear límites y protección inmediata. Demo avanzada y licencias Advanced/Pro.',
};

const bloquesLectura = [
	{
		n: 1,
		title: 'Antes de empezar',
		detail:
			'EA en el gráfico tras la instalación y clave validada (demo avanzada o licencia).',
	},
	{
		n: 2,
		title: 'F7 y límites',
		detail: 'Abre inputs (F7). Ajusta límites y días ON/OFF de la semana. Aceptar y revisa el panel.',
	},
	{
		n: 3,
		title: 'Bloquear límites',
		detail:
			'Pulsa Bloquear límites → lee el resumen → confirma. La protección arranca al confirmar (irreversible hasta el viernes).',
	},
	{
		n: 4,
		title: 'Panel protegido',
		detail: 'Candado teal en multigráfico — estado protegido activo.',
	},
];

const otrasGuias = [
	{
		label: 'Instalación',
		title: 'Cómo instalar en MT5',
		href: '/instalacion',
	},
	{
		label: 'Advanced / Pro',
		title: 'Planificar la semana en sábado o domingo',
		href: '/configuracion-fin-de-semana',
	},
	{
		label: 'Essential',
		title: 'Configuración',
		href: '/configuracion',
	},
];
---

<Layout seo={seo} bodyClass="page-guia-config-instalar">
	<Container>
		<div class="guia-page">
			<section class="feature-hero guia-hero">
				<p class="guia-eyebrow">Guía al instalar — Advanced / Pro</p>
				<h1>Configuración al instalar</h1>
				<p class="feature-hook">
					<span class="feature-hook__dot" aria-hidden="true"></span>Entre semana — F7, Bloquear límites, protección al momento.
				</p>
			</section>

			<section id="configuracion-al-instalar-video" class="guia-video-panel">
				<div class="guia-video-panel__halo" aria-hidden="true"></div>
				<div class="guia-video-panel__inner">
					<header class="guia-section-head">
						<p class="guia-eyebrow">Vídeo</p>
						<h2>Configuración al instalar</h2>
					</header>
					<div class="guia-embed guia-embed--chrome">
						<p class="guia-embed-pending">Vídeo en preparación — usa los pasos de abajo mientras tanto.</p>
					</div>
					<p class="guia-note-box guia-note-box--after-video">
						<strong>¿Es sábado o domingo?</strong> Usa
						<a href="/configuracion-fin-de-semana">configuración fin de semana</a> — Guardar para el lunes,
						arranque el lunes a las 00:00.
					</p>
				</div>
			</section>

			<section class="guia-read-section">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Apoyo al vídeo</p>
					<h2>Si prefieres leer</h2>
					<p class="guia-section-sub">Cuatro bloques, mismo orden.</p>
				</header>
				<div class="guia-read-panel">
					<ol class="guia-phase-list">
						{
							bloquesLectura.map((bloque) => (
								<li>
									<article class="guia-phase-card">
										<span class="guia-phase-card__n">{bloque.n}</span>
										<div class="guia-phase-card__body">
											<h3 class="guia-phase-card__title">{bloque.title}</h3>
											<p class="guia-phase-card__detail">{bloque.detail}</p>
										</div>
									</article>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section class="guia-fork-panel">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Otras guías</p>
					<h2>Enlaces relacionados</h2>
					<p class="guia-section-sub guia-fork-hint">Elige tu guía:</p>
				</header>
				<ul class="guia-fork-list">
					{
						otrasGuias.map((guia) => (
							<li>
								<a href={guia.href} class="guia-fork-link">
									<span class="guia-fork-link__label">{guia.label}</span>
									<span class="guia-fork-link__title">{guia.title}</span>
									<span class="guia-fork-link__arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</Container>
</Layout>
