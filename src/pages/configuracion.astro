---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import '../styles/guia-operativa.css';

const seo = {
	title: 'Guía rápida de configuración | tevsys',
	description: 'Configura los límites y el panel de tevsys Essential. Vídeo paso a paso en fin de semana. Entre semana el flujo es similar.',
};

const VIDEO_DRIVE_ID = '1fzSxwhZK2DC9SgUQhXeFf8WyTBeMecTg';
const VIDEO_EMBED_URL = `https://drive.google.com/file/d/${VIDEO_DRIVE_ID}/preview`;
const VIDEO_LINK_URL = `https://drive.google.com/file/d/${VIDEO_DRIVE_ID}/view?usp=sharing`;

const bloquesLectura = [
	{
		n: 1,
		title: 'Tras instalar',
		detail: 'Con el EA en el gráfico, abre inputs (F7) para límites de pérdida y ganancia.',
	},
	{
		n: 2,
		title: 'Fin de semana vs entre semana',
		detail:
			'El vídeo muestra el flujo en fin de semana; entre semana es similar — cambia el día activo.',
	},
	{
		n: 3,
		title: 'Panel',
		detail: 'Tras configurar verás el panel y el flujo Essential de demo.',
	},
];

const otrasGuias = [
	{
		label: 'Instalación',
		title: 'Cómo instalar en MT5',
		href: '/instalacion',
	},
	{
		label: 'Advanced / Pro',
		title: 'Configuración al instalar de lunes a viernes',
		href: '/configuracion-al-instalar',
	},
	{
		label: 'Advanced / Pro',
		title: 'Planificar la semana en sábado o domingo',
		href: '/configuracion-fin-de-semana',
	},
];
---

<Layout seo={seo} bodyClass="page-guia-config-essential">
	<Container>
		<div class="guia-page">
			<section class="feature-hero guia-hero">
				<p class="guia-eyebrow">Guía Essential — demo estándar</p>
				<h1>Configuración — tevsys Essential</h1>
				<p class="feature-hook">
					<span class="feature-hook__dot" aria-hidden="true"></span>Vídeo 2:36 — límites, panel y primer uso.
				</p>
			</section>

			<section id="configuracion-video" class="guia-video-panel">
				<div class="guia-video-panel__halo" aria-hidden="true"></div>
				<div class="guia-video-panel__inner">
					<header class="guia-section-head">
						<p class="guia-eyebrow">Vídeo</p>
						<h2>Configuración básica</h2>
					</header>
					<div class="guia-embed guia-embed--chrome">
						<iframe
							src={VIDEO_EMBED_URL}
							width="560"
							height="315"
							allow="autoplay"
							allowfullscreen
							title="Guía rápida de configuración tevsys"
						></iframe>
					</div>
					<p class="guia-embed-fallback">
						Si el vídeo no se reproduce, <a href={VIDEO_LINK_URL} target="_blank" rel="noopener noreferrer">ábrelo directamente</a>.
					</p>
					<p class="guia-note-box guia-note-box--after-video">
						<strong>Advanced o Pro:</strong>
						<a href="/configuracion-al-instalar">configuración al instalar</a> (entre semana) ·
						<a href="/configuracion-fin-de-semana">configuración en fin de semana</a> (sáb. o dom.).
					</p>
				</div>
			</section>

			<section class="guia-read-section">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Apoyo al vídeo</p>
					<h2>Si prefieres leer</h2>
					<p class="guia-section-sub">Tres bloques, mismo orden.</p>
				</header>
				<div class="guia-read-panel">
					<ol class="guia-phase-list">
						{
							bloquesLectura.map((bloque) => (
								<li>
									<article class="guia-phase-card">
										<span class="guia-phase-card__n">{bloque.n}</span>
										<div class="guia-phase-card__body">
											<h3 class="guia-phase-card__title">{bloque.title}</h3>
											<p class="guia-phase-card__detail">{bloque.detail}</p>
										</div>
									</article>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section class="guia-fork-panel">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Otras guías</p>
					<h2>Enlaces relacionados</h2>
					<p class="guia-section-sub guia-fork-hint">Elige tu guía:</p>
				</header>
				<ul class="guia-fork-list">
					{
						otrasGuias.map((guia) => (
							<li>
								<a href={guia.href} class="guia-fork-link">
									<span class="guia-fork-link__label">{guia.label}</span>
									<span class="guia-fork-link__title">{guia.title}</span>
									<span class="guia-fork-link__arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</Container>
</Layout>
