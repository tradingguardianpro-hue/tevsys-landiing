---
/**
 * Lista curada de vídeos públicos en YouTube (casos de cierre / presentación).
 * Editar el array `videos`: título + URL. Dejar url vacía para tarjeta "Próximamente".
 * Miniatura: oficial de YouTube (hqdefault) vía ID extraído del enlace.
 */
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

function youtubeIdFromUrl(url: string): string | null {
	const u = url.trim();
	const short = u.match(/youtu\.be\/([^?&#/]+)/);
	if (short?.[1]) return short[1];
	const watch = u.match(/[?&]v=([^&#]+)/);
	if (watch?.[1]) return watch[1];
	const embed = u.match(/youtube\.com\/embed\/([^?&#/]+)/);
	if (embed?.[1]) return embed[1];
	return null;
}

const videos: { title: string; blurb?: string; url: string }[] = [
	{
		title: 'Parte 1 · Presentación tevsys (~3 min)',
		blurb: 'Qué es tevsys, un gráfico, protección a nivel cuenta. Ideal como primera toma de contacto.',
		url: 'https://youtu.be/Kz21Hm_ukZ0',
	},
	{
		title: 'Parte 2 · Cierre al límite y evidencia MT5 (~2 min 22 s)',
		blurb: 'Operativa documentada, límites, informe HTML, rotación. Complemento del artículo Seller.',
		url: 'https://youtu.be/QU1hC6SKg10',
	},
	{
		title: 'HyperClose · Precisión 15 lotes + semáforo (~2 min 23 s)',
		blurb:
			'Misma demo que en /features/hyperclose: GER40, límite −1 %, desviación 1,31 €, tres modales. No sustituye a parte 1 ni 2; es evidencia del flujo HyperClose en movimiento.',
		url: 'https://youtu.be/jwEvJrohR4I',
	},
];

const videosWithMeta = videos.map((v) => {
	const id = v.url ? youtubeIdFromUrl(v.url) : null;
	return {
		...v,
		videoId: id,
		thumbUrl: id ? `https://img.youtube.com/vi/${id}/hqdefault.jpg` : null,
	};
});

const seo = {
	title: 'Vídeos — casos de cierre | tevsys',
	description:
		'Lista de vídeos públicos en YouTube: presentación de tevsys y casos de cierre documentados en MT5.',
};
---

<Layout seo={seo}>
	<Container>
		<section class="yt-list-hero">
			<p class="yt-list-kicker">En nuestra casa</p>
			<h1 class="yt-list-hero__title">
				Pruebas en vídeo.
				<span class="yt-list-hero__accent">Sin rodeos.</span>
			</h1>
			<p class="yt-list-lead">
				Aquí tienes una selección directa de vídeos de tevsys para revisar casos reales en pocos minutos.
				Miniatura oficial; un clic y reproduces en <span class="yt-list-lead-brand">YouTube</span>.
			</p>
			<p class="yt-list-edit-note">
				<strong>Vídeos editados:</strong> vamos a los momentos clave; puede haber <strong>saltos de tiempo</strong>
				visibles en el reloj del terminal. La evidencia verificable está en el informe MT5 y en la
				documentación enlazada desde tevsys.io.
			</p>
		</section>

		<ul class="yt-grid">
			{
				videosWithMeta.map((v) => (
					<li class="yt-grid__cell">
						{v.url && v.thumbUrl ? (
							<a
								class="yt-card yt-card--live"
								href={v.url}
								target="_blank"
								rel="noopener noreferrer"
							>
								<div class="yt-card__media">
									<img
										class="yt-card__thumb"
										src={v.thumbUrl}
										alt=""
										width={480}
										height={360}
										loading="lazy"
										decoding="async"
									/>
									<span class="yt-card__shade" aria-hidden="true" />
									<span class="yt-card__play" aria-hidden="true">
										<svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true">
											<circle cx="32" cy="32" r="30" fill="rgba(0,0,0,0.55)" />
											<path
												d="M26 20 L46 32 L26 44 Z"
												fill="#fff"
											/>
										</svg>
									</span>
								</div>
								<div class="yt-card__body">
									<p class="yt-card__brand">
										<span class="yt-card__brand-dot" aria-hidden="true" />
										YouTube
									</p>
									<h2 class="yt-card__title">{v.title}</h2>
									{v.blurb && <p class="yt-card__blurb">{v.blurb}</p>}
									<span class="yt-card__cta">Abrir vídeo →</span>
								</div>
							</a>
						) : (
							<div class="yt-card yt-card--pending">
								<div class="yt-card__media yt-card__media--pending">
									<span class="yt-card__pending-label">Próximamente</span>
									<span class="yt-card__pending-hint">Falta publicar el enlace</span>
								</div>
								<div class="yt-card__body">
									<p class="yt-card__brand yt-card__brand--muted">
										<span class="yt-card__brand-dot yt-card__brand-dot--muted" aria-hidden="true" />
										YouTube
									</p>
									<h2 class="yt-card__title">{v.title}</h2>
									{v.blurb && <p class="yt-card__blurb">{v.blurb}</p>}
								</div>
							</div>
						)}
					</li>
				))
			}
		</ul>

		<nav class="yt-list-nav" aria-label="Seguir explorando en tevsys">
			<span class="yt-list-nav__label">Seguir explorando:</span>
			<span class="yt-list-nav__links">
				<a href="/">Inicio</a>
				<span class="yt-list-nav__sep" aria-hidden="true">·</span>
				<a href="/features/precision">Precisión</a>
				<span class="yt-list-nav__sep" aria-hidden="true">·</span>
				<a href="/features/hyperclose">HyperClose</a>
				<span class="yt-list-nav__sep" aria-hidden="true">·</span>
				<a href="/features/sml">SML</a>
				<span class="yt-list-nav__sep" aria-hidden="true">·</span>
				<a href="/features/evidencia">Evidencia</a>
			</span>
		</nav>
	</Container>
</Layout>

<style>
	.yt-list-hero {
		margin: var(--section-margin) auto 2.25rem;
		max-width: min(40rem, 100%);
		text-align: center;
		padding: 0 0.5rem;
		box-sizing: border-box;
	}
	.yt-list-kicker {
		margin: 0 0 0.5rem;
		opacity: 0.75;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.78rem;
		color: rgba(232, 234, 237, 0.6);
	}
	.yt-list-hero__title {
		margin: 0 0 0.85rem;
		font-size: clamp(1.75rem, 4vw, 2.45rem);
		line-height: 1.15;
		font-weight: 700;
		letter-spacing: -0.02em;
		max-width: min(30ch, 100%);
		margin-left: auto;
		margin-right: auto;
	}
	.yt-list-hero__accent {
		display: block;
		margin-top: 0.45rem;
		font-size: 0.5em;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: #f5b041;
	}
	.yt-list-lead {
		margin: 0;
		line-height: 1.55;
		opacity: 0.92;
	}
	/* Rojo tipo crimson apagado — evita el #ff0033 “anuncio” */
	.yt-list-lead-brand {
		color: #9a4a52;
		font-weight: 600;
	}
	.yt-list-edit-note {
		margin: 1.1rem 0 0;
		max-width: 52ch;
		margin-left: auto;
		margin-right: auto;
		padding: 0.75rem 1rem;
		font-size: 0.9rem;
		line-height: 1.5;
		opacity: 0.92;
		text-align: left;
		border-left: 3px solid rgba(245, 176, 65, 0.45);
		background: rgba(0, 0, 0, 0.12);
		border-radius: 0 6px 6px 0;
	}
	.yt-list-edit-note strong {
		font-weight: 600;
	}
	.yt-grid {
		list-style: none;
		margin: 0 0 2.5rem;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 700px) {
		.yt-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.75rem;
			align-items: stretch;
		}
	}
	.yt-grid__cell {
		margin: 0;
		padding: 0;
		min-width: 0;
	}
	.yt-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		border-radius: 12px;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			transform 0.2s ease;
	}
	a.yt-card--live:hover {
		border-color: rgba(245, 176, 65, 0.45);
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
		transform: translateY(-2px);
	}
	a.yt-card--live:focus-visible {
		outline: 2px solid #f5b041;
		outline-offset: 3px;
	}
	.yt-card__media {
		position: relative;
		aspect-ratio: 16 / 9;
		background: #1a1a1a;
		overflow: hidden;
	}
	.yt-card__thumb {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.yt-card__shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent 45%);
		pointer-events: none;
		opacity: 0.85;
		transition: opacity 0.2s ease;
	}
	a.yt-card--live:hover .yt-card__shade {
		opacity: 1;
	}
	.yt-card__play {
		position: absolute;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
		filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.55));
		pointer-events: none;
		transition: transform 0.2s ease;
	}
	a.yt-card--live:hover .yt-card__play {
		transform: translate(-50%, -50%) scale(1.06);
	}
	.yt-card__media--pending {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		background: linear-gradient(145deg, rgba(40, 40, 40, 0.9), rgba(20, 20, 22, 0.95));
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}
	.yt-card__pending-label {
		font-weight: 700;
		font-size: 1.05rem;
		opacity: 0.75;
	}
	.yt-card__pending-hint {
		font-size: 0.82rem;
		opacity: 0.5;
	}
	.yt-card__body {
		padding: 1rem 1.1rem 1.15rem;
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.yt-card__brand {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: #9a4a52;
	}
	.yt-card__brand--muted {
		color: rgba(255, 255, 255, 0.35);
	}
	.yt-card__brand-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #9a4a52;
		opacity: 0.9;
	}
	.yt-card__brand-dot--muted {
		background: rgba(255, 255, 255, 0.25);
	}
	.yt-card__title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.25;
	}
	.yt-card__blurb {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.45;
		opacity: 0.85;
		flex: 1;
	}
	.yt-card__cta {
		margin-top: 0.35rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: #f5b041;
	}
	a.yt-card--live:hover .yt-card__cta {
		color: #f7c050;
	}
	/* Una línea: "Seguir explorando:" a la izquierda, enlaces a la derecha (envuelven en móvil) */
	.yt-list-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: 0.6rem;
		row-gap: 0.45rem;
		margin: 0 0 calc(var(--section-margin) * 1.2);
		max-width: 100%;
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.yt-list-nav__label {
		flex: 0 0 auto;
		opacity: 0.58;
		font-size: 0.8rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		white-space: nowrap;
	}
	.yt-list-nav__links {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.15rem 0.3rem;
		flex: 1 1 auto;
		min-width: min(100%, 12rem);
	}
	.yt-list-nav__links a {
		color: rgba(232, 234, 237, 0.9);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		text-decoration-color: rgba(245, 176, 65, 0.35);
	}
	.yt-list-nav__links a:hover {
		color: #f5b041;
		text-decoration-color: #f5b041;
	}
	.yt-list-nav__sep {
		opacity: 0.4;
		user-select: none;
	}
</style>
