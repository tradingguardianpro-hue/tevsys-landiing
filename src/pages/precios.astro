---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import settings from '../config/settings.js';

const seo = {
	title: 'Precios y planes | tevsys',
	description: 'Precios Essential, Advanced, Pro y Pro Multi (2–3 cuentas). Oferta lanzamiento primeros 100: año 1 lanzamiento, 6 meses más si renuevas. 4+ cuentas: empresas.',
};

const planesRetail = [
	{
		nombre: 'Essential',
		mensual: '39 €/mes',
		anual: '390 €/año',
		estandar: '49 €/mes',
		capital: '30.000 €',
		cuentas: null,
		incluye: [
			'1 cuenta MT5',
			'Un día activo, rotación automática',
			'Precisión milimétrica, HyperClose',
			'Días OFF',
			'Actualización noticias y horarios (cuando estén listas)',
		],
		badge: 'Lanzamiento',
	},
	{
		nombre: 'Advanced',
		mensual: '79 €/mes',
		anual: '790 €/año',
		estandar: '99 €/mes',
		capital: '120.000 €',
		cuentas: null,
		incluye: [
			'1 cuenta MT5',
			'Todo Essential',
			'Configuración de toda la semana',
			'Protección desde el lunes o desde que instales',
			'Límites por cada día, SML',
			'Actualización noticias y horarios (cuando estén listas)',
		],
		badge: 'En desarrollo — lista de espera',
	},
	{
		nombre: 'Pro',
		mensual: '119 €/mes',
		anual: '1.190 €/año',
		estandar: '149 €/mes',
		capital: '240.000 €',
		cuentas: null,
		incluye: [
			'1 cuenta MT5',
			'Todo Advanced',
			'Drawdown automático',
			'Noticias y horarios completos',
			'Actualización noticias y horarios (cuando estén listas)',
		],
		badge: 'En desarrollo — lista de espera',
	},
];

const planesMulti = [
	{
		nombre: 'Pro Multi 2',
		mensual: '149 €/mes',
		anual: '1.490 €/año',
		estandar: '179 €/mes',
		capital: '120.000 € por cuenta',
		cuentas: '2 cuentas MT5',
		incluye: [
			'Todo Pro',
			'Cuentas fondeadas o propias',
			'Actualización noticias y horarios (cuando estén listas)',
		],
		badge: 'En desarrollo — lista de espera',
	},
	{
		nombre: 'Pro Multi 3',
		mensual: '179 €/mes',
		anual: '1.790 €/año',
		estandar: '209 €/mes',
		capital: '120.000 € por cuenta',
		cuentas: '3 cuentas MT5',
		incluye: [
			'Todo Pro',
			'Cuentas fondeadas o propias',
			'Actualización noticias y horarios (cuando estén listas)',
		],
		badge: 'En desarrollo — lista de espera',
	},
];
---

<Layout seo={seo}>
	<Container>
		<section class="precios-hero">
			<p class="precios-kicker">Planes y precios</p>
			<h1>Precios, condiciones y funcionalidades por tier</h1>
			<p class="tevsys-page-definition">
				Todos los planes son la misma utilidad para MetaTrader 5 que hace cumplir tus límites en intradía y en
				swing. Lo que cambia entre planes es el alcance: capital cubierto, días configurables y capas disponibles.
			</p>
			<p class="precios-lead">
				Todos los planes son suscripciones (mensual o anual). Oferta lanzamiento para los primeros 100: precio lanzamiento el primer año; al renovar, si sigues suscrito, mantienes ese precio 6 meses más (año y medio en total). A partir de los 18 meses, precio estándar.
			</p>
		</section>

		<section class="precios-cards-section">
			<h2 class="precios-cards-title">Oferta lanzamiento — primeros 100 clientes</h2>
			<p class="precios-cards-sub">(Precio lanzamiento año 1; 6 meses más si renuevas y sigues suscrito)</p>
			<div class="precios-cards-grid precios-cards-grid--retail">
				{planesRetail.map((plan) => (
					<article class="precios-card" id={plan.nombre.toLowerCase()}>
						<h3 class="precios-card__name">{plan.nombre}</h3>
						{plan.badge && <span class="precios-card__badge">{plan.badge}</span>}
						<div class="precios-card__precios">
							<p class="precios-card__lanzamiento"><span class="precios-card__label">Lanzamiento</span> {plan.mensual} · {plan.anual}</p>
							<p class="precios-card__estandar"><span class="precios-card__label">Estándar (desde 18 meses)</span> {plan.estandar}</p>
						</div>
						{plan.cuentas ? (
							<>
								<p class="precios-card__capital"><span class="precios-card__label">Cuentas</span> {plan.cuentas}</p>
								<p class="precios-card__capital"><span class="precios-card__label">Capital máx. por cuenta</span> {plan.capital}</p>
							</>
						) : (
							<p class="precios-card__capital"><span class="precios-card__label">Capital máx.</span> {plan.capital}</p>
						)}
						<ul class="precios-card__incluye">
							{plan.incluye.map((item) => <li>{item}</li>)}
						</ul>
						{plan.nombre === 'Essential' && settings.checkoutEssentialReady && (
							<a href={settings.checkoutEssentialUrlMensual} class="precios-card__comprar" target="_blank" rel="noopener noreferrer">Comprar</a>
						)}
					</article>
				))}
			</div>
			<div class="precios-cards-grid precios-cards-grid--multi">
				{planesMulti.map((plan) => (
					<article class="precios-card">
						<h3 class="precios-card__name">{plan.nombre}</h3>
						{plan.badge && <span class="precios-card__badge">{plan.badge}</span>}
						<div class="precios-card__precios">
							<p class="precios-card__lanzamiento"><span class="precios-card__label">Lanzamiento</span> {plan.mensual} · {plan.anual}</p>
							<p class="precios-card__estandar"><span class="precios-card__label">Estándar (desde 18 meses)</span> {plan.estandar}</p>
						</div>
						{plan.cuentas ? (
							<>
								<p class="precios-card__capital"><span class="precios-card__label">Cuentas</span> {plan.cuentas}</p>
								<p class="precios-card__capital"><span class="precios-card__label">Capital máx. por cuenta</span> {plan.capital}</p>
							</>
						) : (
							<p class="precios-card__capital"><span class="precios-card__label">Capital máx.</span> {plan.capital}</p>
						)}
						<ul class="precios-card__incluye">
							{plan.incluye.map((item) => <li>{item}</li>)}
						</ul>
					</article>
				))}
			</div>
			<p class="precios-nota">Primeros 100 clientes: precio lanzamiento año 1; si renuevas y sigues suscrito, mantienes ese precio 6 meses más. A partir de los 18 meses, precio estándar.</p>
		</section>

		<section class="precios-desc">
			<p>Cuando tengamos las actualizaciones para tu cuenta y Advanced y Pro listos, te avisaremos por email. <strong>Lista de espera abierta</strong> — <a href="/company/contact?flow=lista" class="precios-desc__link">escríbenos para apuntarte</a>.</p>
		</section>

		<section class="precios-empresas">
			<p><strong>¿4 o más cuentas, academia o capital corporativo?</strong> Trato a medida — <a href="/company/empresas">Contacto empresas</a>.</p>
		</section>

		<section class="precios-cta">
			<h2>¿Quieres probar primero?</h2>
			<p>Solicita la demo y pruébala con calma. Cualquier duda, aquí estamos.</p>
			<a href="/company/contact?flow=demo" class="precios-cta__button">Solicitar demo</a>
		</section>
	</Container>
</Layout>

<style>
	.precios-hero,
	.precios-cards-section,
	.precios-desc,
	.precios-empresas,
	.precios-cta {
		margin: var(--section-margin) auto;
	}
	.precios-kicker {
		margin: 0 0 0.35rem;
		opacity: 0.8;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.82rem;
	}
	.precios-hero h1 {
		margin: 0 0 0.65rem;
		font-size: clamp(1.6rem, 3.5vw, 2.2rem);
	}
	.precios-lead {
		max-width: 60ch;
		line-height: 1.55;
		opacity: 0.9;
	}
	.precios-cards-title {
		margin: 0 0 0.25rem;
		font-size: 1.4rem;
		font-weight: 700;
		color: #f5b041;
	}
	.precios-cards-sub {
		margin: 0 0 1.25rem;
		font-size: 0.9rem;
		opacity: 0.85;
	}
	.precios-cards-grid {
		display: grid;
		gap: 1.25rem;
		margin-bottom: 1rem;
	}
	.precios-cards-grid--retail {
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
	}
	.precios-cards-grid--multi {
		grid-template-columns: repeat(2, 1fr);
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}
	@media (max-width: 600px) {
		.precios-cards-grid--multi {
			grid-template-columns: 1fr;
		}
	}
	.precios-card {
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1.25rem;
		border: 1px solid var(--theme-surface-2);
		display: flex;
		flex-direction: column;
		scroll-margin-top: 2rem;
	}
	.precios-card:hover {
		border-color: rgba(245, 176, 65, 0.4);
	}
	.precios-card:target {
		border-color: #f5b041;
		box-shadow: 0 0 24px rgba(245, 176, 65, 0.35), 0 0 0 1px rgba(245, 176, 65, 0.5);
	}
	.precios-card__name {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
		font-weight: 700;
	}
	.precios-card__badge {
		display: inline-block;
		margin-bottom: 0.75rem;
		padding: 0.2rem 0.5rem;
		font-size: 0.75rem;
		background: rgba(245, 176, 65, 0.2);
		color: #f5b041;
		border-radius: 0.35rem;
		align-self: flex-start;
	}
	.precios-card__precios {
		margin: 0 0 0.5rem;
	}
	.precios-card__lanzamiento {
		margin: 0 0 0.25rem;
		font-size: 1rem;
		font-weight: 600;
	}
	.precios-card__estandar {
		margin: 0;
		font-size: 0.88rem;
		opacity: 0.9;
	}
	.precios-card__capital {
		margin: 0 0 0.75rem;
		font-size: 0.9rem;
	}
	.precios-card__label {
		display: block;
		font-size: 0.75rem;
		opacity: 0.8;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.15rem;
	}
	.precios-card__incluye {
		margin: 0;
		padding-left: 1.25rem;
		line-height: 1.6;
		font-size: 0.9rem;
		opacity: 0.95;
		flex: 1;
	}
	.precios-card__incluye li {
		margin-bottom: 0.35rem;
	}
	.precios-card__comprar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-top: 1rem;
		padding: 0.5rem 1rem;
		border-radius: 1.5rem;
		background: #f5b041;
		color: #1a1510;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.2s ease;
		align-self: flex-start;
	}
	.precios-card__comprar:hover {
		background: #f7c050;
	}
	.precios-nota {
		font-size: 0.88rem;
		opacity: 0.85;
		font-style: italic;
	}
	.precios-desc {
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1.2rem;
	}
	.precios-desc p {
		margin: 0 0 0.75rem;
		line-height: 1.55;
	}
	.precios-desc__link {
		color: #f5b041;
		font-weight: 600;
		text-decoration: none;
	}
	.precios-desc__link:hover {
		text-decoration: underline;
	}
	.precios-desc p:last-child {
		margin-bottom: 0;
	}
	.precios-empresas {
		background: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
		padding: 1.2rem;
		border-left: 4px solid rgba(245, 176, 65, 0.6);
	}
	.precios-empresas p {
		margin: 0;
		line-height: 1.5;
	}
	.precios-empresas a {
		color: #f5b041;
		font-weight: 600;
	}
	.precios-empresas a:hover {
		text-decoration: underline;
	}
	.precios-cta {
		text-align: center;
	}
	.precios-cta h2 {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
	}
	.precios-cta p {
		margin: 0 0 1rem;
		opacity: 0.9;
	}
</style>
