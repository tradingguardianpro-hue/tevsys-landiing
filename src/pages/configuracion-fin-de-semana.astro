---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';
import '../styles/guia-operativa.css';

const seo = {
	title: 'Configuración en fin de semana | tevsys Advanced y Pro',
	description:
		'Solo sábado o domingo: planifica lunes a viernes, Guardar para el lunes y protección programada. El lunes a las 00:00 entra la protección si confirmaste.',
};

const VIDEO_CACHE_BUST = '20260606';

const bloquesLectura = [
	{
		n: 1,
		title: 'Cuándo usar esta guía',
		detail:
			'Solo sábado o domingo. Planifica la semana de lunes a viernes: días OFF y límites. En fin de semana estás en modo configuración (engranaje): puedes ajustar en F7 las veces que necesites.',
	},
	{
		n: 2,
		title: 'Guardar para el lunes',
		detail:
			'F7 → revisa la semana → Guardar para el lunes. Confirma el modal Protección programada → PROGRAMADO · LUNES y engranaje en color.',
	},
	{
		n: 3,
		title: 'Arranque el lunes',
		detail:
			'El lunes a las 00:00 entra la protección si quedó programada. Hasta entonces puedes reconfigurar y volver a guardar.',
	},
];

const otrasGuias = [
	{
		label: 'Instalación',
		title: 'Cómo instalar en MT5',
		href: '/instalacion',
	},
	{
		label: 'Advanced / Pro',
		title: 'Configuración al instalar de lunes a viernes',
		href: '/configuracion-al-instalar',
	},
	{
		label: 'Essential',
		title: 'Configuración',
		href: '/configuracion',
	},
];
---

<Layout seo={seo} bodyClass="page-guia-config-finde">
	<Container>
		<div class="guia-page">
			<section class="feature-hero guia-hero">
				<p class="guia-eyebrow">Guía fin de semana — Advanced / Pro</p>
				<h1>Configuración en fin de semana</h1>
				<p class="feature-hook">
					<span class="feature-hook__dot" aria-hidden="true"></span>Vídeo 2:01 — planifica la semana el sábado o domingo.
				</p>
			</section>

			<section id="configuracion-fin-de-semana-video" class="guia-video-panel">
				<div class="guia-video-panel__halo" aria-hidden="true"></div>
				<div class="guia-video-panel__inner">
					<header class="guia-section-head">
						<p class="guia-eyebrow">Vídeo</p>
						<h2>Configuración en fin de semana</h2>
					</header>
					<div class="guia-embed guia-embed--chrome" id="config-finde-demo-container">
						<video id="config-finde-demo-video" controls preload="metadata" playsinline>
							<source
								src={`/videos/features/configuracion-semana-demo.mp4?v=${VIDEO_CACHE_BUST}`}
								type="video/mp4"
							/>
							Tu navegador no soporta reproducción de video HTML5.
						</video>
					</div>
					<p class="guia-note-box guia-note-box--after-video">
						<strong>¿Instalaste entre semana (lunes–viernes)?</strong> Usa
						<a href="/configuracion-al-instalar">configuración al instalar</a> — Bloquear límites y protección al
						momento.
					</p>
				</div>
			</section>

			<section class="guia-read-section">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Apoyo al vídeo</p>
					<h2>Si prefieres leer</h2>
					<p class="guia-section-sub">Tres bloques, mismo orden.</p>
				</header>
				<div class="guia-read-panel">
					<ol class="guia-phase-list">
						{
							bloquesLectura.map((bloque) => (
								<li>
									<article class="guia-phase-card">
										<span class="guia-phase-card__n">{bloque.n}</span>
										<div class="guia-phase-card__body">
											<h3 class="guia-phase-card__title">{bloque.title}</h3>
											<p class="guia-phase-card__detail">{bloque.detail}</p>
										</div>
									</article>
								</li>
							))
						}
					</ol>
				</div>
			</section>

			<section class="guia-fork-panel">
				<header class="guia-section-head">
					<p class="guia-eyebrow">Otras guías</p>
					<h2>Enlaces relacionados</h2>
					<p class="guia-section-sub guia-fork-hint">Elige tu guía:</p>
				</header>
				<ul class="guia-fork-list">
					{
						otrasGuias.map((guia) => (
							<li>
								<a href={guia.href} class="guia-fork-link">
									<span class="guia-fork-link__label">{guia.label}</span>
									<span class="guia-fork-link__title">{guia.title}</span>
									<span class="guia-fork-link__arrow" aria-hidden="true">→</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</Container>
</Layout>

<script>
	function initConfigFindeDemoExpand() {
		const video = document.getElementById('config-finde-demo-video');
		const container = document.getElementById('config-finde-demo-container');
		if (!video || !container) return;
		video.addEventListener('play', () => container.classList.add('guia-embed--playing'));
		video.addEventListener('ended', () => container.classList.remove('guia-embed--playing'));
	}
	document.addEventListener('DOMContentLoaded', initConfigFindeDemoExpand);
</script>
