			rgba(148, 154, 168, 0.62) 72%,
			rgba(110, 116, 128, 0.35) 100%
		);
	}

	html[data-theme='light'] .how-present-title__accent::after {
		background: linear-gradient(
			90deg,
			rgba(218, 155, 48, 0.9) 0%,
			rgba(120, 125, 138, 0.5) 75%,
			rgba(90, 95, 108, 0.28) 100%
		);
	}

	.how-zero-title__accent {
		display: inline-block;
		text-align: left;
	}

	.how-zero-title__accent::after {
		content: '';
		display: block;
		width: min(12.5rem, 100%);
		height: 3px;
		margin: 0.5rem 0.85rem 0 0.12rem;
		border-radius: 999px;
		background: linear-gradient(
			90deg,
			rgba(245, 176, 65, 0.95) 0%,
			rgba(148, 154, 168, 0.62) 72%,
			rgba(110, 116, 128, 0.35) 100%
		);
	}

	html[data-theme='light'] .how-zero-title__accent::after {
		background: linear-gradient(
			90deg,
			rgba(218, 155, 48, 0.9) 0%,
			rgba(120, 125, 138, 0.5) 75%,
			rgba(90, 95, 108, 0.28) 100%
		);
