---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Cómo funciona tevsys | tevsys',
	description:
		'Vídeo principal y selección corta: presentación en MT5, configuración esencial y caso con evidencia.',
};

/** Vídeo principal: sustituir `embed` cuando tengáis el corte nuevo (estilo artículo MQL5 + features actuales, ~3 min). */
const spotlightVideo = {
	title: 'Presentación en el gráfico (~3 min)',
	blurb: 'EA en MT5 y panel, sin señales. Pronto: mismo enfoque que el artículo MQL5, con las features actuales (incl. arrastrar el EA al gráfico).',
	embed: 'https://www.youtube-nocookie.com/embed/Kz21Hm_ukZ0',
	href: 'https://youtu.be/Kz21Hm_ukZ0',
	cta: 'Abrir en YouTube',
};

/** Pocos vídeos, mismo tamaño de reproductor que el principal. */
const curatedVideos: {
	title: string;
	blurb: string;
	embed: string;
	href: string;
	cta: string;
	external?: boolean;
}[] = [
	{
		title: 'Configuración esencial (Essential)',
		blurb: 'Límites, panel y primer uso tras instalar la demo.',
		embed: 'https://drive.google.com/file/d/1fzSxwhZK2DC9SgUQhXeFf8WyTBeMecTg/preview',
		href: '/configuracion',
		cta: 'Guía paso a paso',
	},
	{
		title: 'Cierre al límite + evidencia MT5',
		blurb: 'Caso corto: límites, cierre y contraste con el terminal.',
		embed: 'https://www.youtube-nocookie.com/embed/QU1hC6SKg10',
		href: 'https://youtu.be/QU1hC6SKg10',
		cta: 'Abrir en YouTube',
		external: true,
	},
];
---

<Layout seo={seo}>
	<Container>
		<section class="how-hero how-hero--tight" aria-labelledby="how-hero-title">
			<h1 id="how-hero-title">Cómo funciona <span class="how-accent">tevsys</span></h1>
			<p class="how-hero__one">Vídeo primero. Abajo, dos cortes más si quieres profundizar.</p>
		</section>

		<section class="how-spotlight" aria-labelledby="spotlight-title">
			<header class="how-block-head">
				<p class="how-eyebrow">Vídeo principal</p>
				<h2 id="spotlight-title">{spotlightVideo.title}</h2>
				<p class="how-block-lead">{spotlightVideo.blurb}</p>
				<a
					href={spotlightVideo.href}
					class="how-text-link"
					target="_blank"
					rel="noopener noreferrer">{spotlightVideo.cta} →</a>
			</header>
			<div class="how-embed how-embed--chrome">
				<iframe
					src={spotlightVideo.embed}
					title={spotlightVideo.title}
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					allowfullscreen
					loading="eager"
					referrerpolicy="strict-origin-when-cross-origin"
				></iframe>
			</div>
		</section>

		<section class="how-curated" aria-labelledby="curated-title">
			<header class="how-section-head">
				<h2 id="curated-title">Selección en vídeo</h2>
				<p class="how-section-sub">Mismo reproductor, distinto foco. Un título claro y una línea; el clic abre el detalle si lo necesitas.</p>
			</header>
			<div class="how-curated__stack">
				{
					curatedVideos.map((v) => (
						<article class="how-curated-card">
							<header class="how-block-head how-block-head--compact">
								<h3>{v.title}</h3>
								<p class="how-block-lead">{v.blurb}</p>
								<a
									href={v.href}
									class="how-text-link"
									target={v.external ? '_blank' : undefined}
									rel={v.external ? 'noopener noreferrer' : undefined}>{v.cta} →</a>
							</header>
							<div class="how-embed how-embed--chrome">
								<iframe
									src={v.embed}
									title={v.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								></iframe>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<nav class="how-deep" aria-label="Ir a más detalle">
			<a href="/configuracion">Configuración</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/videos-cierre-youtube">Todos los vídeos</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/features/evidencia">Evidencia</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/company/contact?flow=demo">Demo</a>
		</nav>
	</Container>
</Layout>

<style>
	.how-hero,
	.how-spotlight,
	.how-curated,
	.how-deep {
		margin: var(--section-margin) auto;
	}

	.how-hero--tight {
		margin-top: calc(var(--section-margin) * 0.65);
		margin-bottom: 1rem;
		text-align: center;
		max-width: 36rem;
		margin-left: auto;
		margin-right: auto;
	}

	.how-hero h1 {
		font-size: clamp(1.45rem, 3.8vw, 2.1rem);
		margin: 0 0 0.5rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.how-accent {
		color: #f5b041;
	}

	.how-hero__one {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.45;
		opacity: 0.88;
	}

	.how-spotlight,
	.how-curated-card {
		max-width: min(56rem, 100%);
		margin-left: auto;
		margin-right: auto;
	}

	.how-spotlight {
		padding: 0 0 0.25rem;
	}

	.how-section-head {
		text-align: center;
		max-width: 40rem;
		margin: 0 auto 1.25rem;
	}

	.how-section-head h2 {
		margin: 0 0 0.45rem;
		font-size: clamp(1.15rem, 2.4vw, 1.35rem);
		font-weight: 700;
	}

	.how-section-sub {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.45;
		opacity: 0.85;
	}

	.how-block-head {
		margin-bottom: 1rem;
	}

	.how-block-head--compact {
		margin-bottom: 0.85rem;
	}

	.how-block-head h2,
	.how-block-head h3 {
		margin: 0 0 0.4rem;
		font-size: clamp(1.12rem, 2.2vw, 1.28rem);
		line-height: 1.25;
	}

	.how-block-head h3 {
		font-size: clamp(1.05rem, 2vw, 1.2rem);
	}

	.how-eyebrow {
		margin: 0 0 0.35rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	.how-block-lead {
		margin: 0 0 0.55rem;
		font-size: 0.94rem;
		line-height: 1.5;
		opacity: 0.9;
		max-width: 52ch;
	}

	.how-text-link {
		display: inline-block;
		font-size: 0.9rem;
		font-weight: 600;
		color: #f5b041;
		text-decoration: none;
		border-bottom: 1px solid rgba(245, 176, 65, 0.45);
		padding-bottom: 0.06rem;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.how-text-link:hover {
		color: #f7c050;
		border-color: rgba(247, 192, 80, 0.75);
	}

	.how-embed {
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		width: 100%;
	}

	.how-embed--chrome {
		background: var(--theme-embed-chrome);
		border: 1px solid var(--theme-embed-chrome-border);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), var(--theme-surface-elevated-shadow);
	}

	.how-embed iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
	}

	.how-curated__stack {
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.how-curated-card {
		padding-bottom: 0.15rem;
	}

	.how-deep {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.35rem 0.5rem;
		font-size: 0.88rem;
		opacity: 0.88;
		padding: 0.75rem 0 1.5rem;
	}

	.how-deep a {
		color: rgba(244, 246, 248, 0.92);
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-color: rgba(245, 176, 65, 0.35);
	}

	.how-deep a:hover {
		color: #f5b041;
		text-decoration-color: #f5b041;
	}

	.how-deep__sep {
		opacity: 0.45;
		user-select: none;
	}
</style>
