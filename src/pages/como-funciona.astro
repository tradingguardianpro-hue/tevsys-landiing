			radial-gradient(ellipse 118% 82% at 50% 105%, rgba(200, 145, 55, 0.025) 0%, transparent 42%);
		box-shadow: inset 0 0 clamp(2.5rem, 9vw, 5rem) rgba(0, 0, 0, 0.07);
	}

	@media (prefers-reduced-motion: no-preference) {
		html[data-theme='dark'] .how-more__sweep {
			inset: auto;
			top: -28%;
			bottom: -28%;
			left: -22%;
			right: -22%;
			width: auto;
			height: auto;
			background-image: linear-gradient(
				180deg,
				transparent 0%,
				transparent 30%,
				rgba(110, 114, 128, 0.14) 40%,
				rgba(186, 190, 202, 0.26) 50%,
				rgba(95, 98, 110, 0.13) 60%,
				transparent 72%,
				transparent 100%
			);
			background-size: 100% 480%;
			background-position: 50% 5%;
			background-repeat: no-repeat;
			opacity: 0.58;
			will-change: background-position;
			animation: how-zero-protected-sweep-vertical 44s ease-in-out infinite;
		}

		html[data-theme='light'] .how-more__sweep {
			inset: auto;
			top: -24%;
			bottom: -24%;
			left: -18%;
			right: -18%;
			width: auto;
			height: auto;
			background-image: linear-gradient(
				180deg,
				transparent 0%,
				transparent 32%,
				rgba(88, 92, 104, 0.08) 42%,
				rgba(148, 152, 166, 0.14) 50%,
				rgba(78, 82, 94, 0.07) 58%,
				transparent 70%,
				transparent 100%
			);
			background-size: 100% 440%;
			background-position: 50% 8%;
			background-repeat: no-repeat;
			opacity: 0.38;
			will-change: background-position;
			animation: how-zero-protected-sweep-vertical 50s ease-in-out infinite;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.how-more__sweep {
			animation: none !important;
			opacity: 0.1;
		}

		html[data-theme='light'] .how-more__sweep {
			opacity: 0.05;
		}
