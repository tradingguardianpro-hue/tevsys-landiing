---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Cómo funciona tevsys | tevsys',
	description:
		'Presentación en dos partes, capas del producto (SML, HyperClose, precisión, observación pasiva), vídeo de configuración e instalación.',
};

/** Parte 1 + Parte 2 (artículo MQL5 / mismo relato). Sustituir embeds cuando publiquéis el corte nuevo “producto al día”. */
const presentationParts = [
	{
		partLabel: 'Parte 1',
		title: 'Presentación en el gráfico (~3:00)',
		blurb: 'Onboarding, panel y hints. Sin señales.',
		embed: 'https://www.youtube-nocookie.com/embed/Kz21Hm_ukZ0',
		href: 'https://youtu.be/Kz21Hm_ukZ0',
	},
	{
		partLabel: 'Parte 2',
		title: 'Cierre al límite y evidencia MT5 (~2:22)',
		blurb: 'Límite configurado por ti, cierre y contraste en terminal.',
		embed: 'https://www.youtube-nocookie.com/embed/QU1hC6SKg10',
		href: 'https://youtu.be/QU1hC6SKg10',
	},
];

/** Otros cortes (no duplicar Parte 1 / Parte 2). */
/** Tras el par de presentación: mismas ganas de clic, otras piezas (ampliar cuando tengáis vídeo/micro). */
const depthLayers: { title: string; blurb: string; href: string; cta: string }[] = [
	{
		title: 'Modo observación pasiva',
		blurb: 'Si ya hay posiciones, no “inventamos” el día: medimos desde el bloqueo con trazas claras.',
		href: '/features/evidencia',
		cta: 'Ver evidencia',
	},
	{
		title: 'Smart Money Lock (SML)',
		blurb: 'Capa extra de riesgo/recompensa: porcentaje, estado y consecuencias visibles.',
		href: '/features/sml',
		cta: 'Ver SML',
	},
	{
		title: 'HyperClose',
		blurb: 'Intento con límite tocado: cierre duro y registro que no depende de discursos.',
		href: '/features/hyperclose',
		cta: 'Ver HyperClose',
	},
	{
		title: 'Precisión milimétrica',
		blurb: 'Operativas documentadas: límite vs cierre, con error en porcentaje.',
		href: '/features/precision',
		cta: 'Ver precisión',
	},
	{
		title: 'Más casos en vídeo',
		blurb: 'Lista curada: presentación, índices, volatilidad, cuenta grande…',
		href: '/videos-cierre-youtube',
		cta: 'Abrir lista',
	},
	{
		title: 'Auditoría (pack + ID)',
		blurb: 'Cuando toque validar contigo: archivos locales, ID y criterio sin humo.',
		href: '/auditoria-ia/empezar',
		cta: 'Ir a auditoría',
	},
];

const curatedVideos: {
	title: string;
	blurb: string;
	embed: string;
	href: string;
	cta: string;
	external?: boolean;
}[] = [
	{
		title: 'Configuración esencial (Essential)',
		blurb: 'Límites, panel y primer uso tras instalar la demo.',
		embed: 'https://drive.google.com/file/d/1fzSxwhZK2DC9SgUQhXeFf8WyTBeMecTg/preview',
		href: '/configuracion',
		cta: 'Guía paso a paso',
	},
];
---

<Layout seo={seo}>
	<Container>
		<section class="how-hero how-hero--tight" aria-labelledby="how-hero-title">
			<h1 id="how-hero-title">Cómo funciona <span class="how-accent">tevsys</span></h1>
		</section>

		<section class="how-presentation" aria-labelledby="how-presentation-title">
			<header class="how-section-head">
				<p class="how-eyebrow how-eyebrow--center">Presentación</p>
				<h2 id="how-presentation-title">Dos partes, misma historia</h2>
				<p class="how-section-sub">
					Te enseñamos el producto en marcha y por qué la gente habla de precisión y evidencia.
					<br />
					<span class="how-section-sub__line2">Contrasta tú mismo.</span>
				</p>
			</header>
			<div class="how-pair-grid">
				{
					presentationParts.map((p, i) => (
						<article class="how-pair-cell">
							<header class="how-block-head how-block-head--compact">
								<p class="how-eyebrow">{p.partLabel}</p>
								<h3>{p.title}</h3>
								<p class="how-block-lead">{p.blurb}</p>
								<a href={p.href} class="how-text-link" target="_blank" rel="noopener noreferrer">
									Abrir en YouTube →
								</a>
							</header>
							<div class="how-embed how-embed--chrome">
								<iframe
									src={p.embed}
									title={p.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading={i === 0 ? 'eager' : 'lazy'}
									referrerpolicy="strict-origin-when-cross-origin"
								></iframe>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="how-depth" aria-labelledby="how-depth-title">
			<header class="how-section-head how-depth__head">
				<p class="how-eyebrow how-eyebrow--center">Capas del producto</p>
				<h2 id="how-depth-title">Varias capas, misma exigencia</h2>
				<p class="how-section-sub">
					Lo de arriba era el trailer en dos cortes. Aquí entra lo que suele disparar preguntas fuertes.
					<br />
					<span class="how-section-sub__line2">Un clic, una idea. Tú marcas el ritmo.</span>
				</p>
			</header>
			<div class="how-depth-grid">
				{
					depthLayers.map((item) => (
						<a href={item.href} class="how-depth-card">
							<h3 class="how-depth-card__title">{item.title}</h3>
							<p class="how-depth-card__blurb">{item.blurb}</p>
							<span class="how-depth-card__cta">{item.cta} →</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="how-curated" aria-labelledby="curated-title">
			<header class="how-section-head">
				<h2 id="curated-title">Más en vídeo</h2>
				<p class="how-section-sub">Un corte extra: configuración esencial en pantalla.</p>
			</header>
			<div class="how-curated__stack">
				{
					curatedVideos.map((v) => (
						<article class="how-curated-card">
							<header class="how-block-head how-block-head--compact">
								<h3>{v.title}</h3>
								<p class="how-block-lead">{v.blurb}</p>
								<a
									href={v.href}
									class="how-text-link"
									target={v.external ? '_blank' : undefined}
									rel={v.external ? 'noopener noreferrer' : undefined}>{v.cta} →</a>
							</header>
							<div class="how-embed how-embed--chrome">
								<iframe
									src={v.embed}
									title={v.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								></iframe>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="how-side" aria-labelledby="how-side-title">
			<h2 id="how-side-title">Instalación y guías</h2>
			<p class="how-side__intro">Mismo enlace que en el pie: un clic y van al <strong>vídeo único</strong> de instalación.</p>
			<div class="how-side__grid">
				<article class="how-side-card">
					<p class="how-eyebrow">Paso 0</p>
					<h3>Cómo instalar en MT5</h3>
					<p class="how-side-card__p">Descarga, permisos y carga del EA. Reproductor en la guía oficial (la misma URL que el footer).</p>
					<a href="/instalacion#instalacion-video" class="how-side-cta">Abrir instalación con vídeo →</a>
				</article>
				<article class="how-side-card">
					<p class="how-eyebrow">Después del gráfico</p>
					<h3>Configuración esencial y avanzada</h3>
					<p class="how-side-card__p">
						<strong>Esencial:</strong> límites y primer uso en vídeo corto.
						<strong>Avanzado:</strong> seguimos ampliando la guía de entradas en MT5; de momento el puente está en el paso 2 de instalación.
					</p>
					<div class="how-side-actions">
						<a href="/configuracion" class="how-side-cta">Guía esencial (vídeo) →</a>
						<a href="/instalacion#configuracion" class="how-side-cta how-side-cta--ghost">Paso 2 · instalación →</a>
					</div>
				</article>
			</div>
		</section>

		<nav class="how-deep" aria-label="Ir a más detalle">
			<a href="/instalacion#instalacion-video">Instalación</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/configuracion">Configuración</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/videos-cierre-youtube">Todos los vídeos</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/features/evidencia">Evidencia</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/company/contact?flow=demo">Demo</a>
		</nav>
	</Container>
</Layout>

<style>
	.how-depth,
	.how-curated,
	.how-side,
	.how-deep {
		margin: var(--section-margin) auto;
	}

	.how-hero.how-hero--tight {
		margin: calc(var(--section-margin) * 0.65) auto clamp(2.5rem, 8vw, 4.75rem);
		text-align: center;
		max-width: 32rem;
	}

	.how-hero h1 {
		font-size: clamp(1.45rem, 3.8vw, 2.1rem);
		margin: 0;
		line-height: 1.22;
		letter-spacing: -0.02em;
	}

	.how-accent {
		color: #f5b041;
	}

	.how-presentation {
		max-width: min(56rem, 100%);
		margin: 0 auto var(--section-margin);
		padding: clamp(0.35rem, 1.5vw, 1rem) 0 0.5rem;
	}

	.how-section-head {
		text-align: center;
		max-width: 42rem;
		margin: 0 auto 1.1rem;
	}

	/* Mucho aire: H1 → bloque “Presentación” y “Contrasta tú mismo” → Parte 1 / 2 */
	.how-presentation .how-section-head {
		margin-bottom: clamp(3.5rem, 12vw, 6.25rem);
		padding-bottom: 0.35rem;
	}

	.how-section-head h2 {
		margin: 0 0 0.65rem;
		font-size: clamp(1.12rem, 2.4vw, 1.32rem);
		font-weight: 700;
		line-height: 1.28;
	}

	.how-section-sub {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.55;
		opacity: 0.84;
	}

	.how-section-sub__line2 {
		display: inline-block;
		margin-top: 0.55rem;
		margin-bottom: 0.15rem;
		font-weight: 600;
		opacity: 0.92;
		letter-spacing: 0.01em;
	}

	/* Empuja “segunda parte” bajo el pliegue: primero se ven solo presentación + 2 vídeos (p. ej. zoom ~75 %). */
	.how-depth {
		max-width: min(56rem, 100%);
		padding: 0 0 0.25rem;
		margin-top: clamp(7rem, 42vh, 46rem);
	}

	.how-depth__head {
		margin-bottom: 2rem;
	}

	.how-depth-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem 1rem;
	}

	.how-depth-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-height: 100%;
		padding: 1rem 1.05rem;
		box-sizing: border-box;
		background: var(--theme-surface-1);
		border: 1px solid var(--theme-surface-border);
		border-radius: var(--theme-shape-radius);
		box-shadow: var(--theme-surface-elevated-shadow);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}

	.how-depth-card:hover {
		border-color: rgba(245, 176, 65, 0.38);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
		transform: translateY(-2px);
	}

	.how-depth-card:focus-visible {
		outline: 2px solid rgba(245, 176, 65, 0.65);
		outline-offset: 3px;
	}

	.how-depth-card__title {
		margin: 0 0 0.4rem;
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.015em;
	}

	.how-depth-card__blurb {
		margin: 0 0 0.65rem;
		font-size: 0.82rem;
		line-height: 1.48;
		opacity: 0.88;
		flex: 1;
	}

	.how-depth-card__cta {
		font-size: 0.82rem;
		font-weight: 600;
		color: #f5b041;
	}

	.how-eyebrow {
		margin: 0 0 0.5rem;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		opacity: 0.65;
	}

	.how-eyebrow--center {
		text-align: center;
	}

	.how-pair-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
		align-items: start;
		padding-top: clamp(0.35rem, 2vw, 1.1rem);
	}

	.how-pair-cell {
		min-width: 0;
	}

	.how-block-head {
		margin-bottom: 0.75rem;
	}

	.how-block-head--compact {
		margin-bottom: 0.65rem;
	}

	.how-pair-cell .how-block-head--compact {
		margin-bottom: 0;
	}

	.how-pair-cell .how-block-head--compact .how-eyebrow {
		margin-bottom: 0.55rem;
	}

	.how-pair-cell .how-block-head--compact h3 {
		margin-bottom: 0.5rem;
	}

	.how-pair-cell .how-block-head--compact .how-block-lead {
		margin-bottom: 0.6rem;
	}

	.how-pair-cell .how-text-link {
		margin-bottom: 1rem;
	}

	.how-block-head h3 {
		margin: 0 0 0.35rem;
		font-size: clamp(1.02rem, 2vw, 1.15rem);
		line-height: 1.28;
		font-weight: 600;
	}

	.how-block-lead {
		margin: 0 0 0.45rem;
		font-size: 0.88rem;
		line-height: 1.45;
		opacity: 0.88;
		max-width: 42ch;
	}

	.how-text-link {
		display: inline-block;
		font-size: 0.88rem;
		font-weight: 600;
		color: #f5b041;
		text-decoration: none;
		border-bottom: 1px solid rgba(245, 176, 65, 0.45);
		padding-bottom: 0.06rem;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.how-text-link:hover {
		color: #f7c050;
		border-color: rgba(247, 192, 80, 0.75);
	}

	.how-embed {
		border-radius: var(--theme-shape-radius);
		overflow: hidden;
		width: 100%;
	}

	.how-embed--chrome {
		background: var(--theme-embed-chrome);
		border: 1px solid var(--theme-embed-chrome-border);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), var(--theme-surface-elevated-shadow);
	}

	.how-embed iframe {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
	}

	.how-curated-card {
		max-width: min(56rem, 100%);
		margin-left: auto;
		margin-right: auto;
		padding-bottom: 0.15rem;
	}

	.how-curated__stack {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.how-side {
		max-width: min(56rem, 100%);
		margin-left: auto;
		margin-right: auto;
	}

	.how-side h2 {
		margin: 0 0 0.45rem;
		font-size: clamp(1.12rem, 2.3vw, 1.32rem);
		text-align: center;
	}

	.how-side__intro {
		margin: 0 0 1.1rem;
		text-align: center;
		font-size: 0.92rem;
		line-height: 1.45;
		opacity: 0.88;
		max-width: 40rem;
		margin-left: auto;
		margin-right: auto;
	}

	.how-side__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.how-side-card {
		background: var(--theme-surface-1);
		border: 1px solid var(--theme-surface-border);
		border-radius: var(--theme-shape-radius);
		padding: 1.05rem 1.1rem;
		box-shadow: var(--theme-surface-elevated-shadow);
	}

	.how-side-card h3 {
		margin: 0 0 0.45rem;
		font-size: 1.05rem;
		line-height: 1.25;
	}

	.how-side-card__p {
		margin: 0 0 0.85rem;
		font-size: 0.9rem;
		line-height: 1.48;
		opacity: 0.9;
	}

	.how-side-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.65rem;
	}

	.how-side-cta {
		display: inline-flex;
		align-items: center;
		font-size: 0.88rem;
		font-weight: 600;
		color: #0b0d12;
		background: #f5b041;
		text-decoration: none;
		padding: 0.45rem 0.85rem;
		border-radius: 999px;
		border: 1px solid rgba(245, 176, 65, 0.55);
		transition: background 0.15s ease, transform 0.15s ease;
	}

	.how-side-cta:hover {
		background: #f7c050;
		transform: translateY(-1px);
	}

	.how-side-cta--ghost {
		background: rgba(255, 255, 255, 0.06);
		color: rgba(244, 246, 248, 0.95);
		border-color: rgba(255, 255, 255, 0.22);
	}

	.how-side-cta--ghost:hover {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
	}

	.how-deep {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.35rem 0.5rem;
		font-size: 0.88rem;
		opacity: 0.88;
		padding: 0.75rem 0 1.5rem;
	}

	.how-deep a {
		color: rgba(244, 246, 248, 0.92);
		text-decoration: underline;
		text-underline-offset: 0.18em;
		text-decoration-color: rgba(245, 176, 65, 0.35);
	}

	.how-deep a:hover {
		color: #f5b041;
		text-decoration-color: #f5b041;
	}

	.how-deep__sep {
		opacity: 0.45;
		user-select: none;
	}

	@media (max-width: 900px) {
		.how-pair-grid,
		.how-side__grid {
			grid-template-columns: 1fr;
		}
		.how-depth-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (min-width: 601px) and (max-width: 900px) {
		.how-depth-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
