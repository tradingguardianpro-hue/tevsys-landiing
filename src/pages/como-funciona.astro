---
import { Container } from '@components/odyssey-theme';
import Layout from '../layouts/Page.astro';

const seo = {
	title: 'Cómo funciona tevsys | tevsys',
	description:
		'Presentación, De cero a protegido, comportamientos en vivo, cortos y micros; más vídeo, instalación y guías.',
};

/** Parte 1 + Parte 2 (artículo MQL5 / mismo relato). Sustituir embeds cuando publiquéis el corte nuevo “producto al día”. */
const presentationParts = [
	{
		partLabel: 'Parte 1',
		title: 'Presentación en el gráfico (~3:00)',
		blurb: 'Onboarding, panel y hints. Sin señales.',
		embed: 'https://www.youtube-nocookie.com/embed/Kz21Hm_ukZ0',
		href: 'https://youtu.be/Kz21Hm_ukZ0',
	},
	{
		partLabel: 'Parte 2',
		title: 'Cierre al límite y evidencia MT5 (~2:22)',
		blurb: 'Límite configurado por ti, cierre y contraste en terminal.',
		embed: 'https://www.youtube-nocookie.com/embed/QU1hC6SKg10',
		href: 'https://youtu.be/QU1hC6SKg10',
	},
];

/** Recorrido largo en un solo vídeo: dejar `embedUrl` vacío hasta tener URL YouTube (nocookie/embed). Opcional `watchHref` para “Abrir en YouTube”. */
const zeroToProtected = {
	title: 'De cero a protegido',
	durationLabel: '~X min',
	blurb: 'Instalación paso a paso + panel (compacto / expandido) + configuración hasta quedar protegido.',
	embedUrl: '',
	watchHref: '',
};

/** Cuatro “puertas” tras la presentación: orden ver → comprobar → riesgo avanzado → trazabilidad (lista YouTube y demo en bloques inferiores + nav). */
const depthLayers: { title: string; blurb: string; href: string; cta: string }[] = [
	{
		title: 'HyperClose — bloqueo bajo presión',
		blurb: 'Límite tocado, intento de operar con bloqueo, semáforos y registro en vivo: sin discursos, con lo que pasa en el gráfico.',
		href: '/features/hyperclose',
		cta: 'Ver HyperClose',
	},
	{
		title: 'Evidencia en MT5 — ver y comprobar',
		blurb: 'Informes, HTML y trazas; observación pasiva si ya hay posiciones. La precisión milimétrica documentada está en su micro dedicada.',
		href: '/features/evidencia',
		cta: 'Ver evidencia',
	},
	{
		title: 'Smart Money Lock (SML)',
		blurb: 'Capa extra de riesgo/recompensa: porcentaje, estado en panel y consecuencias visibles.',
		href: '/features/sml',
		cta: 'Ver SML',
	},
	{
		title: 'Auditoría — pack e ID',
		blurb: 'Preparar archivos en tu equipo, comprobar en el navegador y seguir el criterio público: sin prometer recepción en servidor hasta que sea cierto.',
		href: '/auditoria-ia/empezar',
		cta: 'Preparar o empezar',
	},
];

/** Tercer bloque: `videoCorto` (embed + hint), `tarjetaMicro` (imagen opcional + CTA), `tarjetaDoble` (micro + clip; reservado). Añadir o quitar entradas sin rediseñar la página. */
type MoreBehaviorItem =
	| {
			kind: 'videoCorto';
			title: string;
			playHint: string;
			embedUrl: string;
			watchHref?: string;
	  }
	| {
			kind: 'tarjetaMicro';
			title: string;
			line1: string;
			line2: string;
			href: string;
			cta: string;
			imgSrc?: string;
			imgAlt?: string;
	  }
	| {
			kind: 'tarjetaDoble';
			title: string;
			blurb: string;
			hrefMicro: string;
			ctaMicro: string;
			thumbSrc?: string;
			thumbAlt?: string;
			watchHref?: string;
			ctaClip?: string;
	  };

const moreBehaviorsItems: MoreBehaviorItem[] = [
	{
		kind: 'tarjetaMicro',
		title: 'Días OFF ↔ día operativo',
		line1: 'Cómo se ve la cuenta cuando el calendario marca OFF frente a un día con protección lista para operar.',
		line2: 'Capturas y vídeo en la micro de HyperClose (bloque dedicado a día OFF).',
		href: '/features/hyperclose#hyperclose-off',
		cta: 'Ver día OFF en HyperClose',
		imgSrc: '/images/evidence/hyperclose-dias-off-panel-protegido.png',
		imgAlt: 'Panel tevsys con día OFF y límites bloqueados.',
	},
	{
		kind: 'tarjetaMicro',
		title: 'Observación pasiva',
		line1: 'Si ya hay posiciones abiertas, el sistema no “inventa” el día: mide desde el bloqueo con trazas claras.',
		line2: 'Informes, HTML y galería en la micro de evidencia.',
		href: '/features/evidencia',
		cta: 'Ver evidencia',
	},
	{
		kind: 'videoCorto',
		title: 'Inputs con EA vigilando (~25–30 s)',
		playHint: 'Qué pasa si tocas F7 con límites bloqueados: modal y aviso en el panel, en segundos.',
		embedUrl: '',
		watchHref: '',
	},
];

const curatedVideos: {
	title: string;
	blurb: string;
	embed: string;
	href: string;
	cta: string;
	external?: boolean;
}[] = [
	{
		title: 'Configuración esencial (Essential)',
		blurb: 'Límites, panel y primer uso tras instalar la demo.',
		embed: 'https://drive.google.com/file/d/1fzSxwhZK2DC9SgUQhXeFf8WyTBeMecTg/preview',
		href: '/configuracion',
		cta: 'Guía paso a paso',
	},
];
---

<Layout seo={seo}>
	<Container>
		<section class="how-hero how-hero--tight" aria-labelledby="how-hero-title">
			<h1 id="how-hero-title">Cómo funciona <span class="how-accent">tevsys</span></h1>
		</section>

		<section class="how-presentation" aria-labelledby="how-presentation-title">
			<header class="how-section-head">
				<p class="how-eyebrow how-eyebrow--center">Presentación</p>
				<h2 id="how-presentation-title">Dos partes, misma historia</h2>
				<p class="how-section-sub">
					Te enseñamos el producto en marcha y por qué la gente habla de precisión y evidencia.
					<br />
					<span class="how-section-sub__line2">Contrasta tú mismo.</span>
				</p>
			</header>
			<div class="how-pair-grid">
				{
					presentationParts.map((p, i) => (
						<article class="how-pair-cell">
							<header class="how-block-head how-block-head--compact">
								<p class="how-eyebrow">{p.partLabel}</p>
								<h3>{p.title}</h3>
								<p class="how-block-lead">{p.blurb}</p>
								<a href={p.href} class="how-text-link" target="_blank" rel="noopener noreferrer">
									Abrir en YouTube →
								</a>
							</header>
							<div class="how-embed how-embed--chrome">
								<iframe
									src={p.embed}
									title={p.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading={i === 0 ? 'eager' : 'lazy'}
									referrerpolicy="strict-origin-when-cross-origin"
								></iframe>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="how-zero-protected" id="de-cero-a-protegido" aria-labelledby="how-zero-title">
			<header class="how-section-head">
				<p class="how-eyebrow how-eyebrow--center">De la teoría a la pantalla</p>
				<h2 id="how-zero-title">
					{zeroToProtected.title}
					<span class="how-zero-duration">({zeroToProtected.durationLabel})</span>
				</h2>
				<p class="how-section-sub">{zeroToProtected.blurb}</p>
			</header>
			<div class="how-zero-protected__frame">
				{
					zeroToProtected.embedUrl ? (
						<>
							<div class="how-embed how-embed--chrome">
								<iframe
									src={zeroToProtected.embedUrl}
									title={zeroToProtected.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"></iframe>
							</div>
							{zeroToProtected.watchHref ? (
								<p class="how-zero-watch">
									<a
										href={zeroToProtected.watchHref}
										class="how-text-link"
										target="_blank"
										rel="noopener noreferrer">
										Abrir en YouTube →
									</a>
								</p>
							) : null}
						</>
					) : (
						<div class="how-embed how-embed--chrome how-embed-placeholder" role="status" aria-live="polite">
							<p class="how-embed-placeholder__title">Vídeo en preparación</p>
							<p class="how-embed-placeholder__sub">
								Pronto verás aquí el recorrido completo. Mientras, las dos partes de arriba y la instalación más abajo cubren el arranque.
							</p>
						</div>
					)
				}
			</div>
		</section>

		<section class="how-depth" aria-labelledby="how-depth-title">
			<header class="how-section-head how-depth__head">
				<p class="how-eyebrow how-eyebrow--center">De la teoría a la pantalla</p>
				<h2 id="how-depth-title">Así funciona en vivo</h2>
				<p class="how-section-sub">
					Has visto el panel por dentro y un cierre real. Cuatro enlaces directos: lo que suele importar en vivo, sin dispersarte.
					<br />
					<span class="how-section-sub__line2">Lista completa de vídeos y demo: abajo y en el pie de página.</span>
				</p>
			</header>
			<div class="how-depth-grid">
				{
					depthLayers.map((item) => (
						<a href={item.href} class="how-depth-card">
							<h3 class="how-depth-card__title">{item.title}</h3>
							<p class="how-depth-card__blurb">{item.blurb}</p>
							<span class="how-depth-card__cta">{item.cta} →</span>
						</a>
					))
				}
			</div>
		</section>

		<section class="how-more" id="mas-comportamientos" aria-labelledby="how-more-title">
			<header class="how-section-head how-more__head">
				<p class="how-eyebrow how-eyebrow--center">Siguiente nivel</p>
				<h2 id="how-more-title">Esto no es todo: más comportamientos en vivo</h2>
				<p class="how-section-sub">
					Tras lo esencial, el día a día suma matices: de un <strong>día OFF</strong> a un <strong>día operativo</strong> (y al
					revés), <strong>observación pasiva</strong> cuando ya hay posiciones, y <strong>qué pasa si tocáis inputs</strong> con
					el EA vigilando. Aquí van cortes breves (~25–30 s) y enlaces a las micros donde lo profundizamos.
				</p>
			</header>
			<div class="how-more-grid">
				{
					moreBehaviorsItems.map((item) =>
						item.kind === 'tarjetaMicro' ? (
							<a href={item.href} class="how-more-card how-more-card--micro">
								{item.imgSrc ? (
									<div class="how-more-card__media">
										<img src={item.imgSrc} alt={item.imgAlt ?? ''} width={640} height={360} loading="lazy" decoding="async" />
									</div>
								) : null}
								<div class="how-more-card__body">
									<h3 class="how-more-card__title">{item.title}</h3>
									<p class="how-more-card__line">{item.line1}</p>
									<p class="how-more-card__line how-more-card__line--muted">{item.line2}</p>
									<span class="how-more-card__cta">{item.cta} →</span>
								</div>
							</a>
						) : item.kind === 'videoCorto' ? (
							<article class="how-more-cell how-more-cell--video">
								<header class="how-block-head how-block-head--compact">
									<h3 class="how-more-card__title">{item.title}</h3>
									<p class="how-block-lead">{item.playHint}</p>
									{item.watchHref ? (
										<a href={item.watchHref} class="how-text-link" target="_blank" rel="noopener noreferrer">
											Abrir en YouTube →
										</a>
									) : null}
								</header>
								{item.embedUrl ? (
									<div class="how-embed how-embed--chrome how-more-embed">
										<iframe
											src={item.embedUrl}
											title={item.title}
											allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
											allowfullscreen
											loading="lazy"
											referrerpolicy="strict-origin-when-cross-origin"></iframe>
									</div>
								) : (
									<div class="how-embed how-embed--chrome how-embed-placeholder how-more-embed" role="status">
										<p class="how-embed-placeholder__title">Clip en preparación</p>
										<p class="how-embed-placeholder__sub">Aquí irá el corte de ~25–30 s cuando lo tengáis listo para publicar.</p>
									</div>
								)}
							</article>
						) : item.kind === 'tarjetaDoble' ? (
							<article class="how-more-card how-more-card--doble">
								<h3 class="how-more-card__title">{item.title}</h3>
								<p class="how-more-card__line">{item.blurb}</p>
								<div class="how-more-doble__actions">
									<a href={item.hrefMicro} class="how-text-link">
										{item.ctaMicro} →
									</a>
									{item.watchHref && item.ctaClip ? (
										<a href={item.watchHref} class="how-text-link" target="_blank" rel="noopener noreferrer">
											{item.ctaClip} →
										</a>
									) : null}
								</div>
							</article>
						) : null,
					)
				}
			</div>
		</section>

		<section class="how-curated" aria-labelledby="curated-title">
			<header class="how-section-head">
				<h2 id="curated-title">Más en vídeo</h2>
				<p class="how-section-sub">
					Cortes curados, alineados con lo que el producto muestra hoy. Para más contexto:
					<a href="/videos-cierre-youtube" class="how-inline-link">todos los vídeos en YouTube →</a>
				</p>
			</header>
			<div class="how-curated__stack">
				{
					curatedVideos.map((v) => (
						<article class="how-curated-card">
							<header class="how-block-head how-block-head--compact">
								<h3>{v.title}</h3>
								<p class="how-block-lead">{v.blurb}</p>
								<a
									href={v.href}
									class="how-text-link"
									target={v.external ? '_blank' : undefined}
									rel={v.external ? 'noopener noreferrer' : undefined}>{v.cta} →</a>
							</header>
							<div class="how-embed how-embed--chrome">
								<iframe
									src={v.embed}
									title={v.title}
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
									loading="lazy"
									referrerpolicy="strict-origin-when-cross-origin"
								></iframe>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<section class="how-side" aria-labelledby="how-side-title">
			<h2 id="how-side-title">Instalación y guías</h2>
			<p class="how-side__intro">Mismo enlace que en el pie: un clic y van al <strong>vídeo único</strong> de instalación.</p>
			<p class="how-side__note">
				El recorrido largo <a href="#de-cero-a-protegido" class="how-inline-link">De cero a protegido</a> vive más arriba en esta misma página; cuando haya vídeo, se verá en ese bloque.
			</p>
			<div class="how-side__grid">
				<article class="how-side-card">
					<p class="how-eyebrow">Paso 0</p>
					<h3>Cómo instalar en MT5</h3>
					<p class="how-side-card__p">Descarga, permisos y carga del EA. Reproductor en la guía oficial (la misma URL que el footer).</p>
					<a href="/instalacion#instalacion-video" class="how-side-cta">Abrir instalación con vídeo →</a>
				</article>
				<article class="how-side-card">
					<p class="how-eyebrow">Después del gráfico</p>
					<h3>Configuración esencial y avanzada</h3>
					<p class="how-side-card__p">
						<strong>Esencial:</strong> límites y primer uso en vídeo corto.
						<strong>Avanzado:</strong> seguimos ampliando la guía de entradas en MT5; de momento el puente está en el paso 2 de instalación.
					</p>
					<div class="how-side-actions">
						<a href="/configuracion" class="how-side-cta">Guía esencial (vídeo) →</a>
						<a href="/instalacion#configuracion" class="how-side-cta how-side-cta--ghost">Paso 2 · instalación →</a>
					</div>
				</article>
			</div>
		</section>

		<nav class="how-deep" aria-label="Ir a más detalle">
			<a href="/instalacion#instalacion-video">Instalación</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/configuracion">Configuración</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/videos-cierre-youtube">Todos los vídeos</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/features/evidencia">Evidencia</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/features/precision">Precisión</a>
			<span class="how-deep__sep" aria-hidden="true">·</span>
			<a href="/company/contact?flow=demo">Demo</a>
		</nav>
	</Container>
</Layout>

<style>
	.how-depth,
	.how-more,
	.how-curated,
	.how-side,
	.how-deep {
		margin: clamp(2.85rem, 8vw, 5.25rem) auto;
	}

	.how-hero.how-hero--tight {
		margin: calc(var(--section-margin) * 0.65) auto clamp(2.5rem, 8vw, 4.75rem);
		text-align: center;
		max-width: 32rem;
	}

	.how-hero h1 {
		margin: 0;
		/* Solo esta página: un poco más de presencia que el titular compacto por defecto. */
		font-size: clamp(1.68rem, 3.85vw, 2.38rem);
		line-height: 1.22;
	}

	.how-accent {
		color: #f5b041;
	}

	.how-presentation {
		max-width: min(56rem, 100%);
		margin: 0 auto clamp(3.5rem, 12vh, 7rem);
		padding: clamp(0.35rem, 1.5vw, 1rem) 0 clamp(2rem, 6vw, 4rem);
	}

	.how-zero-protected {
		max-width: min(56rem, 100%);
		margin: clamp(3.75rem, 16vh, 9.5rem) auto clamp(4.25rem, 18vh, 11rem);
		padding: clamp(1rem, 4vw, 2.25rem) 0 clamp(1.25rem, 4vw, 2rem);
	}

	.how-zero-protected .how-section-head {
		margin-bottom: clamp(1.75rem, 5vw, 2.75rem);
	}

	.how-zero-duration {
		font-weight: 600;
		font-size: 0.72em;
		color: rgba(244, 246, 248, 0.72);
		letter-spacing: 0.02em;
	}

	.how-zero-protected__frame {
		max-width: min(42rem, 100%);
		margin: 0 auto;
	}

	.how-zero-watch {
		margin: 0.65rem 0 0;
		text-align: center;
	}

	.how-embed-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		aspect-ratio: 16 / 9;
		padding: clamp(1rem, 4vw, 2rem);
		box-sizing: border-box;
		text-align: center;
		background: rgba(0, 0, 0, 0.2);
	}

	.how-embed-placeholder__title {
		margin: 0;
		font-size: clamp(1rem, 2.2vw, 1.15rem);
		font-weight: 700;
		color: rgba(244, 246, 248, 0.92);
	}

	.how-embed-placeholder__sub {
		margin: 0;
		max-width: 32ch;
		font-size: 0.94rem;
		line-height: 1.5;
		opacity: 0.82;
	}

	.how-section-head {
		text-align: center;
		max-width: 42rem;
		margin: 0 auto 1.1rem;
	}

	/* Mucho aire: H1 → bloque “Presentación” y “Contrasta tú mismo” → Parte 1 / 2 */
	.how-presentation .how-section-head {
		margin-bottom: clamp(4rem, 14vw, 7.25rem);
		padding-bottom: 0.35rem;
	}

	.how-section-head h2 {
		margin: 0 0 0.65rem;
		font-size: clamp(1.18rem, 2.55vw, 1.4rem);
		font-weight: 700;
		line-height: 1.28;
	}

	.how-section-sub {
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.55;
		opacity: 0.84;
	}

	.how-section-sub__line2 {
		display: inline-block;
		margin-top: 0.55rem;
		margin-bottom: 0.15rem;
		font-weight: 600;
		opacity: 0.92;
		letter-spacing: 0.01em;
	}

	/* Separación fuerte respecto a «De cero a protegido»: más scroll, más aire. */
	.how-depth {
		max-width: min(56rem, 100%);
		padding: clamp(0.5rem, 2vw, 1.25rem) 0 0.35rem;
		margin-top: clamp(5.25rem, 26vh, 34rem);
	}

	.how-depth__head {
		margin-bottom: clamp(2.25rem, 6vw, 3.25rem);
	}

	.how-depth-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(1.35rem, 3.5vw, 2rem) clamp(1.25rem, 3vw, 1.65rem);
	}

	.how-depth-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-height: 100%;
		padding: clamp(1.15rem, 3vw, 1.35rem) clamp(1.1rem, 2.8vw, 1.3rem);
		box-sizing: border-box;
		background: var(--theme-surface-1);
		border: 1px solid var(--theme-surface-border);
		border-radius: var(--theme-shape-radius);
		box-shadow: var(--theme-surface-elevated-shadow);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease,
			transform 0.18s ease;
	}

	.how-depth-card:hover {
		border-color: rgba(245, 176, 65, 0.38);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
		transform: translateY(-2px);
	}

	.how-depth-card:focus-visible {
