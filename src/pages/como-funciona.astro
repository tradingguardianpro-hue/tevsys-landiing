	/* “Siguiente nivel”: mismo fondo + mismo barrido vertical que «De cero a protegido» (valores alineados). */
	.how-more.how-more--stage {
		position: relative;
		overflow: hidden;
		border-radius: clamp(0.5rem, 1.2vw, 0.875rem);
		margin: clamp(2.25rem, 8vh, 5rem) auto clamp(2.5rem, 9vh, 5.5rem);
		padding: clamp(1rem, 4vw, 2rem) clamp(0.75rem, 2.5vw, 1rem) clamp(1.35rem, 4vw, 2.35rem);
		box-sizing: border-box;
	}

	.how-more__bg,
	.how-more__sweep {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		border-radius: inherit;
	}

	.how-more__inner {
		position: relative;
		z-index: 1;
