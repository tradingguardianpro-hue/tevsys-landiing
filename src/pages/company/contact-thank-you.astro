---
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const seo = {
	title: 'Solicitud recibida | tevsys',
	description: 'Hemos recibido tu solicitud. Te responderemos en menos de 24h.',
};
---

<Layout seo={seo}>
	<Container>
		<section class="contact-thank-you">
			<h1>Gracias por tu interés en tevsys</h1>
			<p id="thankYouMain">Hemos recibido tu solicitud. Te responderemos en menos de 24 horas con los pasos para acceder a la demo.</p>
			<p id="thankYouAccesoNote" class="contact-thank-you__acceso-note" hidden>Essential está listo; Advanced y Pro en desarrollo. Te indicaremos el siguiente paso según tu perfil.</p>
			<div id="thankYouDevNote" class="contact-thank-you__dev-block" hidden>
				<p class="contact-thank-you__dev-title">Te añadimos a la lista de espera.</p>
				<p class="contact-thank-you__dev-text">Mientras tanto, la demo disponible es Essential.</p>
			</div>
			<p class="contact-thank-you__note">Revisa tu bandeja de entrada (y la de spam, por si acaso).</p>
			<a href="/" class="contact-thank-you__link">Volver al inicio</a>
		</section>
		<script is:inline>
			(() => {
				const params = new URLSearchParams(window.location.search);
				const main = document.getElementById('thankYouMain');
				const accesoNote = document.getElementById('thankYouAccesoNote');
				const devBlock = document.getElementById('thankYouDevNote');
				const plan = (params.get('plan') || '').toLowerCase();
				const flow = params.get('flow') || '';

				if (flow === 'lista') {
					if (main) main.textContent = 'Te hemos añadido a la lista de espera.';
					if (devBlock) {
						const title = devBlock.querySelector('.contact-thank-you__dev-title');
						const text = devBlock.querySelector('.contact-thank-you__dev-text');
						if (title) title.textContent = 'Te avisaremos por email cuando Advanced y Pro estén disponibles.';
						if (text) text.textContent = 'Mientras tanto, la demo Essential está lista para probar.';
						devBlock.hidden = false;
					}
				} else if (plan === 'advanced' || plan === 'pro') {
					if (main) main.textContent = 'Hemos recibido tu solicitud. Te responderemos en menos de 24 horas.';
					if (devBlock) {
						const title = devBlock.querySelector('.contact-thank-you__dev-title');
						if (title) title.textContent = 'Te añadimos a la lista de espera de ' + (plan === 'advanced' ? 'Advanced' : 'Pro') + '.';
						devBlock.hidden = false;
					}
				} else if (flow === 'acceso') {
					if (main) main.textContent = 'Hemos recibido tu solicitud. Te responderemos en menos de 24 horas.';
					if (accesoNote) accesoNote.hidden = false;
				}
			})();
		</script>
	</Container>
</Layout>

<style>
	.contact-thank-you {
		min-height: 50vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		text-align: center;
		padding: 3rem 1rem;
	}
	.contact-thank-you h1 {
		margin-bottom: 1rem;
		font-size: 1.75rem;
	}
	.contact-thank-you p {
		margin-bottom: 0.75rem;
		max-width: 36ch;
	}
	.contact-thank-you__acceso-note {
		font-size: 0.95rem;
		opacity: 0.95;
		font-style: italic;
	}
	.contact-thank-you__dev-block {
		margin: 1.5rem 0;
		padding: 1.25rem 1.5rem;
		max-width: 36ch;
		border: 1px solid rgba(245, 176, 65, 0.4);
		border-radius: 0.5rem;
		background: rgba(245, 176, 65, 0.08);
	}
	.contact-thank-you__dev-title {
		font-weight: 600;
		margin-bottom: 0.35rem;
	}
	.contact-thank-you__dev-text {
		font-style: italic;
		opacity: 0.95;
		margin-bottom: 0;
	}
	.contact-thank-you__note {
		font-size: 0.95rem;
		opacity: 0.9;
	}
	.contact-thank-you__link {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.6rem 1.25rem;
		background: var(--theme-primary, #f5b041);
		color: var(--theme-on-primary, #0a0a0a);
		text-decoration: none;
		border-radius: 0.5rem;
		font-weight: 600;
	}
	.contact-thank-you__link:hover {
		opacity: 0.9;
	}
</style>
