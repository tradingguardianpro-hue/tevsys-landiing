---
import ContactForm from '../../components/forms/ContactForm.astro';
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const seo = {
	title: 'Contact | Astro Odyssey Theme',
	description: 'Contact Page',
};
const introText =
	'Completa el formulario y te indicamos el siguiente paso según tu perfil y el estado actual de cada plan.';
const tips = [
	'Essential: acceso demo/beta disponible.',
	'Advanced y Pro: en desarrollo (lista de espera).',
	'Solo datos clave para responderte rápido y con plan recomendado.',
];
---

<Layout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1 id="contactHeroTitle">Completa tu acceso a tevsys</h1>
				<p id="contactHeroIntro">{introText}</p>
				<ul class="contact-hero__tips">
					{tips.map((tip, idx) => <li id={`contactTip-${idx + 1}`}>{tip}</li>)}
				</ul>
				<div class="contact-hero__visual">
					<img id="contactHeroImage" src="/logo-tevsys.png" alt="Visual de tevsys" loading="lazy" />
				</div>
			</div>
			<div class="col-2__container">
				<ContactForm selectedPlan="" allowNoPlan={false} />
			</div>
		</section>
	</Container>
</Layout>

<script is:inline>
	(() => {
		const params = new URLSearchParams(window.location.search);
		const plan = (params.get('plan') || '').toLowerCase();
		const flow = (params.get('flow') || '').toLowerCase();

		const titleNode = document.getElementById('contactHeroTitle');
		const introNode = document.getElementById('contactHeroIntro');
		const imageNode = document.getElementById('contactHeroImage');
		const tip1 = document.getElementById('contactTip-1');
		const tip2 = document.getElementById('contactTip-2');
		const tip3 = document.getElementById('contactTip-3');

		const setTips = (a, b, c) => {
			if (tip1) tip1.textContent = a;
			if (tip2) tip2.textContent = b;
			if (tip3) tip3.textContent = c;
		};

		if (flow === 'demo') {
			if (titleNode) titleNode.textContent = 'Solicita tu demo de tevsys';
			if (introNode) {
				introNode.textContent =
					'Déjanos tus datos y te ayudamos a empezar rápido. La demo está pensada para validar encaje real con tu operativa, sin ruido ni complicaciones.';
			}
			setTips(
				'Demo orientada a validación real de tu operativa.',
				'Respuesta rápida con los siguientes pasos para activación.',
				'Proceso simple: solo pedimos datos clave.'
			);
			if (imageNode) {
				imageNode.src = '/logo-tevsys.png';
				imageNode.alt = 'Demo de tevsys';
			}
			return;
		}

		const planMap = {
			essential: {
				name: 'Essential',
				image: '/assets/images/plans/essential-form-v4.png',
				label: 'ESSENTIAL PROTECTION',
			},
			advanced: {
				name: 'Advanced',
				image: '/assets/images/plans/advanced-form-v4.png',
				label: 'ADVANCED PROTECTION',
			},
			pro: {
				name: 'Pro',
				image: '/assets/images/plans/pro-form-v4.png',
				label: 'PRO PROTECTION',
			},
		};

		const selected = planMap[plan];
		if (!selected) return;

		if (imageNode) {
			imageNode.src = selected.image;
			imageNode.alt = `Visual del plan ${selected.name}`;
		}
	})();
</script>

<style>
	.contact-hero__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: calc(90vh - var(--navbar-height));
		gap: 3rem;
	}
	.contact-hero__text-section {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.col-2__container {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.contact-hero__tips {
		padding-left: 1rem;
		margin-top: 0.5rem;
	}
	.contact-hero__tips li {
		margin-bottom: 0.35rem;
	}
	.contact-hero__visual {
		margin-top: 1rem;
		width: min(360px, 88%);
		border-radius: 0.85rem;
		overflow: hidden;
		background: #06080d;
		border: 1px solid rgba(245, 176, 65, 0.3);
	}
	.contact-hero__visual img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
		object-position: center;
	}
	@media (max-width: 768px) {
		.contact-hero__section {
			grid-template-columns: 1fr;
		}
		.contact-hero__visual {
			width: min(300px, 90%);
		}
	}
</style>
