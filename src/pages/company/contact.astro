---
import ContactForm from '../../components/forms/ContactForm.astro';
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const flowFromUrl = (Astro.url.searchParams.get('flow') || '').toLowerCase();
const allowNoPlan = flowFromUrl === 'acceso' || flowFromUrl === 'demo';

const seo = {
	title: 'Contact | Astro Odyssey Theme',
	description: 'Contact Page',
};
const introText =
	'Rellena el formulario y te indicamos el siguiente paso según tu perfil.';
const tips = [
	'Configuras una vez. tevsys ejecuta siempre. Incluso los días que tú decides estar OFF.',
	'Límite diario, precisión milimétrica y HyperClose incluidos.',
	'Respuesta en menos de 24h con los siguientes pasos.',
];
const empresasTipHtml = '<a href="/company/empresas" class="contact-tip__link">Empresas o contacto corporativo</a>';
---

<Layout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1 id="contactHeroTitle" class="contact-hero__title">Completa tu acceso a tevsys</h1>
				<p id="contactHeroIntro">{introText}</p>
				<ul class="contact-hero__tips">
					{tips.map((tip, idx) => <li id={`contactTip-${idx + 1}`}>{tip}</li>)}
					<li id="contactTip-4" set:html={empresasTipHtml} />
					<li id="contactTip-5" class="contact-tip-5" style="display: none;" />
				</ul>
				<div class="contact-hero__visual" id="contactHeroVisual">
					<span id="contactHeroDemoBadge" class="contact-hero__demo-badge" hidden>DEMO</span>
					<img id="contactHeroImage" src="/logo-tevsys.png" alt="Visual de tevsys" loading="lazy" />
				</div>
				<p id="contactHeroDevNote" class="contact-hero__dev-note" hidden></p>
			</div>
			<div class="col-2__container">
				<ContactForm selectedPlan="" allowNoPlan={allowNoPlan} />
			</div>
		</section>
	</Container>
</Layout>

<script is:inline>
	(() => {
		const params = new URLSearchParams(window.location.search);
		const plan = (params.get('plan') || '').toLowerCase();
		let flow = (params.get('flow') || '').toLowerCase();
		if (!flow && !plan && !params.get('feature')) {
			window.location.replace('/company/contact?flow=acceso');
			return;
		}
		const feature = (params.get('feature') || '').toLowerCase();
		const origin = (params.get('origin') || '').toLowerCase();

		const titleNode = document.getElementById('contactHeroTitle');
		const introNode = document.getElementById('contactHeroIntro');
		const imageNode = document.getElementById('contactHeroImage');
		const demoBadge = document.getElementById('contactHeroDemoBadge');
		const devNote = document.getElementById('contactHeroDevNote');
		const tip1 = document.getElementById('contactTip-1');
		const tip2 = document.getElementById('contactTip-2');
		const tip3 = document.getElementById('contactTip-3');
		const tip4 = document.getElementById('contactTip-4');
		const tip5 = document.getElementById('contactTip-5');

		const empresasTipHtml = '<a href="/company/empresas" class="contact-tip__link">Empresas o contacto corporativo</a>';
		const setTips = (a, b, c, d, e) => {
			if (tip1) tip1.textContent = a;
			if (tip2) tip2.textContent = b;
			if (tip3) tip3.textContent = c;
			if (tip4) {
				if (e !== undefined) {
					tip4.textContent = d;
					if (tip5) { tip5.style.display = ''; tip5.innerHTML = e; }
				} else {
					tip4.innerHTML = d;
					if (tip5) tip5.style.display = 'none';
				}
			}
		};

		const sourceMap = {
			precision: {
				intro:
					'Si vienes por la precisión de cierre, te explicamos cómo se calcula y cómo se valida con operativas reales, sin promesas vacías.',
				tips: [
					'Te mostramos el enfoque de precisión con contexto real de ejecución.',
					'Resolveremos dudas clave para tu tipo de operativa.',
					'Proceso simple: solo pedimos datos clave para responderte rápido.',
				],
			},
			hyperclose: {
				intro:
					'Si vienes por HyperClose, te mostramos cómo funciona el cierre en milisegundos cuando se intenta operar estando bloqueado.',
				tips: [
					'Verás cómo funciona HyperClose en un escenario real de uso.',
					'Te explicamos qué se registra en cada intento y por qué importa.',
					'Te guiamos con pasos claros para validar encaje con tu operativa.',
				],
			},
			sml: {
				intro:
					'Si vienes por SML, te explicamos cuándo activarlo, qué margen puede darte y cómo encaja con tu disciplina diaria.',
				tips: [
					'Entenderás el uso práctico de SML sin tecnicismos innecesarios.',
					'Te ayudamos a decidir si te conviene según tu perfil.',
					'Respuesta rápida con los siguientes pasos recomendados.',
				],
			},
			evidence: {
				intro:
					'Si vienes por evidencia verificable, te mostramos qué se registra en cada cierre, bloqueo y rotación para que puedas comprobarlo.',
				tips: [
					'Panel, logs y reporte oficial para validar lo que pasa en real.',
					'Todo queda con trazabilidad para revisión propia o auditoría.',
					'Proceso claro: vemos encaje y te indicamos el siguiente paso.',
				],
			},
		};

		if (flow === 'acceso') {
			if (titleNode) titleNode.textContent = 'Completa tu acceso a tevsys';
			if (introNode) introNode.textContent = 'Rellena el formulario y te indicamos el siguiente paso según tu perfil. Essential listo; Advanced y Pro en desarrollo.';
			setTips(
				'Essential listo para probar. Advanced y Pro en desarrollo — lista de espera.',
				'Respuesta en menos de 24h. Te orientamos según tu perfil.',
				'Precisión y HyperClose validados con operativas reales. Días OFF y configuración flexible de toda la semana.',
				empresasTipHtml
			);
			if (imageNode) {
				imageNode.src = '/assets/images/plans/esse-form-v4.png';
				imageNode.alt = 'Acceso tevsys';
			}
			if (demoBadge) demoBadge.hidden = false;
			return;
		}

		if (flow === 'demo') {
			if (titleNode) titleNode.textContent = 'Solicita tu demo de tevsys';
			const demoProcess = ' Rellena el formulario. Te respondemos en menos de 24h con los pasos para acceder a la demo.';
			const selectedSource = sourceMap[feature] || sourceMap[origin];
			if (selectedSource) {
				if (introNode) introNode.textContent = selectedSource.intro + demoProcess;
				setTips(selectedSource.tips[0], selectedSource.tips[1], 'Respuesta en menos de 24h con los siguientes pasos.', empresasTipHtml);
			} else {
				if (introNode) {
					introNode.textContent =
						'Déjanos tus datos y te ayudamos a empezar rápido.' + demoProcess;
				}
				setTips(
					'Demo orientada a validación real de tu operativa.',
					'Incluye precisión, HyperClose y días OFF para probar.',
					'La demo que recibirás es Essential. Advanced y Pro en fase final de desarrollo — lista de espera.',
					empresasTipHtml
				);
			}
			if (imageNode) {
				imageNode.src = '/assets/images/plans/esse-form-v4.png';
				imageNode.alt = 'Demo de tevsys';
			}
			if (demoBadge) demoBadge.hidden = false;
			return;
		}

		const selectedSource = sourceMap[feature] || sourceMap[origin];
		if (selectedSource && !plan) {
			if (introNode) introNode.textContent = selectedSource.intro;
			setTips(selectedSource.tips[0], selectedSource.tips[1], selectedSource.tips[2]);
		}

		const planMap = {
			essential: {
				name: 'Essential',
				image: '/assets/images/plans/esse-form-v4.png',
				label: 'ESSENTIAL PROTECTION',
			},
			advanced: {
				name: 'Advanced',
				image: '/assets/images/plans/adva-form-v4.png',
				label: 'ADVANCED PROTECTION',
			},
			pro: {
				name: 'Pro',
				image: '/assets/images/plans/pro-form-v4.png',
				label: 'PRO PROTECTION',
			},
		};

		const selected = planMap[plan];
		if (!selected) return;

		if (imageNode) {
			imageNode.src = selected.image;
			imageNode.alt = `Visual del plan ${selected.name}`;
		}
		if (demoBadge) demoBadge.hidden = plan !== 'essential';
		if (devNote) {
			if (plan === 'advanced') {
				devNote.textContent = 'Advanced en desarrollo. La demo disponible ahora es Essential.';
				devNote.hidden = false;
			} else if (plan === 'pro') {
				devNote.textContent = 'Pro en desarrollo. La demo disponible ahora es Essential.';
				devNote.hidden = false;
			} else {
				devNote.hidden = true;
			}
		}

		const planTipsMap = {
			essential: [
				'Configuras una vez. tevsys ejecuta siempre. Incluso los días que tú decides estar OFF.',
				'Límite diario, precisión milimétrica y HyperClose incluidos.',
				'Respuesta en menos de 24h con los siguientes pasos.',
				empresasTipHtml,
			],
			advanced: [
				'Todo lo de Essential, además:',
				'Protección configurable toda la semana + SML para operativas avanzadas.',
				'Puedes marcar días OFF para proteger tu operativa.',
				'Horarios de mercado y noticias (mejorados): en fase de desarrollo.',
				empresasTipHtml,
			],
			pro: [
				'Todo lo de Advanced, además:',
				'Para capitales más altos: drawdown y estructura completa.',
				'Horarios de mercado y noticias (con eventos personalizados): en fase de desarrollo.',
				empresasTipHtml,
			],
		};

		const planTips = planTipsMap[plan];
		if (planTips) {
			if (planTips.length === 5) {
				setTips(planTips[0], planTips[1], planTips[2], planTips[3], planTips[4]);
			} else {
				setTips(planTips[0], planTips[1], planTips[2], planTips[3]);
			}
		}
	})();
</script>

<style>
	.contact-hero__title::after {
		content: '';
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #f5b041;
		margin-left: 0.4rem;
		vertical-align: middle;
	}
	.contact-hero__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: calc(90vh - var(--navbar-height));
		gap: 3rem;
	}
	.contact-hero__text-section {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.col-2__container {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.contact-hero__tips {
		padding-left: 1rem;
		margin-top: 0.5rem;
	}
	.contact-hero__tips li {
		margin-bottom: 0.35rem;
	}
	.contact-hero__tips :global(a.contact-tip__link) {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.contact-hero__tips :global(a.contact-tip__link:hover) {
		color: #f5b041;
	}
	.contact-hero__visual {
		position: relative;
		margin-top: 1rem;
		width: min(360px, 88%);
		border-radius: 0.85rem;
		overflow: hidden;
		background: #06080d;
		border: 1px solid rgba(245, 176, 65, 0.3);
	}
	.contact-hero__demo-badge {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		padding: 0.25rem 0.6rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: rgba(10, 10, 10, 0.9);
		background: rgba(245, 176, 65, 0.5);
		border-radius: 0.35rem;
		z-index: 1;
	}
	.contact-hero__visual img {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
		object-position: center;
	}
	.contact-hero__dev-note {
		margin-top: 1rem;
		font-style: italic;
		color: inherit;
		font-size: inherit;
		max-width: min(360px, 88%);
	}
	@media (max-width: 768px) {
		.contact-hero__section {
			grid-template-columns: 1fr;
		}
		.contact-hero__visual {
			width: min(300px, 90%);
		}
	}
</style>
