---
import ContactForm from '../../components/forms/ContactForm.astro';
import Layout from '../../layouts/Page.astro';
import { Container } from '@components/odyssey-theme';

const seo = {
	title: 'Contact | Astro Odyssey Theme',
	description: 'Contact Page',
};
const selectedPlan = (Astro.url.searchParams.get('plan') || '').toLowerCase();
const displayPlan = selectedPlan
	? `${selectedPlan.charAt(0).toUpperCase()}${selectedPlan.slice(1)}`
	: null;
---

<Layout seo={seo}>
	<Container>
		<section class="contact-hero__section">
			<div class="contact-hero__text-section">
				<h1>{displayPlan ? `Has seleccionado ${displayPlan}` : 'Contacta con tevsys'}</h1>
				<p>
					Completa el formulario para validar si este plan encaja con tu capital y operativa.
					Te responderemos con el siguiente paso para activar la cuenta correctamente.
				</p>
				<ul class="contact-hero__tips">
					<li>Plan y capital aproximado se validan automáticamente.</li>
					<li>Si no encaja, te sugerimos el plan correcto.</li>
					<li>Sin ruido: solo datos clave para darte una respuesta rápida.</li>
				</ul>
			</div>
			<div class="col-2__container">
				<ContactForm selectedPlan={selectedPlan} />
			</div>
		</section>
	</Container>
</Layout>

<style>
	.contact-hero__section {
		margin: var(--section-margin) auto;
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: calc(90vh - var(--navbar-height));
		gap: 3rem;
	}
	.contact-hero__text-section {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		background-color: var(--theme-surface-1);
		border-radius: var(--theme-shape-radius);
	}
	.col-2__container {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.contact-hero__tips {
		padding-left: 1rem;
		margin-top: 0.5rem;
	}
	.contact-hero__tips li {
		margin-bottom: 0.35rem;
	}
	@media (max-width: 768px) {
		.contact-hero__section {
			grid-template-columns: 1fr;
		}
	}
</style>
