---
<div class="brand-oval">
  <span class="brand-oval__symbol" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 1L13.5 9L22 10L14.5 11L12 19L9.5 11L2 10L10.5 9L12 1Z"/>
    </svg>
  </span>
  <span class="brand-oval__text">Trading Edge Verification System</span>
</div>

<style>
  .brand-oval {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2.5rem;
    background: rgba(255, 255, 255, 0.04);
  }
  .brand-oval__symbol {
    display: flex;
    align-items: center;
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.95);
  }
  .brand-oval__symbol svg {
    width: 100%;
    height: 100%;
  }
  .brand-oval__text {
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.95);
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .brand-oval__text {
      font-size: 0.9rem;
    }
  }
  @media (max-width: 600px) {
    .brand-oval__text {
      white-space: normal;
      max-width: 160px;
      line-height: 1.2;
      font-size: 0.85rem;
    }
  }
</style>
