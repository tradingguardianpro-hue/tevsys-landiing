---
import settings from '../../config/settings.js';
import ThemeProvider from '../theme-switcher/ThemeProvider.astro';
import { stripLocalePrefix, enReadyPaths } from '../../i18n/locales.js';

import '../../styles/index.css';

export interface Props {
	title?: string;
	description?: string;
	canonicalURL?: URL | string;
	image?: string;
}

const title = Astro.props.title || settings.title;
const description = Astro.props.description || settings.description;
const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);
const image = new URL(Astro.props.image || '/mano%20robotica%20central%20web.png', Astro.site);

/*
  hreflang por página (5 sep 2026). Antes: las tres etiquetas apuntaban SIEMPRE a la portada
  → Google no emparejaba /features/precision con /en/features/precision (ni ninguna otra).
  Fuente única de qué existe en EN: `enReadyPaths`.
*/
const barePath = stripLocalePrefix(Astro.url.pathname);
const hasEnglishVersion = enReadyPaths.has(barePath);
const esAlternate = new URL(barePath === '/' ? '/' : barePath, Astro.site);
const enAlternate = new URL(barePath === '/' ? '/en/' : `/en${barePath}`, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="google-site-verification" content="0xNV257HhIawlZd5KGvnrpi6ZUfVmlZL2OxE5PDiGlE" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<!-- Preconnect font domains (reduces render-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@600;700&family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- Preload LCP hero (solo home) -->
{(Astro.url.pathname === '/' || Astro.url.pathname === '' || Astro.url.pathname === '/en' || Astro.url.pathname === '/en/') && (
  <link rel="preload" as="image" href="/mano%20robotica%20central%20web.png?v=2" />
)}
<link rel="alternate" hreflang="es" href={esAlternate} />
{hasEnglishVersion && <link rel="alternate" hreflang="en" href={enAlternate} />}
<link rel="alternate" hreflang="x-default" href={esAlternate} />
<!-- Schema.org JSON-LD (SoftwareApplication) — home ES|EN. MT5 + featureList canónicos (GEO). -->
{Astro.url.pathname === '/' || Astro.url.pathname === '' || Astro.url.pathname === '/en' || Astro.url.pathname === '/en/' ? (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": settings.name,
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "MetaTrader 5",
    "description": description,
    "url": Astro.url.pathname.startsWith('/en') ? settings.url + '/en/' : settings.url,
    "featureList": Astro.url.pathname.startsWith('/en')
      ? [
          "Enforces user-configured daily and weekly loss/profit limits on MT5",
          "Lock blocks new trade attempts when a limit is hit (HyperClose ≠ close-at-limit)",
          "Swing/overnight: pact percentages stay across day boundaries — UI Trade in progress",
          "Close attribution: tevsys decision vs MT5 execution (not mixed with slippage)",
          "Tu ID tevsys (TVS-…) case identity from install — /como-funciona#tu-id-tevsys",
          "Optional Smart Money Lock (SML) — not Smart Margin Limit — validation in progress",
          "Documented close precision and MT5-contrastable audit trail — not forensic broker audit",
          "Not a signal EA — does not trade for you",
        ]
      : [
          "Hace cumplir límites de pérdida y ganancia (día y semana) en MT5",
          "Bloqueo de nuevos intentos al alcanzar el límite (HyperClose ≠ cierre al límite)",
          "Swing/overnight: % del pacto se mantienen al cruzar el día — Operación en curso",
          "Atribución en el cierre: decisión tevsys vs ejecución MT5 (sin mezclar con slippage)",
          "Tu ID tevsys (TVS-…) identidad del caso desde la instalación — #tu-id-tevsys",
          "SML opcional = Smart Money Lock (no Smart Margin Limit) — validación en curso",
          "Precisión documentada y acta contrastable con MT5 — no auditoría forense del bróker",
          "No es un EA de señales — no opera por ti",
        ],
    "offers": {
      "@type": "Offer",
      "url": (Astro.url.pathname.startsWith('/en') ? settings.url + '/en' : settings.url) + "/company/contact"
    }
  })} />
) : null}
<!-- Generator -->
<meta name="generator" content={Astro.generator} />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />

<!-- For Demonstration of the themes -->
{settings.enableThemeSwitcher && <ThemeProvider />}

<!-- Google Analytics -->
<script>
  var host = window.location.hostname;
  if(host != 'localhost') {
    // Place Google Analytics code here.
  }
</script>
