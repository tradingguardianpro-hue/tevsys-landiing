---
import settings from '../../config/settings.js';
import ThemeProvider from '../theme-switcher/ThemeProvider.astro';

import '../../styles/index.css';

export interface Props {
	title?: string;
	description?: string;
	canonicalURL?: URL | string;
	image?: string;
}

const title = Astro.props.title || settings.title;
const description = Astro.props.description || settings.description;
const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);
const image = new URL(Astro.props.image || '/mano%20robotica%20central%20web.png', Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<meta name="google-site-verification" content="0xNV257HhIawlZd5KGvnrpi6ZUfVmlZL2OxE5PDiGlE" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<!-- Preconnect font domains (reduces render-blocking) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@600;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<!-- Preload LCP hero (solo home) -->
{(Astro.url.pathname === '/' || Astro.url.pathname === '') && (
  <link rel="preload" as="image" href="/mano%20robotica%20central%20web.png?v=2" />
)}
<!-- Schema.org JSON-LD (SoftwareApplication) -->
{Astro.url.pathname === '/' || Astro.url.pathname === '' ? (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": settings.name,
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Windows",
    "description": settings.description,
    "url": settings.url,
    "offers": {
      "@type": "Offer",
      "url": settings.url + "/company/contact"
    }
  })} />
) : null}
<!-- Generator -->
<meta name="generator" content={Astro.generator} />
<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />

<!-- For Demonstration of the themes -->
{settings.enableThemeSwitcher && <ThemeProvider />}

<!-- Google Analytics -->
<script>
  var host = window.location.hostname;
  if(host != 'localhost') {
    // Place Google Analytics code here.
  }
</script>
