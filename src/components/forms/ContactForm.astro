---
import { Button, FormInput } from '@components/odyssey-theme';

const { selectedPlan = '', allowNoPlan = false, locale = 'es' } = Astro.props;
const normalizedPlan = (selectedPlan || '').toLowerCase();
const en = locale === 'en';

// Formspree: crea un formulario en formspree.io y reemplaza TU_FORM_ID por tu ID real.
// Las solicitudes llegarán a tu email corporativo.
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || 'https://formspree.io/f/xzdjbenk';

const labels = en
	? {
			name: 'Name',
			namePh: 'Your name',
			email: 'Email',
			emailPh: 'you@email.com',
			lista: 'Which plan are you interested in?',
			listaPh: 'Select an option',
			ambos: 'Both',
			capital: 'Approximate capital',
			capitalPh: 'Select capital',
			capMore: 'More than €240,000',
			exp: 'Experience',
			expPh: 'Select an option',
			exp1: 'Beginner',
			exp2: 'Intermediate',
			exp3: 'Advanced',
			exp4: 'Professional / Prop trader',
			notify: 'Yes, notify me when it is available.',
			channel: 'Contact channel (optional)',
			channelPh: 'Telegram, WhatsApp or phone',
			submit: 'Send request',
			hasta: 'Up to',
		}
	: {
			name: 'Nombre',
			namePh: 'Tu nombre',
			email: 'Email',
			emailPh: 'tu@email.com',
			lista: '¿En qué plan estás interesado?',
			listaPh: 'Selecciona una opción',
			ambos: 'Ambos',
			capital: 'Capital aproximado',
			capitalPh: 'Selecciona capital',
			capMore: 'Más de 240.000 €',
			exp: 'Experiencia',
			expPh: 'Selecciona una opción',
			exp1: 'Principiante',
			exp2: 'Intermedio',
			exp3: 'Avanzado',
			exp4: 'Profesional / Prop Trader',
			notify: 'Sí, avísame cuando esté disponible.',
			channel: 'Canal de contacto (opcional)',
			channelPh: 'Telegram, WhatsApp o teléfono',
			submit: 'Enviar solicitud',
			hasta: 'Hasta',
		};
---

<form id="tevsysContactForm" name="Contact Form" data-formspree-endpoint={formspreeEndpoint} data-locale={locale}>
  <FormInput type="text" label={labels.name} name="Name" placeholder={labels.namePh} required />
  <FormInput type="email" label={labels.email} name="Email" placeholder={labels.emailPh} required />

  <input id="planInput" type="hidden" name="Plan" value={normalizedPlan} data-allow-no-plan={allowNoPlan ? 'true' : 'false'} />
  <input id="flowInput" type="hidden" name="Flow" value="" />
  <input id="featureInput" type="hidden" name="Feature" value="" />
  <p id="selectedPlanBadge" class="selected-plan-badge" hidden></p>

  <div id="listaPlanContainer" class="form-field__container" hidden>
    <label for="listaPlanSelect">{labels.lista}</label>
    <select id="listaPlanSelect">
      <option value="">{labels.listaPh}</option>
      <option value="advanced">Advanced</option>
      <option value="pro">Pro</option>
      <option value="ambos">{labels.ambos}</option>
    </select>
  </div>

  <div id="contactFieldCapital" class="form-field__container">
    <label for="capitalSelect">{labels.capital}</label>
    <select id="capitalSelect" name="ApproxCapital" required>
      <option value="">{labels.capitalPh}</option>
      <option value="5000">{labels.hasta} 5.000 €</option>
      <option value="10000">{labels.hasta} 10.000 €</option>
      <option value="25000">{labels.hasta} 25.000 €</option>
      <option value="30000">{labels.hasta} 30.000 €</option>
      <option value="50000">{labels.hasta} 50.000 €</option>
      <option value="100000">{labels.hasta} 100.000 €</option>
      <option value="120000">{labels.hasta} 120.000 €</option>
      <option value="200000">{labels.hasta} 200.000 €</option>
      <option value="240000">{labels.hasta} 240.000 €</option>
      <option value="250000">{labels.capMore}</option>
    </select>
  </div>

  <div id="contactFieldExperience" class="form-field__container">
    <label for="experienceSelect">{labels.exp}</label>
    <select id="experienceSelect" name="Experience" required>
      <option value="">{labels.expPh}</option>
      <option value="principiante">{labels.exp1}</option>
      <option value="intermedio">{labels.exp2}</option>
      <option value="avanzado">{labels.exp3}</option>
      <option value="pro">{labels.exp4}</option>
    </select>
  </div>

  <div id="notifyContainer" class="form-field__notify-box" hidden>
    <input type="hidden" id="notifyInput" value="Sí" />
    <label class="form-field__notify-label">
      <input type="checkbox" id="notifyCheckbox" checked />
      <span id="notifyLabelText">{labels.notify}</span>
    </label>
  </div>

  <div class="form-field__container">
    <label for="contactChannel">{labels.channel}</label>
    <input id="contactChannel" type="text" name="ContactChannel" placeholder={labels.channelPh} />
  </div>

  <p id="planValidationMessage" class="plan-validation-message" hidden></p>
  <Button id="contactSubmitBtn" type="submit">{labels.submit}</Button>
</form>

<script is:inline>
  (() => {
    const form = document.getElementById('tevsysContactForm');
    if (!form) return;

    const planInput = document.getElementById('planInput');
    const capitalSelect = document.getElementById('capitalSelect');
    const badgeNode = document.getElementById('selectedPlanBadge');
    const messageNode = document.getElementById('planValidationMessage');

    const limits = {
      essential: 30000,
      advanced: 120000,
      pro: 240000,
      elite: Number.POSITIVE_INFINITY,
    };

    const planNames = {
      essential: 'Essential',
      advanced: 'Advanced',
      pro: 'Pro',
      elite: 'Elite',
    };

    const recommendationByCapital = (capital) => {
      if (capital <= 30000) return 'Essential';
      if (capital <= 120000) return 'Advanced';
      if (capital <= 240000) return 'Pro';
      return 'Elite';
    };

    const setPlanFromUrl = () => {
      if (!planInput) return '';
      const params = new URLSearchParams(window.location.search);
      const urlFlow = (params.get('flow') || '').toLowerCase();
      const urlFeature = (params.get('feature') || '').toLowerCase();

      if (urlFlow === 'demo' || urlFlow === 'acceso' || urlFlow === 'lista' || urlFlow === 'auditoria-ia') {
        planInput.dataset.allowNoPlan = 'true';
      }
      const urlPlan = (params.get('plan') || '').toLowerCase();
      if (urlFlow === 'lista') {
        const listaContainer = document.getElementById('listaPlanContainer');
        if (listaContainer) listaContainer.hidden = false;
      } else if (urlPlan && limits[urlPlan] !== undefined) {
        planInput.value = urlPlan;
      }

      const flowInput = document.getElementById('flowInput');
      const featureInput = document.getElementById('featureInput');
      if (flowInput) flowInput.value = urlFlow;
      if (featureInput) featureInput.value = urlFeature;

      if (urlFlow === 'demo') {
        const subBtn = document.getElementById('contactSubmitBtn');
        if (subBtn) subBtn.textContent = 'Solicitar demo';
        if (badgeNode) {
          badgeNode.hidden = false;
          badgeNode.classList.remove('selected-plan-badge--warning');
          badgeNode.textContent = 'Demo Essential — rellena y te enviamos el acceso y las guías.';
        }
      }

      /** Solicitud auditoría: quitar miedo y carga; sin capital ni experiencia en este paso. */
      if (urlFlow === 'auditoria-ia') {
        const capWrap = document.getElementById('contactFieldCapital');
        const expWrap = document.getElementById('contactFieldExperience');
        const capSel = document.getElementById('capitalSelect');
        const expSel = document.getElementById('experienceSelect');
        const subBtn = document.getElementById('contactSubmitBtn');
        if (capWrap) capWrap.hidden = true;
        if (expWrap) expWrap.hidden = true;
        if (capSel) {
          capSel.removeAttribute('required');
          capSel.removeAttribute('name');
        }
        if (expSel) {
          expSel.removeAttribute('required');
          expSel.removeAttribute('name');
        }
        if (badgeNode) badgeNode.hidden = true;
        if (subBtn) subBtn.textContent = 'Enviar';
        if (!form.querySelector('input[name="ApproxCapital"][data-audit-dummy]')) {
          const h1 = document.createElement('input');
          h1.type = 'hidden';
          h1.name = 'ApproxCapital';
          h1.setAttribute('data-audit-dummy', '1');
          h1.value = 'solicitud_auditoria';
          form.appendChild(h1);
        }
        if (!form.querySelector('input[name="Experience"][data-audit-dummy]')) {
          const h2 = document.createElement('input');
          h2.type = 'hidden';
          h2.name = 'Experience';
          h2.setAttribute('data-audit-dummy', '1');
          h2.value = 'solicitud_auditoria';
          form.appendChild(h2);
        }
      }

      return (planInput.value || '').toLowerCase();
    };

    const renderPlanBadge = (plan) => {
      if (!badgeNode) return;
      const flowInputEarly = document.getElementById('flowInput');
      if (flowInputEarly && flowInputEarly.value === 'auditoria-ia') {
        badgeNode.hidden = true;
        return;
      }
      const canSubmitWithoutPlan = planInput && planInput.dataset.allowNoPlan === 'true';
      badgeNode.hidden = false;
      if (plan) {
        badgeNode.classList.remove('selected-plan-badge--warning');
        badgeNode.innerHTML = `Plan seleccionado: <strong>${plan.toUpperCase()}</strong>`;
      } else if (canSubmitWithoutPlan) {
        badgeNode.classList.remove('selected-plan-badge--warning');
        const flowInput = document.getElementById('flowInput');
        const flowVal = flowInput ? flowInput.value : '';
        if (flowVal === 'lista') {
          badgeNode.textContent = 'Lista de espera — indica tu plan de interés abajo.';
        } else if (flowVal === 'demo') {
          badgeNode.textContent = 'Demo Essential — rellena y te enviamos el acceso y las guías.';
        } else if (flowVal === 'acceso') {
          badgeNode.textContent = 'Rellena el formulario. Te indicaremos el siguiente paso según tu perfil.';
        } else {
          badgeNode.textContent = 'Sin plan preseleccionado.';
        }
      } else {
        badgeNode.classList.add('selected-plan-badge--warning');
        badgeNode.textContent = 'No hay plan seleccionado. Vuelve a la home y pulsa en "Elegir plan".';
      }
    };

    const validatePlanAgainstCapital = () => {
      const plan = (planInput && planInput.value || '').toLowerCase();
      const capital = Number(capitalSelect && capitalSelect.value || 0);
      const flowInput = document.getElementById('flowInput');
      const flowVal = flowInput ? flowInput.value : '';
      const canSubmitWithoutPlan = planInput && planInput.dataset.allowNoPlan === 'true';

      if (flowVal === 'auditoria-ia') {
        if (messageNode) {
          messageNode.hidden = true;
          messageNode.textContent = '';
        }
        return true;
      }

      if (!plan && !canSubmitWithoutPlan) {
        messageNode.hidden = false;
        messageNode.textContent = 'Selecciona un plan desde la home para continuar.';
        return false;
      }

      if (flowVal === 'lista') {
        if (!plan || !['advanced', 'pro', 'ambos'].includes(plan)) {
          messageNode.hidden = false;
          messageNode.textContent = 'Indica en qué plan estás interesado.';
          return false;
        }
        messageNode.hidden = true;
        messageNode.textContent = '';
        return true;
      }

      if (!plan && canSubmitWithoutPlan) {
        messageNode.hidden = true;
        messageNode.textContent = '';
        return true;
      }

      if (!capital) {
        messageNode.hidden = true;
        messageNode.textContent = '';
        return false;
      }

      const maxLimit = limits[plan];
      const isValid = capital <= maxLimit;
      if (isValid) {
        messageNode.hidden = true;
        messageNode.textContent = '';
        return true;
      }

      const maxText = maxLimit.toLocaleString('es-ES');
      const recommendedPlan = recommendationByCapital(capital);
      messageNode.hidden = false;
      messageNode.textContent = `Para ${planNames[plan]}, el capital máximo es ${maxText} €. Te recomendamos ${recommendedPlan}.`;
      return false;
    };

    const listaPlanSelect = document.getElementById('listaPlanSelect');
    const flowInputEl = document.getElementById('flowInput');
    if (listaPlanSelect && flowInputEl && flowInputEl.value === 'lista') {
      listaPlanSelect.addEventListener('change', () => {
        if (planInput) planInput.value = (listaPlanSelect.value || '').toLowerCase();
        validatePlanAgainstCapital();
      });
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const flowInputSubmit = document.getElementById('flowInput');
      if (flowInputSubmit && flowInputSubmit.value === 'lista' && listaPlanSelect) {
        if (planInput) planInput.value = (listaPlanSelect.value || '').toLowerCase();
      }
      if (!validatePlanAgainstCapital()) return;

      const submitBtn = form.querySelector('button');
      const endpoint = form.dataset.formspreeEndpoint;
      const flow = flowInputSubmit ? flowInputSubmit.value : '';
      const planVal = (planInput && planInput.value || '').toLowerCase();
      const q = new URLSearchParams();
      if (flow === 'acceso') q.set('flow', 'acceso');
      if (flow === 'lista') q.set('flow', 'lista');
      if (flow === 'auditoria-ia') q.set('flow', 'auditoria-ia');
      if (flow === 'demo') q.set('flow', 'demo');
      if (planVal === 'advanced' || planVal === 'pro') q.set('plan', planVal);
      if (flow === 'lista' && planVal === 'ambos') q.set('plan', 'ambos');
      const thankYouUrl = '/company/contact-thank-you' + (q.toString() ? '?' + q.toString() : '');
      if (!endpoint) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando…';
      }

      try {
        const formData = new FormData(form);
        const response = await fetch(endpoint, {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });
        if (response.ok) {
          window.location.href = thankYouUrl;
          return;
        }
        throw new Error('Error al enviar');
      } catch (err) {
        if (messageNode) {
          messageNode.hidden = false;
          messageNode.textContent = 'No se pudo enviar. Inténtalo de nuevo o escríbenos a info@tevsys.io';
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          const flowReset = flowInputSubmit ? flowInputSubmit.value : '';
          submitBtn.textContent = flowReset === 'demo' ? 'Solicitar demo' : 'Enviar solicitud';
        }
      }
    });

    const initializedPlan = setPlanFromUrl();
    renderPlanBadge(initializedPlan);

    const notifyContainer = document.getElementById('notifyContainer');
    const notifyInput = document.getElementById('notifyInput');
    const notifyCheckbox = document.getElementById('notifyCheckbox');
    const notifyLabelText = document.getElementById('notifyLabelText');
    if (initializedPlan === 'advanced' || initializedPlan === 'pro') {
      if (notifyContainer) notifyContainer.hidden = false;
      if (notifyInput) notifyInput.setAttribute('name', 'AvisarCuandoDisponible');
      if (notifyLabelText) notifyLabelText.textContent = 'Sí, avísame cuando ' + (initializedPlan === 'advanced' ? 'Advanced' : 'Pro') + ' esté disponible.';
      if (notifyCheckbox && notifyInput) {
        notifyCheckbox.addEventListener('change', () => {
          if (notifyInput) notifyInput.value = notifyCheckbox.checked ? 'Sí' : 'No';
        });
      }
    }

    capitalSelect && capitalSelect.addEventListener('change', validatePlanAgainstCapital);
  })();
</script>

<style>
  form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .form-field__container select,
  .form-field__container input[type='text'] {
    width: 100%;
    padding: 0.5rem;
    border: 2px solid var(--form-field-border-color, #ccc);
    color: var(--form-field-input-color, #000000);
    border-radius: var(--form-field-border-radius, 0.25rem);
    outline-style: none;
    font-size: 1rem;
    font-family: inherit;
    -webkit-appearance: none;
  }
  .form-field__container select:focus,
  .form-field__container input:focus {
    border: 2px solid var(--form-field-border-focus-color, #000);
  }
  .plan-validation-message {
    margin: 0;
    padding: 0.75rem;
    border-radius: 0.5rem;
    background: rgba(245, 176, 65, 0.15);
    border: 1px solid rgba(245, 176, 65, 0.65);
    color: var(--theme-on-bg);
    font-size: 0.95rem;
  }
  .selected-plan-badge {
    margin: 0;
    padding: 0.7rem;
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.95rem;
  }
  .selected-plan-badge--warning {
    background: rgba(245, 176, 65, 0.12);
    border-color: rgba(245, 176, 65, 0.6);
  }
  .form-field__notify-box {
    padding: 1rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(245, 176, 65, 0.35);
    background: rgba(245, 176, 65, 0.06);
  }
  .form-field__notify-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.95rem;
  }
  .form-field__notify-label input[type='checkbox'] {
    width: auto;
    accent-color: #f5b041;
  }
</style>