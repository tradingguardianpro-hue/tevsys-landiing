---
export interface Props {
	src: string;
	alt: string;
	caption?: string;
	width?: number;
	height?: number;
	figureClass?: string;
	triggerClass?: string;
	imgClass?: string;
	capClass?: string;
}

const {
	src,
	alt,
	caption,
	width = 1907,
	height = 936,
	figureClass = '',
	triggerClass = '',
	imgClass = '',
	capClass = '',
} = Astro.props;
---

<figure class:list={['tevsys-evidence-lightbox', figureClass]}>
	<button
		type="button"
		class:list={['tevsys-evidence-lightbox__trigger', triggerClass]}
		data-tevsys-lightbox-src={src}
		data-tevsys-lightbox-alt={alt}
		data-tevsys-lightbox-caption={caption || undefined}
		aria-label={`Ampliar captura: ${alt}`}>
		<img
			class:list={['tevsys-evidence-lightbox__thumb', imgClass]}
			src={src}
			alt=""
			loading="lazy"
			width={width}
			height={height}
			decoding="async"
		/>
	</button>
	{caption ? <figcaption class:list={['tevsys-evidence-lightbox__cap', capClass]}>{caption}</figcaption> : null}
</figure>
