---
import { Icon } from 'astro-icon/components';
import Container from '../core/Container.astro';
import Plug from './Plug.astro';

const {
	footerSocials,
	footerNav = [],
	footerColumns = [],
	footerLists = [],
	copyrightName,
	background,
	color,
	showPlug: showPlug = true,
} = Astro.props;

const columns = footerColumns.length > 0 ? footerColumns : footerLists;
---

<footer style={background && `--footer-bg:${background}; --footer-color:${color}`}>
	<Container narrow>
		<div class="footer-top">
			<div class="footer-brand__container">
				<div class="footer-brand__slot">
					<slot name="logo" />
				</div>
				{
					footerSocials.length > 0 && (
						<ul class="footer-socials__list">
							{footerSocials.map((social) => (
								<li class="footer-socials__item">
									<a
										href={social.url}
										target="_blank"
										rel="noopener noreferrer"
										class="footer-socials__link"
										title={`Open ${social.name} profile`}
									>
										<Icon name={social.icon} width={24} height={24} />
									</a>
								</li>
							))}
						</ul>
					)
				}
				<div class="footer-contact">
					<a href="mailto:info@tevsys.io" class="footer-contact__item">
						<img src="/icons/icon-email.svg" alt="" width="20" height="20" />
						<span>info@tevsys.io</span>
					</a>
					<span class="footer-contact__item">
						<img src="/icons/icon-location.svg" alt="" width="20" height="20" />
						<span>Barcelona (Spain)</span>
					</span>
				</div>
			</div>
		</div>

		{
			footerNav.length > 0 && (
				<div class="footer-nav-row">
					<nav class="footer-nav" aria-label="Navegación del sitio">
						<p class="footer-nav-row__label">Sitio</p>
						<ul class="footer-nav__list">
							{footerNav.map((item) => (
								<li>
									<a href={item.slug}>{item.title}</a>
								</li>
							))}
						</ul>
					</nav>
				</div>
			)
		}

		<div class="footer-columns">
			{
				columns.map((column) => (
					<div class="footer-list-col">
						<p class="footer-list-col__title">
							<strong>{column.title}</strong>
						</p>
						{column.groups ? (
							column.groups.map((group) => (
								<div class="footer-link-group">
									{group.label && <p class="footer-link-group__label">{group.label}</p>}
									<ul class="footer-link__list">
										{group.items.map((item) => (
											<li>
												{item.slug ? (
													<a href={item.slug}>
														{item.title}
														{item.note && (
															<span class="footer-link__hint"> · {item.note}</span>
														)}
													</a>
												) : (
													<span class="footer-link__disabled">
														{item.title}
														{item.note && (
															<span class="footer-link__note"> ({item.note})</span>
														)}
													</span>
												)}
											</li>
										))}
									</ul>
								</div>
							))
						) : (
							<ul class="footer-link__list">
								{column.items.map((item) => (
									<li>
										{item.slug ? (
											<a href={item.slug}>
												{item.title}
												{item.note && (
													<span class="footer-link__hint"> · {item.note}</span>
												)}
											</a>
										) : (
											<span class="footer-link__disabled">
												{item.title}
												{item.note && (
													<span class="footer-link__note"> ({item.note})</span>
												)}
											</span>
										)}
									</li>
								))}
							</ul>
						)}
					</div>
				))
			}
		</div>

		<div class="footer-copyright__container">
			{showPlug && <Plug />}
			<p class="footer-independiente">
				<a href="#" class="footer-independiente__link"
					>❤️ Made with love for trading. — Desarrollado independientemente. Sin inversores. Sin
					excusas.</a
				>
			</p>
			<p>Copyright &copy; {new Date().getFullYear()} {copyrightName}. Todos los derechos reservados.</p>
		</div>
	</Container>
</footer>

<style>
	footer {
		--footer-bg: var(--theme-primary);
		--footer-color: var(--theme-on-primary);
		min-height: auto;
		max-width: 1500px;
		margin-left: auto;
		margin-right: auto;
		background-color: var(--footer-bg);
		color: var(--footer-color);
		border-top-left-radius: var(--theme-shape-radius);
		border-top-right-radius: var(--theme-shape-radius);
	}

	.footer-top {
		padding: 2rem 0 1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer-brand__container {
		max-width: 36rem;
	}

	.footer-brand__slot {
		margin-bottom: 0.5rem;
	}

	.footer-brand__slot :global(.footer-brand__name) {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: 1.25rem;
		text-decoration: none;
		color: inherit;
	}

	.footer-brand__slot :global(.footer-brand__name:hover) {
		opacity: 0.9;
	}

	.footer-brand__slot :global(.footer-brand__logo) {
		flex-shrink: 0;
	}

	.footer-socials__list {
		margin: 0.75rem 0;
		padding: 0;
		display: flex;
		list-style: none;
	}

	.footer-socials__item {
		margin-right: 0.5rem;
	}

	.footer-contact {
		margin-top: 0.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.footer-contact__item {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: inherit;
		text-decoration: none;
		font-size: 0.9rem;
		opacity: 0.9;
	}

	.footer-contact__item:hover {
		opacity: 1;
		color: #f5b041;
	}

	.footer-contact__item img {
		flex-shrink: 0;
	}

	.footer-nav-row {
		padding: 0.9rem 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(0, 0, 0, 0.14);
	}

	.footer-nav-row .footer-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.65rem 1rem;
		margin: 0;
		padding: 0;
		border: none;
	}

	.footer-nav-row__label {
		margin: 0;
		font-size: 0.78rem;
		font-weight: 500;
		opacity: 0.52;
		flex-shrink: 0;
	}

	.footer-nav__list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.5rem;
		line-height: 1.5;
	}

	.footer-nav__list li {
		display: inline-flex;
		align-items: center;
	}

	.footer-nav__list li:not(:last-child)::after {
		content: '·';
		margin-left: 0.5rem;
		opacity: 0.45;
		pointer-events: none;
	}

	.footer-nav__list a {
		text-decoration: none;
		font-size: 0.92rem;
		opacity: 0.92;
		transition: color 0.2s ease;
	}

	.footer-nav__list a:hover {
		color: #f5b041;
		opacity: 1;
	}

	.footer-columns {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0;
		padding: 1.35rem 0 1rem;
	}

	.footer-list-col {
		padding: 0 1.25rem;
		border-left: 1px solid rgba(245, 176, 65, 0.22);
	}

	.footer-list-col:first-child {
		padding-left: 0;
		border-left: none;
	}

	.footer-list-col:last-child {
		padding-right: 0;
	}

	.footer-list-col__title {
		margin: 0 0 0.75rem;
		font-size: 1rem;
	}

	.footer-list-col__title::before {
		content: '— ';
		color: #f5b041;
	}

	.footer-link-group + .footer-link-group {
		margin-top: 0.65rem;
		padding-top: 0.65rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.footer-link-group__label {
		margin: 0 0 0.3rem;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		opacity: 0.52;
	}

	.footer-link__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-link__list li {
		margin-bottom: 0.45rem;
	}

	.footer-link__list li a {
		text-decoration: none;
		font-size: 0.92rem;
		transition: color 0.2s ease;
	}

	.footer-link__list li a:hover {
		color: #f5b041;
	}

	.footer-link__hint {
		opacity: 0.58;
		font-size: 0.88em;
		font-weight: 400;
	}

	.footer-link__disabled {
		opacity: 0.72;
		cursor: default;
		text-decoration: none;
		font-size: 0.92rem;
	}

	.footer-link__note {
		opacity: 0.65;
		font-size: 0.86em;
	}

	.footer-copyright__container {
		display: flex;
		flex-direction: column;
		padding-top: 0.5rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.footer-copyright__container p {
		font-size: var(--font-size-sm);
	}

	.footer-independiente {
		margin-bottom: 0.6rem;
		font-size: 1.08rem;
		letter-spacing: 0.01em;
	}

	.footer-independiente__link {
		color: inherit;
		text-decoration: none;
	}

	.footer-independiente__link:hover {
		color: #f5b041;
	}

	@media (max-width: 768px) {
		.footer-columns {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.footer-list-col {
			padding: 0 0 1.25rem;
			border-left: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		}

		.footer-list-col:last-child {
			padding-bottom: 0;
			border-bottom: none;
		}
	}

	@media (max-width: 600px) {
		.footer-top {
			padding: 1.5rem 0 1rem;
		}

		.footer-nav-row .footer-nav {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}

		.footer-nav__list {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.4rem;
		}

		.footer-nav__list li:not(:last-child)::after {
			content: none;
		}
	}
</style>
