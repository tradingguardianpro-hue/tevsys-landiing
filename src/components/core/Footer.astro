---
import { Icon } from 'astro-icon/components';
import Container from '../core/Container.astro';
import Plug from './Plug.astro';

const {
	footerSocials,
	footerColumns = [],
	footerLists = [],
	copyrightName,
	background,
	color,
	showPlug: showPlug = true,
} = Astro.props;

const columns = footerColumns.length > 0 ? footerColumns : footerLists;
---

<footer style={background && `--footer-bg:${background}; --footer-color:${color}`}>
	<Container narrow>
		<div class="footer-top">
			<div class="footer-top__row">
				<div class="footer-brand__slot">
					<slot name="logo" />
				</div>
				<span class="footer-top__sep" aria-hidden="true">·</span>
				<a href="mailto:info@tevsys.io" class="footer-contact__item">
					<img src="/icons/icon-email.svg" alt="" width="18" height="18" />
					<span>info@tevsys.io</span>
				</a>
				<span class="footer-top__sep" aria-hidden="true">·</span>
				<span class="footer-contact__item footer-contact__item--static">
					<img src="/icons/icon-location.svg" alt="" width="18" height="18" />
					<span>Barcelona (Spain)</span>
				</span>
			</div>
			{
				footerSocials.length > 0 && (
					<ul class="footer-socials__list">
						{footerSocials.map((social) => (
							<li class="footer-socials__item">
								<a
									href={social.url}
									target="_blank"
									rel="noopener noreferrer"
									class="footer-socials__link"
									title={`Open ${social.name} profile`}
								>
									<Icon name={social.icon} width={24} height={24} />
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>

		<div class="footer-columns">
			{
				columns.map((column) => (
					<div class="footer-list-col">
						<p class="footer-list-col__title">
							<strong>{column.title}</strong>
						</p>
						{column.groups ? (
							column.groups.map((group) => (
								<div class="footer-link-group">
									{group.label && <p class="footer-link-group__label">{group.label}</p>}
									<ul class="footer-link__list">
										{group.items.map((item) => (
											<li>
												{item.slug ? (
													<a href={item.slug}>
														{item.title}
														{item.note && (
															<span class="footer-link__hint"> · {item.note}</span>
														)}
													</a>
												) : (
													<span class="footer-link__disabled">
														{item.title}
														{item.note && (
															<span class="footer-link__note"> ({item.note})</span>
														)}
													</span>
												)}
											</li>
										))}
									</ul>
								</div>
							))
						) : (
							<ul class="footer-link__list">
								{column.items.map((item) => (
									<li>
										{item.slug ? (
											<a href={item.slug}>
												{item.title}
												{item.note && (
													<span class="footer-link__hint"> · {item.note}</span>
												)}
											</a>
										) : (
											<span class="footer-link__disabled">
												{item.title}
												{item.note && (
													<span class="footer-link__note"> ({item.note})</span>
												)}
											</span>
										)}
									</li>
								))}
							</ul>
						)}
					</div>
				))
			}
		</div>

		<div class="footer-copyright__container">
			{showPlug && <Plug />}
			<div class="footer-independiente-wrap">
				<p class="footer-independiente">
					<a href="#" class="footer-independiente__link"
						>❤️ Made with love for trading. — Desarrollado independientemente. Sin inversores. Sin
						excusas.</a
					>
				</p>
			</div>
			<p class="footer-copyright">Copyright &copy; {new Date().getFullYear()} {copyrightName}. Todos los derechos reservados.</p>
		</div>
	</Container>
</footer>

<style>
	footer {
		--footer-bg: var(--theme-primary);
		--footer-color: var(--theme-on-primary);
		min-height: auto;
		max-width: 1500px;
		margin-left: auto;
		margin-right: auto;
		background-color: var(--footer-bg);
		color: var(--footer-color);
		border-top-left-radius: var(--theme-shape-radius);
		border-top-right-radius: var(--theme-shape-radius);
	}

	.footer-top {
		padding: clamp(1.25rem, 3vw, 1.65rem) 0 clamp(1rem, 2.5vw, 1.35rem);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer-top__row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.65rem;
		row-gap: 0.55rem;
	}

	.footer-top__sep {
		opacity: 0.42;
		font-size: 1.1rem;
		line-height: 1;
		user-select: none;
	}

	.footer-brand__slot {
		margin: 0;
	}

	.footer-brand__slot :global(.footer-brand__name) {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 600;
		font-size: 1.15rem;
		text-decoration: none;
		color: inherit;
	}

	.footer-brand__slot :global(.footer-brand__name:hover) {
		opacity: 0.9;
	}

	.footer-brand__slot :global(.footer-brand__logo) {
		flex-shrink: 0;
	}

	.footer-socials__list {
		margin: 0.65rem 0 0;
		padding: 0;
		display: flex;
		list-style: none;
	}

	.footer-socials__item {
		margin-right: 0.5rem;
	}

	.footer-contact__item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: inherit;
		text-decoration: none;
		font-size: 0.9rem;
		opacity: 0.9;
	}

	.footer-contact__item--static {
		cursor: default;
	}

	.footer-contact__item:hover {
		opacity: 1;
		color: #f5b041;
	}

	.footer-contact__item--static:hover {
		color: inherit;
		opacity: 0.9;
	}

	.footer-contact__item img {
		flex-shrink: 0;
		opacity: 0.88;
	}

	.footer-columns {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1.75rem, 4vw, 2.75rem);
		padding: clamp(1.35rem, 3.5vw, 1.85rem) 0 clamp(1rem, 2.5vw, 1.25rem);
	}

	.footer-list-col {
		padding: 0 clamp(0.75rem, 2vw, 1.35rem);
		border-left: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-list-col:first-child {
		padding-left: 0;
		border-left: none;
	}

	.footer-list-col:last-child {
		padding-right: 0;
	}

	.footer-list-col__title {
		margin: 0 0 0.75rem;
		font-size: 1rem;
	}

	.footer-list-col__title::before {
		content: '— ';
		color: #f5b041;
	}

	.footer-link-group + .footer-link-group {
		margin-top: 0.65rem;
		padding-top: 0.65rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.footer-link-group__label {
		margin: 0 0 0.3rem;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		opacity: 0.52;
	}

	.footer-link__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-link__list li {
		margin-bottom: 0.45rem;
	}

	.footer-link__list li a {
		text-decoration: none;
		font-size: 0.92rem;
		transition: color 0.2s ease;
	}

	.footer-link__list li a:hover {
		color: #f5b041;
	}

	.footer-link__hint {
		opacity: 0.58;
		font-size: 0.88em;
		font-weight: 400;
	}

	.footer-link__disabled {
		opacity: 0.72;
		cursor: default;
		text-decoration: none;
		font-size: 0.92rem;
	}

	.footer-link__note {
		opacity: 0.65;
		font-size: 0.86em;
	}

	.footer-copyright__container {
		display: flex;
		flex-direction: column;
		padding-top: 0;
		border-top: none;
	}

	.footer-independiente-wrap {
		margin-top: clamp(1.35rem, 3.5vw, 1.85rem);
		padding: clamp(1.35rem, 3.5vw, 1.85rem) 0 clamp(1rem, 2.5vw, 1.25rem);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-independiente {
		margin: 0;
		font-size: 1.08rem;
		letter-spacing: 0.01em;
		text-align: center;
		line-height: 1.45;
	}

	.footer-independiente__link {
		color: inherit;
		text-decoration: none;
	}

	.footer-independiente__link:hover {
		color: #f5b041;
	}

	.footer-copyright {
		margin: 0;
		padding-bottom: clamp(1rem, 2.5vw, 1.35rem);
		font-size: var(--font-size-sm);
		text-align: center;
		opacity: 0.88;
	}

	@media (max-width: 768px) {
		.footer-columns {
			grid-template-columns: 1fr;
			gap: 1.35rem;
		}

		.footer-list-col {
			padding: 0 0 1.25rem;
			border-left: none;
			border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		}

		.footer-list-col:last-child {
			padding-bottom: 0;
			border-bottom: none;
		}
	}

	@media (max-width: 600px) {
		.footer-top__sep {
			display: none;
		}

		.footer-top__row {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}

		.footer-independiente {
			text-align: left;
		}

		.footer-copyright {
			text-align: left;
		}
	}
</style>
