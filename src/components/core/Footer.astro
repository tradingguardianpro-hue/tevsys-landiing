---
import { Icon } from 'astro-icon/components';
import Container from '../core/Container.astro';
import Plug from './Plug.astro';
import settings from '../../config/settings.js';

const {
	footerSocials,
	footerColumns = [],
	footerLists = [],
	copyrightName,
	background,
	color,
	showPlug = true,
	lang = 'es',
} = Astro.props;

const columns = footerColumns.length > 0 ? footerColumns : footerLists;
const [colGuias, colProducto, colLegal] = columns;
const isEn = lang === 'en';
const loveLine = isEn
	? '❤️ Made with love for trading. — Built independently. No investors. No excuses.'
	: '❤️ Made with love for trading. — Desarrollado independientemente. Sin inversores. Sin excusas.';
const rightsLine = isEn ? 'All rights reserved.' : 'Todos los derechos reservados.';
const linkedInUrl = settings.founderLinkedInUrl;
const linkedInLabel = isEn ? settings.founderLinkedInLabelEn : settings.founderLinkedInLabelEs;


const footerStyle = background
	? `--footer-bg:${background}; --footer-color:${color ?? 'inherit'}`
	: undefined;
---

<footer style={footerStyle}>
	<Container narrow>
		<div class="footer-main">
			<div class="footer-main__row footer-main__row--contact">
				<div class="footer-main__cell">
					<div class="footer-brand__slot">
						<slot name="logo" />
					</div>
				</div>
				<div class="footer-main__cell">
					<div class="footer-contact__stack">
						<a href="mailto:info@tevsys.io" class="footer-contact__item">
							<img src="/icons/icon-email.svg" alt="" width="18" height="18" />
							<span>info@tevsys.io</span>
						</a>
						<a
							href={linkedInUrl}
							class="footer-contact__item"
							target="_blank"
							rel="noopener noreferrer"
							title={linkedInLabel}
						>
							<img src="/icons/icon-linkedin.svg" alt="" width="18" height="18" />
							<span>{linkedInLabel}</span>
						</a>
					</div>
				</div>
				<div class="footer-main__cell footer-main__cell--trail">
					<span class="footer-contact__item footer-contact__item--static">
						<img src="/icons/icon-location.svg" alt="" width="18" height="18" />
						<span>Barcelona (España)</span>
					</span>
				</div>
			</div>

			<div class="footer-main__row footer-main__row--links">
				<div class="footer-main__cell">
					{
						colGuias && (
							<div class="footer-list-col">
								<p class="footer-list-col__title footer-list-col__title--brand">
									<span class="footer-list-col__mark" aria-hidden="true">—</span>
									<strong>{colGuias.title}</strong>
								</p>
								{
									colGuias.groups
										? colGuias.groups.map((group) => (
												<div class="footer-link-group">
													{group.label && <p class="footer-link-group__label">{group.label}</p>}
													<ul class="footer-link__list">
														{group.items.map((item) => (
															<li>
																{item.slug ? (
																	<a href={item.slug}>
																		{item.title}
																		{item.note && (
																			<span class="footer-link__hint"> · {item.note}</span>
																		)}
																	</a>
																) : (
																	<span class="footer-link__disabled">
																		{item.title}
																		{item.note && (
																			<span class="footer-link__note"> ({item.note})</span>
																		)}
																	</span>
																)}
															</li>
														))}
													</ul>
												</div>
											))
										: colGuias.items && (
												<ul class="footer-link__list">
													{colGuias.items.map((item) => (
														<li>
															{item.slug ? (
																<a href={item.slug}>
																	{item.title}
																	{item.note && (
																		<span class="footer-link__hint"> · {item.note}</span>
																	)}
																</a>
															) : (
																<span class="footer-link__disabled">
																	{item.title}
																	{item.note && (
																		<span class="footer-link__note"> ({item.note})</span>
																	)}
																</span>
															)}
														</li>
													))}
												</ul>
											)
								}
							</div>
						)
					}
				</div>
				<div class="footer-main__cell">
					{
						colProducto && (
							<div class="footer-list-col">
								<p class="footer-list-col__title footer-list-col__title--contact">
									<span class="footer-list-col__mark" aria-hidden="true">—</span>
									<strong>{colProducto.title}</strong>
								</p>
								{
									colProducto.groups
										? colProducto.groups.map((group) => (
												<div class="footer-link-group">
													{group.label && <p class="footer-link-group__label">{group.label}</p>}
													<ul class="footer-link__list">
														{group.items.map((item) => (
															<li>
																{item.slug ? (
																	<a href={item.slug}>
																		{item.title}
																		{item.note && (
																			<span class="footer-link__hint"> · {item.note}</span>
																		)}
																	</a>
																) : (
																	<span class="footer-link__disabled">
																		{item.title}
																		{item.note && (
																			<span class="footer-link__note"> ({item.note})</span>
																		)}
																	</span>
																)}
															</li>
														))}
													</ul>
												</div>
											))
										: colProducto.items && (
												<ul class="footer-link__list">
													{colProducto.items.map((item) => (
														<li>
															{item.slug ? (
																<a href={item.slug}>
																	{item.title}
																	{item.note && (
																		<span class="footer-link__hint"> · {item.note}</span>
																	)}
																</a>
															) : (
																<span class="footer-link__disabled">
																	{item.title}
																	{item.note && (
																		<span class="footer-link__note"> ({item.note})</span>
																	)}
																</span>
															)}
														</li>
													))}
												</ul>
											)
								}
							</div>
						)
					}
				</div>
				<div class="footer-main__cell footer-main__cell--trail">
					{
						colLegal && (
							<div class="footer-list-col">
								<p class="footer-list-col__title footer-list-col__title--contact">
									<span class="footer-list-col__mark" aria-hidden="true">—</span>
									<strong>{colLegal.title}</strong>
								</p>
								{
									colLegal.groups
										? colLegal.groups.map((group) => (
												<div class="footer-link-group">
													{group.label && <p class="footer-link-group__label">{group.label}</p>}
													<ul class="footer-link__list">
														{group.items.map((item) => (
															<li>
																{item.slug ? (
																	<a href={item.slug}>
																		{item.title}
																		{item.note && (
																			<span class="footer-link__hint"> · {item.note}</span>
																		)}
																	</a>
																) : (
																	<span class="footer-link__disabled">
																		{item.title}
																		{item.note && (
																			<span class="footer-link__note"> ({item.note})</span>
																		)}
																	</span>
																)}
															</li>
														))}
													</ul>
												</div>
											))
										: colLegal.items && (
												<ul class="footer-link__list">
													{colLegal.items.map((item) => (
														<li>
															{item.slug ? (
																<a href={item.slug}>
																	{item.title}
																	{item.note && (
																		<span class="footer-link__hint"> · {item.note}</span>
																	)}
																</a>
															) : (
																<span class="footer-link__disabled">
																	{item.title}
																	{item.note && (
																		<span class="footer-link__note"> ({item.note})</span>
																	)}
																</span>
															)}
														</li>
													))}
												</ul>
											)
								}
							</div>
						)
					}
				</div>
			</div>
		</div>

		{
			footerSocials.length > 0 && (
				<ul class="footer-socials__list">
					{footerSocials.map((social) => (
						<li class="footer-socials__item">
							<a
								href={social.url}
								target="_blank"
								rel="noopener noreferrer"
								class="footer-socials__link"
								title={`Open ${social.name} profile`}
							>
								<Icon name={social.icon} width={24} height={24} />
							</a>
						</li>
					))}
				</ul>
			)
		}

		<div class="footer-copyright__container">
			{showPlug && <Plug />}
			<div class="footer-independiente-wrap">
				<p class="footer-independiente">
					<a href="#" class="footer-independiente__link">
						{loveLine}
					</a>
				</p>
			</div>
			<p class="footer-copyright">
				Copyright &copy; {new Date().getFullYear()} {copyrightName}. {rightsLine}
			</p>
		</div>
	</Container>
</footer>

<style>
	footer {
		--footer-bg: var(--theme-primary);
		--footer-color: var(--theme-on-primary);
		--footer-col-gap: clamp(2.75rem, 6.5vw, 4.5rem);
		--footer-icon-slot: 18px;
		--footer-icon-gap: 0.4rem;
		--footer-brand-icon: 24px;
		--footer-brand-gap: 0.5rem;
		min-height: auto;
		max-width: 1500px;
		margin-left: auto;
		margin-right: auto;
		background-color: var(--footer-bg);
		color: var(--footer-color);
		border-top-left-radius: var(--theme-shape-radius);
		border-top-right-radius: var(--theme-shape-radius);
	}

	.footer-main {
		padding-top: clamp(1.25rem, 3vw, 1.65rem);
	}

	.footer-main__row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
		column-gap: var(--footer-col-gap);
	}

	.footer-main__row--contact {
		padding-bottom: clamp(1rem, 2.5vw, 1.35rem);
		margin-bottom: clamp(1.25rem, 3vw, 1.65rem);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer-main__cell {
		min-width: 0;
		justify-self: start;
	}

	.footer-main__cell--trail {
		justify-self: end;
		width: max-content;
		max-width: 100%;
	}

	.footer-brand__slot {
		margin: 0;
	}

	.footer-brand__slot :global(.footer-brand__name) {
		display: inline-grid;
		grid-template-columns: var(--footer-brand-icon) minmax(0, auto);
		column-gap: var(--footer-brand-gap);
		align-items: center;
		font-weight: 600;
		font-size: 1.15rem;
		text-decoration: none;
		color: inherit;
	}

	.footer-brand__slot :global(.footer-brand__name:hover) {
		opacity: 0.9;
	}

	.footer-brand__slot :global(.footer-brand__logo) {
		grid-column: 1;
		width: var(--footer-brand-icon);
		height: var(--footer-brand-icon);
		flex-shrink: 0;
	}

	.footer-brand__slot :global(.footer-brand__name span) {
		grid-column: 2;
	}

	.footer-contact__stack {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
	}

	.footer-contact__item {
		display: inline-grid;
		grid-template-columns: var(--footer-icon-slot) minmax(0, auto);
		column-gap: var(--footer-icon-gap);
		align-items: center;
		color: inherit;
		text-decoration: none;
		font-size: 0.9rem;
		opacity: 0.9;
		white-space: nowrap;
	}

	.footer-contact__item img {
		grid-column: 1;
		width: var(--footer-icon-slot);
		height: var(--footer-icon-slot);
		opacity: 0.88;
	}

	.footer-contact__item span {
		grid-column: 2;
		font-family: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
		font-size: clamp(0.72rem, 1.05vw, 0.8125rem);
		font-weight: 500;
		letter-spacing: 0.045em;
	}

	.footer-contact__item--static {
		cursor: default;
	}

	.footer-contact__item:hover {
		opacity: 1;
		color: #f5b041;
	}

	.footer-contact__item--static:hover {
		color: inherit;
		opacity: 0.9;
	}

	.footer-list-col {
		padding: 0;
		border: none;
	}

	.footer-list-col__title {
		display: inline-grid;
		align-items: center;
		margin: 0 0 0.75rem;
		font-size: 1rem;
		width: max-content;
		max-width: 100%;
	}

	.footer-list-col__title--brand {
		grid-template-columns: var(--footer-brand-icon) minmax(0, auto);
		column-gap: var(--footer-brand-gap);
	}

	.footer-list-col__title--contact {
		grid-template-columns: var(--footer-icon-slot) minmax(0, auto);
		column-gap: var(--footer-icon-gap);
	}

	.footer-list-col__mark {
		grid-column: 1;
		justify-self: center;
		color: #f5b041;
		font-weight: 600;
		line-height: 1;
	}

	.footer-list-col__title strong {
		grid-column: 2;
		font-weight: inherit;
	}

	.footer-link-group + .footer-link-group {
		margin-top: 0.65rem;
		padding-top: 0.65rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.footer-link-group__label {
		margin: 0 0 0.3rem;
		font-size: 0.78rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		opacity: 0.52;
	}

	.footer-link-group:first-of-type .footer-link-group__label,
	.footer-list-col > .footer-link-group:first-child .footer-link-group__label {
		margin-top: 0;
	}

	.footer-main__row--links .footer-main__cell:first-child .footer-link-group__label,
	.footer-main__row--links .footer-main__cell:first-child .footer-link__list {
		padding-left: calc(var(--footer-brand-icon) + var(--footer-brand-gap));
	}

	.footer-main__row--links .footer-main__cell:nth-child(2) .footer-link-group__label,
	.footer-main__row--links .footer-main__cell:nth-child(2) .footer-link__list {
		padding-left: calc(var(--footer-icon-slot) + var(--footer-icon-gap));
	}

	.footer-main__row--links .footer-main__cell--trail .footer-link-group__label,
	.footer-main__row--links .footer-main__cell--trail .footer-link__list {
		padding-left: calc(var(--footer-icon-slot) + var(--footer-icon-gap));
	}

	.footer-socials__list {
		margin: 0.65rem 0 0;
		padding: 0;
		display: flex;
		list-style: none;
	}

	.footer-socials__item {
		margin-right: 0.5rem;
	}

	.footer-link__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-link__list li {
		margin-bottom: 0.45rem;
	}

	.footer-link__list li a {
		text-decoration: none;
		font-size: 0.92rem;
		transition: color 0.2s ease;
	}

	.footer-link__list li a:hover {
		color: #f5b041;
	}

	.footer-link__hint {
		opacity: 0.58;
		font-size: 0.88em;
		font-weight: 400;
	}

	.footer-link__disabled {
		opacity: 0.72;
		cursor: default;
		text-decoration: none;
		font-size: 0.92rem;
	}

	.footer-link__note {
		opacity: 0.65;
		font-size: 0.86em;
	}

	.footer-copyright__container {
		display: flex;
		flex-direction: column;
		padding-top: clamp(1rem, 2.5vw, 1.35rem);
	}

	.footer-independiente-wrap {
		margin-top: clamp(1.35rem, 3.5vw, 1.85rem);
		padding: clamp(1.35rem, 3.5vw, 1.85rem) 0 clamp(1rem, 2.5vw, 1.25rem);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-independiente {
		margin: 0;
		font-size: clamp(0.72rem, 1vw, 0.8125rem);
		letter-spacing: 0.015em;
		text-align: center;
		line-height: 1.45;
		opacity: 0.82;
	}

	.footer-independiente__link {
		color: inherit;
		text-decoration: none;
	}

	.footer-independiente__link:hover {
		color: #f5b041;
	}

	.footer-copyright {
		margin: 0;
		padding-bottom: clamp(1rem, 2.5vw, 1.35rem);
		font-size: clamp(0.68rem, 0.95vw, 0.78rem);
		font-weight: 400;
		text-align: center;
		opacity: 0.88;
	}

	@media (max-width: 768px) {
		.footer-main__row {
			grid-template-columns: 1fr;
			row-gap: 0.65rem;
		}

		.footer-main__row--contact {
			margin-bottom: 1rem;
		}

		.footer-main__row--links {
			row-gap: 0;
		}

		.footer-main__cell,
		.footer-main__cell--trail {
			justify-self: start;
			width: 100%;
			max-width: none;
		}

		.footer-main__row--links .footer-main__cell {
			padding-bottom: 1.25rem;
			margin-bottom: 0.5rem;
			border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		}

		.footer-main__row--links .footer-main__cell:last-child {
			padding-bottom: 0;
			border-bottom: none;
		}

		.footer-main__row--links .footer-main__cell .footer-link-group__label,
		.footer-main__row--links .footer-main__cell .footer-link__list {
			padding-left: calc(var(--footer-icon-slot) + var(--footer-icon-gap));
		}

		.footer-main__row--links .footer-main__cell:first-child .footer-link-group__label,
		.footer-main__row--links .footer-main__cell:first-child .footer-link__list {
			padding-left: calc(var(--footer-brand-icon) + var(--footer-brand-gap));
		}
	}

	@media (max-width: 600px) {
		.footer-independiente {
			text-align: left;
		}

		.footer-copyright {
			text-align: left;
		}
	}
</style>
