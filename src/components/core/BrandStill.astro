---
/**
 * Still marca tevsys — hueco 16:9 sin MP4.
 * Canon nov 2026: negro + ámbar (elegante); orb suave, no bola 3D.
 * Estilos: `src/styles/brand-still.css`.
 */
export type BrandStillTone = 'amber' | 'teal' | 'cool' | 'steel' | 'warm';
export type BrandStillOrb = 'c' | 'tr' | 'tl' | 'br' | 'bl';

export interface Props {
	tone?: BrandStillTone;
	orb?: BrandStillOrb;
	label?: string;
	/** Línea corta encima (p. ej. «Vídeo en preparación»). */
	kicker?: string;
	/** Línea bajo el nombre (p. ej. fecha 11/11/2026). */
	sub?: string;
	aria?: string;
	/** 16:9 — hueco tipo vídeo. */
	clip?: boolean;
	id?: string;
	class?: string;
}

const {
	tone = 'amber',
	orb = 'c',
	label = 'tevsys',
	kicker,
	sub,
	aria,
	clip = true,
	id,
	class: className,
} = Astro.props;

const ariaParts = [aria ?? `Marca ${label}`, kicker, sub].filter(Boolean);
---

<div
	class:list={[
		'how-brand-still',
		clip && 'how-brand-still--clip',
		kicker && 'how-brand-still--status',
		`how-brand-still--tone-${tone}`,
		`how-brand-still--orb-${orb}`,
		className,
	]}
	id={id}
	role="img"
	aria-label={ariaParts.join(' · ')}>
	<span class="how-brand-still__glow" aria-hidden="true"></span>
	<span class="how-brand-still__orb" aria-hidden="true"></span>
	<span class="how-brand-still__frame" aria-hidden="true"></span>
	<div class="how-brand-still__copy">
		{kicker ? <span class="how-brand-still__kicker">{kicker}</span> : null}
		<span class="how-brand-still__name">{label}</span>
		{sub ? <span class="how-brand-still__sub">{sub}</span> : null}
	</div>
</div>
