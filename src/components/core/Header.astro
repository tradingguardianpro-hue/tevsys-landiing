---
import { Icon } from 'astro-icon/components'
const { navData, rightMenu } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
/** Escáner gris: home a intensidad plena; micros producto más suave vía CSS `:not(.tevsys-header--home-scanner)` */
const headerScannerSubtle =
	pathname.startsWith('/features') || pathname === '/como-funciona' || pathname === '/precios';
const showHeaderScanner = isHome || headerScannerSubtle;
const headerClasses = [
	rightMenu ? 'header--right' : null,
	showHeaderScanner ? 'tevsys-header--with-scanner' : null,
	isHome ? 'tevsys-header--home-scanner' : null,
].filter(Boolean) as string[];

function navLinkState(slug: string, asButton?: boolean): { className: string; active: boolean } {
	const parts: string[] = [];
	if (asButton) parts.push('nav-link--button');
	const s = (slug || '/').replace(/\/$/, '') || '/';
	const p = pathname;
	const active = s === '/' ? p === '/' : p === s || p.startsWith(`${s}/`);
	if (active) parts.push('nav-link--active');
	return { className: parts.join(' '), active };
}
---

<script type="module">
  const bodyElement = document.querySelector('body');
  const menuButton = document.querySelector('#menuButton')
  const navHeader = document.querySelector('#odysseyNavHeader');
  const menuButtonIconHam = document.querySelector('#menuButtonIconHam');
  const menuButtonIconClose = document.querySelector('#menuButtonIconClose');
  let scrollPosition = 0;

  menuButton.addEventListener('click', toggleMenu)

  function toggleMenu() {
    menuButtonIconHam.toggleAttribute('hidden');
    menuButtonIconClose.toggleAttribute('hidden');
    
    if (navHeader.hasAttribute('mobile-menu-open', true)) {
      menuButton.title = "Open Main Menu"
      // unlock scroll position
      bodyElement.style.removeProperty('overflow');
      bodyElement.style.removeProperty('position');
      bodyElement.style.removeProperty('top');
      bodyElement.style.removeProperty('width');
      window.scrollTo(0, scrollPosition);
    } else {
      menuButton.title = "Close Main Menu"
      // lock scroll position
      scrollPosition = window.pageYOffset;
      bodyElement.style.overflow = 'hidden';
      bodyElement.style.position = 'fixed';
      bodyElement.style.top = `-${scrollPosition}px`;
      bodyElement.style.width = '100%';
    }
    
    navHeader.toggleAttribute('mobile-menu-open');
  }
</script>  

<header id="odysseyNavHeader" class:list={headerClasses}>
	{showHeaderScanner && <div class="tevsys-header-scanner" aria-hidden="true"></div>}
  <div class="header-logo-menu__container">
  <button id="menuButton" title="Open Main Menu">
    <span id="menuButtonIconHam">
      <Icon name="ic:baseline-menu" width="24px" height="24px" />
    </span>
    <span id="menuButtonIconClose" hidden>
      <Icon name="ic:baseline-close" width="24px" height="24px" />
    </span>
  </button>
  <a class="header-logo__link" href="/">
    <slot name="logo">
    </slot>
  </a>
  </div>
  <div class="header-nav__container">
    <slot name="nav">
      {navData && (
        <nav aria-label="Principal">
          <ul>
            {navData.map((navItem) => {
              const { className, active } = navLinkState(navItem.slug, navItem.asButton);
              return (
                <li>
                  <a
                    href={navItem.slug}
                    class={className}
                    aria-current={active && !navItem.asButton ? 'page' : undefined}
                  >
                    {navItem.title}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )}
    </slot>
  </div>
  <div class="header-action-item__container">
    <slot name="action-item">
    </slot>
  </div>
</header>

<style>
  /* Misma sans que el hero (Inter): superficie de producto coherente */
  header {
    /* Una sola barra a todo el ancho (como antes el layout); borde ovalado muy fino, sin relleno nuevo */
    --tevsys-header-bar-border: rgba(255, 255, 255, 0.09);
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    margin: 0.42rem 0 0;
    border-radius: 2.5rem;
    border: 1px solid var(--tevsys-header-bar-border);
    background: transparent;
    /*
	  Logo BrandOval: dentro de la barra ya no hace falta otra pastilla fuerte;
	  baja contraste del trazo/relleno para que no se lean “dos cápsulas”.
	*/
    --tevsys-header-pill-border: rgba(255, 255, 255, 0.12);
    --tevsys-header-pill-surface: transparent;
    /* Barra fina tipo referencia: logo a la izquierda, mucho aire al centro, menú agrupado a la derecha */
    padding: 0.66rem clamp(0.75rem, 2vw, 1.25rem);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: 'Inter', system-ui, -apple-system, var(--theme-font-family-sans);
    font-feature-settings: 'kern' 1;
    -webkit-font-smoothing: antialiased;
  }

  :global(html[data-theme='light']) header {
    --tevsys-header-bar-border: rgba(15, 18, 28, 0.09);
  }
  header.tevsys-header--with-scanner {
    position: relative;
    overflow: hidden;
  }
  header.header--right {
    display: grid;
    grid-template-columns: 1fr auto auto;
  }
  .header-logo__link {
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }
  .header-logo-menu__container {
    display: flex;
    align-items: center;
    z-index: 100;
  }
  .header-action-item__container {
    z-index: 100;
  }
  #menuButton {
    outline: none;
    border: none;
    background-color: transparent;
    margin-right: 0.5rem;
    display: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #menuButton > span {
    color: var(--theme-on-bg);
    vertical-align: middle;
  }
  nav {
  display: flex;
  }
  nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }
  nav ul li a {
    text-decoration: none;
    color: rgba(255, 255, 255, 0.96);
    opacity: 1;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    display: inline-block;
    transition:
      color 160ms ease,
      background-color 160ms ease,
      box-shadow 160ms ease;
  }
  /* Menú: forma de píldora sin trazo (menos “burbujas”); el ratón sube la luz */
  nav ul li a:not(.nav-link--button) {
    border: none;
    border-radius: 2.5rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.42rem 0.84rem;
  }
  nav ul li a:focus-visible {
    outline: 2px solid rgba(168, 174, 190, 0.9);
    outline-offset: 2px;
  }
  /* Activo: un peldaño más de gris, sin contorno */
  nav ul li a.nav-link--active:not(.nav-link--button) {
    color: #fff;
    background: rgba(48, 52, 62, 0.88);
    box-shadow: none;
  }
  nav ul li a.nav-link--button {
    padding: 0.58rem 1.08rem;
    background: #fff;
    color: #111;
    border-radius: 2rem;
    opacity: 1;
    font-weight: 600;
    box-shadow: none;
  }
  nav ul li a.nav-link--button.nav-link--active {
    box-shadow: 0 0 0 2px rgba(90, 96, 112, 0.85);
  }
  nav ul li a.nav-link--button:hover {
    opacity: 0.95;
    background: #f8f8f8;
  }
  nav ul li a:not(.nav-link--button):not(.nav-link--active):hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }
  nav ul li a.nav-link--active:not(.nav-link--button):hover {
    background: rgba(64, 68, 82, 0.98);
    box-shadow: 0 0 32px rgba(160, 168, 190, 0.1);
  }
  /*
    En vista estrecha `header--right` usa grid 3 columnas; al ocultar `.header-nav__container`
    el reparto de columnas puede producir saltos al pintar / hidratar. Flex + min-width:0 evita
    empujar logo o CTAs fuera de sitio.
  */
  @media (max-width: 600px) {
    header.header--right {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.35rem;
    }
    .header-logo-menu__container {
      flex: 1;
      min-width: 0;
    }
    .header-action-item__container {
      flex-shrink: 0;
    }
  }

  @media(max-width: 600px) {
    #menuButton {
      display: block;  
      position: relative;
      z-index: 110;
    }
    .header-nav__container {
      width: 100%;
      height: 100%;
      background-color: var(--theme-bg);
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: fixed;
      inset: 0;
      z-index: 105;
    }
    header[mobile-menu-open] .header-nav__container {
      display: flex;
    }
    /* Con overflow:hidden el fixed del menú puede anclarse mal al header. */
    header[mobile-menu-open].tevsys-header--with-scanner {
      overflow: visible;
    }
    /* Logo/marca encima del menú (z-index del contenedor): ocultar al abrir. */
    header[mobile-menu-open] .header-logo__link {
      visibility: hidden;
      pointer-events: none;
    }
    header[mobile-menu-open] nav ul {
      align-items: center;
      flex-direction: column;
      gap: 0.35rem;
    }
    header[mobile-menu-open] nav ul li {
      font-size: var(--font-size-lg);
      margin-bottom: 0.35rem;
    }
    header[mobile-menu-open] nav ul li a {
      padding: 0.65rem 1rem;
      font-size: 1.05rem;
    }
  }
</style>