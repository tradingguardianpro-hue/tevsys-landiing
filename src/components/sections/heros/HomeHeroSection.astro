---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';

/** Fondo hero “aurora”: A = institucional (sutil), B = más visible. Cambiar solo esta línea para comparar. */
const heroAuroraVariant: 'A' | 'B' = 'A';
---

<Container>
  <section
    class:list={[
      'hero-section__section',
      heroAuroraVariant === 'B' && 'hero-section__section--aurora-b',
    ]}
  >
    <!-- Capas reales (no ::before): overflow:hidden recortaba el blur y el efecto casi no se veía -->
    <div class="hero-aurora-layers" aria-hidden="true">
      <span class="hero-aurora-layers__spot hero-aurora-layers__spot--1"></span>
      <span class="hero-aurora-layers__spot hero-aurora-layers__spot--2"></span>
    </div>
    <div class="hero-section__text">
      <h1 class="hero-title">Tu trading merece más que buenas intenciones</h1>
      <p class="hero-subline">
        <span>Pioneros en verificación de disciplina automatizada</span><br />
        <span>y gestión de riesgo para mercados financieros.</span>
      </p>
      <div class="hero-tagline">
        <span class="hero-tagline__dot"></span>
        <span class="hero-tagline__text">Where precision meets the edge</span>
      </div>
      <a href="/company/contact?flow=demo" class="hero-download-btn">
        Descargar demo →
      </a>
      <p class="hero-platform-note">Disponible en MT5 · Próximamente: más plataformas</p>
      {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
    </div>
    <div class="hero-section__image">
      <div class="hero-image__wrapper">
        <picture>
          <source type="image/webp" srcset="/mano-robotica-central-web.webp" />
          <img
            src="/mano%20robotica%20central%20web.png"
            alt="tevsys"
            id="home-hero-image"
            width="1200"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <span class="hero-image__brand">Trading Edge Verification System</span>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
    gap: 1rem;
    position: relative;
    isolation: isolate;
    border-radius: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .hero-aurora-layers {
    position: absolute;
    inset: -12% -8% -18% -8%;
    z-index: 0;
    pointer-events: none;
    overflow: visible;
  }

  .hero-aurora-layers__spot {
    position: absolute;
    border-radius: 50%;
    filter: blur(72px);
    will-change: transform, opacity;
    transform: translateZ(0);
  }

  /* Variante A — sutil pero visible */
  .hero-aurora-layers__spot--1 {
    top: -5%;
    left: -5%;
    width: min(58vw, 580px);
    height: min(58vw, 580px);
    background: radial-gradient(
      circle at 40% 40%,
      rgba(56, 189, 248, 0.32) 0%,
      rgba(34, 197, 194, 0.14) 38%,
      transparent 62%
    );
    animation: hero-aurora-spot-1 20s ease-in-out infinite alternate;
  }

  .hero-aurora-layers__spot--2 {
    bottom: -8%;
    right: -10%;
    width: min(52vw, 520px);
    height: min(52vw, 520px);
    background: radial-gradient(
      circle at 55% 55%,
      rgba(96, 165, 250, 0.26) 0%,
      rgba(59, 130, 246, 0.12) 42%,
      transparent 65%
    );
    animation: hero-aurora-spot-2 24s ease-in-out infinite alternate;
  }

  /* Variante B — más intensidad */
  .hero-section__section--aurora-b .hero-aurora-layers__spot--1 {
    filter: blur(88px);
    background: radial-gradient(
      circle at 40% 40%,
      rgba(56, 189, 248, 0.48) 0%,
      rgba(45, 212, 191, 0.22) 38%,
      transparent 60%
    );
    animation-duration: 13s;
  }

  .hero-section__section--aurora-b .hero-aurora-layers__spot--2 {
    filter: blur(96px);
    background: radial-gradient(
      circle at 55% 55%,
      rgba(129, 140, 248, 0.38) 0%,
      rgba(59, 130, 246, 0.2) 42%,
      transparent 62%
    );
    animation-duration: 16s;
  }

  @keyframes hero-aurora-spot-1 {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.65;
    }
    100% {
      transform: translate(24px, 18px) scale(1.07);
      opacity: 0.95;
    }
  }

  @keyframes hero-aurora-spot-2 {
    0% {
      transform: translate(0, 0) scale(1);
      opacity: 0.5;
    }
    100% {
      transform: translate(-20px, -22px) scale(1.09);
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-aurora-layers__spot {
      animation: none;
      opacity: 0.55;
    }
    .hero-section__section--aurora-b .hero-aurora-layers__spot {
      opacity: 0.7;
    }
  }

  @media (max-width: 768px) {
    .hero-aurora-layers__spot {
      filter: blur(56px);
    }
    .hero-section__section--aurora-b .hero-aurora-layers__spot {
      filter: blur(68px);
    }
  }

  .hero-section__text {
    grid-column: 1;
    justify-self: center;
    max-width: 25rem;
    position: relative;
    z-index: 1;
  }
  .hero-title {
    font-family: 'Outfit', -apple-system, sans-serif;
  }
  .hero-subline {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    opacity: 0.9;
    max-width: 34ch;
  }
  .hero-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    border: none;
    border-radius: 2rem;
    background: #f5b041;
    color: #1a1510;
    text-decoration: none;
  }
  .hero-platform-note {
    margin: 0.65rem 0 0;
    font-size: 0.76rem;
    opacity: 0.78;
  }
  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 1.2rem;
    margin: 1rem 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.03);
  }
  .hero-tagline__dot {
    width: 22px;
    height: 22px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-tagline__text {
    font-size: 1.05rem;
    opacity: 0.95;
  }
  .hero-section__image {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    position: relative;
    z-index: 1;
  }
  .hero-image__wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
  }
  .hero-image__brand {
    margin-top: 0.75rem;
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.02em;
  }
  .hero-image__wrapper img,
  .hero-section__image img {
    width: 100%;
    min-width: 420px;
    max-width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    object-position: right top;
    border-radius: var(--theme-shape-radius);
  }
  @media (max-width: 768px) {
    .hero-section__section {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 1.25rem;
    }
    .hero-section__text {
      justify-self: stretch;
      max-width: 100%;
    }
    .hero-section__image {
      grid-column: 1;
      grid-row: auto;
      align-items: center;
    }
    .hero-image__wrapper {
      width: 100%;
      justify-content: center;
    }
    .hero-image__wrapper img,
    .hero-section__image img {
      min-width: unset;
      width: min(96vw, 540px);
      max-height: none;
    }
    .hero-image__brand {
      align-self: center;
      text-align: center;
    }
  }
  @media (max-width: 420px) {
    .hero-image__wrapper img,
    .hero-section__image img {
      width: 100%;
    }
  }
</style>
