---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';

const heroProductPillars = [
  'Precisión de cierre verificable',
  'Disciplina automatizada',
  'Trazabilidad contrastable con MT5',
  'Protección activa en toda la cuenta',
];
---

<Container>
  <section class="hero-section__section" data-hero-layout="scheme-2m-e-column">
    <div class="hero-section__glow" aria-hidden="true"></div>
    <div class="hero-section__inner">
      <div class="hero-section__text">
        <h1 class="hero-title">
          <span class="hero-title__line">Tú pones los límites.</span>
          <span class="hero-title__line hero-title__line--accent">
            <span class="hero-title__brand">TEVSYS</span> los blinda.
          </span>
        </h1>
        <div class="hero-pillar-fade" aria-label="Capas del producto tevsys">
          <div class="hero-pillar-fade__stage" data-hero-pillar-stage>
            <div class="hero-pillar-fade__mark" data-hero-pillar-mark aria-hidden="true">
              <img
                src="/favicon.png"
                alt=""
                width="96"
                height="96"
                decoding="async"
                fetchpriority="low"
              />
            </div>
            {heroProductPillars.map((phrase, index) => (
              <p class="hero-pillar-fade__phrase" data-hero-pillar-index={index}>
                {phrase}
              </p>
            ))}
          </div>
        </div>
        <div class="hero-action-block">
          <p class="hero-disclaimer">
            No damos señales ni promesas de beneficio.
          </p>
          <div class="hero-cta-row">
            <a href="/company/contact?flow=demo" class="hero-download-btn">
              Descargar demo →
            </a>
            <a href="/como-funciona?play=1#evidencia-nasdaq-100" class="hero-audit-btn">
              Ver evidencia (~4 min)
            </a>
          </div>
        </div>
        {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
      </div>
      <div class="hero-section__image">
        <div class="hero-image__wrapper">
          <div class="hero-image__media">
            <picture class="hero-image__picture">
              <img
                class="hero-image__img"
                src="/mano%20robotica%20central%20web.png?v=2"
                alt="tevsys"
                id="home-hero-image"
                width="1200"
                height="800"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <span class="hero-image__brand" lang="en" translate="no">Trading Edge Verification System</span>
        </div>
        <p class="hero-platform-note">Disponible en MT5 · Próximamente: más plataformas</p>
      </div>
    </div>
  </section>
</Container>

<script define:vars={{ heroProductPillars }}>
  const HERO_PILLAR_TIMING = {
    emptyMs: 900,
    emptyMsMobile: 1050,
    batchFadeInDelayMs: 650,
    batchPhraseFadeInMs: 2400,
    batchPhraseFadeInMsMobile: 2200,
    batchPhraseInGapMs: 340,
    batchPhraseInGapMsMobile: 400,
    batchPhraseFadeOutMs: 2100,
    batchPhraseFadeOutMsMobile: 1950,
    batchPhraseOutGapMs: 340,
    batchPhraseOutGapMsMobile: 400,
    batchHoldMs: 420,
    batchHoldMsMobile: 520,
    soloHoldMs: 4000,
    soloStartGapMs: 780,
    soloRepositionFadeOutMs: 920,
    soloFadeInMs: 2600,
    soloFadeInMsMobile: 2400,
    soloFadeOutMs: 1400,
    loopPauseMs: 3200,
    loopPauseMsMobile: 2800,
  };

  const HERO_GLOW_IN_EASE = 'cubic-bezier(0.22, 0, 0.08, 1)';
  const HERO_FADE_OUT_EASE = 'cubic-bezier(0.42, 0, 0.18, 1)';

  const HERO_MOBILE_MQ = '(max-width: 768px)';

  const HERO_BATCH_ENTER_Y = '0.3rem';

  const HERO_PILLAR_SOLO_SLOTS = [
    { top: '8%', left: '3%', right: 'auto', align: 'left', maxW: '54%' },
    { top: '20%', left: 'auto', right: '7%', align: 'right', maxW: '46%' },
    { top: '34%', left: '28%', right: 'auto', align: 'left', maxW: '44%' },
    { top: '48%', left: 'auto', right: '14%', align: 'right', maxW: '48%' },
    { top: '56%', left: '6%', right: 'auto', align: 'left', maxW: '50%' },
    { top: '68%', left: 'auto', right: '5%', align: 'right', maxW: '52%' },
    { top: '14%', left: '36%', right: 'auto', align: 'left', maxW: '42%' },
    { top: '62%', left: '38%', right: 'auto', align: 'left', maxW: '40%' },
  ];

  const HERO_PILLAR_SOLO_SLOTS_MOBILE = [
    { top: '3%', left: '8%', right: 'auto', align: 'left', maxW: '78%' },
    { top: '24%', left: 'auto', right: '5%', align: 'right', maxW: '74%' },
    { top: '46%', left: '4%', right: 'auto', align: 'left', maxW: '82%' },
    { top: '64%', left: 'auto', right: '9%', align: 'right', maxW: '76%' },
  ];

  function isMobileHero() {
    return window.matchMedia(HERO_MOBILE_MQ).matches;
  }

  function getHeroTiming(key) {
    const mobile = isMobileHero();
    if (mobile && `${key}Mobile` in HERO_PILLAR_TIMING) {
      return HERO_PILLAR_TIMING[`${key}Mobile`];
    }
    return HERO_PILLAR_TIMING[key];
  }

  function isPhraseVisible(el) {
    return el.style.visibility !== 'hidden' && parseFloat(el.style.opacity || '0') > 0.02;
  }

  function setBatchLayout(stage, active) {
    stage.classList.toggle('hero-pillar-fade__stage--batch', active);
    if (active) stage.classList.remove('hero-pillar-fade__stage--solo');
  }

  function setSoloLayout(stage, active) {
    stage.classList.toggle('hero-pillar-fade__stage--solo', active);
    if (active) stage.classList.remove('hero-pillar-fade__stage--batch');
  }

  function measureAndLockStageHeight(stage, phrases) {
    if (stage.dataset.heroPillarHeightLocked === '1') return;

    setBatchLayout(stage, true);
    prepareAbsolutePhrases(phrases);

    phrases.forEach((el) => {
      el.style.transition = 'none';
      el.style.visibility = 'visible';
      el.style.opacity = '1';
      el.style.transform = 'none';
    });

    const height = Math.ceil(stage.getBoundingClientRect().height);
    const lockedHeight = `${height}px`;
    stage.style.setProperty('--hero-pillar-stage-min', lockedHeight);
    const wrap = stage.parentElement;
    if (wrap?.classList.contains('hero-pillar-fade')) {
      wrap.style.setProperty('--hero-pillar-stage-min', lockedHeight);
    }
    stage.classList.add('hero-pillar-fade__stage--height-locked');
    stage.dataset.heroPillarHeightLocked = '1';

    phrases.forEach((el) => setPhraseHiddenInstant(el));
  }

  function prepareAbsolutePhrases(phrases) {
    phrases.forEach((el) => {
      el.style.position = '';
      el.style.top = '';
      el.style.left = '';
      el.style.right = '';
      el.style.maxWidth = '';
      el.style.textAlign = '';
      el.style.width = '';
    });
  }

  function getSoloSlotPool() {
    return isMobileHero() ? HERO_PILLAR_SOLO_SLOTS_MOBILE : HERO_PILLAR_SOLO_SLOTS;
  }

  function shuffle(list) {
    const copy = [...list];
    for (let i = copy.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function applyPillarSlot(el, slot) {
    el.style.top = slot.top;
    el.style.left = slot.left;
    el.style.right = slot.right;
    el.style.maxWidth = slot.maxW;
    el.style.textAlign = slot.align;
  }

  function setPhraseHiddenInstant(el) {
    el.style.transition = 'none';
    el.style.opacity = '0';
    el.style.visibility = 'hidden';
    el.style.transform = 'none';
    el.style.filter = 'none';
  }

  async function glowPhrase(el, visible, ms, easing = HERO_GLOW_IN_EASE) {
    el.style.transition = `opacity ${ms}ms ${easing}, visibility 0s linear`;
    if (visible) {
      el.style.visibility = 'visible';
      el.style.opacity = '0';
      await sleep(20);
      el.style.opacity = '1';
    } else {
      el.style.opacity = '0';
    }
    await sleep(ms);
    if (!visible) el.style.visibility = 'hidden';
  }

  async function fadeBatchInTogether(phrases) {
    const phraseFadeMs = getHeroTiming('batchPhraseFadeInMs');
    const gapMs = getHeroTiming('batchPhraseInGapMs');
    const { batchFadeInDelayMs } = HERO_PILLAR_TIMING;

    phrases.forEach((el) => setPhraseHiddenInstant(el));
    await sleep(32);
    await sleep(batchFadeInDelayMs);

    for (let i = 0; i < phrases.length; i += 1) {
      const el = phrases[i];
      el.style.transition = `opacity ${phraseFadeMs}ms ${HERO_GLOW_IN_EASE}, transform ${phraseFadeMs}ms ${HERO_GLOW_IN_EASE}, visibility 0s linear`;
      el.style.visibility = 'visible';
      el.style.opacity = '0';
      el.style.transform = `translateY(${HERO_BATCH_ENTER_Y})`;
      await sleep(28);
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
      await sleep(phraseFadeMs + (i < phrases.length - 1 ? gapMs : 0));
    }
  }

  async function fadeOutBatchColumn(phrases, stage) {
    const fadeMs = getHeroTiming('batchPhraseFadeOutMs');
    const gapMs = getHeroTiming('batchPhraseOutGapMs');

    for (let i = 0; i < phrases.length; i += 1) {
      const el = phrases[i];
      if (!isPhraseVisible(el)) continue;

      el.style.transition = `opacity ${fadeMs}ms ${HERO_FADE_OUT_EASE}, transform ${fadeMs}ms ${HERO_FADE_OUT_EASE}, visibility 0s linear`;
      el.style.opacity = '0';
      el.style.transform = `translateY(-${HERO_BATCH_ENTER_Y})`;
      await sleep(fadeMs + (i < phrases.length - 1 ? gapMs : 0));
    }

    phrases.forEach((el) => {
      el.style.visibility = 'hidden';
      el.style.transform = 'none';
    });

    setSoloLayout(stage, true);
    prepareAbsolutePhrases(phrases);

    return shuffle(phrases.map((_, index) => index));
  }

  async function movePhraseToSlot(el, slot, { fadeOutMs = 0 } = {}) {
    if (fadeOutMs > 0 && isPhraseVisible(el)) {
      await glowPhrase(el, false, fadeOutMs, HERO_FADE_OUT_EASE);
    } else {
      setPhraseHiddenInstant(el);
    }
    applyPillarSlot(el, slot);
    await sleep(36);
  }

  async function glowMark(el, visible, ms, easing = HERO_GLOW_IN_EASE) {
    if (!el) return;
    el.style.transition = `opacity ${ms}ms ${easing}, visibility 0s linear`;
    if (visible) {
      el.style.visibility = 'visible';
      el.style.opacity = '0';
      await sleep(20);
      el.style.opacity = '1';
    } else {
      el.style.opacity = '0';
    }
    await sleep(ms);
    if (!visible) el.style.visibility = 'hidden';
  }

  function setMarkHiddenInstant(el) {
    if (!el) return;
    el.style.transition = 'none';
    el.style.opacity = '0';
    el.style.visibility = 'hidden';
  }

  async function runHeroPillarCycle(phrases, stage) {
    const soloFadeInMs = getHeroTiming('soloFadeInMs');
    const mark = stage.querySelector('[data-hero-pillar-mark]');

    setBatchLayout(stage, true);
    prepareAbsolutePhrases(phrases);
    phrases.forEach((el) => setPhraseHiddenInstant(el));
    setMarkHiddenInstant(mark);
    await sleep(32);

    await sleep(getHeroTiming('emptyMs'));

    const markInMs = Math.round(getHeroTiming('batchPhraseFadeInMs') * 0.85);
    await Promise.all([glowMark(mark, true, markInMs), fadeBatchInTogether(phrases)]);
    await sleep(getHeroTiming('batchHoldMs'));

    const markOutMs = getHeroTiming('batchPhraseFadeOutMs');
    const remainingSoloIndices = await Promise.all([
      fadeOutBatchColumn(phrases, stage),
      glowMark(mark, false, markOutMs),
    ]).then(([indices]) => indices);

    await sleep(280);

    await glowMark(mark, true, Math.round(soloFadeInMs * 0.75));

    const slots = shuffle(getSoloSlotPool()).slice(0, remainingSoloIndices.length);

    for (let i = 0; i < remainingSoloIndices.length; i += 1) {
      const el = phrases[remainingSoloIndices[i]];
      const slot = slots[i];
      await movePhraseToSlot(el, slot, { fadeOutMs: HERO_PILLAR_TIMING.soloRepositionFadeOutMs });
      await glowPhrase(el, true, soloFadeInMs, HERO_GLOW_IN_EASE);
      await sleep(HERO_PILLAR_TIMING.soloHoldMs);
      await glowPhrase(el, false, HERO_PILLAR_TIMING.soloFadeOutMs, HERO_FADE_OUT_EASE);
      await sleep(HERO_PILLAR_TIMING.soloStartGapMs);
    }

    await glowMark(mark, false, HERO_PILLAR_TIMING.soloFadeOutMs, HERO_FADE_OUT_EASE);
    await sleep(getHeroTiming('loopPauseMs'));
  }

  function initHeroPillarFade() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const stage = document.querySelector('[data-hero-pillar-stage]');
    if (!stage || stage.dataset.heroPillarInit === '1') return;

    const phrases = [...stage.querySelectorAll('.hero-pillar-fade__phrase')];
    if (phrases.length === 0) return;

    const mark = stage.querySelector('[data-hero-pillar-mark]');
    if (mark) setMarkHiddenInstant(mark);

    stage.dataset.heroPillarInit = '1';
    stage.classList.add('hero-pillar-fade__stage--js');
    measureAndLockStageHeight(stage, phrases);

    (async () => {
      while (stage.isConnected) {
        await runHeroPillarCycle(phrases, stage);
      }
    })();
  }

  initHeroPillarFade();
  document.addEventListener('astro:page-load', initHeroPillarFade);
</script>

<style>
  .hero-section__section {
    --hero-tech-font: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
    margin: var(--section-margin) auto;
    min-height: clamp(88vh, 92vw, calc(100vh - var(--navbar-height)));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }

  .hero-section__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 88% 78% at 90% 30%, rgba(245, 176, 65, 0.14) 0%, transparent 58%),
      radial-gradient(ellipse 60% 55% at 96% 68%, rgba(255, 210, 120, 0.08) 0%, transparent 52%),
      radial-gradient(ellipse 50% 45% at 78% 45%, rgba(247, 192, 80, 0.05) 0%, transparent 46%);
  }

  .hero-section__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    min-height: 0;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1rem clamp(1.35rem, 3.5vh, 2.35rem);
    box-sizing: border-box;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .hero-section__text {
    --hero-disclaimer-font-size: clamp(0.9375rem, 1.05vw + 0.28rem, 1.0625rem);
    max-width: min(52rem, 100%);
    width: 100%;
    min-width: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding-inline: clamp(0.5rem, 2vw, 1rem);
    box-sizing: border-box;
  }

  /* Esquema 2 — H1 dos líneas, escala tipo landing quant (sin forzar una sola línea). */
  .hero-title {
    font-family: var(--tevsys-display-title-font, 'DM Sans', 'Inter', system-ui, sans-serif);
    font-weight: var(--tevsys-display-title-weight, 600);
    font-size: clamp(2rem, calc(5.4vw + 0.5rem), 4.35rem);
    line-height: 1.06;
    letter-spacing: var(--tevsys-display-title-tracking, -0.03em);
    margin: 0 0 clamp(1rem, 2.5vh, 1.65rem);
    width: 100%;
    max-width: min(42rem, 100%);
    margin-inline: auto;
    color: #e8ebf0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.28em;
    text-wrap: balance;
  }

  .hero-title__line {
    display: block;
  }

  .hero-title__brand {
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #f5b041;
    text-decoration: none;
  }

  .hero-pillar-fade {
    position: relative;
    z-index: 1;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    margin: 0 0 clamp(1.15rem, 2.8vh, 1.85rem);
    padding: 0;
    box-sizing: border-box;
    min-height: var(--hero-pillar-stage-min, clamp(10rem, 24vh, 12.5rem));
  }

  .hero-pillar-fade__stage {
    position: relative;
    width: 100%;
    min-height: clamp(10rem, 24vh, 12.5rem);
    margin: 0;
    padding: 0;
  }

  .hero-pillar-fade__mark {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 0;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 0;
    line-height: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 1.4s cubic-bezier(0.33, 0, 0.18, 1);
  }

  .hero-pillar-fade__mark img {
    display: block;
    width: clamp(3.75rem, 11vw, 5.25rem);
    height: auto;
    filter: grayscale(1) brightness(1.05) contrast(0.82);
    opacity: var(--hero-mark-img-opacity, 0.2);
  }

  .hero-pillar-fade__stage--js .hero-pillar-fade__phrase {
    z-index: 1;
  }

  .hero-pillar-fade__stage--js.hero-pillar-fade__stage--batch .hero-pillar-fade__mark {
    --hero-mark-img-opacity: 0.14;
  }

  .hero-pillar-fade__stage--js.hero-pillar-fade__stage--solo .hero-pillar-fade__mark {
    --hero-mark-img-opacity: 0.22;
  }

  .hero-pillar-fade__stage--js.hero-pillar-fade__stage--height-locked,
  .hero-pillar-fade__stage--js.hero-pillar-fade__stage--solo {
    min-height: var(--hero-pillar-stage-min, clamp(10rem, 24vh, 12.5rem));
  }

  .hero-pillar-fade__phrase {
    position: absolute;
    top: var(--fade-top, 0);
    left: var(--fade-left, 0);
    right: var(--fade-right, auto);
    width: auto;
    max-width: var(--fade-max-w, 100%);
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: var(--hero-tech-font);
    font-size: clamp(0.8125rem, 1.15vw, 0.875rem);
    font-weight: 400;
    line-height: 1.38;
    letter-spacing: 0.028em;
    font-variant-numeric: tabular-nums;
    color: #e4e8f0;
    text-align: var(--fade-align, left);
    text-wrap: balance;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: none;
    transition: opacity 1.4s cubic-bezier(0.33, 0, 0.18, 1);
  }

  .hero-pillar-fade__stage--js .hero-pillar-fade__phrase {
    animation: none;
  }

  .hero-pillar-fade__stage--js.hero-pillar-fade__stage--batch {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.42rem, 1.25vh, 0.68rem);
    min-height: var(--hero-pillar-stage-min, clamp(10rem, 24vh, 12.5rem));
  }

  .hero-pillar-fade__stage--js.hero-pillar-fade__stage--batch::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 8%;
    bottom: 8%;
    width: 1px;
    transform: translateX(-50%);
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(245, 176, 65, 0.08) 18%,
      rgba(245, 176, 65, 0.18) 50%,
      rgba(245, 176, 65, 0.08) 82%,
      transparent 100%
    );
    pointer-events: none;
    opacity: 0.5;
  }

  .hero-pillar-fade__stage--js.hero-pillar-fade__stage--batch .hero-pillar-fade__phrase {
    position: relative;
    top: auto;
    left: auto;
    right: auto;
    width: auto;
    max-width: min(26rem, 100%);
    text-align: center;
    padding-inline: clamp(0.35rem, 2vw, 0.75rem);
    color: rgba(228, 232, 240, 0.9);
    letter-spacing: 0.028em;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pillar-fade__stage {
      min-height: auto;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .hero-pillar-fade__phrase {
      position: static;
      opacity: 0.82;
      visibility: visible;
      animation: none;
      transition: none;
    }

    .hero-pillar-fade__mark {
      position: static;
      transform: none;
      opacity: 0.12;
      visibility: visible;
      align-self: center;
      margin: 0.35rem 0;
    }

    .hero-pillar-fade__mark img {
      width: 3rem;
      opacity: 0.18;
    }
  }

  .hero-action-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;
    width: 100%;
    max-width: min(36rem, 100%);
    margin-top: 0;
    gap: 0;
  }

  .hero-disclaimer {
    margin: 0 0 clamp(1.65rem, 4vw, 2.25rem);
    max-width: min(32rem, 100%);
    width: 100%;
    padding: 0 0.35rem;
    box-sizing: border-box;
    font-family: var(--tevsys-display-title-font, 'DM Sans', 'Inter', system-ui, sans-serif);
    font-size: var(--hero-disclaimer-font-size);
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: 0.018em;
    color: rgba(244, 246, 248, 0.9);
    text-align: center;
    text-wrap: balance;
  }

  .hero-cta-row {
    margin-top: 0;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .hero-download-btn {
    gap: 0.5rem;
  }

  .hero-cta-row .hero-download-btn {
    margin-top: 0;
  }

  .hero-audit-btn {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
