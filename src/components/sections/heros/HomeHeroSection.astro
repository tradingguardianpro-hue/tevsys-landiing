---
import { Icon } from 'astro-icon/components';
import { Container, Button } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';
---

<Container>
  <section class="hero-section__section">
    <div class="hero-section__text">
      <h1>Tu capital merece más que buenas intenciones</h1>
      <div class="hero-tagline">
        <span class="hero-tagline__dot"></span>
        <span class="hero-tagline__text">Where precision meets the edge</span>
      </div>
      <div class="hero-btns__container">
        <Button href="/company/contact" customIcon>
          Probar demo
          <Fragment slot="icon">
            <Icon name="ic:baseline-chevron-right"/>
          </Fragment>
        </Button>
        <Button href="/company/contact" unelevated>Contactar</Button>
      </div>
      {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
    </div>
    <div class="hero-section__image">
      <picture>
        <img
          src="/hero-tevsys.png"
          alt="tevsys"
          id="home-hero-image"
        />
      </picture>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 1rem;
  }
  .hero-section__text {
    justify-self: center;
    max-width: 25rem;
  }
  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.03);
  }
  .hero-tagline__dot {
    width: 12px;
    height: 12px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-tagline__text {
    font-size: 1rem;
    opacity: 0.95;
  }
  .hero-btns__container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hero-section__image {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-section__image img {
    width: 100%;
    max-width: 560px;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    border-radius: var(--theme-shape-radius);
  }
  @media (max-width: 768px) {
    .hero-section__section {
      grid-template-columns: 1fr;
    }
  }
</style>
