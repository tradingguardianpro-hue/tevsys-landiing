---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';

const heroProductPillars = [
  'Precisión de cierre verificable',
  'Disciplina automatizada',
  'Trazabilidad contrastable con MT5',
  'Protección activa en toda la cuenta',
];
---

<Container>
  <section class="hero-section__section" data-hero-layout="scheme-2m-e-column">
    <div class="hero-section__glow" aria-hidden="true"></div>
    <div class="hero-section__inner">
      <div class="hero-section__text">
        <h1 class="hero-title">
          <span class="hero-title__line">Tú pones los límites.</span>
          <span class="hero-title__line hero-title__line--accent">
            <span class="hero-title__brand">TEVSYS</span> los blinda.
          </span>
        </h1>
        <div class="hero-pillar-fade" aria-label="Capas del producto tevsys">
          <div class="hero-pillar-fade__stage" data-hero-pillar-stage>
            <div class="hero-pillar-fade__mark" data-hero-pillar-mark aria-hidden="true">
              <img
                class="hero-pillar-fade__mark-icon"
                src="/hero-tevsys-chevrons.png"
                alt=""
                width="346"
                height="348"
                decoding="async"
                fetchpriority="low"
              />
            </div>
            {heroProductPillars.map((phrase, index) => (
              <p class="hero-pillar-fade__phrase" data-hero-pillar-index={index}>
                {phrase}
              </p>
            ))}
          </div>
        </div>
        <div class="hero-action-block">
          <p class="hero-disclaimer">
            No damos señales ni promesas de beneficio.
          </p>
          <div class="hero-cta-row">
            <a href="/company/contact?flow=demo" class="hero-download-btn">
              Descargar demo →
            </a>
            <a href="/como-funciona?play=1#evidencia-nasdaq-100" class="hero-audit-btn hero-audit-btn--secondary">
              Ver evidencia (~4 min)
            </a>
          </div>
        </div>
        {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
      </div>
      <div class="hero-section__image">
        <div class="hero-image__wrapper">
          <div class="hero-image__media">
            <picture class="hero-image__picture">
              <img
                class="hero-image__img"
                src="/mano%20robotica%20central%20web.png?v=2"
                alt="tevsys"
                id="home-hero-image"
                width="1200"
                height="800"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <span class="hero-image__brand" lang="en" translate="no">Trading Edge Verification System</span>
        </div>
        <p class="hero-platform-note">· Disponible en MT5 ·</p>
      </div>
    </div>
  </section>
</Container>

<script define:vars={{ heroProductPillars }}>
  const HERO_PILLAR_TIMING = {
    /* Arranque antes (25 jul): titular ~2–3 s → blur ya emergiendo (no vacío largo). */
    emptyMs: 400,
    emptyMsMobile: 480,
    /* Bucles: menos aire muerto antes de la marca. */
    emptyMsSoft: 220,
    emptyMsSoftMobile: 260,
    /* Handoff logo→frases: sin aire (el delay lo mata el solape). */
    batchFadeInDelayMs: 0,
    batchPhraseFadeInMs: 2400,
    batchPhraseFadeInMsMobile: 2200,
    batchPhraseInGapMs: 340,
    batchPhraseInGapMsMobile: 400,
    batchPhraseFadeOutMs: 2100,
    batchPhraseFadeOutMsMobile: 1950,
    batchPhraseOutGapMs: 340,
    batchPhraseOutGapMsMobile: 400,
    batchHoldMs: 420,
    batchHoldMsMobile: 520,
    soloHoldMs: 4000,
    soloStartGapMs: 780,
    soloRepositionFadeOutMs: 920,
    soloFadeInMs: 2600,
    soloFadeInMsMobile: 2400,
    soloFadeOutMs: 1400,
    loopPauseMs: 2400,
    loopPauseMsMobile: 2100,
    introMarkDelayMs: 280,
    introMarkDelayMsMobile: 220,
    introMarkDelayMsSoft: 120,
    introMarkDelayMsSoftMobile: 100,
    /* Misma alma blur; un poco menos de tramo casi invisible al inicio. */
    introMarkFadeInMs: 5200,
    introMarkFadeInMsMobile: 4800,
    introMarkFadeInMsSoft: 3400,
    introMarkFadeInMsSoftMobile: 3100,
    /* Nítido en pantalla: 2–2,2 s (antes 3) → blur salida + 1.ª frase. */
    introMarkHoldMs: 2200,
    introMarkHoldMsMobile: 2000,
    introMarkHoldMsSoft: 1500,
    introMarkHoldMsSoftMobile: 1400,
    introMarkFadeOutMs: 3000,
    introMarkFadeOutMsMobile: 2700,
    introMarkFadeOutMsSoft: 2400,
    introMarkFadeOutMsSoftMobile: 2200,
    introMarkGapBeforeBatchMs: 0,
  };

  const HERO_GLOW_IN_EASE = 'cubic-bezier(0.22, 0, 0.08, 1)';
  const HERO_FADE_OUT_EASE = 'cubic-bezier(0.42, 0, 0.18, 1)';
  /* Intro marca: mucho tiempo casi invisible → emerge sin golpe (no “susto”). */
  const HERO_MARK_SURFACE_IN_EASE = 'cubic-bezier(0.45, 0.02, 0.22, 1)';
  /* Misma curva que la aparición — el blur de salida se siente igual de “alma”. */
  const HERO_MARK_SURFACE_OUT_EASE = 'cubic-bezier(0.45, 0.02, 0.22, 1)';

  const HERO_MOBILE_MQ = '(max-width: 768px)';

  const HERO_BATCH_ENTER_Y = '0.3rem';
  const HERO_MARK_ENTER_Y = '0.85rem';
  const HERO_MARK_INTRO_BLUR = '14px';

  /* Solo: perímetro; maxW hasta el borde del chevron; una sola línea. */
  const HERO_PILLAR_SOLO_SLOTS = [
    { top: '6%', left: '1%', right: 'auto', align: 'left', maxW: 'calc(50% - 3.75rem)' },
    { top: '8%', left: 'auto', right: '1%', align: 'right', maxW: 'calc(50% - 3.75rem)' },
    { top: '28%', left: '1%', right: 'auto', align: 'left', maxW: 'calc(50% - 3.75rem)' },
    { top: '30%', left: 'auto', right: '1%', align: 'right', maxW: 'calc(50% - 3.75rem)' },
    { top: '52%', left: '1%', right: 'auto', align: 'left', maxW: 'calc(50% - 3.75rem)' },
    { top: '54%', left: 'auto', right: '1%', align: 'right', maxW: 'calc(50% - 3.75rem)' },
    { top: '74%', left: '1%', right: 'auto', align: 'left', maxW: 'calc(50% - 3.75rem)' },
    { top: '72%', left: 'auto', right: '1%', align: 'right', maxW: 'calc(50% - 3.75rem)' },
  ];

  const HERO_PILLAR_SOLO_SLOTS_MOBILE = [
    { top: '2%', left: '2%', right: 'auto', align: 'left', maxW: 'calc(50% - 2.5rem)' },
    { top: '4%', left: 'auto', right: '2%', align: 'right', maxW: 'calc(50% - 2.5rem)' },
    { top: '58%', left: '2%', right: 'auto', align: 'left', maxW: 'calc(50% - 2.5rem)' },
    { top: '74%', left: 'auto', right: '2%', align: 'right', maxW: 'calc(50% - 2.5rem)' },
  ];

  function isMobileHero() {
    return window.matchMedia(HERO_MOBILE_MQ).matches;
  }

  function getHeroTiming(key, { soft = false } = {}) {
    const mobile = isMobileHero();
    if (soft) {
      const softKey = `${key}Soft`;
      if (mobile && `${softKey}Mobile` in HERO_PILLAR_TIMING) {
        return HERO_PILLAR_TIMING[`${softKey}Mobile`];
      }
      if (softKey in HERO_PILLAR_TIMING) {
        return HERO_PILLAR_TIMING[softKey];
      }
    }
    if (mobile && `${key}Mobile` in HERO_PILLAR_TIMING) {
      return HERO_PILLAR_TIMING[`${key}Mobile`];
    }
    return HERO_PILLAR_TIMING[key];
  }

  function isPhraseVisible(el) {
    return el.style.visibility !== 'hidden' && parseFloat(el.style.opacity || '0') > 0.02;
  }

  function setBatchLayout(stage, active) {
    stage.classList.toggle('hero-pillar-fade__stage--batch', active);
    if (active) stage.classList.remove('hero-pillar-fade__stage--solo');
  }

  function setSoloLayout(stage, active) {
    stage.classList.toggle('hero-pillar-fade__stage--solo', active);
    if (active) stage.classList.remove('hero-pillar-fade__stage--batch');
  }

  function measureAndLockStageHeight(stage, phrases) {
    if (stage.dataset.heroPillarHeightLocked === '1') return;

    setBatchLayout(stage, true);
    prepareAbsolutePhrases(phrases);

    phrases.forEach((el) => {
      el.style.transition = 'none';
      el.style.visibility = 'visible';
      el.style.opacity = '1';
      el.style.transform = 'none';
    });

    const height = Math.ceil(stage.getBoundingClientRect().height);
    const lockedHeight = `${height}px`;
    stage.style.setProperty('--hero-pillar-stage-min', lockedHeight);
    const wrap = stage.parentElement;
    if (wrap?.classList.contains('hero-pillar-fade')) {
      wrap.style.setProperty('--hero-pillar-stage-min', lockedHeight);
    }
    stage.classList.add('hero-pillar-fade__stage--height-locked');
    stage.dataset.heroPillarHeightLocked = '1';

    phrases.forEach((el) => setPhraseHiddenInstant(el));
  }

  function prepareAbsolutePhrases(phrases) {
    phrases.forEach((el) => {
      el.style.position = '';
      el.style.top = '';
      el.style.left = '';
      el.style.right = '';
      el.style.maxWidth = '';
      el.style.textAlign = '';
      el.style.width = '';
    });
  }

  function getSoloSlotPool() {
    return isMobileHero() ? HERO_PILLAR_SOLO_SLOTS_MOBILE : HERO_PILLAR_SOLO_SLOTS;
  }

  function shuffle(list) {
    const copy = [...list];
    for (let i = copy.length - 1; i > 0; i -= 1) {
      const j = Math.floor(Math.random() * (i + 1));
      [copy[i], copy[j]] = [copy[j], copy[i]];
    }
    return copy;
  }

  function sleep(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  function applyPillarSlot(el, slot) {
    el.style.top = slot.top;
    el.style.left = slot.left;
    el.style.right = slot.right;
    el.style.maxWidth = slot.maxW;
    el.style.textAlign = slot.align;
  }

  function setPhraseHiddenInstant(el) {
    el.style.transition = 'none';
    el.style.opacity = '0';
    el.style.visibility = 'hidden';
    el.style.transform = 'none';
    el.style.filter = 'none';
  }

  async function glowPhrase(el, visible, ms, easing = HERO_GLOW_IN_EASE) {
    el.style.transition = `opacity ${ms}ms ${easing}, visibility 0s linear`;
    if (visible) {
      el.style.visibility = 'visible';
      el.style.opacity = '0';
      await sleep(20);
      el.style.opacity = '1';
    } else {
      el.style.opacity = '0';
    }
    await sleep(ms);
    if (!visible) el.style.visibility = 'hidden';
  }

  async function fadeBatchInTogether(phrases) {
    const phraseFadeMs = getHeroTiming('batchPhraseFadeInMs');
    const gapMs = getHeroTiming('batchPhraseInGapMs');
    const { batchFadeInDelayMs } = HERO_PILLAR_TIMING;

    phrases.forEach((el) => setPhraseHiddenInstant(el));
    await sleep(32);
    await sleep(batchFadeInDelayMs);

    for (let i = 0; i < phrases.length; i += 1) {
      const el = phrases[i];
      el.style.transition = `opacity ${phraseFadeMs}ms ${HERO_GLOW_IN_EASE}, transform ${phraseFadeMs}ms ${HERO_GLOW_IN_EASE}, visibility 0s linear`;
      el.style.visibility = 'visible';
      el.style.opacity = '0';
      el.style.transform = `translateY(${HERO_BATCH_ENTER_Y})`;
      await sleep(28);
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
      await sleep(phraseFadeMs + (i < phrases.length - 1 ? gapMs : 0));
    }
  }

  async function fadeOutBatchColumn(phrases, stage) {
    const fadeMs = getHeroTiming('batchPhraseFadeOutMs');
    const gapMs = getHeroTiming('batchPhraseOutGapMs');

    for (let i = 0; i < phrases.length; i += 1) {
      const el = phrases[i];
      if (!isPhraseVisible(el)) continue;

      el.style.transition = `opacity ${fadeMs}ms ${HERO_FADE_OUT_EASE}, transform ${fadeMs}ms ${HERO_FADE_OUT_EASE}, visibility 0s linear`;
      el.style.opacity = '0';
      el.style.transform = `translateY(-${HERO_BATCH_ENTER_Y})`;
      await sleep(fadeMs + (i < phrases.length - 1 ? gapMs : 0));
    }

    phrases.forEach((el) => {
      el.style.visibility = 'hidden';
      el.style.transform = 'none';
    });

    setSoloLayout(stage, true);
    prepareAbsolutePhrases(phrases);

    return shuffle(phrases.map((_, index) => index));
  }

  async function movePhraseToSlot(el, slot, { fadeOutMs = 0 } = {}) {
    if (fadeOutMs > 0 && isPhraseVisible(el)) {
      await glowPhrase(el, false, fadeOutMs, HERO_FADE_OUT_EASE);
    } else {
      setPhraseHiddenInstant(el);
    }
    applyPillarSlot(el, slot);
    await sleep(36);
  }

  function setMarkMode(el, mode) {
    if (!el) return;
    el.classList.remove('hero-pillar-fade__mark--intro', 'hero-pillar-fade__mark--solo');
    if (mode === 'intro') el.classList.add('hero-pillar-fade__mark--intro');
    if (mode === 'solo') el.classList.add('hero-pillar-fade__mark--solo');
  }

  function setMarkHiddenInstant(el) {
    if (!el) return;
    const img = el.querySelector('.hero-pillar-fade__mark-icon');
    el.style.transition = 'none';
    el.style.opacity = '0';
    el.style.visibility = 'hidden';
    el.style.transform = 'translate(-50%, -50%) scale(1)';
    if (img) {
      img.style.transition = 'none';
      img.style.filter = '';
    }
    setMarkMode(el, null);
  }

  /** Solo intro: surge / se va con el mismo blur (aparición = desaparición). */
  async function animateMarkSurface(el, visible, ms) {
    if (!el) return;
    const img = el.querySelector('.hero-pillar-fade__mark-icon');
    const ease = visible ? HERO_MARK_SURFACE_IN_EASE : HERO_MARK_SURFACE_OUT_EASE;
    const base = 'translate(-50%, -50%) scale(1)';
    const enterFrom = `translate(-50%, calc(-50% + ${HERO_MARK_ENTER_Y})) scale(0.9)`;
    const exitTo = `translate(-50%, calc(-50% - ${HERO_MARK_ENTER_Y})) scale(0.9)`;

    setMarkMode(el, 'intro');

    if (visible) {
      el.style.transition = 'none';
      if (img) img.style.transition = 'none';
      el.style.visibility = 'visible';
      el.style.opacity = '0';
      el.style.transform = enterFrom;
      if (img) img.style.filter = `blur(${HERO_MARK_INTRO_BLUR})`;
      await sleep(48);
      el.style.transition = `opacity ${ms}ms ${ease}, transform ${ms}ms ${ease}, visibility 0s linear`;
      if (img) img.style.transition = `filter ${ms}ms ${ease}`;
      el.style.opacity = '1';
      el.style.transform = base;
      if (img) img.style.filter = 'blur(0)';
    } else {
      /* Partir nítido → mismo blur de la aparición (espejo). */
      el.style.transition = 'none';
      if (img) img.style.transition = 'none';
      el.style.opacity = '1';
      el.style.transform = base;
      if (img) img.style.filter = 'blur(0)';
      await sleep(48);
      el.style.transition = `opacity ${ms}ms ${ease}, transform ${ms}ms ${ease}, visibility 0s linear`;
      if (img) img.style.transition = `filter ${ms}ms ${ease}`;
      el.style.opacity = '0';
      el.style.transform = exitTo;
      if (img) img.style.filter = `blur(${HERO_MARK_INTRO_BLUR})`;
    }

    await sleep(ms);

    if (!visible) {
      el.style.visibility = 'hidden';
      el.style.transform = base;
      if (img) {
        img.style.transition = '';
        img.style.filter = '';
      }
      setMarkMode(el, null);
    }
  }

  /** Fase solo: fade corto, sin blur de intro. */
  async function animateMark(el, visible, ms, { mode = null } = {}) {
    if (!el) return;
    if (mode) setMarkMode(el, mode);
    const ease = visible ? HERO_GLOW_IN_EASE : HERO_FADE_OUT_EASE;
    const base = 'translate(-50%, -50%) scale(1)';
    const enterFrom = `translate(-50%, calc(-50% + ${HERO_BATCH_ENTER_Y})) scale(1)`;
    const exitTo = `translate(-50%, calc(-50% - ${HERO_BATCH_ENTER_Y})) scale(1)`;

    el.style.transition = `opacity ${ms}ms ${ease}, transform ${ms}ms ${ease}, visibility 0s linear`;
    if (visible) {
      el.style.visibility = 'visible';
      el.style.opacity = '0';
      el.style.transform = enterFrom;
      await sleep(36);
      el.style.opacity = '1';
      el.style.transform = base;
    } else {
      el.style.opacity = '0';
      el.style.transform = exitTo;
    }
    await sleep(ms);
    if (!visible) {
      el.style.visibility = 'hidden';
      el.style.transform = base;
    }
  }

  function setHomeMarkFocus(on) {
    document.body.classList.toggle('tevsys-home-mark-focus', Boolean(on));
  }

  async function runHeroPillarCycle(phrases, stage, { intro = false, soft = false } = {}) {
    const soloFadeInMs = getHeroTiming('soloFadeInMs');
    const mark = stage.querySelector('[data-hero-pillar-mark]');

    setSoloLayout(stage, false);
    stage.classList.remove(
      'hero-pillar-fade__stage--batch',
      'hero-pillar-fade__stage--intro',
      'hero-pillar-fade__stage--mark-handoff',
    );
    prepareAbsolutePhrases(phrases);
    phrases.forEach((el) => setPhraseHiddenInstant(el));
    setMarkHiddenInstant(mark);
    setHomeMarkFocus(false);
    await sleep(32);

    await sleep(getHeroTiming('emptyMs', { soft }));

    if (intro && mark) {
      setHomeMarkFocus(true);
      stage.classList.add('hero-pillar-fade__stage--intro');
      await sleep(getHeroTiming('introMarkDelayMs', { soft }));
      await animateMarkSurface(mark, true, getHeroTiming('introMarkFadeInMs', { soft }));
      await sleep(getHeroTiming('introMarkHoldMs', { soft }));

      /* Sync: blur de salida + 1.ª frase a la vez (sin hueco). */
      stage.classList.remove('hero-pillar-fade__stage--intro');
      stage.classList.add('hero-pillar-fade__stage--mark-handoff');
      setBatchLayout(stage, true);
      const markOut = animateMarkSurface(mark, false, getHeroTiming('introMarkFadeOutMs', { soft }));
      const batchIn = fadeBatchInTogether(phrases);
      await markOut;
      stage.classList.remove('hero-pillar-fade__stage--mark-handoff');
      setMarkHiddenInstant(mark);
      setHomeMarkFocus(false);
      await batchIn;
    } else {
      setBatchLayout(stage, true);
      setMarkHiddenInstant(mark);
      await fadeBatchInTogether(phrases);
    }

    await sleep(getHeroTiming('batchHoldMs'));

    const remainingSoloIndices = await fadeOutBatchColumn(phrases, stage);

    await sleep(280);

    if (mark) {
      setHomeMarkFocus(true);
      await animateMark(mark, true, soloFadeInMs, { mode: 'solo' });
    }

    const slots = shuffle(getSoloSlotPool()).slice(0, remainingSoloIndices.length);

    for (let i = 0; i < remainingSoloIndices.length; i += 1) {
      const el = phrases[remainingSoloIndices[i]];
      const slot = slots[i];
      await movePhraseToSlot(el, slot, { fadeOutMs: HERO_PILLAR_TIMING.soloRepositionFadeOutMs });
      await glowPhrase(el, true, soloFadeInMs, HERO_GLOW_IN_EASE);
      await sleep(HERO_PILLAR_TIMING.soloHoldMs);
      await glowPhrase(el, false, HERO_PILLAR_TIMING.soloFadeOutMs, HERO_FADE_OUT_EASE);
      await sleep(HERO_PILLAR_TIMING.soloStartGapMs);
    }

    if (mark) {
      await animateMark(mark, false, getHeroTiming('batchPhraseFadeOutMs'), { mode: 'solo' });
      setMarkMode(mark, null);
      setHomeMarkFocus(false);
    }

    await sleep(getHeroTiming('loopPauseMs'));
  }

  function initHeroPillarFade() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const stage = document.querySelector('[data-hero-pillar-stage]');
    if (!stage || stage.dataset.heroPillarInit === '1') return;

    const phrases = [...stage.querySelectorAll('.hero-pillar-fade__phrase')];
    if (phrases.length === 0) return;

    const mark = stage.querySelector('[data-hero-pillar-mark]');
    if (mark) setMarkHiddenInstant(mark);

    stage.dataset.heroPillarInit = '1';
    stage.classList.add('hero-pillar-fade__stage--js');
    measureAndLockStageHeight(stage, phrases);

    (async () => {
      let firstCycle = true;
      while (stage.isConnected) {
        /* 1.ª vez: intro completo. Bucles: soft (misma alma, más corto). */
        await runHeroPillarCycle(phrases, stage, { intro: true, soft: !firstCycle });
        firstCycle = false;
      }
    })();
  }

  function initHomeAmbientSettle() {
    const isHome = Boolean(document.querySelector('.tevsys-home-band--cards'));
    if (!isHome) {
      document.body.classList.remove('tevsys-home-ambient-settle');
      delete document.body.dataset.tevsysAmbientSettleInit;
      return;
    }
    if (document.body.dataset.tevsysAmbientSettleInit === '1') return;
    document.body.dataset.tevsysAmbientSettleInit = '1';
    /* ~26 s: bienvenida ya vista; ambiente baja un poco (revertible). */
    window.setTimeout(() => {
      if (!document.querySelector('.tevsys-home-band--cards')) return;
      document.body.classList.add('tevsys-home-ambient-settle');
    }, 26000);
  }

  initHeroPillarFade();
  initHomeAmbientSettle();
  document.addEventListener('astro:page-load', () => {
    initHeroPillarFade();
    initHomeAmbientSettle();
  });
</script>

<style>
  .hero-section__section {
    --hero-tech-font: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'Consolas', monospace;
    margin: var(--section-margin) auto;
    min-height: clamp(88vh, 92vw, calc(100vh - var(--navbar-height)));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }

  .hero-section__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 88% 78% at 90% 30%, rgba(245, 176, 65, 0.14) 0%, transparent 58%),
      radial-gradient(ellipse 60% 55% at 96% 68%, rgba(255, 210, 120, 0.08) 0%, transparent 52%),
      radial-gradient(ellipse 50% 45% at 78% 45%, rgba(247, 192, 80, 0.05) 0%, transparent 46%);
  }

  .hero-section__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    min-height: 0;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1rem clamp(1.35rem, 3.5vh, 2.35rem);
    box-sizing: border-box;
