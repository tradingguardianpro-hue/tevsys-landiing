---
import { Icon } from 'astro-icon/components';
import { Container, Button } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';
---

<Container>
  <section class="hero-section__section">
    <a href="/" class="hero-brand__oval">
      <img src="/logo-tevsys.png" alt="tevsys" class="hero-brand__logo" />
    </a>
    <div class="hero-section__text">
      <h1>Tu capital merece más que buenas intenciones</h1>
      <div class="hero-tagline">
        <span class="hero-tagline__dot"></span>
        <span class="hero-tagline__text">Where precision meets the edge</span>
      </div>
      <div class="hero-btns__container">
        <Button href="/company/contact" customIcon>
          Probar demo
          <Fragment slot="icon">
            <Icon name="ic:baseline-chevron-right"/>
          </Fragment>
        </Button>
        <Button href="/company/contact" unelevated>Contactar</Button>
      </div>
      {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
    </div>
    <div class="hero-section__image">
      <picture>
        <img
          src="/hero-tevsys.png"
          alt="tevsys"
          id="home-hero-image"
        />
      </picture>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    grid-template-rows: auto 1fr;
    align-items: center;
    gap: 2rem;
  }
  .hero-brand__oval {
    grid-column: 1;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.75rem;
    margin: 0;
    width: fit-content;
    max-width: 95%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 3rem;
    background: rgba(255, 255, 255, 0.04);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s;
  }
  .hero-brand__oval:hover {
    opacity: 0.9;
  }
  .hero-brand__logo {
    height: 1.85rem;
    width: auto;
    filter: brightness(0) invert(1);
    flex-shrink: 0;
    display: block;
  }
  .hero-section__text {
    grid-column: 1;
    grid-row: 2;
    justify-self: center;
    max-width: 25rem;
  }
  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.03);
  }
  .hero-tagline__dot {
    width: 14px;
    height: 14px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-tagline__text {
    font-size: 1rem;
    opacity: 0.95;
  }
  .hero-btns__container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hero-section__image {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .hero-section__image img {
    width: 100%;
    min-width: 400px;
    max-width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    border-radius: var(--theme-shape-radius);
  }
  @media (max-width: 768px) {
    .hero-section__section {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
    }
    .hero-brand__oval {
      grid-column: 1;
      grid-row: 1;
      max-width: 100%;
      align-self: center;
    }
    .hero-section__text {
      grid-column: 1;
    }
    .hero-section__image img {
      min-width: unset;
    }
  }
</style>
