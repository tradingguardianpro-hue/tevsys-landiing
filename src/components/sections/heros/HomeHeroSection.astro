---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';
---

<Container>
  <section class="hero-section__section">
    <div class="hero-section__text">
      <h1 class="hero-title">Tu capital merece más que buenas intenciones</h1>
      <div class="hero-tagline">
        <span class="hero-tagline__dot"></span>
        <span class="hero-tagline__text">Where precision meets the edge</span>
      </div>
      <a href="/company/contact" class="hero-download-btn">
        Descargar demo →
      </a>
      {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
    </div>
    <div class="hero-section__image">
      <div class="hero-image__wrapper">
        <picture>
          <img
            src="/hero-tevsys.png"
            alt="tevsys"
            id="home-hero-image"
          />
        </picture>
      </div>
      <span class="hero-image__brand">Trading Edge Verification System</span>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    align-items: center;
    gap: 2rem;
  }
  .hero-section__text {
    grid-column: 1;
    justify-self: center;
    max-width: 25rem;
  }
  .hero-title {
    font-family: 'Outfit', -apple-system, sans-serif;
  }
  .hero-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    border: none;
    border-radius: 2rem;
    background: #fff;
    color: #111;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .hero-download-btn:hover {
    opacity: 0.92;
  }
  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 1.2rem;
    margin: 1rem 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.03);
  }
  .hero-tagline__dot {
    width: 32px;
    height: 32px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-tagline__text {
    font-size: 1.05rem;
    opacity: 0.95;
  }
  .hero-section__image {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
  }
  .hero-image__wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  .hero-image__brand {
    margin-top: 0.75rem;
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.02em;
  }
  .hero-image__wrapper img,
  .hero-section__image img {
    width: 100%;
    min-width: 400px;
    max-width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    border-radius: var(--theme-shape-radius);
  }
  @media (max-width: 768px) {
    .hero-section__section {
      grid-template-columns: 1fr;
    }
    .hero-image__wrapper img,
    .hero-section__image img {
      min-width: unset;
    }
  }
</style>
