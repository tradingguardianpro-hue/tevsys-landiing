---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';
---

<Container>
  <section class="hero-section__section">
    <div class="hero-section__text">
      <h1 class="hero-title">
        MT5: <span class="hero-title__underline">disciplina automatizada</span>. Tú pones los límites, <span class="hero-title__brand">tevsys</span> los blinda, no negocia y lo registra.
      </h1>
      <div class="hero-tagline">
        <span class="hero-tagline__dot"></span>
        <span class="hero-tagline__text">Where precision meets the edge</span>
      </div>
      <a href="/company/contact?flow=demo" class="hero-download-btn">
        Descargar demo →
      </a>
      <p class="hero-platform-note">Disponible en MT5 · Próximamente: más plataformas</p>
      {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
    </div>
    <div class="hero-section__image">
      <div class="hero-image__wrapper">
        <picture>
          <source type="image/webp" srcset="/mano-robotica-central-web.webp" />
          <img
            src="/mano%20robotica%20central%20web.png"
            alt="tevsys"
            id="home-hero-image"
            width="1200"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <span class="hero-image__brand">Trading Edge Verification System</span>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
    gap: 1rem;
    position: relative;
    isolation: isolate;
    border-radius: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .hero-section__text {
    grid-column: 1;
    justify-self: center;
    max-width: min(36rem, 100%);
    position: relative;
    z-index: 1;
  }
  .hero-title {
    font-family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    font-weight: 600;
    font-size: clamp(1.2rem, 3.6vw, 1.75rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22em;
    color: rgba(255, 255, 255, 0.98);
  }
  .hero-title__underline {
    text-decoration: underline;
    text-decoration-thickness: 0.11em;
    text-underline-offset: 0.18em;
    text-decoration-color: rgba(255, 255, 255, 0.92);
  }
  .hero-title__brand {
    font-family: 'Outfit', -apple-system, sans-serif;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #f5b041;
    text-decoration: none;
  }
  .hero-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.35rem;
    margin-top: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 2rem;
    background: #f5b041;
    color: #1a1510;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(245, 176, 65, 0.35);
  }
  .hero-download-btn:hover {
    filter: brightness(1.06);
  }
  .hero-platform-note {
    margin: 0.65rem 0 0;
    font-size: 0.76rem;
    opacity: 0.78;
  }
  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 1.2rem;
    margin: 0.75rem 0 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.03);
  }
  .hero-tagline__dot {
    width: 22px;
    height: 22px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-tagline__text {
    font-size: 1.05rem;
    opacity: 0.95;
  }
  .hero-section__image {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    position: relative;
    z-index: 1;
  }
  .hero-image__wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
  }
  .hero-image__brand {
    margin-top: 0.75rem;
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.02em;
  }
  .hero-image__wrapper img,
  .hero-section__image img {
    width: 100%;
    min-width: min(280px, 100%);
    max-width: min(100%, 480px);
    height: auto;
    max-height: min(48vh, 520px);
    object-fit: contain;
    object-position: right top;
    border-radius: var(--theme-shape-radius);
  }
  @media (max-width: 768px) {
    .hero-section__section {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 1.25rem;
    }
    .hero-section__text {
      justify-self: stretch;
      max-width: 100%;
    }
    .hero-section__image {
      grid-column: 1;
      grid-row: auto;
      align-items: center;
    }
    .hero-image__wrapper {
      width: 100%;
      justify-content: center;
    }
    .hero-image__wrapper img,
    .hero-section__image img {
      min-width: unset;
      width: min(88vw, 400px);
      max-height: min(42vh, 380px);
    }
    .hero-image__brand {
      align-self: center;
      text-align: center;
    }
  }
  @media (max-width: 420px) {
    .hero-image__wrapper img,
    .hero-section__image img {
      width: 100%;
    }
  }
</style>
