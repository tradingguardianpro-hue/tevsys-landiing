---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';
---

<Container>
  <section class="hero-section__section">
    <div class="hero-section__glow" aria-hidden="true"></div>
    <div class="hero-section__inner">
      <div class="hero-section__text">
        <h1 class="hero-title">
          Tú pones los límites. <span class="hero-title__brand">TEVSYS</span> los blinda. <span class="hero-title__underline">Disciplina automatizada</span>.
        </h1>
        <p class="hero-context-line">
          Control de riesgo y límites en tu cuenta MT5 — automatizado y registrado.
        </p>
        <div class="hero-tagline-wrap">
          <div class="hero-tagline">
            <span class="hero-tagline__dot"></span>
            <span class="hero-tagline__text">Where precision meets the edge</span>
          </div>
        </div>
        <a href="/company/contact?flow=demo" class="hero-download-btn">
          Descargar demo →
        </a>
        <p class="hero-platform-note">Disponible en MT5 · Próximamente: más plataformas</p>
        {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
      </div>
      <div class="hero-section__image">
        <div class="hero-image__wrapper">
          <picture class="hero-image__picture">
            <source type="image/webp" srcset="/mano-robotica-central-web.webp" />
            <img
              class="hero-image__img"
              src="/mano%20robotica%20central%20web.png"
              alt="tevsys"
              id="home-hero-image"
              width="1200"
              height="800"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
        <span class="hero-image__brand">Trading Edge Verification System</span>
      </div>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(88vh, 92vw, calc(100vh - var(--navbar-height)));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* Un solo redondeo visible: lo aplica .tevsys-home-hero-stack (evita doble “marco”) */
    border-radius: 0;
  }

  /* Halo fijo ámbar (marca tevsys), solo en hero; motions globales siguen en index/global */
  .hero-section__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 88% 78% at 90% 30%, rgba(245, 176, 65, 0.28) 0%, transparent 54%),
      radial-gradient(ellipse 60% 55% at 96% 68%, rgba(255, 210, 120, 0.16) 0%, transparent 50%),
      radial-gradient(ellipse 50% 45% at 78% 45%, rgba(247, 192, 80, 0.1) 0%, transparent 42%);
  }

  /* Tipografía solo en este bloque: Inter (producto/legibilidad). Resto de la web: tema hasta decisión global. */
  .hero-section__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1rem 1.5rem;
    box-sizing: border-box;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .hero-section__text {
    max-width: min(40rem, 100%);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-title {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-weight: 600;
    font-size: clamp(1.55rem, 3.5vw, 2.15rem);
    line-height: 1.46;
    letter-spacing: -0.028em;
    margin: 0;
    max-width: 24em;
    color: #f4f6f8;
    text-align: center;
  }
  .hero-title__underline {
    text-decoration: underline;
    text-decoration-thickness: 0.09em;
    text-underline-offset: 0.22em;
    text-decoration-color: rgba(255, 255, 255, 0.88);
  }
  .hero-title__brand {
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #f5b041;
    text-decoration: none;
  }

  /* Contexto temprano (novatos): no compite con el H1 */
  .hero-context-line {
    margin: 0.875rem 0 0;
    max-width: min(34rem, 100%);
    padding: 0 0.25rem;
    font-size: clamp(0.9375rem, 2.1vw, 1.0625rem);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: rgba(244, 246, 248, 0.82);
    text-align: center;
  }

  .hero-tagline-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: clamp(1.75rem, 5vw, 2.75rem);
    margin-bottom: clamp(1.5rem, 3.5vw, 2.25rem);
  }
  .hero-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.35rem;
    margin-top: clamp(1.75rem, 4.5vw, 2.75rem);
    font-size: 1rem;
    font-weight: 600;
    border: none;
    border-radius: 2rem;
    background: #f5b041;
    color: #1a1510;
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(245, 176, 65, 0.35);
  }
  .hero-download-btn:hover {
    filter: brightness(1.06);
  }
  .hero-platform-note {
    margin: clamp(1.25rem, 3vw, 1.75rem) 0 0;
    font-size: 0.8125rem;
    font-weight: 400;
    color: rgba(244, 246, 248, 0.72);
    text-align: center;
    max-width: 28rem;
  }
  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 1rem;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
  }
  .hero-tagline__dot {
    width: 18px;
    height: 18px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-tagline__text {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(244, 246, 248, 0.92);
  }
  .hero-section__image {
    /* Tema oscuro pone --theme-shape-radius: 0; aquí forzamos esquinas suaves solo para la foto */
    --hero-image-radius: clamp(1.2rem, 3.2vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    max-width: 36rem;
    position: relative;
    z-index: 1;
  }
  .hero-image__wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    position: relative;
    border-radius: var(--hero-image-radius);
    overflow: hidden;
    /* Funde la silueta con el hero (menos “pegatine” rectangular) */
    box-shadow: 0 22px 56px -28px rgba(0, 0, 0, 0.5);
  }
  /* Viñeta un poco más generosa en bordes y esquinas */
  .hero-image__wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 0 72px 40px rgba(0, 0, 0, 0.42),
      inset 0 0 148px 64px rgba(0, 0, 0, 0.28);
  }
  .hero-image__picture {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 0;
  }
  .hero-image__brand {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.42);
    letter-spacing: 0.02em;
    text-align: center;
  }
  .hero-image__img,
  .hero-image__wrapper img,
  .hero-section__image img {
    display: block;
    width: auto;
    max-width: min(100%, 340px);
    height: auto;
    max-height: min(36vh, 320px);
    margin-left: auto;
    margin-right: auto;
    object-fit: contain;
    object-position: center center;
    border-radius: var(--hero-image-radius);
    /* Misma receta que cards: integra sin “apagar”; contraste ≥1 para sensación nítida (evita aspecto borroso) */
    filter: brightness(0.91) saturate(0.97) contrast(1.04);
  }
  @media (max-width: 768px) {
    .hero-section__section {
      min-height: auto;
    }
    .hero-section__inner {
      padding-bottom: 1.25rem;
    }
    .hero-image__wrapper img,
    .hero-section__image img {
      max-width: min(88vw, 300px);
      max-height: min(34vh, 280px);
    }
  }
  @media (max-width: 420px) {
    .hero-title {
      max-width: 100%;
    }
  }
</style>
