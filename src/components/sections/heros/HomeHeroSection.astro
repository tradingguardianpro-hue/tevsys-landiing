---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';

const heroProductPillars = [
  'Precisión de cierre en tu operativa',
  'Disciplina automatizada',
  'Trazabilidad verificable',
  'Protección activa en MT5',
];
const heroPillarFadeCycleSec = 20;
---

<Container>
  <section class="hero-section__section" data-hero-layout="scheme-2m-b">
    <div class="hero-section__glow" aria-hidden="true"></div>
    <div class="hero-section__inner">
      <div class="hero-section__text">
        <h1 class="hero-title">
          <span class="hero-title__line">Tú pones los límites.</span>
          <span class="hero-title__line hero-title__line--accent">
            <span class="hero-title__brand">TEVSYS</span> los blinda.
          </span>
        </h1>
        <div class="hero-pillar-fade" aria-label="Capas del producto tevsys">
          <div class="hero-pillar-fade__stage">
            {heroProductPillars.map((phrase, index) => (
              <p
                class="hero-pillar-fade__phrase"
                style={`--fade-i: ${index}; --fade-cycle: ${heroPillarFadeCycleSec}s;`}
              >
                {phrase}
              </p>
            ))}
          </div>
        </div>
        <div class="hero-action-block">
          <p class="hero-disclaimer">
            No damos señales ni promesas de beneficio.
          </p>
          <div class="hero-cta-row">
            <a href="/company/contact?flow=demo" class="hero-download-btn">
              Descargar demo →
            </a>
            <a href="/como-funciona?play=1#evidencia-nasdaq-100" class="hero-audit-btn">
              Ver evidencia (~4 min)
            </a>
          </div>
        </div>
        {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
      </div>
      <div class="hero-section__image">
        <div class="hero-image__wrapper">
          <div class="hero-image__media">
            <picture class="hero-image__picture">
              <img
                class="hero-image__img"
                src="/mano%20robotica%20central%20web.png?v=2"
                alt="tevsys"
                id="home-hero-image"
                width="1200"
                height="800"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
          </div>
          <span class="hero-image__brand" lang="en" translate="no">Trading Edge Verification System</span>
        </div>
        <p class="hero-platform-note">Disponible en MT5 · Próximamente: más plataformas</p>
      </div>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(88vh, 92vw, calc(100vh - var(--navbar-height)));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }

  .hero-section__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 88% 78% at 90% 30%, rgba(245, 176, 65, 0.19) 0%, transparent 54%),
      radial-gradient(ellipse 60% 55% at 96% 68%, rgba(255, 210, 120, 0.11) 0%, transparent 50%),
      radial-gradient(ellipse 50% 45% at 78% 45%, rgba(247, 192, 80, 0.07) 0%, transparent 42%);
  }

  .hero-section__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    min-height: 0;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1rem clamp(1.35rem, 3.5vh, 2.35rem);
    box-sizing: border-box;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .hero-section__text {
    --hero-disclaimer-font-size: clamp(0.875rem, 1vw + 0.18rem, 0.96875rem);
    max-width: min(52rem, 100%);
    width: 100%;
    min-width: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding-inline: clamp(0.5rem, 2vw, 1rem);
    box-sizing: border-box;
  }

  /* Esquema 2 — H1 dos líneas, escala tipo landing quant (sin forzar una sola línea). */
  .hero-title {
    font-family: var(--tevsys-display-title-font, 'DM Sans', 'Inter', system-ui, sans-serif);
    font-weight: var(--tevsys-display-title-weight, 600);
    font-size: clamp(2rem, calc(5.4vw + 0.5rem), 4.35rem);
    line-height: 1.06;
    letter-spacing: var(--tevsys-display-title-tracking, -0.03em);
    margin: 0 0 clamp(2rem, 5.5vh, 3.65rem);
    width: 100%;
    max-width: min(42rem, 100%);
    margin-inline: auto;
    color: #e8ebf0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.28em;
    text-wrap: balance;
  }

  .hero-title__line {
    display: block;
  }

  .hero-title__brand {
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #f5b041;
    text-decoration: none;
  }

  .hero-pillar-fade {
    position: relative;
    z-index: 1;
    align-self: stretch;
    width: 100%;
    max-width: 100%;
    margin: 0 0 clamp(2.25rem, 5.2vh, 3.25rem);
    padding: clamp(0.15rem, 0.5vw, 0.35rem) 0;
    box-sizing: border-box;
  }

  .hero-pillar-fade__stage {
    position: relative;
    width: 100%;
    min-height: clamp(2.9em, 5.5vw, 3.2em);
    margin: 0;
    padding: 0;
  }

  .hero-pillar-fade__phrase {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: clamp(0.875rem, 1.25vw, 0.9375rem);
    font-weight: 400;
    line-height: 1.45;
    letter-spacing: 0.04em;
    color: rgba(208, 212, 222, 0.92);
    text-align: left;
    text-wrap: balance;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    will-change: opacity, visibility;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-pillar-fade__phrase {
      animation: hero-pillar-phrase-fade var(--fade-cycle, 20s) ease-in-out infinite;
      animation-delay: calc(var(--fade-i, 0) * (var(--fade-cycle, 20s) / 4));
    }
  }

  @keyframes hero-pillar-phrase-fade {
    0%,
    6%,
    28%,
    100% {
      opacity: 0;
      visibility: hidden;
    }
    12%,
    21% {
      opacity: 1;
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-pillar-fade__stage {
      min-height: auto;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .hero-pillar-fade__phrase {
      position: static;
      opacity: 0.82;
      visibility: visible;
    }
  }

  .hero-action-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    align-self: center;
    width: 100%;
    max-width: min(36rem, 100%);
    margin-top: 0;
    gap: 0;
  }

  .hero-disclaimer {
    margin: 0 0 clamp(1.5rem, 3.8vw, 2.1rem);
    max-width: min(30rem, 100%);
    width: 100%;
    padding: 0 0.35rem;
    box-sizing: border-box;
    font-family: var(--tevsys-display-title-font, 'DM Sans', 'Inter', system-ui, sans-serif);
    font-size: var(--hero-disclaimer-font-size);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: 0.01em;
    color: rgba(244, 246, 248, 0.74);
    text-align: center;
    text-wrap: balance;
  }

  .hero-cta-row {
    margin-top: 0;
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .hero-download-btn {
    gap: 0.5rem;
  }

  .hero-cta-row .hero-download-btn {
    margin-top: 0;
  }

  .hero-audit-btn {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.35;
    padding: 0.55rem 1.1rem;
    border-radius: 2rem;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.03);
    color: rgba(244, 246, 248, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.24);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .hero-audit-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.36);
    color: #f4f6f8;
  }

  .hero-platform-note {
    margin: auto 0 0;
    padding-top: clamp(1.35rem, 3.5vh, 2.75rem);
    padding-bottom: clamp(0.25rem, 0.8vh, 0.5rem);
    font-size: 0.8125rem;
    font-weight: 400;
    color: rgba(244, 246, 248, 0.62);
    text-align: center;
    max-width: 28rem;
    line-height: 1.4;
    width: 100%;
  }

  .hero-section__image {
    --hero-image-radius: clamp(1.2rem, 3.2vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex: 1 1 auto;
    min-height: 0;
    margin-top: clamp(1.25rem, 3.2vw, 1.75rem);
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    max-width: 41rem;
    position: relative;
    z-index: 1;
  }

  .hero-image__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: clamp(0.72rem, 2vw, 0.95rem) clamp(0.95rem, 2.5vw, 1.15rem)
      clamp(0.52rem, 1.35vw, 0.72rem);
    position: relative;
    border-radius: var(--hero-image-radius);
    overflow: visible;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 26px -10px rgba(245, 176, 65, 0.07),
      0 22px 56px -28px rgba(0, 0, 0, 0.5);
  }

  @keyframes tevsys-hero-hand-outer-frame {
    from {
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.08),
        0 0 26px -10px rgba(245, 176, 65, 0.07),
        0 22px 56px -28px rgba(0, 0, 0, 0.5);
    }
    to {
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.14),
        0 0 30px -6px rgba(245, 176, 65, 0.14),
        0 22px 56px -28px rgba(0, 0, 0, 0.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-image__wrapper {
      animation: tevsys-hero-hand-outer-frame 21s ease-in-out infinite alternate;
    }
  }

  .hero-image__wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 0 34px 18px rgba(0, 0, 0, 0.14),
      inset 0 0 78px 34px rgba(0, 0, 0, 0.08);
  }

  .hero-image__media {
    display: inline-block;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    line-height: 0;
  }

  .hero-image__picture {
    display: block;
    width: 100%;
    margin: 0;
  }

  .hero-image__brand {
    position: static;
    transform: none;
    align-self: center;
    margin: clamp(0.58rem, 1.35vw, 0.78rem) 0 0;
    padding: 0 0.35rem;
    max-width: 100%;
    box-sizing: border-box;
    font-size: clamp(0.5625rem, 0.92vw, 0.625rem);
    font-weight: 400;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.2);
    letter-spacing: 0.05em;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
  }

  .hero-image__img,
  .hero-image__wrapper img,
  .hero-section__image img {
    display: block;
    width: auto;
    max-width: min(100%, 410px);
    height: auto;
    max-height: min(43vh, 392px);
    margin-left: auto;
    margin-right: auto;
    object-fit: contain;
    object-position: center center;
    border-radius: var(--hero-image-radius);
    transition: none;
    transform: scale(1.1);
    transform-origin: center center;
    filter: brightness(0.99) saturate(1.02) contrast(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image__img,
    .hero-image__wrapper img,
    .hero-section__image img {
      transition: none;
      transform: scale(1.1);
    }

    .hero-image__wrapper {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .hero-section__section {
      min-height: auto;
      overflow-x: visible;
      overflow-y: hidden;
    }

    .hero-section__inner {
      padding-bottom: 1.25rem;
      padding-left: max(1rem, env(safe-area-inset-left, 0px));
      padding-right: max(1rem, env(safe-area-inset-right, 0px));
    }

    .hero-title {
      font-size: clamp(1.85rem, calc(5.5vw + 0.35rem), 3rem);
      line-height: 1.08;
      gap: 0.2em;
      padding-inline: 0.15rem;
      margin-bottom: clamp(1.65rem, 5vh, 2.35rem);
      color: #e8ebf0;
    }

    .hero-section__text {
      --hero-disclaimer-font-size: clamp(0.8125rem, 2.65vw, 0.875rem);
    }

    .hero-pillar-fade {
      margin-bottom: clamp(2rem, 5.5vh, 2.85rem);
    }

    .hero-pillar-fade__stage {
      min-height: clamp(3.1em, 10vw, 3.6em);
    }

    .hero-pillar-fade__phrase {
      font-size: clamp(0.8125rem, 2.75vw, 0.875rem);
      letter-spacing: 0.035em;
      line-height: 1.5;
    }

    .hero-action-block {
      gap: 0;
    }

    .hero-disclaimer {
      margin-bottom: clamp(1.25rem, 4vw, 1.65rem);
      color: rgba(244, 246, 248, 0.72);
    }

    .hero-section__inner {
      padding-bottom: clamp(1.1rem, 3vh, 1.65rem);
    }

    .hero-section__image {
      flex: 1 1 auto;
      margin-top: clamp(1rem, 3.5vw, 1.65rem);
      --hero-image-radius: clamp(1.35rem, 4.5vw, 1.95rem);
    }

    .hero-platform-note {
      padding-top: clamp(1.1rem, 3.5vh, 2rem);
    }

    .hero-cta-row {
      margin-top: 0;
      gap: 0.62rem;
    }

    .hero-audit-btn {
      width: auto;
      max-width: 100%;
      font-size: 0.93rem;
      padding: 0.52rem 0.95rem;
    }

    .hero-image__brand {
      margin-top: clamp(0.5rem, 1.85vw, 0.68rem);
      font-size: clamp(0.5rem, 1.85vw, 0.5625rem);
      letter-spacing: 0.045em;
      color: rgba(255, 255, 255, 0.18);
      white-space: normal;
      text-wrap: balance;
    }

    .hero-image__wrapper {
      flex-direction: column;
      padding: 1.05rem clamp(2rem, 9vw, 2.85rem) clamp(0.62rem, 1.8vw, 0.85rem);
      border-radius: var(--hero-image-radius);
      animation: none;
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.11),
        0 0 28px -8px rgba(245, 176, 65, 0.1),
        0 22px 56px -28px rgba(0, 0, 0, 0.5);
    }

    .hero-image__wrapper::after {
      box-shadow:
        inset 0 0 26px 14px rgba(0, 0, 0, 0.11),
        inset 0 0 64px 28px rgba(0, 0, 0, 0.06);
    }

    .hero-image__wrapper img,
    .hero-section__image img {
      max-width: min(86vw, 322px);
      max-height: min(40vh, 330px);
      transform: translate3d(0, 0, 0) scale(1.03);
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
  }
</style>
