---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';
---

<Container>
  <section class="hero-section__section" data-hero-layout="scheme-2b">
    <div class="hero-section__glow" aria-hidden="true"></div>
    <div class="hero-section__inner">
      <div class="hero-section__text">
        <h1 class="hero-title">
          <span class="hero-title__line">Tú pones los límites.</span>
          <span class="hero-title__line hero-title__line--accent">
            <span class="hero-title__brand">TEVSYS</span> los blinda.
          </span>
        </h1>
        <p class="hero-subline hero-subline--pillar">
          Disciplina automatizada · Trazabilidad verificable
        </p>
        <p class="hero-subline hero-subline--pillar">
          Precisión de cierre de operaciones · Protección activa en MT5
        </p>
        <p class="hero-disclaimer">
          No damos señales ni promesas de beneficio.
        </p>
        <div class="hero-cta-row">
          <a href="/company/contact?flow=demo" class="hero-download-btn">
            Descargar demo →
          </a>
          <a href="/como-funciona?play=1#evidencia-nasdaq-100" class="hero-audit-btn">
            Ver evidencia (~4 min)
          </a>
        </div>
        <div class="hero-tagline-wrap">
          <div class="hero-tagline">
            <span class="hero-tagline__dot"></span>
            <span class="hero-tagline__text">Where precision meets the edge</span>
          </div>
        </div>
        {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
      </div>
      <div class="hero-section__image">
        <div class="hero-image__wrapper">
          <picture class="hero-image__picture">
            <img
              class="hero-image__img"
              src="/mano%20robotica%20central%20web.png?v=2"
              alt="tevsys"
              id="home-hero-image"
              width="1200"
              height="800"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>
        <span class="hero-image__brand">Trading Edge Verification System</span>
        <p class="hero-platform-note">Disponible en MT5 · Próximamente: más plataformas</p>
      </div>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(88vh, 92vw, calc(100vh - var(--navbar-height)));
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 0;
  }

  .hero-section__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 88% 78% at 90% 30%, rgba(245, 176, 65, 0.28) 0%, transparent 54%),
      radial-gradient(ellipse 60% 55% at 96% 68%, rgba(255, 210, 120, 0.16) 0%, transparent 50%),
      radial-gradient(ellipse 50% 45% at 78% 45%, rgba(247, 192, 80, 0.1) 0%, transparent 42%);
  }

  .hero-section__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 2.5rem) 1rem 1.5rem;
    box-sizing: border-box;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }

  .hero-section__text {
    max-width: min(52rem, 100%);
    width: 100%;
    min-width: 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-inline: clamp(0.5rem, 2vw, 1rem);
    box-sizing: border-box;
  }

  /* Esquema 2 — H1 dos líneas, escala tipo landing quant (sin forzar una sola línea). */
  .hero-title {
    font-family: var(--tevsys-display-title-font, 'DM Sans', 'Inter', system-ui, sans-serif);
    font-weight: var(--tevsys-display-title-weight, 600);
    font-size: clamp(1.85rem, calc(4.9vw + 0.55rem), 4rem);
    line-height: 1.08;
    letter-spacing: var(--tevsys-display-title-tracking, -0.03em);
    margin: 0;
    width: 100%;
    max-width: min(40rem, 100%);
    margin-inline: auto;
    color: #f4f6f8;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.12em;
    text-wrap: balance;
  }

  .hero-title__line {
    display: block;
  }

  .hero-title__brand {
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #f5b041;
    text-decoration: none;
  }

  .hero-subline {
    width: 100%;
    max-width: min(38rem, 100%);
    margin: 0;
    padding: 0 0.25rem;
    box-sizing: border-box;
    text-align: center;
    text-wrap: balance;
    letter-spacing: -0.02em;
  }

  .hero-subline--pillar {
    margin-top: clamp(0.55rem, 1.8vw, 0.72rem);
    font-size: clamp(1rem, 2.65vw, 1.55rem);
    font-weight: 600;
    line-height: 1.38;
    color: rgba(244, 246, 248, 0.94);
  }

  .hero-subline--pillar:first-of-type {
    margin-top: clamp(1.1rem, 3.2vw, 1.85rem);
  }

  .hero-disclaimer {
    margin: clamp(1rem, 2.8vw, 1.35rem) 0 0;
    max-width: min(32rem, 100%);
    width: 100%;
    padding: 0 0.25rem;
    box-sizing: border-box;
    font-size: clamp(0.875rem, 1.9vw, 1rem);
    font-weight: 500;
    line-height: 1.42;
    letter-spacing: -0.01em;
    color: rgba(244, 246, 248, 0.72);
    text-align: center;
    text-wrap: balance;
  }

  .hero-tagline-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: clamp(1.1rem, 3vw, 1.5rem);
    margin-bottom: 0;
  }

  .hero-download-btn {
    gap: 0.5rem;
  }

  .hero-cta-row {
    margin-top: clamp(1.35rem, 3.8vw, 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .hero-cta-row .hero-download-btn {
    margin-top: 0;
  }

  .hero-audit-btn {
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 0.97rem;
    font-weight: 600;
    line-height: 1.35;
    padding: 0.55rem 1.1rem;
    border-radius: 2rem;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.03);
    color: rgba(244, 246, 248, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.24);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .hero-audit-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.36);
    color: #f4f6f8;
  }

  .hero-platform-note {
    margin: 0.55rem 0 0;
    font-size: 0.8125rem;
    font-weight: 400;
    color: rgba(244, 246, 248, 0.62);
    text-align: center;
    max-width: 28rem;
    line-height: 1.4;
  }

  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.38rem 0.85rem;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
  }

  .hero-tagline__dot {
    width: 14px;
    height: 14px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .hero-tagline__text {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(244, 246, 248, 0.78);
  }

  .hero-section__image {
    --hero-image-radius: clamp(1.2rem, 3.2vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    margin-left: auto;
    margin-right: auto;
    width: 100%;
    max-width: 41rem;
    position: relative;
    z-index: 1;
  }

  .hero-image__wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.72rem 0.95rem;
    position: relative;
    border-radius: var(--hero-image-radius);
    overflow: visible;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 0 26px -10px rgba(245, 176, 65, 0.07),
      0 22px 56px -28px rgba(0, 0, 0, 0.5);
  }

  @keyframes tevsys-hero-hand-outer-frame {
    from {
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.08),
        0 0 26px -10px rgba(245, 176, 65, 0.07),
        0 22px 56px -28px rgba(0, 0, 0, 0.5);
    }
    to {
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.14),
        0 0 30px -6px rgba(245, 176, 65, 0.14),
        0 22px 56px -28px rgba(0, 0, 0, 0.5);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-image__wrapper {
      animation: tevsys-hero-hand-outer-frame 21s ease-in-out infinite alternate;
    }
  }

  .hero-image__wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 0 34px 18px rgba(0, 0, 0, 0.14),
      inset 0 0 78px 34px rgba(0, 0, 0, 0.08);
  }

  .hero-image__picture {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    margin: 0;
  }

  .hero-image__brand {
    margin-top: 0.5rem;
    font-size: 0.72rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.42);
    letter-spacing: 0.02em;
    text-align: center;
  }

  .hero-image__img,
  .hero-image__wrapper img,
  .hero-section__image img {
    display: block;
    width: auto;
    max-width: min(100%, 410px);
    height: auto;
    max-height: min(43vh, 392px);
    margin-left: auto;
    margin-right: auto;
    object-fit: contain;
    object-position: center center;
    border-radius: var(--hero-image-radius);
    transition: none;
    transform: scale(1.1);
    transform-origin: center center;
    filter: brightness(0.99) saturate(1.02) contrast(1.1);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image__img,
    .hero-image__wrapper img,
    .hero-section__image img {
      transition: none;
      transform: scale(1.1);
    }

    .hero-image__wrapper {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .hero-section__section {
      min-height: auto;
      overflow-x: visible;
      overflow-y: hidden;
    }

    .hero-section__inner {
      padding-bottom: 1.25rem;
      padding-left: max(1rem, env(safe-area-inset-left, 0px));
      padding-right: max(1rem, env(safe-area-inset-right, 0px));
    }

    .hero-title {
      font-size: clamp(1.65rem, calc(5.2vw + 0.4rem), 2.85rem);
      line-height: 1.1;
      padding-inline: 0.15rem;
    }

    .hero-subline--pillar {
      font-size: clamp(0.98rem, 3.2vw, 1.2rem);
      line-height: 1.4;
    }

    .hero-subline--pillar:first-of-type {
      margin-top: 1rem;
    }

    .hero-disclaimer {
      font-size: clamp(0.875rem, 2.6vw, 0.9375rem);
      margin-top: 1rem;
      color: rgba(244, 246, 248, 0.7);
    }

    .hero-cta-row {
      margin-top: clamp(1.25rem, 4vw, 1.65rem);
      gap: 0.62rem;
    }

    .hero-audit-btn {
      width: auto;
      max-width: 100%;
      font-size: 0.93rem;
      padding: 0.52rem 0.95rem;
    }

    .hero-section__image {
      --hero-image-radius: clamp(1.35rem, 4.5vw, 1.95rem);
    }

    .hero-image__wrapper {
      padding: 1.05rem clamp(2rem, 9vw, 2.85rem);
      border-radius: var(--hero-image-radius);
      animation: none;
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.11),
        0 0 28px -8px rgba(245, 176, 65, 0.1),
        0 22px 56px -28px rgba(0, 0, 0, 0.5);
    }

    .hero-image__wrapper::after {
      box-shadow:
        inset 0 0 26px 14px rgba(0, 0, 0, 0.11),
        inset 0 0 64px 28px rgba(0, 0, 0, 0.06);
    }

    .hero-image__wrapper img,
    .hero-section__image img {
      max-width: min(86vw, 322px);
      max-height: min(40vh, 330px);
      transform: translate3d(0, 0, 0) scale(1.03);
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
  }
</style>
