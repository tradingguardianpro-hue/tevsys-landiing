---
import { Container } from '@components/odyssey-theme';
import settings from '../../../config/settings.js';
import {ThemeSwitcher} from '../../theme-switcher/theme-switcher';

/** Fondo hero “aurora”: A = institucional (sutil), B = más visible. Cambiar solo esta línea para comparar. */
const heroAuroraVariant: 'A' | 'B' = 'A';
---

<Container>
  <section
    class:list={[
      'hero-section__section',
      heroAuroraVariant === 'B' && 'hero-section__section--aurora-b',
    ]}
  >
    <!-- Degradados animados (sin blur pesado: en fondo oscuro el blur se veía “gris” y casi sin movimiento) -->
    <div class="hero-aurora-layers" aria-hidden="true"></div>
    <div class="hero-section__text">
      <h1 class="hero-title">Tu trading merece más que buenas intenciones</h1>
      <p class="hero-subline">
        <span>Pioneros en verificación de disciplina automatizada</span><br />
        <span>y gestión de riesgo para mercados financieros.</span>
      </p>
      <div class="hero-tagline">
        <span class="hero-tagline__dot"></span>
        <span class="hero-tagline__text">Where precision meets the edge</span>
      </div>
      <a href="/company/contact?flow=demo" class="hero-download-btn">
        Descargar demo →
      </a>
      <p class="hero-platform-note">Disponible en MT5 · Próximamente: más plataformas</p>
      {settings.enableThemeSwitcher && <ThemeSwitcher client:only/>}
    </div>
    <div class="hero-section__image">
      <div class="hero-image__wrapper">
        <picture>
          <source type="image/webp" srcset="/mano-robotica-central-web.webp" />
          <img
            src="/mano%20robotica%20central%20web.png"
            alt="tevsys"
            id="home-hero-image"
            width="1200"
            height="800"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
      <span class="hero-image__brand">Trading Edge Verification System</span>
    </div>
  </section>
</Container>

<style>
  .hero-section__section {
    margin: var(--section-margin) auto;
    min-height: clamp(90vh, 100vw, calc(100vh - var(--navbar-height)));
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: start;
    gap: 1rem;
    position: relative;
    isolation: isolate;
    border-radius: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .hero-aurora-layers {
    position: absolute;
    inset: -6%;
    z-index: 0;
    pointer-events: none;
    border-radius: inherit;
    /* Tres capas: dos radiales + un linear grande; movemos background-position (movimiento claro, sin blur) */
    background-image:
      radial-gradient(
        ellipse 85% 70% at 18% 22%,
        rgba(56, 189, 248, 0.38) 0%,
        rgba(56, 189, 248, 0.08) 42%,
        transparent 58%
      ),
      radial-gradient(
        ellipse 80% 65% at 88% 78%,
        rgba(129, 140, 248, 0.32) 0%,
        rgba(59, 130, 246, 0.1) 45%,
        transparent 60%
      ),
      linear-gradient(
        125deg,
        rgba(8, 12, 22, 0.2) 0%,
        rgba(15, 118, 110, 0.12) 28%,
        rgba(30, 58, 138, 0.14) 55%,
        rgba(8, 12, 22, 0.25) 100%
      );
    background-size: 120% 120%, 130% 130%, 320% 320%;
    background-position: 10% 15%, 90% 85%, 0% 50%;
    background-repeat: no-repeat;
    will-change: background-position;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-aurora-layers {
      animation: hero-aurora-flow 22s ease-in-out infinite alternate;
    }
  }

  /* Variante B — más contraste y ciclo algo más rápido */
  .hero-section__section--aurora-b .hero-aurora-layers {
    background-image:
      radial-gradient(
        ellipse 90% 75% at 15% 18%,
        rgba(56, 189, 248, 0.52) 0%,
        rgba(45, 212, 191, 0.16) 40%,
        transparent 58%
      ),
      radial-gradient(
        ellipse 85% 70% at 90% 82%,
        rgba(165, 180, 252, 0.42) 0%,
        rgba(99, 102, 241, 0.18) 42%,
        transparent 58%
      ),
      linear-gradient(
        115deg,
        rgba(6, 10, 20, 0.15) 0%,
        rgba(34, 197, 194, 0.18) 30%,
        rgba(37, 99, 235, 0.2) 60%,
        rgba(6, 10, 20, 0.2) 100%
      );
    background-size: 130% 130%, 140% 140%, 380% 380%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-section__section--aurora-b .hero-aurora-layers {
      animation-duration: 14s;
    }
  }

  @keyframes hero-aurora-flow {
    0% {
      background-position: 8% 12%, 92% 88%, 5% 48%;
    }
    50% {
      background-position: 42% 28%, 62% 72%, 55% 52%;
    }
    100% {
      background-position: 78% 18%, 22% 82%, 95% 46%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-aurora-layers {
      animation: none !important;
      background-position: 20% 20%, 80% 80%, 40% 50%;
      opacity: 0.92;
    }
  }

  .hero-section__text {
    grid-column: 1;
    justify-self: center;
    max-width: 25rem;
    position: relative;
    z-index: 1;
  }
  .hero-title {
    font-family: 'Outfit', -apple-system, sans-serif;
  }
  .hero-subline {
    margin: 0.6rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
    opacity: 0.9;
    max-width: 34ch;
  }
  .hero-download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    border: none;
    border-radius: 2rem;
    background: #f5b041;
    color: #1a1510;
    text-decoration: none;
  }
  .hero-platform-note {
    margin: 0.65rem 0 0;
    font-size: 0.76rem;
    opacity: 0.78;
  }
  .hero-tagline {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 1.2rem;
    margin: 1rem 0;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 2rem;
    background: rgba(255, 255, 255, 0.03);
  }
  .hero-tagline__dot {
    width: 22px;
    height: 22px;
    background: #f5b041;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .hero-tagline__text {
    font-size: 1.05rem;
    opacity: 0.95;
  }
  .hero-section__image {
    grid-column: 2;
    grid-row: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
    position: relative;
    z-index: 1;
  }
  .hero-image__wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
  }
  .hero-image__brand {
    margin-top: 0.75rem;
    align-self: flex-start;
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.02em;
  }
  .hero-image__wrapper img,
  .hero-section__image img {
    width: 100%;
    min-width: 420px;
    max-width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    object-position: right top;
    border-radius: var(--theme-shape-radius);
  }
  @media (max-width: 768px) {
    .hero-section__section {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 1.25rem;
    }
    .hero-section__text {
      justify-self: stretch;
      max-width: 100%;
    }
    .hero-section__image {
      grid-column: 1;
      grid-row: auto;
      align-items: center;
    }
    .hero-image__wrapper {
      width: 100%;
      justify-content: center;
    }
    .hero-image__wrapper img,
    .hero-section__image img {
      min-width: unset;
      width: min(96vw, 540px);
      max-height: none;
    }
    .hero-image__brand {
      align-self: center;
      text-align: center;
    }
  }
  @media (max-width: 420px) {
    .hero-image__wrapper img,
    .hero-section__image img {
      width: 100%;
    }
  }
</style>
